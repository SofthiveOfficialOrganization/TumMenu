@model Application.Dashboard.Queries.OwnerDashboardDto
@{
    ViewData["Title"] = "Kontrol Paneli";
    var momSign = Model.MonthOverMonthPercent >= 0 ? "+" : "";
    var momClass = Model.MonthOverMonthPercent >= 0 ? "text-success" : "text-danger";
    var momIcon = Model.MonthOverMonthPercent >= 0 ? "fa-arrow-up" : "fa-arrow-down";
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="horizon-card h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="rounded-2 p-2 bg-primary bg-opacity-10">
                    <i class="fas fa-store text-primary"></i>
                </div>
                <span class="text-secondary small">Dükkan Sayısı</span>
            </div>
            <h3 class="fw-bold mb-0 text-primary">@Model.StoreCount</h3>
            <p class="text-secondary small mb-0 mt-1">Aktif dükkanlar</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="horizon-card h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="rounded-2 p-2" style="background:rgba(56,217,169,.12)">
                    <i class="fas fa-list-alt" style="color:#38d9a9"></i>
                </div>
                <span class="text-secondary small">Menü Sayısı</span>
            </div>
            <h3 class="fw-bold mb-0" style="color:#38d9a9">@Model.MenuCount</h3>
            <p class="text-secondary small mb-0 mt-1">Yayınlanan menüler</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="horizon-card h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="rounded-2 p-2" style="background:rgba(247,201,72,.12)">
                    <i class="fas fa-utensils" style="color:#f7c948"></i>
                </div>
                <span class="text-secondary small">Ürün Sayısı</span>
            </div>
            <h3 class="fw-bold mb-0" style="color:#f7c948">@Model.ProductCount</h3>
            <p class="text-secondary small mb-0 mt-1">Toplam ürün</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="horizon-card h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="rounded-2 p-2" style="background:rgba(240,101,149,.12)">
                    <i class="fas fa-qrcode" style="color:#f06595"></i>
                </div>
                <span class="text-secondary small">Bu Ay QR</span>
            </div>
            <h3 class="fw-bold mb-0" style="color:#f06595">@Model.CurrentMonthQRScans.ToString("N0")</h3>
            <p class="@momClass small mb-0 mt-1">
                <i class="fas @momIcon me-1"></i>@momSign@Model.MonthOverMonthPercent% geçen aya göre
            </p>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="horizon-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h5 class="fw-bold mb-0">QR Okutma İstatistikleri</h5>
                    <p class="text-secondary small mb-0">Dükkan bazlı karşılaştırma</p>
                </div>
                <div class="btn-group btn-group-sm" role="group" id="periodToggle">
                    <button type="button" class="btn btn-primary active" data-period="weekly" onclick="switchPeriod(this)">Haftalık</button>
                    <button type="button" class="btn btn-outline-secondary" data-period="monthly" onclick="switchPeriod(this)">Aylık</button>
                </div>
            </div>
            <div style="position:relative;height:280px">
                <canvas id="qrChart"></canvas>
            </div>
            <div id="chartLegend" class="d-flex flex-wrap gap-3 mt-3"></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-md-6">
        <div class="horizon-card h-100">
            <h5 class="fw-bold mb-3">En Çok Görüntülenen Ürünler</h5>
            @if (Model.TopProducts.Count == 0)
            {
                <p class="text-secondary small">Henüz veri yok.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var product in Model.TopProducts)
                    {
                        <li class="d-flex justify-content-between align-items-center py-2 border-bottom border-opacity-10">
                            <div>
                                <div class="fw-semibold small">@product.Title</div>
                                <div class="text-secondary" style="font-size:.75rem">@product.StoreName</div>
                            </div>
                            <span class="fw-bold text-primary">@product.Views.ToString("N0")</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="horizon-card h-100">
            <h5 class="fw-bold mb-3">Son Aktivite</h5>
            @if (Model.RecentActivity.Count == 0)
            {
                <p class="text-secondary small">Henüz aktivite yok.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var item in Model.RecentActivity)
                    {
                        <li class="d-flex gap-3 py-2 border-bottom border-opacity-10">
                            <span class="text-secondary small" style="min-width:36px">@item.Time</span>
                            <div>
                                <div class="fw-semibold small">@item.Description</div>
                                <div class="text-secondary" style="font-size:.75rem">@item.StoreName</div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const CHART_COLORS = ['#4f9ef8','#38d9a9','#f7c948','#f06595','#a78bfa','#fb923c','#34d399','#f472b6'];
    let qrChart = null;

    function escapeHtml(str) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function buildChart(data) {
        const ctx = document.getElementById('qrChart').getContext('2d');
        if (qrChart) qrChart.destroy();

        const datasets = data.datasets.map((ds, i) => ({
            label: ds.storeTitle,
            data: ds.data,
            backgroundColor: CHART_COLORS[i % CHART_COLORS.length] + 'cc',
            borderColor: CHART_COLORS[i % CHART_COLORS.length],
            borderWidth: 1,
            borderRadius: 4,
        }));

        qrChart = new Chart(ctx, {
            type: 'bar',
            data: { labels: data.labels, datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { mode: 'index', intersect: false }
                },
                scales: {
                    x: { stacked: true, grid: { display: false }, ticks: { color: '#a3aed0' } },
                    y: { stacked: true, grid: { color: 'rgba(163,174,208,.1)' }, ticks: { color: '#a3aed0', precision: 0 } }
                }
            }
        });

        // Legend
        const legend = document.getElementById('chartLegend');
        legend.innerHTML = datasets.map((ds, i) =>
            `<span class="d-flex align-items-center gap-1 small text-secondary">
                <span style="width:10px;height:10px;border-radius:2px;background:${CHART_COLORS[i % CHART_COLORS.length]};display:inline-block"></span>
                ${escapeHtml(ds.label)}
            </span>`
        ).join('');
    }

    async function switchPeriod(btn) {
        document.querySelectorAll('#periodToggle .btn').forEach(b => {
            b.classList.remove('btn-primary', 'active');
            b.classList.add('btn-outline-secondary');
        });
        btn.classList.remove('btn-outline-secondary');
        btn.classList.add('btn-primary', 'active');

        const period = btn.dataset.period;
        const response = await fetch(`/Admin/Dashboard/QRChartData?period=${period}`);
        const data = await response.json();
        buildChart(data);
    }

    // Initial load — use server-embedded data (no extra HTTP request)
    const initialData = @Html.Raw(ViewData["InitialChartData"]?.ToString() ?? "null");
    if (initialData) buildChart(initialData);
</script>
}
