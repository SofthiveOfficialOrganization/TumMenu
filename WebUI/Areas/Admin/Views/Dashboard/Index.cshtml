@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-md-3">
        <div class="horizon-card">
            <div class="d-flex align-items-center mb-3">
                <i class="fas fa-dollar-sign fa-2x text-primary me-3"></i>
                <h5 class="mb-0 text-secondary">Kazançlar</h5>
            </div>
            <h3 class="fw-bold">$340.50</h3>
            <span class="text-success small"><i class="fas fa-arrow-up"></i> +2.5%</span>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="horizon-card">
            <div class="d-flex align-items-center mb-3">
                <i class="fas fa-file-alt fa-2x text-primary me-3"></i>
                <h5 class="mb-0 text-secondary">Bu ay harcamaları</h5>
            </div>
            <h3 class="fw-bold">$642.39</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="horizon-card">
            <h5 class="text-secondary mb-3">Satışlar</h5>
            <h3 class="fw-bold">$574.34</h3>
            <span class="text-success small">+23% since last month</span>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 text-secondary">Bakiye</h5>
                <img src="https://flagcdn.com/us.svg" width="20" alt="US">
            </div>
            <h3 class="fw-bold">$1,000</h3>
            <div class="mt-3">
                 <img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" width="30" alt="Mastercard">
                 <span class="ms-2 small text-secondary">**** 1234</span>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="horizon-card">
            <h4 class="fw-bold mb-4">Toplam Harcamalar</h4>
            <div class="d-flex align-items-center mb-4">
                <h2 class="fw-bold me-3">$37.5K</h2>
                <span class="badge bg-success text-white">+2.45%</span>
            </div>
             <p class="text-success small"><i class="fas fa-check-circle me-1"></i> On track</p>
             <!-- Chart placeholder -->
             <div style="height: 200px; background: #f4f7fe; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #a3aed0;">
                 Chart Area
             </div>
        </div>
    </div>
    
     <div class="col-md-6">
        <div class="horizon-card">
            <h4 class="fw-bold mb-4">Haftalık Gelirler</h4>
             <!-- Chart placeholder -->
             <div style="height: 250px; background: #f4f7fe; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #a3aed0;">
                 Bar Chart Area
             </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold">Check Table</h4>
                <i class="fas fa-ellipsis-h text-secondary cursor-pointer"></i>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle">
                    <thead>
                        <tr class="text-secondary small text-uppercase">
                            <th>Name</th>
                            <th>Progress</th>
                            <th>Quantity</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold">Horizon UI PRO</td>
                            <td>17.5%</td>
                            <td>2,458</td>
                            <td>24.Jan.2021</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Horizon UI Free</td>
                            <td>10.8%</td>
                            <td>1,485</td>
                            <td>12.Jun.2021</td>
                        </tr>
                         <tr>
                            <td class="fw-bold">Weekly Update</td>
                            <td>21.3%</td>
                            <td>1,024</td>
                            <td>05.Jan.2021</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
