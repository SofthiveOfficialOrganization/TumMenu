@using Application.Common.Base.DTOs
@using Application.Companies.DTOs
@model PaginatedListDTO<CompanyDTO>

@{
    ViewData["Title"] = "My Companies";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                   <h4 class="fw-bold mb-1">My Companies</h4>
                   <p class="text-secondary small mb-0">Manage the companies you own.</p>
                </div>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i> Create New
                </a>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">Company Name</th>
                            <th>Slug</th>
                            <th>Created Date</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-3">
                                                @item.Title.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.Title</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-secondary">@item.Slug</td>
                                    <td class="text-secondary">@item.CreatedAt?.ToString("d")</td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary me-2" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-light text-success me-2" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this company?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light text-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-secondary">
                                    <div class="mb-3">
                                        <span class="fa-stack fa-2x">
                                            <i class="fas fa-circle fa-stack-2x text-light"></i>
                                            <i class="fas fa-store fa-stack-1x text-secondary opacity-50"></i>
                                        </span>
                                    </div>
                                    <h5>No companies yet</h5>
                                    <p class="small">You haven't created any companies yet. Start by creating one!</p>
                                    <a asp-action="Create" class="btn btn-primary mt-2">Create Company</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
             <!-- Pagination -->
            @if (Model != null && Model.Pages > 1)
            {
                   <div class="d-flex justify-content-center mt-4">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                <a class="page-link" asp-action="MyCompanies" asp-route-Index="@(Model.Index - 1)">Previous</a>
                            </li>
                             @for (int i = 1; i <= Model.Pages; i++)
                            {
                                <li class="page-item @(Model.Index == i ? "active" : "")">
                                    <a class="page-link" asp-action="MyCompanies" asp-route-Index="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                <a class="page-link" asp-action="MyCompanies" asp-route-Index="@(Model.Index + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
