@using Application.Common.Base.DTOs
@using Application.Companies.DTOs
@model PaginatedListDTO<CompanyDTO>

@{
    ViewData["Title"] = "Şirketlerim";
    var currentPageUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                   <h4 class="fw-bold mb-1">Şirketlerim</h4>
                   <p class="text-secondary small mb-0">Sahip olduğunuz şirketleri yönetin.</p>
                </div>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i> Yeni Oluştur
                </a>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">Şirket Adı</th>
                            <th>Slug</th>
                            <th>Oluşturulma Tarihi</th>
                            <th class="text-end pe-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr data-tummenu-click-url="@Url.Action("Details", "Company", new { area = "Admin", id = item.Id, returnUrl = currentPageUrl })">
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-3">
                                                @item.Title.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.Title</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-secondary">@item.Slug</td>
                                    <td class="text-secondary">@item.CreatedAt?.ToString("d")</td>
                                    <td class="text-end pe-3">
                                        <a asp-area="Admin" asp-controller="Store" asp-action="Index" asp-route-companyId="@item.Id" class="btn btn-sm btn-light text-info me-2" title="Dükkanlar">
                                            <i class="fas fa-store"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Company" asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-sm btn-outline-secondary me-2" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Company" asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" id="deleteForm-@item.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Sil" onclick="TumMenuAlerts.confirm('Bu Şirketi Silmek İstediğinize Emin Misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Sil!').then(res => { if(res) document.getElementById('deleteForm-@item.Id').submit(); })">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-secondary">
                                    <div class="mb-3">
                                        <span class="fa-stack fa-2x">
                                            <i class="fas fa-circle fa-stack-2x text-light"></i>
                                            <i class="fas fa-store fa-stack-1x text-secondary opacity-50"></i>
                                        </span>
                                    </div>
                                    <h5>Henüz şirket yok</h5>
                                    <p class="small">Henüz bir şirket oluşturmadınız. Hemen bir tane oluşturun!</p>
                                    <a asp-action="Create" class="btn btn-primary mt-2">Şirket Oluştur</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <tummenu-pagination index="@(Model?.Index ?? 1)"
                                pages="@(Model?.Pages ?? 0)"
                                has-previous="@(Model?.HasPrevious ?? false)"
                                has-next="@(Model?.HasNext ?? false)" />
        </div>
    </div>
</div>
