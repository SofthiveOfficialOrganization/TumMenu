@using Application.Companies.DTOs
@model CompanyDTO

@{
    ViewData["Title"] = "Şirket Detayları";
    var returnUrl = ViewData["ReturnUrl"] as string
        ?? (User.IsInRole("Admin") ? Url.Action("Index") : Url.Action("Index", "Dashboard"));
}

<div class="horizon-card tm-page-header">
    <div class="tm-page-header__main">
        <a href="@returnUrl"
           data-tummenu-back
           data-fallback-url="@returnUrl"
           class="btn btn-outline-secondary tm-back-button"
           title="Geri Dön">
            <i class="fas fa-arrow-left"></i>
            <span>Geri Dön</span>
        </a>

        <div class="tm-page-heading">
            <div class="tm-page-eyebrow">Şirket Yönetimi</div>
            <h1 class="tm-page-title">@Model.Title</h1>
            <p class="tm-page-subtitle">Şirket profili, medya alanları ve temel bilgileri.</p>
        </div>
    </div>

    <div class="tm-page-actions">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-outline-primary" title="Düzenle">
            <i class="fas fa-edit me-2"></i>Düzenle
        </a>
        <form id="deleteForm" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="button" class="btn btn-outline-danger" title="Sil" onclick="confirmDelete()">
                <i class="fas fa-trash-alt me-2"></i>Sil
            </button>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <!-- Profil Kartı -->
        <div class="horizon-card text-center h-100">
            <div class="horizon-avatar mx-auto mb-3" style="width: 80px; height: 80px; font-size: 32px;">
                @Model.Title.Substring(0, 1).ToUpper()
            </div>
            <h4 class="fw-bold text-dark mb-1">@Model.Title</h4>
            <p class="text-secondary small">Şirket Profili</p>
            
            <div class="mt-4 d-flex justify-content-center gap-3">
                 <div class="text-center px-3 border-end">
                    <h5 class="fw-bold mb-0">1</h5>
                    <small class="text-secondary">Menü</small>
                </div>
                <div class="text-center px-3">
                    <h5 class="fw-bold mb-0">0</h5>
                    <small class="text-secondary">Sipariş</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8 mb-4">
        <!-- Detay Kartı -->
        <div class="horizon-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <h5 class="fw-bold text-dark mb-0">Genel Bilgiler</h5>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="text-secondary small text-uppercase fw-bold mb-1">Şirket Adı</label>
                    <p class="fw-bold text-dark">@Model.Title</p>
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small text-uppercase fw-bold mb-1">Slug</label>
                    <p class="fw-bold text-dark">@Model.Slug</p>
                </div>
            </div>

            <div class="row mb-4">
                 <div class="col-md-6">
                    <label class="text-secondary small text-uppercase fw-bold mb-1">Durum</label>
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Aktif</span>
                </div>
            </div>
             <div class="row mb-4">
                 <div class="col-md-6">
                     <label class="text-secondary small text-uppercase fw-bold mb-1">Oluşturulma Tarihi</label>
                     <p class="text-secondary">@Model.CreatedAt?.ToString("g")</p>
                 </div>
                  <div class="col-md-6">
                     <label class="text-secondary small text-uppercase fw-bold mb-1">Son Güncelleme</label>
                     <p class="text-secondary">@Model.ModifiedAt?.ToString("g")</p>
                 </div>
             </div>


        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <partial name="_MediaGallery" model='(Model.Id, Domain.Entities.MediaRefType.Company, Model.Medias, "logo")' />
    </div>
    <div class="col-md-6 mb-4">
        <partial name="_MediaGallery" model='(Model.Id, Domain.Entities.MediaRefType.Company, Model.Medias, "banner")' />
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            TumMenuAlerts.confirm('Emin misiniz?', 'Bu şirketi silmek istediğinize emin misiniz? Bu işlem geri alınamaz!', 'Evet, Sil!')
                .then((result) => {
                    if (result) {
                        document.getElementById('deleteForm').submit();
                    }
                });
        }
    </script>
}
