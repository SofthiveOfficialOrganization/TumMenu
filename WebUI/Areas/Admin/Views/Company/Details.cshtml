@using Application.Companies.DTOs
@model CompanyDTO

@{
    ViewData["Title"] = "Company Details";
}

<div class="row">
    <div class="col-md-4 mb-4">
        <!-- Profile Card -->
        <div class="horizon-card text-center h-100">
            <div class="horizon-avatar mx-auto mb-3" style="width: 80px; height: 80px; font-size: 32px;">
                @Model.Name.Substring(0, 1).ToUpper()
            </div>
            <h4 class="fw-bold text-dark mb-1">@Model.Name</h4>
            <p class="text-secondary small">Company Profile</p>
            
            <div class="mt-4 d-flex justify-content-center gap-3">
                 <div class="text-center px-3 border-end">
                    <h5 class="fw-bold mb-0">1</h5>
                    <small class="text-secondary">Menus</small>
                </div>
                <div class="text-center px-3">
                    <h5 class="fw-bold mb-0">0</h5>
                    <small class="text-secondary">Orders</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8 mb-4">
        <!-- Details Card -->
        <div class="horizon-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <h5 class="fw-bold text-dark mb-0">General Information</h5>
                 <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-sm btn-light text-primary">
                    <i class="fas fa-edit me-1"></i> Edit
                </a>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="text-secondary small text-uppercase fw-bold mb-1">Company Name</label>
                    <p class="fw-bold text-dark">@Model.Name</p>
                </div>
                <div class="col-md-6">
                    <label class="text-secondary small text-uppercase fw-bold mb-1">Slug</label>
                    <p class="fw-bold text-dark">@Model.Slug</p>
                </div>
            </div>

            <div class="row mb-4">
                 <div class="col-md-6">
                    <label class="text-secondary small text-uppercase fw-bold mb-1">Owner ID</label>
                    <p class="text-dark font-monospace small bg-light p-2 rounded">@Model.OwnerId</p>
                </div>
                 <div class="col-md-6">
                    <label class="text-secondary small text-uppercase fw-bold mb-1">Status</label>
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Active</span>
                </div>
            </div>
             <div class="row mb-4">
                 <div class="col-md-6">
                     <label class="text-secondary small text-uppercase fw-bold mb-1">Created At</label>
                     <p class="text-secondary">@Model.CreatedAt?.ToString("g")</p>
                 </div>
                  <div class="col-md-6">
                     <label class="text-secondary small text-uppercase fw-bold mb-1">Last Updated</label>
                     <p class="text-secondary">@Model.ModifiedAt?.ToString("g")</p>
                 </div>
             </div>

            <div class="d-flex justify-content-end pt-3 border-top">
                <a asp-action="MyCompanies" class="btn btn-light text-secondary me-2">Back to List</a>
                
                 <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this company? This action cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger bg-opacity-10 border-0">
                        <i class="fas fa-trash me-2"></i> Delete Company
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
