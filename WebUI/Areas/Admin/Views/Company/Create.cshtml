@using Application.Companies.Commands
@model CreateCompanyCommand

@{
    ViewData["Title"] = "Create Company";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <div class="card-body">
                        <form asp-area="Admin" asp-controller="Company" asp-action="Create" method="post">
                            @Html.AntiForgeryToken()
                            @* <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div> *@
                            <div class="form-group mb-3">
                                <label asp-for="Name" class="form-label">İsim</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Slug" class="form-label">Slug</label>
                                <input asp-for="Slug" class="form-control" />
                                <span asp-validation-for="Slug" class="text-danger"></span>
                            </div>

                            <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-end">
                                <button type="submit" class="btn btn-primary">Create</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
