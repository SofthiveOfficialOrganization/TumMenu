@using Application.Common.Base.DTOs
@using Application.Companies.DTOs
@model PaginatedListDTO<CompanyDTO>

@{
    ViewData["Title"] = "Tüm Şirketler";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold">Şirket Listesi</h4>
                <div class="d-flex gap-2">
                     <form method="get" class="d-flex align-items-center">
                         <!-- Note: Controller likely expects 'Index' or 'PageIndex' depending on query binder, assumes Index based on DTO -->
                        <input type="text" name="Search" class="form-control me-2" placeholder="Şirket ara..." value="@Context.Request.Query["Search"]">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                    </form>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i> Şirket Ekle
                    </a>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">Şirket Adı</th>
                            <th>Slug</th>
                            <th>Şirket Sahibi</th>
                            <th>Şirket Sahibi ID</th>
                            <th>Oluşturulma Tarihi</th>
                            <th>Değiştirilme Tarihi</th>
                            <th>Silinme Tarihi</th>
                            <th class="text-end pe-3">Eylemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-3">
                                                @item.Title.Substring(0, 1).ToUpper()
                                            </div>
                                            <span class="fw-bold text-dark">@item.Title</span>
                                        </div>
                                    </td>
                                    <td class="text-secondary">@item.Slug</td>
                                    <td class="text-secondary small">
                                        <span class="badge bg-light text-dark fw-normal">
                                            <i class="fas fa-key me-1"></i>
                                            @item.OwnerName
                                        </span>
                                    </td>                                    <td class="text-secondary small">
                                        <span class="badge bg-light text-dark fw-normal">
                                            <i class="fas fa-key me-1"></i>
                                            @item.OwnerId
                                        </span>
                                    </td>
                                    <td class="text-secondary small">
                                        <span class="badge bg-light text-dark fw-normal">
                                            <i class="fas fa-key me-1"></i>
                                            @item.CreatedAt
                                        </span>
                                    </td>
                                    <td class="text-secondary small">
                                        <span class="badge bg-light text-dark fw-normal">
                                            <i class="fas fa-key me-1"></i>
                                            @item.ModifiedAt
                                        </span>
                                    </td>
                                    <td class="text-secondary small">
                                        <span class="badge bg-light text-dark fw-normal">
                                            <i class="fas fa-key me-1"></i>
                                            @item.DeletedAt
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-controller="Store" asp-action="Index" asp-route-companyId="@item.Id" class="btn btn-sm btn-light text-info me-2" title="Dükkanlar">
                                            <i class="fas fa-store"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary me-2" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-light text-success me-2" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" id="deleteForm-@item.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-light text-danger" title="Sil" onclick="TumMenuAlerts.confirm('Bu Şirketi Silmek İstediğinize Emin Misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Sil!').then(res => { if(res) document.getElementById('deleteForm-@item.Id').submit(); })">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-secondary">
                                    <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-50"></i>
                                    Şirket bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Sayfalama -->
            @if (Model != null && Model.Pages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div class="text-secondary small">
                        @Model.Count kayıttan @Model.Items.Count tanesi gösteriliyor
                    </div>
                    <nav aria-label="Sayfa navigasyonu">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-Index="@(Model.Index - 1)" asp-route-Search="@Context.Request.Query["Search"]">Önceki</a>
                            </li>
                            @for (int i = 1; i <= Model.Pages; i++)
                            {
                                <li class="page-item @(Model.Index == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-Index="@i" asp-route-Search="@Context.Request.Query["Search"]">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-Index="@(Model.Index + 1)" asp-route-Search="@Context.Request.Query["Search"]">Sonraki</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
