@using Application.Ads.DTOs
@model List<AdCreativeDTO>
@{
    ViewData["Title"] = "Reklam İçerikleri";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                   <h4 class="fw-bold mb-1">Reklam İçerikleri</h4>
                   <p class="text-secondary small mb-0">Google Adsense kodlarını veya görsellerinizi yönetin.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i> Slotlara Dön
                    </a>
                    <a asp-action="CreateCreative" class="btn btn-success btn-sm">
                        <i class="fas fa-plus me-1"></i> Yeni İçerik
                    </a>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">Tür</th>
                            <th>İçerik Özeti / Kod</th>
                            <th>Link</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge @(item.Type == "image" ? "bg-primary" : "bg-warning")">@item.Type.ToUpper()</span>
                                    </td>
                                    <td>
                                        <code class="small text-truncate d-inline-block" style="max-width: 300px;">@item.Content</code>
                                    </td>
                                    <td>
                                        @if(!string.IsNullOrEmpty(item.ClickUrl))
                                        {
                                            <a href="@item.ClickUrl" target="_blank" class="small text-decoration-none">Git <i class="fas fa-external-link-alt"></i></a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="EditCreative" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="DeleteCreative" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu içeriği silmek istediğinize emin misiniz?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-secondary">
                                    <h5>Henüz reklam içeriği tanımlanmamış</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
