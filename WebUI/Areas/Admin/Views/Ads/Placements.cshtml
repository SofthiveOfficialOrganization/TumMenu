@using Application.Ads.DTOs
@model List<AdPlacementDTO>
@{
    ViewData["Title"] = "Reklam Yerleşimleri";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                   <h4 class="fw-bold mb-1">Reklam Yerleşimleri</h4>
                   <p class="text-secondary small mb-0">Hangi reklamanın hangi slotta ne zaman görüneceğini belirleyin.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i> Slotlara Dön
                    </a>
                    <a asp-action="CreatePlacement" class="btn btn-success btn-sm">
                        <i class="fas fa-plus me-1"></i> Yeni Yerleşim
                    </a>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">Slot</th>
                            <th>İçerik Türü</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th class="text-center">Durum</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">@item.AdSlot.Key</td>
                                    <td>@item.AdCreative.Type</td>
                                    <td>@(item.StartAt?.ToString("g") ?? "-")</td>
                                    <td>@(item.EndAt?.ToString("g") ?? "-")</td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-soft text-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-soft text-danger">Pasif</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="EditPlacement" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="DeletePlacement" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu yerleşimi silmek istediğinize emin misiniz?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-secondary">
                                    <h5>Aktif yerleşim bulunamadı</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
