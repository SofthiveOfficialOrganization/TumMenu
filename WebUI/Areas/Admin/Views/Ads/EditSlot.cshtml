@using Application.Ads.Commands
@model UpdateAdSlotCommand
@{
    ViewData["Title"] = "Reklam Slotu Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1">Reklam Slotu Düzenle</h4>
                    <p class="text-secondary small">"@Model.Key" slotunu güncelleyin.</p>
                </div>
                <form asp-action="DeleteSlot" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu slotu silmek istediğinize emin misiniz?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="fas fa-trash-alt me-1"></i> Sil
                    </button>
                </form>
            </div>

            <form asp-action="EditSlot" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Key" class="form-label small fw-bold">Slot Anahtarı (Key)</label>
                    <input asp-for="Key" class="form-control" required />
                    <span asp-validation-for="Key" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-bold">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActive">
                        <label class="form-check-label small fw-bold" for="isActive">Aktif</label>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end border-top pt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-4">İptal</a>
                    <button type="submit" class="btn btn-primary btn-sm px-4">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>
