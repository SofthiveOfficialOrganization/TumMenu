@using Application.Common.Base.DTOs
@using Application.Menus.DTOs
@model PaginatedListDTO<MenuDTO>

@{
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = "Tüm Menüler";
    var currentPageUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold">Tüm Menüler</h4>
                <div class="d-flex gap-2">
                     <form method="get" class="d-flex align-items-center">
                        <input type="text" name="Search" class="form-control me-2" placeholder="Menü ara..." value="@Context.Request.Query["Search"]">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                    </form>
                    @if (!isAdmin)
                    {
                        <div class="dropdown">
                            <button class="btn btn-primary btn-sm dropdown-toggle" type="button" id="createMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-plus me-2"></i> Menü Ekle
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="createMenuDropdown">
                                <li><a class="dropdown-item" asp-action="CreateToCompany" asp-route-returnUrl="@currentPageUrl">Şirkete Ata</a></li>
                                <li><a class="dropdown-item" asp-action="CreateToStore" asp-route-returnUrl="@currentPageUrl">Dükkana Ata</a></li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">İsim</th>
                            <th class="text-nowrap">Durum</th>
                            <th class="text-nowrap">İlişkili</th>
                            <th class="text-nowrap">Oluşturulma Tarihi</th>
                            <th class="text-end pe-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-3">
                                                <i class="fas fa-clipboard-list"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.Title</span>
                                                @if (item.IsDefaultCompanyMenu)
                                                {
                                                    <span class="badge bg-warning text-dark mt-1">
                                                        <i class="fas fa-thumbtack me-1"></i>Varsayılan Ana Menü
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-nowrap">
                                        @if (item.Status == Domain.Entities.MenuStatus.Active)
                                        {
                                            <span class="badge bg-success">AKTİF</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary">PASİF</span>
                                        }
                                    </td>
                                    <td class="text-secondary text-nowrap">
                                        @if(item.CompanyId.HasValue)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                                <i class="fas fa-building me-1"></i> @(!string.IsNullOrEmpty(item.CompanyName) ? item.CompanyName : "Şirket")
                                            </span>
                                        }
                                        else if(item.StoreId.HasValue)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info">
                                                <i class="fas fa-store me-1"></i> @(!string.IsNullOrEmpty(item.StoreName) ? item.StoreName : "Dükkan")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">Atanmamış</span>
                                        }
                                    </td>
                                    <td class="text-secondary small text-nowrap">@item.CreatedAt?.ToString("d")</td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <a asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="@currentPageUrl" class="btn btn-sm btn-outline-secondary me-2" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        
                                        <form asp-action="Delete" asp-route-id="@item.Id" asp-route-returnUrl="@currentPageUrl" method="post" class="d-inline" id="deleteForm-@item.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Sil" onclick="TumMenuAlerts.confirm('Bu menüyü silmek istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Sil!').then(res => { if(res) document.getElementById('deleteForm-@item.Id').submit(); })">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-50"></i>
                                    Menü bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <tummenu-pagination index="@(Model?.Index ?? 1)"
                                pages="@(Model?.Pages ?? 0)"
                                has-previous="@(Model?.HasPrevious ?? false)"
                                has-next="@(Model?.HasNext ?? false)"
                                count="@(Model?.Count ?? 0)"
                                items-count="@(Model?.Items.Count ?? 0)"
                                show-summary="true"
                                container-class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top" />
        </div>
    </div>
</div>
