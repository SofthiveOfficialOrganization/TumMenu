@using Application.Common.Base.DTOs
@using Application.Menus.DTOs
@model PaginatedListDTO<MenuDTO>

@{
    ViewData["Title"] = "Tüm Menüler";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold">Tüm Menüler</h4>
                <div class="d-flex gap-2">
                     <form method="get" class="d-flex align-items-center">
                        <input type="text" name="Search" class="form-control me-2" placeholder="Menü ara..." value="@Context.Request.Query["Search"]">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                    </form>
                    <div class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" type="button" id="createMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-plus me-2"></i> Menü Ekle
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="createMenuDropdown">
                            <li><a class="dropdown-item" asp-action="CreateToCompany">Şirkete Ata</a></li>
                            <li><a class="dropdown-item" asp-action="CreateToStore">Dükkana Ata</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">İsim</th>
                            <th>Durum</th>
                            <th>İlişkili</th>
                            <th>Şablon ID</th>
                            <th>Oluşturulma Tarihi</th>
                            <th class="text-end pe-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-3">
                                                <i class="fas fa-clipboard-list"></i>
                                            </div>
                                            <span class="fw-bold text-dark">@item.Title</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Status == Domain.Entities.MenuStatus.Active)
                                        {
                                            <span class="badge bg-success">AKTİF</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary">PASİF</span>
                                        }
                                    </td>
                                    <td class="text-secondary">
                                        @if(item.CompanyId.HasValue)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary">Şirket: @item.CompanyId</span>
                                        }
                                        else if(item.StoreId.HasValue)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info">Dükkan: @item.StoreId</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">Atanmamış</span>
                                        }
                                    </td>
                                    <td class="text-secondary small">@item.MenuTemplateId</td>
                                    <td class="text-secondary small">@item.CreatedAt?.ToString("g")</td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary me-2" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu menüyü silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light text-danger" title="Sil">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-50"></i>
                                    Menü bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model != null && Model.Pages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div class="text-secondary small">
                        @Model.Count kayıttan @Model.Items.Count tanesi gösteriliyor
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                <a class="page-link" asp-action="AllMenus" asp-route-Index="@(Model.Index - 1)" asp-route-Search="@Context.Request.Query["Search"]">Önceki</a>
                            </li>
                            @for (int i = 1; i <= Model.Pages; i++)
                            {
                                <li class="page-item @(Model.Index == i ? "active" : "")">
                                    <a class="page-link" asp-action="AllMenus" asp-route-Index="@i" asp-route-Search="@Context.Request.Query["Search"]">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                <a class="page-link" asp-action="AllMenus" asp-route-Index="@(Model.Index + 1)" asp-route-Search="@Context.Request.Query["Search"]">Sonraki</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
