@using Application.Common.Base.DTOs
@using Application.Menus.DTOs
@model PaginatedListDTO<MenuDTO>

@{
    ViewData["Title"] = "Menülerim";
    var currentPageUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                   <h4 class="fw-bold mb-1">Dükkan Menülerim</h4>
                   <p class="text-secondary small mb-0">Dükkanlarınıza ait menüleri yönetin.</p>
                </div>
                <a asp-action="CreateToStore" asp-route-returnUrl="@currentPageUrl" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-2"></i> Yeni Dükkan Menüsü
                </a>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">İsim</th>
                            <th>Bağlı Olduğu Şirket / Dükkan</th>
                            <th>Durum</th>
                            <th class="d-none d-md-table-cell">Kategoriler</th>
                            <th class="d-none d-lg-table-cell">Oluşturulma Tarihi</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr data-tummenu-click-url="@Url.Action("Details", new { id = item.Id, returnUrl = currentPageUrl })">
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-3">
                                                <i class="fas fa-utensils"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.Title</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.StoreName))
                                        {
                                            <div class="d-inline-flex align-items-center p-1 px-2 border rounded bg-light">
                                                <span class="badge bg-info bg-opacity-10 text-info me-2"><i class="fas fa-store"></i> Dükkan</span>
                                                <small class="text-dark fw-medium">@item.StoreName</small>
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(item.CompanyName))
                                        {
                                            <div class="d-inline-flex align-items-center p-1 px-2 border rounded bg-light">
                                                <span class="badge bg-primary bg-opacity-10 text-primary me-2"><i class="fas fa-star"></i> Ana Menü</span>
                                                <small class="text-dark fw-medium">@item.CompanyName</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == Domain.Entities.MenuStatus.Active)
                                        {
                                            <span class="badge bg-success">AKTİF</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary">PASİF</span>
                                        }
                                    </td>
                                    <td class="text-secondary d-none d-md-table-cell">
                                        <span class="bg-light text-dark fw-normal">
                                            @item.Categories.Count Kategori
                                        </span>
                                    </td>
                                    <td class="text-secondary d-none d-lg-table-cell">@item.CreatedAt?.ToString("d")</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="@currentPageUrl" class="btn btn-sm btn-outline-secondary" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-secondary">
                                    <div class="mb-3">
                                        <span class="fa-stack fa-2x">
                                            <i class="fas fa-circle fa-stack-2x text-light"></i>
                                            <i class="fas fa-utensils fa-stack-1x text-secondary opacity-50"></i>
                                        </span>
                                    </div>
                                    <h5>Henüz dükkan menüsü yok</h5>
                                    <p class="small">Henüz bir dükkan menüsü oluşturmadınız.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <tummenu-pagination index="@(Model?.Index ?? 1)"
                                pages="@(Model?.Pages ?? 0)"
                                has-previous="@(Model?.HasPrevious ?? false)"
                                has-next="@(Model?.HasNext ?? false)" />
        </div>
    </div>
</div>
