@using Application.Common.Base.DTOs
@using Application.Menus.DTOs
@model PaginatedListDTO<MenuDTO>

@{
    ViewData["Title"] = "Menülerim";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                   <h4 class="fw-bold mb-1">Menülerim</h4>
                   <p class="text-secondary small mb-0">Oluşturduğunuz menüleri yönetin.</p>
                </div>
                <div class="dropdown">
                    <button class="btn btn-primary dropdown-toggle" type="button" id="createMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-plus me-2"></i> Menü Oluştur
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="createMenuDropdown">
                        <li><a class="dropdown-item" asp-action="CreateToCompany">Şirkete Ata</a></li>
                        <li><a class="dropdown-item" asp-action="CreateToStore">Dükkana Ata</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">İsim</th>
                            <th>Durum</th>
                            <th class="d-none d-md-table-cell">Kategoriler</th>
                            <th class="d-none d-lg-table-cell">Oluşturulma Tarihi</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-3">
                                                <i class="fas fa-utensils"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.Title</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Status == Domain.Entities.MenuStatus.Active)
                                        {
                                            <span class="badge bg-success">AKTİF</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary">PASİF</span>
                                        }
                                    </td>
                                    <td class="text-secondary d-none d-md-table-cell">
                                        <span class="badge bg-light text-dark fw-normal">
                                            @item.Categories.Count Kategori
                                        </span>
                                    </td>
                                    <td class="text-secondary d-none d-lg-table-cell">@item.CreatedAt?.ToString("d")</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-secondary">
                                    <div class="mb-3">
                                        <span class="fa-stack fa-2x">
                                            <i class="fas fa-circle fa-stack-2x text-light"></i>
                                            <i class="fas fa-utensils fa-stack-1x text-secondary opacity-50"></i>
                                        </span>
                                    </div>
                                    <h5>Henüz menü yok</h5>
                                    <p class="small">Henüz bir menü oluşturmadınız.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
             <!-- Sayfalama -->
            @if (Model != null && Model.Pages > 1)
            {
                   <div class="d-flex justify-content-center mt-4">
                    <nav aria-label="Sayfa navigasyonu">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                <a class="page-link" asp-action="MyMenus" asp-route-Index="@(Model.Index - 1)">Önceki</a>
                            </li>
                             @for (int i = 1; i <= Model.Pages; i++)
                            {
                                <li class="page-item @(Model.Index == i ? "active" : "")">
                                    <a class="page-link" asp-action="MyMenus" asp-route-Index="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                <a class="page-link" asp-action="MyMenus" asp-route-Index="@(Model.Index + 1)">Sonraki</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
