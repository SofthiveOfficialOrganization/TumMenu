@using Application.Common.Base.DTOs
@using Application.Menus.DTOs
@model PaginatedListDTO<MenuDTO>

@{
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = isAdmin ? "Şirket Ana Menüleri" : "Ana Menülerim";
    var currentPageUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                   <h4 class="fw-bold mb-1">@(isAdmin ? "Şirket Ana Menüleri" : "Ana Menülerim")</h4>
                   <p class="text-secondary small mb-0">
                       @(isAdmin
                           ? "Şirketlere ait ana menüleri görüntüleyin."
                           : "Şirketinize ait ana menüleri yönetin. Bu menüler tüm dükkanlarınızda kullanılabilir.")
                   </p>
                </div>
                @if (!isAdmin)
                {
                    <a asp-action="CreateToCompany" asp-route-returnUrl="@currentPageUrl" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus me-2"></i> Yeni Ana Menü
                    </a>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">İsim</th>
                            <th>Şirket</th>
                            <th class="d-none d-md-table-cell">Kategoriler</th>
                            <th class="d-none d-lg-table-cell">Oluşturulma Tarihi</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-3">
                                                <i class="fas fa-utensils"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.Title</span>
                                                <span class="badge bg-primary bg-opacity-10 text-primary mt-1">
                                                    <i class="fas fa-star me-1"></i>Ana Menü
                                                </span>
                                                @if (item.IsDefaultCompanyMenu)
                                                {
                                                    <span class="badge bg-warning text-dark mt-1 ms-1">
                                                        <i class="fas fa-thumbtack me-1"></i>Varsayılan
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CompanyName))
                                        {
                                            <div class="d-inline-flex align-items-center p-1 px-2 border rounded bg-light">
                                                <i class="fas fa-building text-primary me-2"></i>
                                                <small class="text-dark fw-medium">@item.CompanyName</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="text-secondary d-none d-md-table-cell">
                                        <span class="bg-light text-dark fw-normal">
                                            @item.Categories.Count Kategori
                                        </span>
                                    </td>
                                    <td class="text-secondary d-none d-lg-table-cell">@item.CreatedAt?.ToString("d")</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="@currentPageUrl" class="btn btn-sm btn-outline-secondary" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <div class="mb-3">
                                        <span class="fa-stack fa-2x">
                                            <i class="fas fa-circle fa-stack-2x text-light"></i>
                                            <i class="fas fa-utensils fa-stack-1x text-secondary opacity-50"></i>
                                        </span>
                                    </div>
                                    <h5>Henüz ana menü yok</h5>
                                    <p class="small">@(isAdmin ? "Henüz hiçbir şirkete ait ana menü bulunmuyor." : "Şirketiniz için henüz bir ana menü oluşturmadınız.")</p>
                                    @if (!isAdmin)
                                    {
                                        <a asp-action="CreateToCompany" asp-route-returnUrl="@currentPageUrl" class="btn btn-primary btn-sm mt-2">
                                            <i class="fas fa-plus me-2"></i> İlk Ana Menünüzü Oluşturun
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <tummenu-pagination index="@(Model?.Index ?? 1)"
                                pages="@(Model?.Pages ?? 0)"
                                has-previous="@(Model?.HasPrevious ?? false)"
                                has-next="@(Model?.HasNext ?? false)" />
        </div>
    </div>
</div>
