@using Application.Menus.Commands
@model CreateMenuToStoreCommand

@{
    ViewData["Title"] = "Dükkan İçin Menü Oluştur";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- Mode toggle ---
            const modeScratch = document.getElementById('modeScratch');
            const modeClone = document.getElementById('modeClone');
            const formScratchContainer = document.getElementById('form-scratch-container');
            const formCloneContainer = document.getElementById('form-clone-container');

            function setMode(mode) {
                if (mode === 'scratch') {
                    modeScratch.classList.add('active', 'border-primary', 'bg-primary', 'bg-opacity-10');
                    modeScratch.classList.remove('border-secondary');
                    modeClone.classList.remove('active', 'border-primary', 'bg-primary', 'bg-opacity-10');
                    modeClone.classList.add('border-secondary');
                    formScratchContainer.style.display = '';
                    formCloneContainer.style.display = 'none';
                } else {
                    modeClone.classList.add('active', 'border-primary', 'bg-primary', 'bg-opacity-10');
                    modeClone.classList.remove('border-secondary');
                    modeScratch.classList.remove('active', 'border-primary', 'bg-primary', 'bg-opacity-10');
                    modeScratch.classList.add('border-secondary');
                    formCloneContainer.style.display = '';
                    formScratchContainer.style.display = 'none';
                    if (!mainMenusLoaded) loadMainMenus();
                }
            }

            modeScratch.addEventListener('click', () => setMode('scratch'));
            modeClone.addEventListener('click', () => setMode('clone'));

            // --- Store modal (shared by both forms) ---
            const storeModal = new bootstrap.Modal(document.getElementById('storeModal'));
            const searchInput = document.getElementById('storeSearchInput');
            const searchBtn = document.getElementById('searchStoreBtn');
            const storeList = document.getElementById('storeList');

            document.querySelectorAll('.btn-select-store').forEach(btn => {
                btn.addEventListener('click', function () {
                    currentStoreTarget = this.dataset.target;
                    loadStores();
                    storeModal.show();
                });
            });

            let currentStoreTarget = 'StoreId';

            searchBtn.addEventListener('click', () => { loadStores(); });
            searchInput.addEventListener('keypress', e => { if (e.key === 'Enter') { e.preventDefault(); loadStores(); } });

            async function loadStores() {
                const query = searchInput.value;
                storeList.innerHTML = '<div class="text-center p-3"><div class="spinner-border text-primary" role="status"></div></div>';
                try {
                    const response = await fetch(`/admin/Menu/SearchStores?search=${encodeURIComponent(query)}&pageSize=10`);
                    if (!response.ok) throw new Error();
                    const data = await response.json();
                    renderStores(data.items);
                } catch {
                    storeList.innerHTML = '<div class="text-danger p-3">Dükkanlar yüklenirken hata oluştu.</div>';
                }
            }

            function renderStores(stores) {
                storeList.innerHTML = '';
                if (!stores.length) { storeList.innerHTML = '<div class="p-3 text-muted">Dükkan bulunamadı.</div>'; return; }
                const list = document.createElement('div');
                list.className = 'list-group';
                stores.forEach(store => {
                    const item = document.createElement('button');
                    item.type = 'button';
                    item.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                    const companyName = store.company ? store.company.title : '';
                    item.innerHTML = `<div><div class="fw-bold">${store.title}</div><small class="text-muted">${companyName}</small></div><span class="badge bg-primary rounded-pill">Seç</span>`;
                    item.onclick = function () {
                        document.getElementById(currentStoreTarget).value = store.id;
                        document.getElementById(currentStoreTarget + 'Name').value = store.title;
                        storeModal.hide();
                    };
                    list.appendChild(item);
                });
                storeList.appendChild(list);
            }

            // --- Main menu picker (clone mode) ---
            let mainMenusLoaded = false;
            const mainMenuModal = new bootstrap.Modal(document.getElementById('mainMenuModal'));
            const mainMenuSearch = document.getElementById('mainMenuSearchInput');
            const mainMenuSearchBtn = document.getElementById('searchMainMenuBtn');
            const mainMenuList = document.getElementById('mainMenuList');

            document.getElementById('btnSelectMainMenu').addEventListener('click', () => {
                loadMainMenus();
                mainMenuModal.show();
            });

            mainMenuSearchBtn.addEventListener('click', () => loadMainMenus());
            mainMenuSearch.addEventListener('keypress', e => { if (e.key === 'Enter') { e.preventDefault(); loadMainMenus(); } });

            async function loadMainMenus() {
                const query = mainMenuSearch ? mainMenuSearch.value : '';
                mainMenuList.innerHTML = '<div class="text-center p-3"><div class="spinner-border text-primary" role="status"></div></div>';
                try {
                    const response = await fetch(`/admin/Menu/SearchMainMenus?search=${encodeURIComponent(query)}&pageSize=20`);
                    if (!response.ok) throw new Error();
                    const data = await response.json();
                    mainMenusLoaded = true;
                    renderMainMenus(data.items);
                } catch {
                    mainMenuList.innerHTML = '<div class="text-danger p-3">Ana menüler yüklenirken hata oluştu.</div>';
                }
            }

            function renderMainMenus(menus) {
                mainMenuList.innerHTML = '';
                if (!menus.length) { mainMenuList.innerHTML = '<div class="p-3 text-muted">Ana menü bulunamadı.</div>'; return; }
                const list = document.createElement('div');
                list.className = 'list-group';
                menus.forEach(menu => {
                    const item = document.createElement('button');
                    item.type = 'button';
                    item.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                    item.innerHTML = `<div><div class="fw-bold">${menu.title}</div><small class="text-muted"><i class="fas fa-building me-1"></i>${menu.companyName ?? ''}</small></div><span class="badge bg-primary rounded-pill">Seç</span>`;
                    item.onclick = function () {
                        document.getElementById('SourceMenuId').value = menu.id;
                        document.getElementById('SelectedMainMenuName').value = menu.title;
                        mainMenuModal.hide();
                    };
                    list.appendChild(item);
                });
                mainMenuList.appendChild(list);
            }
        });
    </script>
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="horizon-card">
            <h4 class="fw-bold mb-4">Dükkan İçin Menü Oluştur</h4>

            <!-- Mode selector -->
            <div class="d-flex gap-3 mb-4">
                <button type="button" id="modeScratch"
                        class="flex-fill p-3 border rounded-3 text-start active border-primary bg-primary bg-opacity-10"
                        style="cursor:pointer; transition: all .15s">
                    <div class="fw-bold mb-1"><i class="fas fa-plus-circle me-2 text-primary"></i>Sıfırdan Oluştur</div>
                    <small class="text-muted">Boş bir menü oluştur, kategorileri kendin ekle</small>
                </button>
                <button type="button" id="modeClone"
                        class="flex-fill p-3 border border-secondary rounded-3 text-start"
                        style="cursor:pointer; transition: all .15s">
                    <div class="fw-bold mb-1"><i class="fas fa-copy me-2 text-success"></i>Ana Menüden Kopyala</div>
                    <small class="text-muted">Mevcut bir ana menüyü bu dükkana kopyala</small>
                </button>
            </div>

            <!-- Form: Scratch -->
            <div id="form-scratch-container">
                <form asp-action="CreateToStore" method="post">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label text-secondary small text-uppercase fw-bold">Menü Adı</label>
                        <input asp-for="Title" class="form-control" placeholder="örn. Öğle Menüsü" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label text-secondary small text-uppercase fw-bold">Durum</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Inactive">Pasif (Varsayılan)</option>
                            <option value="Active">Aktif</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                        <div class="form-text text-muted small">"Aktif" seçilirse, bu dükkanın diğer tüm menüleri pasif duruma getirilir.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small text-uppercase fw-bold">Dükkan</label>
                        <div class="d-flex gap-2">
                            <input type="text" id="StoreIdName" class="form-control" readonly placeholder="Dükkan seçilmedi" value="@ViewBag.StoreName" />
                            <button type="button" class="btn btn-primary px-4 btn-select-store" data-target="StoreId">
                                <i class="fas fa-search me-2"></i>Seç
                            </button>
                        </div>
                        <input type="hidden" asp-for="StoreId" />
                        <span asp-validation-for="StoreId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>İptal
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-check me-2"></i>Menü Oluştur
                        </button>
                    </div>
                </form>
            </div>

            <!-- Form: Clone -->
            <div id="form-clone-container" style="display:none">
                <form asp-action="CloneToStore" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label text-secondary small text-uppercase fw-bold">Kopyalanacak Ana Menü</label>
                        <div class="d-flex gap-2">
                            <input type="text" id="SelectedMainMenuName" class="form-control" readonly placeholder="Ana menü seçilmedi" />
                            <button type="button" class="btn btn-success px-4" id="btnSelectMainMenu">
                                <i class="fas fa-search me-2"></i>Seç
                            </button>
                        </div>
                        <input type="hidden" id="SourceMenuId" name="SourceMenuId" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small text-uppercase fw-bold">Hedef Dükkan</label>
                        <div class="d-flex gap-2">
                            <input type="text" id="CloneStoreIdName" class="form-control" readonly placeholder="Dükkan seçilmedi" />
                            <button type="button" class="btn btn-primary px-4 btn-select-store" data-target="CloneStoreId">
                                <i class="fas fa-search me-2"></i>Seç
                            </button>
                        </div>
                        <input type="hidden" id="CloneStoreId" name="StoreId" />
                    </div>

                    <div class="alert alert-info small">
                        <i class="fas fa-info-circle me-2"></i>
                        Seçilen ana menünün tüm kategorileri ve ürünleri bu dükkana kopyalanır.
                        Kopyalama sonrası değişiklikler birbirini etkilemez.
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>İptal
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="fas fa-copy me-2"></i>Kopyala ve Oluştur
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Store Modal -->
<div class="modal fade" id="storeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Dükkan Seç</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" id="storeSearchInput" placeholder="Ad ile ara...">
                    <button class="btn btn-primary" type="button" id="searchStoreBtn">Ara</button>
                </div>
                <div id="storeList" style="max-height: 400px; overflow-y: auto;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Main Menu Modal -->
<div class="modal fade" id="mainMenuModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-star me-2 text-primary"></i>Ana Menü Seç</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" id="mainMenuSearchInput" placeholder="Menü adı ile ara...">
                    <button class="btn btn-primary" type="button" id="searchMainMenuBtn">Ara</button>
                </div>
                <div id="mainMenuList" style="max-height: 400px; overflow-y: auto;"></div>
            </div>
        </div>
    </div>
</div>
