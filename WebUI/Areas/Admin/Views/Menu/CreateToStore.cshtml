@using Application.Menus.Commands
@model CreateMenuToStoreCommand

@{
    ViewData["Title"] = "Dükkan İçin Menü Oluştur";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const storeModal = new bootstrap.Modal(document.getElementById('storeModal'));
            const searchInput = document.getElementById('storeSearchInput');
            const searchBtn = document.getElementById('searchStoreBtn');
            const storeList = document.getElementById('storeList');
            const selectedStoreId = document.getElementById('StoreId');
            const selectedStoreName = document.getElementById('SelectedStoreName');
            const selectStoreBtn = document.getElementById('btnSelectStore');

            let currentPage = 1;

            selectStoreBtn.addEventListener('click', function() {
                loadStores();
                storeModal.show();
            });

            searchBtn.addEventListener('click', function() {
                currentPage = 1;
                loadStores();
            });

            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    currentPage = 1;
                    loadStores();
                }
            });

            async function loadStores() {
                const query = searchInput.value;
                storeList.innerHTML = '<div class="text-center p-3"><div class="spinner-border text-primary" role="status"></div></div>';
                
                try {
                    const response = await fetch(`/admin/Menu/SearchStores?search=${encodeURIComponent(query)}&page=${currentPage}&pageSize=10`);
                    if (!response.ok) throw new Error('Network response was not ok');
                    const data = await response.json();
                    
                    renderStores(data.items);
                } catch (error) {
                    console.error('Error:', error);
                    storeList.innerHTML = '<div class="text-danger p-3">Dükkanlar yüklenirken hata oluştu.</div>';
                }
            }

            function renderStores(stores) {
                storeList.innerHTML = '';
                if (stores.length === 0) {
                    storeList.innerHTML = '<div class="p-3 text-muted">Dükkan bulunamadı.</div>';
                    return;
                }

                const listGroup = document.createElement('div');
                listGroup.className = 'list-group';

                stores.forEach(store => {
                    const item = document.createElement('button');
                    item.type = 'button';
                    item.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                    // Check if store has a company object populated, otherwise just show store title
                    const companyName = store.company ? store.company.title : 'Bilinmeyen Şirket';
                    
                    item.innerHTML = `
                        <div>
                            <div class="fw-bold">${store.title}</div>
                            <small class="text-muted"><i class="bi bi-building"></i> ${companyName}</small>
                        </div>
                        <span class="badge bg-primary rounded-pill">Seç</span>
                    `;
                    item.onclick = function() {
                        selectedStoreId.value = store.id;
                        selectedStoreName.value = store.title;
                        storeModal.hide();
                    };
                    listGroup.appendChild(item);
                });

                storeList.appendChild(listGroup);
            }
        });
    </script>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="horizon-card">
            <h4 class="fw-bold mb-4">Dükkan İçin Menü Oluştur</h4>
            
            <form asp-action="CreateToStore" method="post">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label text-secondary small text-uppercase fw-bold">Menü Adı</label>
                    <input asp-for="Title" class="form-control" placeholder="örn. Öğle Menüsü" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                
                <div class="mb-4">
                    <label class="form-label text-secondary small text-uppercase fw-bold">Dükkan</label>
                    <div class="d-flex gap-2">
                        <input type="text" id="SelectedStoreName" class="form-control" readonly placeholder="Dükkan seçilmedi" value="@ViewBag.StoreName" />
                        <button type="button" class="btn btn-primary px-4" id="btnSelectStore">
                            <i class="fas fa-search me-2"></i>Seç
                        </button>
                    </div>
                    <input type="hidden" asp-for="StoreId" />
                    <span asp-validation-for="StoreId" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="MyMenus" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>İptal
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-check me-2"></i>Menü Oluştur
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="storeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Dükkan Seç</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" id="storeSearchInput" placeholder="Ad veya slug ile ara...">
                    <button class="btn btn-primary" type="button" id="searchStoreBtn">Ara</button>
                </div>
                <div id="storeList" style="max-height: 400px; overflow-y: auto;">
                    <!-- Results will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>
