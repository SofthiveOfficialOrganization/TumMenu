@using Application.Menus.Commands
@model UpdateMenuCommand

@{
    ViewData["Title"] = "Menü Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="horizon-card">
            <h4 class="fw-bold mb-4">Menü Düzenle</h4>
            
            <form asp-action="Update" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                
                <div class="mb-3">
                    <label asp-for="Title" class="form-label text-secondary small text-uppercase fw-bold">Menü Adı</label>
                    <input asp-for="Title" class="form-control" placeholder="Menü Adı" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>İptal
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
