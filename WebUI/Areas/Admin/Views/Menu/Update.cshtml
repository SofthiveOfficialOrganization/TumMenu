@using Application.Menus.Commands
@using Application.Menus.DTOs
@using Application.MenuDesigns.DTOs
@model UpdateMenuCommand

@{
    ViewData["Title"] = "Menü Düzenle";
    var designs = ViewBag.MenuDesigns as List<MenuDesignDTO> ?? [];
    var currentDesignId = ViewBag.CurrentMenuDesignId as Guid?;
    var menuInfo = ViewBag.MenuInfo as MenuDTO;
    var returnUrl = ViewData["ReturnUrl"] as string;
    var fallbackUrl = returnUrl ?? Url.Action("Details", new { id = Model.Id });
    var currentPageUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="horizon-card tm-page-header">
    <div class="tm-page-header__main">
        <a href="@fallbackUrl"
           data-tummenu-back
           data-fallback-url="@fallbackUrl"
           class="btn btn-outline-secondary tm-back-button"
           title="Geri Dön">
            <i class="fas fa-arrow-left"></i>
            <span>Geri Dön</span>
        </a>

        <div class="tm-page-heading">
            <div class="tm-page-eyebrow">Menü Yönetimi</div>
            <h1 class="tm-page-title">Menü Düzenle</h1>
            <p class="tm-page-subtitle">Menü adını ve public menü tasarımını güncelleyin.</p>
        </div>
    </div>

    <div class="tm-page-actions">
        <button type="submit" form="updateMenuForm" class="btn btn-primary">
            <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
        </button>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <div class="tm-section-header">
                <div>
                    <h2 class="tm-section-title">Menü Bilgileri</h2>
                    <p class="tm-section-subtitle">Menü adını ve bağlı tasarım seçimini düzenleyin.</p>
                </div>
            </div>

            @if (menuInfo != null)
            {
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="tm-form-label d-block">Durum</label>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            @if (menuInfo.Status == Domain.Entities.MenuStatus.MainMenu)
                            {
                                <span class="badge tm-badge-neutral"><i class="fas fa-star me-1"></i>Ana Menü</span>
                                @if (menuInfo.IsDefaultCompanyMenu)
                                {
                                    <span class="badge tm-badge-warning"><i class="fas fa-thumbtack me-1"></i>Varsayılan</span>
                                }
                            }
                            else if (menuInfo.Status == Domain.Entities.MenuStatus.Active)
                            {
                                <span class="badge tm-badge-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge tm-badge-neutral">Pasif</span>
                                <form asp-action="SetActive" asp-route-id="@Model.Id" method="post" class="d-inline" id="setActiveForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@currentPageUrl" />
                                    <button type="button"
                                            class="btn btn-sm btn-outline-success"
                                            onclick="TumMenuAlerts.confirm('Bu menüyü aktif yapmak istediğinize emin misiniz?', 'Bu işlem diğer aktif menüyü pasif yapacaktır.', 'Evet, Aktif Yap!').then(res => { if(res) document.getElementById('setActiveForm').submit(); })">
                                        <i class="fas fa-check me-1"></i>Aktif Yap
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="tm-form-label d-block">Bağlı Olduğu Kayıt</label>
                        @if (menuInfo.CompanyId.HasValue)
                        {
                            <div class="p-2 border rounded bg-light">
                                <span class="badge bg-primary bg-opacity-10 text-primary"><i class="fas fa-star me-1"></i>Ana Menü</span>
                                <small class="text-dark fw-medium ms-1">@menuInfo.CompanyName</small>
                            </div>
                        }
                        else if (menuInfo.StoreId.HasValue)
                        {
                            <div class="p-2 border rounded bg-light">
                                <span class="badge bg-info bg-opacity-10 text-info"><i class="fas fa-store me-1"></i>Dükkan</span>
                                <small class="text-muted ms-1">@menuInfo.StoreName</small>
                            </div>
                        }
                        else
                        {
                            <div class="p-2 border rounded bg-light text-muted fst-italic">Atanmamış</div>
                        }
                    </div>

                    @if (menuInfo.CompanyId.HasValue && menuInfo.Status == Domain.Entities.MenuStatus.MainMenu && !menuInfo.IsDefaultCompanyMenu)
                    {
                        <div class="col-12">
                            <form asp-action="SetDefault" asp-route-id="@Model.Id" method="post" id="setDefaultMenuForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@currentPageUrl" />
                                <button type="button"
                                        class="btn btn-outline-warning"
                                        onclick="TumMenuAlerts.confirm('Bu menüyü varsayılan ana menü yapmak istediğinize emin misiniz?', 'Mağazanın kendi menüsü yoksa public tarafta bu menü gösterilir.', 'Evet, Varsayılan Yap!').then(res => { if(res) document.getElementById('setDefaultMenuForm').submit(); })">
                                    <i class="fas fa-thumbtack me-2"></i>Varsayılan Ana Menü Yap
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }

            <form asp-action="Update" method="post" id="updateMenuForm">
                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label text-secondary small text-uppercase fw-bold">Menü Adı</label>
                    <input asp-for="Title" class="form-control" placeholder="Menü Adı" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                @if (designs.Count > 0)
                {
                    <div class="mb-4">
                        <label class="form-label text-secondary small text-uppercase fw-bold d-block mb-2">Tasarım Seçimi</label>
                        <p class="text-muted small mb-2">Tasarım kartının üzerine gelerek kısa açıklamayı görebilirsiniz.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="design-option design-picker-option @(currentDesignId == null ? "design-option--active" : "")"
                                   data-design-picker-hint="Sistem varsayılan renk paleti. Özel tasarım seçilmediğinde kullanılır.">
                                <input type="radio" name="menuDesignId" value="" class="d-none"
                                       @(currentDesignId == null ? "checked" : "") />
                                <div class="design-preview" style="background:#f8fafc; border:2px solid #e2e8f0;">
                                    <span class="design-preview__name text-muted">Varsayılan</span>
                                    <span class="design-preview__btn" style="background:#688745; border-radius:24px;">Buton</span>
                                </div>
                            </label>
                            @foreach (var d in designs)
                            {
                                var isActive = currentDesignId == d.Id;
                                var designHint = !string.IsNullOrWhiteSpace(d.Description)
                                    ? d.Description
                                    : $"{d.Name}: Footer arka planı {(d.FooterBackgroundColor ?? "otomatik")}, sayfa metni {d.TextColor}.";
                                <label class="design-option design-picker-option @(isActive ? "design-option--active" : "")"
                                       data-design-picker-hint="@designHint">
                                    <input type="radio" name="menuDesignId" value="@d.Id" class="d-none"
                                           @(isActive ? "checked" : "") />
                                    <div class="design-preview"
                                         style="background:@d.BackgroundColor; border:2px solid @d.PrimaryColor; color:@d.TextColor;">
                                        <span class="design-preview__name">@d.Name</span>
                                        <span class="design-preview__btn"
                                              style="background:@d.PrimaryColor; color:#fff; border-radius:@d.BorderRadius;">Buton</span>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="tm-form-footer">
                    <a href="@fallbackUrl" data-tummenu-back data-fallback-url="@fallbackUrl" class="btn btn-outline-secondary">
                        Vazgeç
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Areas/Admin/Views/MenuDesign/_MenuDesignFieldHintStyles.cshtml")

<style>
    .design-option { cursor: pointer; }
    .design-preview {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 110px;
        height: 90px;
        border-radius: 12px;
        padding: 10px;
        transition: box-shadow .2s;
    }
    .design-option--active .design-preview { box-shadow: 0 0 0 3px #6366f1; }
    .design-preview__name { font-size: 12px; font-weight: 600; }
    .design-preview__btn { font-size: 11px; padding: 3px 10px; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.design-option input[type=radio]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.design-option').forEach(el => el.classList.remove('design-option--active'));
                radio.closest('.design-option').classList.add('design-option--active');
            });
        });

        (function initDesignPickerHints() {
            const tooltip = document.createElement('div');
            tooltip.className = 'design-field-hint';
            document.body.appendChild(tooltip);
            const hide = () => tooltip.classList.remove('is-visible');
            const show = (text, x, y) => {
                tooltip.textContent = text;
                tooltip.style.left = Math.min(x + 12, window.innerWidth - 320) + 'px';
                tooltip.style.top = Math.min(y + 12, window.innerHeight - 80) + 'px';
                tooltip.classList.add('is-visible');
            };
            document.querySelectorAll('[data-design-picker-hint]').forEach(el => {
                const text = el.getAttribute('data-design-picker-hint');
                if (!text) return;
                el.addEventListener('mouseenter', e => show(text, e.clientX, e.clientY));
                el.addEventListener('mousemove', e => show(text, e.clientX, e.clientY));
                el.addEventListener('mouseleave', hide);
            });
        })();
    </script>
}
