@using Application.Menus.Commands
@model UpdateMenuCommand

@{
    ViewData["Title"] = "Update Menu";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="horizon-card">
            <h4 class="fw-bold mb-4">Update Menu</h4>
            
            <form asp-action="Update" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label text-secondary small text-uppercase fw-bold">Menu Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Menu Name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light text-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
