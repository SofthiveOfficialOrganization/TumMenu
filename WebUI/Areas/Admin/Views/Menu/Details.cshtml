@using Application.Menus.DTOs
@model MenuDTO

@{
    ViewData["Title"] = "Menu Details";
}

<div class="row">
    <!-- Menu Details Card -->
    <div class="col-md-4 mb-4">
        <div class="horizon-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Menu Information</h5>
                    <p class="text-secondary small">Basic details about the menu.</p>
                </div>
                <div class="horizon-avatar bg-light text-primary">
                    <i class="fas fa-clipboard-list"></i>
                </div>
            </div>

            <div class="mb-3">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Name</label>
                <p class="fw-bold text-dark fs-5">@Model.Name</p>
            </div>

            <div class="mb-3">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Owner Context</label>
                @if(Model.CompanyId.HasValue)
                {
                     <p class="mb-0"><span class="badge bg-primary bg-opacity-10 text-primary">Company ID: @Model.CompanyId</span></p>
                }
                else if(Model.StoreId.HasValue)
                {
                     <p class="mb-0"><span class="badge bg-info bg-opacity-10 text-info">Store ID: @Model.StoreId</span></p>
                }
                else
                {
                    <p class="text-muted fst-italic">Unassigned</p>
                }
            </div>
            
            <div class="mb-3">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Template</label>
                <p class="text-dark">@(Model.MenuTemplateId.HasValue ? Model.MenuTemplateId.ToString() : "Default Template")</p>
            </div>

             <div class="pt-3 border-top mt-auto">
                 <div class="d-flex justify-content-between small text-secondary">
                     <span>Created: @Model.CreatedAt?.ToString("d")</span>
                 </div>
             </div>
        </div>
    </div>

    <!-- Categories Card -->
    <div class="col-md-8 mb-4">
        <div class="horizon-card h-100">
             <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Categories</h5>
                    <p class="text-secondary small mb-0">Manage categories in this menu.</p>
                </div>
                <a asp-controller="Category" asp-action="Create" asp-route-menuId="@Model.Id" class="btn btn-sm btn-primary">
                    <i class="fas fa-plus me-1"></i> Add Category
                </a>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">Name</th>
                            <th>Description</th>
                            <th>Order</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            foreach (var category in Model.Categories.OrderBy(c => c.SortOrder))
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">@category.Name</td>
                                    <td class="text-secondary text-truncate" style="max-width: 200px;">@category.Description</td>
                                    <td><span class="badge bg-light text-secondary">@category.SortOrder</span></td>
                                    <td class="text-end pe-3">
                                        <a asp-controller="Category" asp-action="Details" asp-route-slug="@category.Slug" class="btn btn-sm btn-light text-primary me-2">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-controller="Category" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-light text-success">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-secondary">
                                    <i class="fas fa-tags fa-2x mb-3 d-block opacity-50"></i>
                                    No categories yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
