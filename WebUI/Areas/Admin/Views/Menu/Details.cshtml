@using Application.Menus.DTOs
@model MenuDTO

@{
    ViewData["Title"] = "Menü Detayları";
}

<div class="row">
    <!-- Menu Details Card -->
    <!-- Menu Details Card -->
    <div class="col-md-4 mb-4">
        <div class="horizon-card h-100">
             <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center gap-3">
                    <h5 class="fw-bold m-0">Menü Bilgileri</h5>
                    @if (Model.Status == Domain.Entities.MenuStatus.Active)
                    {
                        <span class="badge bg-success">AKTİF</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-secondary">PASİF</span>
                         <form asp-action="SetActive" asp-route-id="@Model.Id" method="post" class="d-inline" id="setActiveForm">
                            <button type="button" class="btn btn-sm btn-outline-success ms-2" title="Aktif Yap" onclick="TumMenuAlerts.confirm('Bu menüyü aktif yapmak istediğinize emin misiniz?', 'Bu işlem diğer aktif menüyü pasif yapacaktır.', 'Evet, Aktif Yap!').then(res => { if(res) document.getElementById('setActiveForm').submit(); })">
                                <i class="fas fa-check"></i>
                            </button>
                        </form>
                    }
                </div>
                
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu menüyü silmek istediğinize emin misiniz?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-light text-danger" title="Menüyü Sil">
                        <i class="fas fa-trash"></i>
                    </button>
                </form>
            </div>

            <form asp-action="Update" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                
                <div class="mb-3">
                    <label class="text-secondary small text-uppercase fw-bold d-block mb-1">İsim</label>
                    <input type="text" name="Title" value="@Model.Title" class="form-control fw-bold text-dark" />
                </div>

                <div class="mb-3">
                     <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Bağlı olduğu dükkan/şirket</label>
                    @if(Model.CompanyId.HasValue)
                    {
                         <div class="p-2 border rounded bg-light">
                            <span class="badge bg-primary bg-opacity-10 text-primary"><i class="fas fa-building me-1"></i> Şirket</span>
                            <small class="text-muted ms-1">@Model.CompanyId</small>
                         </div>
                    }
                    else if(Model.StoreId.HasValue)
                    {
                         <div class="p-2 border rounded bg-light">
                            <span class="badge bg-info bg-opacity-10 text-info"><i class="fas fa-store me-1"></i> Dükkan</span>
                            <small class="text-muted ms-1">@Model.StoreName</small>
                         </div>
                    }
                    else
                    {
                         <div class="p-2 border rounded bg-light text-muted fst-italic">Atanmamış</div>
                    }
                </div>

                <div class="mb-4">
                    <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Şablon</label>
                     <div class="p-2 border rounded bg-light text-dark fw-medium">
                        @(Model.MenuTemplateId.HasValue ? Model.MenuTemplateId.ToString() : "Varsayılan Şablon")
                    </div>
                </div>
                
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Kaydet
                    </button>
                </div>
            </form>

             <div class="mt-4 pt-3 border-top text-center text-muted small">
                Oluşturuldu: @Model.CreatedAt?.ToString("d")
             </div>
        </div>
    </div>

    <!-- Categories Card -->
    <div class="col-md-8 mb-4">
        <div class="horizon-card h-100">
             <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Kategoriler</h5>
                    <p class="text-secondary small mb-0">Bu menüdeki kategorileri yönetin.</p>
                </div>
                <div class="d-flex gap-2">
                    @if (!string.IsNullOrEmpty(Model.StoreSlug) && !string.IsNullOrEmpty(Model.CompanySlug))
                    {
                        <a href="/@Model.CompanySlug/@Model.StoreSlug/menu"
                           target="_blank"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-eye me-1"></i> Önizleme
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled title="Önizleme için dükkan slug'ı gerekli">
                            <i class="fas fa-eye me-1"></i> Önizleme
                        </button>
                    }
                    <a asp-controller="Category" asp-action="Create" asp-route-menuId="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus me-1"></i> Kategori Ekle
                    </a>
                </div>
            </div>
            
            <div id="category-grid" class="row">
                @if (Model.Categories != null && Model.Categories.Any())
                {
                    foreach (var category in Model.Categories.OrderBy(c => c.SortOrder))
                    {
                        <div class="col-md-6 mb-3 category-item" data-id="@category.Id">
                            <div class="card h-100 shadow-sm border-0 cursor-move">
                                <div class="card-body d-flex align-items-center">
                                    <div class="me-3 text-secondary handle">
                                        <i class="fas fa-grip-vertical fa-lg"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-dark mb-1">
                                            @category.CategoryLibraryItem.Title
                                            @if (category.ParentId.HasValue)
                                            {
                                                <span class="badge bg-light text-secondary border ms-2 fw-normal" style="font-size: 0.7rem;"><i class="fas fa-level-up-alt fa-rotate-90 me-1"></i> Alt Kategori</span>
                                            }
                                        </h6>
                                        <p class="text-muted small mb-0">
                                            Ürün adedi: @category.Products.Count
                                        </p>
                                    </div>
                                    <div class="d-flex gap-2 text-nowrap">
                                         <a asp-controller="Category" asp-action="Create" asp-route-menuId="@Model.Id" asp-route-parentId="@category.Id" class="btn btn-sm btn-light text-success" title="Alt Kategori Ekle">
                                            <i class="fas fa-plus"></i> <i class="fas fa-level-down-alt"></i>
                                        </a>
                                         <a asp-controller="Category" asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-light text-secondary" title="Ürünler ve Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" asp-route-menuId="@Model.Id" method="post" class="d-inline" id="deleteCategory-@category.Id">
                                            <button type="button" class="btn btn-sm btn-light text-danger" onclick="TumMenuAlerts.confirm('Bu kategoriyi kaldırmak istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Kaldır!').then(res => { if(res) document.getElementById('deleteCategory-@category.Id').submit(); })">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-center py-5 text-secondary border rounded bg-light">
                            <i class="fas fa-tags fa-2x mb-3 d-block opacity-50"></i>
                            <p class="mb-0">Henüz kategori yok. Yukarıdan ekleyebilirsiniz.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var grid = document.getElementById('category-grid');
            if (grid) {
                new Sortable(grid, {
                    animation: 150,
                    handle: '.handle',
                    ghostClass: 'bg-light',
                    onEnd: function (evt) {
                        var items = Array.from(grid.querySelectorAll('.category-item'));
                        var sortData = items.map(function (item, index) {
                            return {
                                id: item.getAttribute('data-id'),
                                sortOrder: index
                            };
                        });

                        // Get CSRF token
                        var token = document.querySelector('input[name="__RequestVerificationToken"]');
                        var headers = {
                            'Content-Type': 'application/json'
                        };
                        if (token) {
                            headers['RequestVerificationToken'] = token.value;
                        }

                        // Send to backend
                        fetch('/admin/Category/UpdateSortOrder', {
                            method: 'POST',
                            headers: headers,
                            body: JSON.stringify({ items: sortData })
                        }).then(response => {
                            if (response.ok) {
                                // showToast('Sıralama güncellendi', 'success');
                            } else {
                                Swal.fire('Hata', 'Sıralama kaydedilemedi.', 'error');
                            }
                        }).catch(error => {
                            console.error('Error:', error);
                            Swal.fire('Hata', 'Bir hata oluştu.', 'error');
                        });
                    }
                });
            }
        });
    </script>
}
