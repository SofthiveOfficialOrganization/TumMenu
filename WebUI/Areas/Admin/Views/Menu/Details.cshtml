@using Application.Categories.DTOs
@using Application.Menus.DTOs
@using Application.MenuDesigns.DTOs
@model MenuDTO

@{
    ViewData["Title"] = "Menü Detayları";
    var menuDetailsReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var allCategories = Model.Categories?.ToList() ?? new List<CategoryDTO>();
    var rootCategories = allCategories
        .Where(c => !c.ParentId.HasValue)
        .OrderBy(c => c.SortOrder)
        .ToList();
    var designs = ViewBag.MenuDesigns as List<MenuDesignDTO> ?? [];
    var currentDesignId = ViewBag.CurrentMenuDesignId as Guid?;
}

<div class="row">
    <!-- Menu Details Card -->
    <!-- Menu Details Card -->
    <div class="col-md-4 mb-4">
        <div class="horizon-card h-100">
             <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center gap-3">
                    <h5 class="fw-bold m-0">Menü Bilgileri</h5>
                    @if (Model.Status == Domain.Entities.MenuStatus.MainMenu)
                    {
                        <span class="badge bg-primary"><i class="fas fa-star me-1"></i>ANA MENÜ</span>
                        @if (Model.IsDefaultCompanyMenu)
                        {
                            <span class="badge bg-warning text-dark"><i class="fas fa-thumbtack me-1"></i>VARSAYILAN</span>
                        }
                    }
                    else if (Model.Status == Domain.Entities.MenuStatus.Active)
                    {
                        <span class="badge bg-success">AKTİF</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-secondary">PASİF</span>
                        <form asp-action="SetActive" asp-route-id="@Model.Id" method="post" class="d-inline" id="setActiveForm">
                            <button type="button" class="btn btn-sm btn-outline-success ms-2" title="Aktif Yap" onclick="TumMenuAlerts.confirm('Bu menüyü aktif yapmak istediğinize emin misiniz?', 'Bu işlem diğer aktif menüyü pasif yapacaktır.', 'Evet, Aktif Yap!').then(res => { if(res) document.getElementById('setActiveForm').submit(); })">
                                <i class="fas fa-check"></i>
                            </button>
                        </form>
                    }
                </div>
                
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" id="deleteMenuForm-@Model.Id" class="d-flex gap-2 flex-shrink-0">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-sm btn-outline-danger shadow-sm" title="Menüyü Sil" onclick="TumMenuAlerts.confirm('Bu menüyü silmek istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Sil!').then(res => { if(res) document.getElementById('deleteMenuForm-@Model.Id').submit(); })" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                    @{
                        var backUrl = ViewData["ReturnUrl"] as string
                            ?? (Model.CompanyId.HasValue ? Url.Action("CompanyMenus") : Url.Action("Index"));
                    }
                    <a href="@backUrl" data-tummenu-back data-fallback-url="@backUrl" class="btn btn-sm btn-outline-secondary shadow-sm px-3" title="Geri Dön" style="height: 36px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-arrow-left"></i> <span class="d-none d-md-inline ms-2">Geri Dön</span>
                    </a>
                </form>
            </div>

            <form asp-action="Update" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                
                <div class="mb-3">
                    <label class="text-secondary small text-uppercase fw-bold d-block mb-1">İsim</label>
                    <input type="text" name="Title" value="@Model.Title" class="form-control fw-bold text-dark" />
                </div>

                <div class="mb-3">
                     <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Bağlı olduğu dükkan/şirket</label>
                    @if(Model.CompanyId.HasValue)
                    {
                         <div class="p-2 border rounded bg-light">
                            <span class="badge bg-primary bg-opacity-10 text-primary"><i class="fas fa-star me-1"></i> Ana Menü</span>
                            <small class="text-dark fw-medium ms-1">@Model.CompanyName</small>
                            @if (Model.IsDefaultCompanyMenu)
                            {
                                <span class="badge bg-warning text-dark ms-2"><i class="fas fa-thumbtack me-1"></i>Varsayılan Ana Menü</span>
                            }
                         </div>
                    }
                    else if(Model.StoreId.HasValue)
                    {
                         <div class="p-2 border rounded bg-light">
                            <span class="badge bg-info bg-opacity-10 text-info"><i class="fas fa-store me-1"></i> Dükkan</span>
                            <small class="text-muted ms-1">@Model.StoreName</small>
                         </div>
                    }
                    else
                    {
                         <div class="p-2 border rounded bg-light text-muted fst-italic">Atanmamış</div>
                    }
                </div>

                <div class="mb-4">
                    <label class="text-secondary small text-uppercase fw-bold d-block mb-2">Tasarım</label>
                    <form asp-action="SetDesign" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <label class="design-option @(currentDesignId == null ? "design-option--active" : "")">
                                <input type="radio" name="menuDesignId" value="" class="d-none"
                                       @(currentDesignId == null ? "checked" : "") />
                                <div class="design-preview" style="background:#f8fafc; border:2px solid #e2e8f0;">
                                    <span class="design-preview__name text-muted" style="font-size:11px;">Varsayılan</span>
                                    <span class="design-preview__btn" style="background:#688745; border-radius:24px; font-size:10px;">Buton</span>
                                </div>
                            </label>
                            @foreach (var d in designs)
                            {
                                var isActive = currentDesignId == d.Id;
                                <label class="design-option @(isActive ? "design-option--active" : "")">
                                    <input type="radio" name="menuDesignId" value="@d.Id" class="d-none"
                                           @(isActive ? "checked" : "") />
                                    <div class="design-preview"
                                         style="background:@d.BackgroundColor; border:2px solid @d.PrimaryColor; color:@d.TextColor;">
                                        <span class="design-preview__name" style="font-size:11px;">@d.Name</span>
                                        <span class="design-preview__btn"
                                              style="background:@d.PrimaryColor; color:#fff; border-radius:@d.BorderRadius; font-size:10px;">Buton</span>
                                    </div>
                                </label>
                            }
                        </div>
                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                            <i class="fas fa-check me-1"></i>Tasarımı Uygula
                        </button>
                    </form>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Kaydet
                    </button>
                </div>
            </form>

            @if (Model.CompanyId.HasValue && Model.Status == Domain.Entities.MenuStatus.MainMenu && !Model.IsDefaultCompanyMenu)
            {
                <div class="mt-3">
                    <label class="text-secondary small text-uppercase fw-bold d-block mb-2">Varsayılan Kullanım</label>
                    <form asp-action="SetDefault" asp-route-id="@Model.Id" method="post" id="setDefaultMenuForm">
                        @Html.AntiForgeryToken()
                        <button type="button"
                                class="btn btn-outline-warning w-100"
                                onclick="TumMenuAlerts.confirm('Bu menüyü varsayılan ana menü yapmak istediğinize emin misiniz?', 'Mağazanın kendi menüsü yoksa public tarafta bu menü gösterilir.', 'Evet, Varsayılan Yap!').then(res => { if(res) document.getElementById('setDefaultMenuForm').submit(); })">
                            <i class="fas fa-thumbtack me-2"></i>Varsayılan Ana Menü Yap
                        </button>
                    </form>
                </div>
            }

             <div class="mt-4 pt-3 border-top text-center text-muted small">
                Oluşturuldu: @Model.CreatedAt?.ToString("d")
             </div>
        </div>
    </div>

    <!-- Categories Card -->
    <div class="col-md-8 mb-4">
        <div class="horizon-card h-100">
             <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Kategoriler</h5>
                    <p class="text-secondary small mb-0">Bu menüdeki kategorileri yönetin.</p>
                </div>
                <div class="d-flex gap-2">
                    @if (!string.IsNullOrEmpty(Model.StoreSlug) && !string.IsNullOrEmpty(Model.CompanySlug))
                    {
                        <a href="/@Model.CompanySlug/@Model.StoreSlug"
                           target="_blank"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-eye me-1"></i> Önizleme
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled title="Önizleme için dükkan slug'ı gerekli">
                            <i class="fas fa-eye me-1"></i> Önizleme
                        </button>
                    }
                    <a asp-controller="Category" asp-action="Create" asp-route-menuId="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus me-1"></i> Kategori Ekle
                    </a>
                </div>
            </div>
            
            <div id="category-grid" class="row">
                @if (rootCategories.Any())
                {
                    foreach (var category in rootCategories)
                    {
                        var subCategoryCount = allCategories.Count(c => c.ParentId == category.Id);
                        var categoryDetailsUrl = Url.Action(
                            "Details",
                            "Category",
                            new { id = category.Id, returnUrl = menuDetailsReturnUrl }
                        );

                        <div class="col-md-6 mb-3 category-item" data-id="@category.Id">
                            <div class="card h-100 shadow-sm border-0 cursor-move category-card" data-details-url="@categoryDetailsUrl">
                                <div class="card-body d-flex align-items-center">
                                    <div class="me-3 text-secondary handle">
                                        <i class="fas fa-grip-vertical fa-lg"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-dark mb-1">
                                            <a href="@categoryDetailsUrl" class="text-dark text-decoration-none">
                                                @category.CategoryLibraryItem.Title
                                            </a>
                                        </h6>
                                        <p class="text-muted small mb-0">
                                            Ürün adedi: @category.Products.Count
                                        </p>
                                        @if (subCategoryCount > 0)
                                        {
                                            <p class="text-muted small mb-0">Alt kategori: @subCategoryCount</p>
                                        }
                                    </div>
                                    <div class="d-flex gap-2 text-nowrap">
                                         <a asp-controller="Category" asp-action="Create" asp-route-menuId="@Model.Id" asp-route-parentId="@category.Id" class="btn btn-sm btn-outline-primary" title="Alt Kategori Ekle">
                                            <i class="fas fa-plus"></i> <i class="fas fa-level-down-alt"></i>
                                        </a>
                                         <a href="@categoryDetailsUrl" class="btn btn-sm btn-outline-secondary" title="Kategoriler ve Ürünler">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" asp-route-menuId="@Model.Id" method="post" class="d-inline" id="deleteCategory-@category.Id">
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="TumMenuAlerts.confirm('Bu kategoriyi kaldırmak istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Kaldır!').then(res => { if(res) document.getElementById('deleteCategory-@category.Id').submit(); })">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-center py-5 text-secondary border rounded bg-light">
                            <i class="fas fa-tags fa-2x mb-3 d-block opacity-50"></i>
                            <p class="mb-0">Henüz ana kategori yok. Yukarıdan ekleyebilirsiniz.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .design-option { cursor: pointer; }
    .design-preview {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        width: 80px;
        height: 70px;
        border-radius: 10px;
        padding: 8px;
        transition: box-shadow .2s;
    }
    .design-option--active .design-preview { box-shadow: 0 0 0 3px #6366f1; }
    .design-preview__btn { padding: 2px 8px; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        document.querySelectorAll('.design-option input[type=radio]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.design-option').forEach(el => el.classList.remove('design-option--active'));
                radio.closest('.design-option').classList.add('design-option--active');
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var grid = document.getElementById('category-grid');
            var categoryCards = document.querySelectorAll('.category-card');

            categoryCards.forEach(function (card) {
                card.addEventListener('click', function (event) {
                    if (event.target.closest('.handle, a, button, form')) {
                        return;
                    }

                    var detailsUrl = card.getAttribute('data-details-url');
                    if (detailsUrl) {
                        window.location.href = detailsUrl;
                    }
                });
            });

            if (grid) {
                new Sortable(grid, {
                    animation: 150,
                    handle: '.handle',
                    ghostClass: 'bg-light',
                    onEnd: function (evt) {
                        var items = Array.from(grid.querySelectorAll('.category-item'));
                        var sortData = items.map(function (item, index) {
                            return {
                                id: item.getAttribute('data-id'),
                                sortOrder: index
                            };
                        });

                        // Get CSRF token
                        var token = document.querySelector('input[name="__RequestVerificationToken"]');
                        var headers = {
                            'Content-Type': 'application/json'
                        };
                        if (token) {
                            headers['RequestVerificationToken'] = token.value;
                        }

                        // Send to backend
                        fetch(`/admin/Category/UpdateSortOrder`, {
                            method: 'POST',
                            headers: headers,
                            body: JSON.stringify({ items: sortData })
                        }).then(response => {
                            if (response.ok) {
                                // showToast('Sıralama güncellendi', 'success');
                            } else {
                                Swal.fire('Hata', 'Sıralama kaydedilemedi.', 'error');
                            }
                        }).catch(error => {
                            console.error('Error:', error);
                            Swal.fire('Hata', 'Bir hata oluştu.', 'error');
                        });
                    }
                });
            }
        });
    </script>
}
