@using Application.Categories.DTOs
@using Application.Menus.DTOs
@using Application.MenuDesigns.DTOs
@using Application.Products.Commands
@model MenuDTO

@{
    ViewData["Title"] = "Menü Detayları";
    var menuDetailsReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var backUrl = ViewData["ReturnUrl"] as string
        ?? (Model.CompanyId.HasValue ? Url.Action("CompanyMenus") : Url.Action("Index"));
    var allCategories = Model.Categories?.ToList() ?? new List<CategoryDTO>();
    var rootCategories = allCategories
        .Where(c => !c.ParentId.HasValue)
        .OrderBy(c => c.SortOrder)
        .ToList();
    var designs = ViewBag.MenuDesigns as List<MenuDesignDTO> ?? [];
    var currentDesignId = ViewBag.CurrentMenuDesignId as Guid?;
    var allProductCount = allCategories.Sum(c => c.Products?.Count ?? 0);
    var productsForPreview = allCategories
        .OrderBy(c => c.SortOrder)
        .SelectMany(c => (c.Products ?? [])
            .OrderBy(p => p.SortOrder)
            .Select(p => new { Product = p, CategoryTitle = c.CategoryLibraryItem.Title }))
        .ToList();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="horizon-card tm-page-header">
    <div class="tm-page-header__main">
        <a href="@backUrl"
           data-tummenu-back
           data-fallback-url="@backUrl"
           class="btn btn-outline-secondary tm-back-button"
           title="Geri Dön">
            <i class="fas fa-arrow-left"></i>
            <span>Geri Dön</span>
        </a>

        <div class="tm-page-heading">
            <div class="tm-page-eyebrow">Menü Yönetimi</div>
            <h1 class="tm-page-title">@Model.Title</h1>
            <p class="tm-page-subtitle">Menü bilgileri, tasarım seçimi, kategoriler ve toplu fiyat işlemleri.</p>
        </div>
    </div>

    <div class="tm-page-actions">
        @if (!string.IsNullOrEmpty(Model.StoreSlug) && !string.IsNullOrEmpty(Model.CompanySlug))
        {
            <a href="/@Model.CompanySlug/@Model.StoreSlug" target="_blank" class="btn btn-outline-secondary">
                <i class="fas fa-eye me-2"></i>Önizle
            </a>
        }
        <a asp-action="Update" asp-route-id="@Model.Id" asp-route-returnUrl="@menuDetailsReturnUrl" class="btn btn-outline-primary">
            <i class="fas fa-edit me-2"></i>Düzenle
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-returnUrl="@(ViewData["ReturnUrl"] as string)" method="post" id="deleteMenuForm-@Model.Id" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="button" class="btn btn-outline-danger" title="Menüyü Sil" onclick="TumMenuAlerts.confirm('Bu menüyü silmek istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Sil!').then(res => { if(res) document.getElementById('deleteMenuForm-@Model.Id').submit(); })">
                <i class="fas fa-trash-alt me-2"></i>Sil
            </button>
        </form>
    </div>
</div>

<div class="row">
    <!-- Categories Card -->
    <div class="col-12 mb-4">
        <div class="horizon-card h-100">
             <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Kategoriler</h5>
                    <p class="text-secondary small mb-0">Bu menüdeki kategorileri yönetin.</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#bulkPriceUpdateModal"
                            @(allProductCount == 0 ? "disabled" : null)>
                        <i class="fas fa-coins me-1"></i> Toplu İşlemler
                    </button>
                    @if (!string.IsNullOrEmpty(Model.StoreSlug) && !string.IsNullOrEmpty(Model.CompanySlug))
                    {
                        <a href="/@Model.CompanySlug/@Model.StoreSlug"
                           target="_blank"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-eye me-1"></i> Önizleme
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled title="Önizleme için dükkan slug'ı gerekli">
                            <i class="fas fa-eye me-1"></i> Önizleme
                        </button>
                    }
                    <a asp-controller="Category" asp-action="Create" asp-route-menuId="@Model.Id" asp-route-returnUrl="@menuDetailsReturnUrl" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus me-1"></i> Kategori Ekle
                    </a>
                </div>
            </div>
            
            <div id="category-grid" class="row">
                @if (rootCategories.Any())
                {
                    foreach (var category in rootCategories)
                    {
                        var subCategoryCount = allCategories.Count(c => c.ParentId == category.Id);
                        var categoryDetailsUrl = Url.Action(
                            "Details",
                            "Category",
                            new { id = category.Id, returnUrl = menuDetailsReturnUrl }
                        );

                        <div class="col-md-6 mb-3 category-item" data-id="@category.Id">
                            <div class="card h-100 shadow-sm border-0 cursor-move category-card" data-tummenu-click-url="@categoryDetailsUrl">
                                <div class="card-body d-flex align-items-center">
                                    <div class="me-3 text-secondary handle">
                                        <i class="fas fa-grip-vertical fa-lg"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-dark mb-1">
                                            <a href="@categoryDetailsUrl" class="text-dark text-decoration-none">
                                                @category.CategoryLibraryItem.Title
                                            </a>
                                        </h6>
                                        <p class="text-muted small mb-0">
                                            Ürün adedi: @category.Products.Count
                                        </p>
                                        @if (subCategoryCount > 0)
                                        {
                                            <p class="text-muted small mb-0">Alt kategori: @subCategoryCount</p>
                                        }
                                    </div>
                                    <div class="d-flex gap-2 text-nowrap">
                                         <a asp-controller="Category" asp-action="Create" asp-route-menuId="@Model.Id" asp-route-parentId="@category.Id" asp-route-returnUrl="@menuDetailsReturnUrl" class="btn btn-sm btn-outline-primary" title="Alt Kategori Ekle">
                                            <i class="fas fa-plus"></i> <i class="fas fa-level-down-alt"></i>
                                        </a>
                                         <a href="@categoryDetailsUrl" class="btn btn-sm btn-outline-secondary" title="Kategoriler ve Ürünler">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" asp-route-menuId="@Model.Id" asp-route-returnUrl="@menuDetailsReturnUrl" method="post" class="d-inline" id="deleteCategory-@category.Id">
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="TumMenuAlerts.confirm('Bu kategoriyi kaldırmak istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Kaldır!').then(res => { if(res) document.getElementById('deleteCategory-@category.Id').submit(); })">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-center py-5 text-secondary border rounded bg-light">
                            <i class="fas fa-tags fa-2x mb-3 d-block opacity-50"></i>
                            <p class="mb-0">Henüz ana kategori yok. Yukarıdan ekleyebilirsiniz.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bulkPriceUpdateModal" tabindex="-1" aria-labelledby="bulkPriceUpdateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="BulkUpdatePrices" asp-route-id="@Model.Id" method="post" id="bulkPriceUpdateForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@menuDetailsReturnUrl" />

                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold" id="bulkPriceUpdateModalLabel">Toplu Fiyat Güncelle</h5>
                        <p class="text-secondary small mb-0">@allProductCount ürünün ana fiyatı ve varsa fiyat seçenekleri güncellenir.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="bulk-price-option h-100">
                                <input class="form-check-input" type="radio" name="UpdateType" value="@BulkPriceUpdateType.FixedAmount" />
                                <span class="bulk-price-option__body">
                                    <span class="fw-bold d-block">Sabit olarak artır</span>
                                    <span class="text-secondary small">Her fiyata aynı TL tutarı eklenir. 200 TL ve 300 TL olan ürünlere +10 TL gibi.</span>
                                </span>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="bulk-price-option h-100">
                                <input class="form-check-input" type="radio" name="UpdateType" value="@BulkPriceUpdateType.Percentage" checked />
                                <span class="bulk-price-option__body">
                                    <span class="fw-bold d-block">Yüzdelik artır</span>
                                    <span class="text-secondary small">Her fiyat kendi tutarına göre artar. Küsürat oluşursa aşağıdaki yuvarlama kullanılabilir.</span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="row g-3 align-items-end mb-4">
                        <div class="col-md-4">
                            <label for="bulkPriceAmount" class="form-label fw-bold text-secondary small text-uppercase">Artış Değeri</label>
                            <div class="input-group">
                                <input id="bulkPriceAmount" name="Amount" class="form-control" type="number" step="0.01" min="0.01" max="1000" value="10" required />
                                <span class="input-group-text" data-bulk-price-unit>%</span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Yüzdelik Artışta Yuvarlama</label>
                            <div class="bulk-rounding-options" data-bulk-rounding-options>
                                <label class="btn btn-outline-secondary">
                                    <input type="radio" name="RoundingStrategy" value="@BulkPriceRoundingStrategy.None" checked />
                                    Yuvarlama yok
                                </label>
                                <label class="btn btn-outline-secondary">
                                    <input type="radio" name="RoundingStrategy" value="@BulkPriceRoundingStrategy.Nearest5" />
                                    En yakın 5 TL
                                </label>
                                <label class="btn btn-outline-secondary">
                                    <input type="radio" name="RoundingStrategy" value="@BulkPriceRoundingStrategy.Nearest10" />
                                    En yakın 10 TL
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="bulk-price-preview">
                        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                            <div>
                                <h6 class="fw-bold mb-1">Fiyat öngösterimi</h6>
                                <p class="bulk-price-muted small mb-0">Güncellemeden sonra menüde görünecek fiyatlar.</p>
                            </div>
                            <span class="bulk-preview-badge" data-bulk-preview-mode>Yüzdelik artış</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 bulk-preview-table">
                                <thead>
                                    <tr>
                                        <th>Ürün</th>
                                        <th class="text-end">Mevcut fiyat</th>
                                        <th>İşlem</th>
                                        <th class="text-end">Yeni fiyat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in productsForPreview)
                                    {
                                        var product = item.Product;
                                        <tr data-preview-price="@product.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            <td>
                                                <span class="fw-semibold">@product.Title</span>
                                                <span class="bulk-price-muted d-block small">@item.CategoryTitle · Ana fiyat</span>
                                            </td>
                                            <td class="text-end">@product.BasePrice.ToString("N2") TL</td>
                                            <td data-preview-operation>%10 artış</td>
                                            <td class="text-end fw-bold" data-preview-result>@product.BasePrice.ToString("N2") TL</td>
                                        </tr>

                                        @foreach (var price in product.Prices.OrderBy(p => p.CreatedAt))
                                        {
                                            <tr data-preview-price="@price.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                <td>
                                                    <span class="fw-semibold">@product.Title</span>
                                                    <span class="bulk-price-muted d-block small">@item.CategoryTitle · @price.Size</span>
                                                </td>
                                                <td class="text-end">@price.Price.ToString("N2") TL</td>
                                                <td data-preview-operation>%10 artış</td>
                                                <td class="text-end fw-bold" data-preview-result>@price.Price.ToString("N2") TL</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="bulk-price-muted small mb-0 mt-3" data-bulk-explanation>
                            Yuvarlama yoksa küsüratlı fiyatlar aynı şekilde kalır. 5 TL veya 10 TL seçerseniz sonuç en yakın katına çekilir.
                        </p>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check me-2"></i>Fiyatları Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Areas/Admin/Views/MenuDesign/_MenuDesignFieldHintStyles.cshtml")

<style>
    .design-option { cursor: pointer; }
    .design-picker-option { position: relative; }
    .design-preview {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        width: 80px;
        height: 70px;
        border-radius: 10px;
        padding: 8px;
        transition: box-shadow .2s;
    }
    .design-option--active .design-preview { box-shadow: 0 0 0 3px #6366f1; }
    .design-preview__btn { padding: 2px 8px; }
    #bulkPriceUpdateModal {
        --bulk-modal-bg: var(--horizon-card-bg);
        --bulk-modal-text: var(--horizon-text-primary);
        --bulk-modal-muted: var(--horizon-text-secondary);
        --bulk-modal-border: rgba(163, 174, 208, 0.28);
        --bulk-modal-soft-border: rgba(163, 174, 208, 0.2);
        --bulk-modal-surface: #f8faff;
        --bulk-modal-surface-strong: #ffffff;
        --bulk-modal-input-bg: #ffffff;
        --bulk-modal-table-head-bg: #f4f7fe;
        --bulk-modal-row-hover: rgba(var(--horizon-primary-rgb), 0.04);
        --bulk-modal-close-filter: none;
    }
    html.dark-mode #bulkPriceUpdateModal,
    body.dark-mode #bulkPriceUpdateModal {
        --bulk-modal-bg: var(--horizon-card-bg);
        --bulk-modal-text: var(--horizon-text-primary);
        --bulk-modal-muted: var(--horizon-text-secondary);
        --bulk-modal-border: rgba(255, 255, 255, 0.16);
        --bulk-modal-soft-border: rgba(255, 255, 255, 0.1);
        --bulk-modal-surface: rgba(255, 255, 255, 0.045);
        --bulk-modal-surface-strong: rgba(255, 255, 255, 0.04);
        --bulk-modal-input-bg: #101943;
        --bulk-modal-table-head-bg: #101943;
        --bulk-modal-row-hover: rgba(255, 255, 255, 0.04);
        --bulk-modal-close-filter: invert(1) grayscale(1);
    }
    #bulkPriceUpdateModal .modal-content {
        background: var(--bulk-modal-bg);
        color: var(--bulk-modal-text);
    }
    #bulkPriceUpdateModal .modal-header,
    #bulkPriceUpdateModal .modal-footer {
        border-color: var(--bulk-modal-soft-border);
    }
    #bulkPriceUpdateModal .btn-close { filter: var(--bulk-modal-close-filter); opacity: .75; }
    #bulkPriceUpdateModal .form-label,
    #bulkPriceUpdateModal .modal-title { color: var(--bulk-modal-text); }
    #bulkPriceUpdateModal .text-secondary,
    .bulk-price-muted { color: var(--bulk-modal-muted) !important; }
    #bulkPriceUpdateModal .form-control,
    #bulkPriceUpdateModal .input-group-text {
        background: var(--bulk-modal-input-bg);
        border-color: var(--bulk-modal-border);
        color: var(--bulk-modal-text);
    }
    .bulk-price-option {
        display: flex;
        gap: 12px;
        padding: 14px;
        border: 1px solid var(--bulk-modal-border);
        border-radius: 8px;
        cursor: pointer;
        background: var(--bulk-modal-surface-strong);
        color: var(--bulk-modal-text);
        transition: border-color .2s, background .2s, box-shadow .2s;
    }
    .bulk-price-option:has(input:checked) {
        border-color: var(--horizon-primary);
        background: rgba(var(--horizon-primary-rgb), 0.12);
        box-shadow: 0 0 0 3px rgba(var(--horizon-primary-rgb), 0.2);
    }
    .bulk-price-option .form-check-input { margin-top: 3px; flex-shrink: 0; }
    .bulk-price-option__body { display: block; }
    .bulk-rounding-options {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
    }
    .bulk-rounding-options .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 38px;
        white-space: normal;
        color: var(--bulk-modal-text);
        border-color: var(--bulk-modal-border);
        background: var(--bulk-modal-surface-strong);
    }
    .bulk-rounding-options .btn:has(input:checked) {
        color: #fff;
        background: var(--horizon-primary);
        border-color: var(--horizon-primary);
    }
    .bulk-rounding-options input { margin: 0; }
    .bulk-price-preview {
        border: 1px solid var(--bulk-modal-border);
        border-radius: 8px;
        padding: 16px;
        background: var(--bulk-modal-surface);
    }
    .bulk-price-preview .table-responsive {
        max-height: 320px;
        overflow-y: auto;
        border: 1px solid var(--bulk-modal-soft-border);
        border-radius: 8px;
    }
    .bulk-preview-table { color: var(--bulk-modal-text); }
    .bulk-preview-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--bulk-modal-table-head-bg);
        color: var(--bulk-modal-muted);
        border-color: var(--bulk-modal-soft-border);
    }
    .bulk-preview-table tbody td {
        color: var(--bulk-modal-text);
        border-color: var(--bulk-modal-soft-border);
    }
    .bulk-preview-table tbody tr:hover { background: var(--bulk-modal-row-hover); }
    .bulk-preview-badge {
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 4px 10px;
        border-radius: 999px;
        color: #dce6ff;
        background: rgba(var(--horizon-primary-rgb), 0.2);
        border: 1px solid rgba(var(--horizon-primary-rgb), 0.35);
        font-size: .75rem;
        font-weight: 700;
    }
    @@media (max-width: 576px) {
        .bulk-rounding-options { grid-template-columns: 1fr; }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        document.querySelectorAll('.design-option input[type=radio]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.design-option').forEach(el => el.classList.remove('design-option--active'));
                radio.closest('.design-option').classList.add('design-option--active');
            });
        });

        (function initDesignPickerHints() {
            const tooltip = document.createElement('div');
            tooltip.className = 'design-field-hint';
            tooltip.setAttribute('role', 'tooltip');
            document.body.appendChild(tooltip);

            function hide() { tooltip.classList.remove('is-visible'); }
            function show(text, x, y) {
                tooltip.textContent = text;
                tooltip.style.left = Math.min(x + 12, window.innerWidth - 320) + 'px';
                tooltip.style.top = Math.min(y + 12, window.innerHeight - 80) + 'px';
                tooltip.classList.add('is-visible');
            }

            document.querySelectorAll('[data-design-picker-hint]').forEach(el => {
                const text = el.getAttribute('data-design-picker-hint');
                if (!text) return;
                el.addEventListener('mouseenter', e => show(text, e.clientX, e.clientY));
                el.addEventListener('mousemove', e => show(text, e.clientX, e.clientY));
                el.addEventListener('mouseleave', hide);
            });
        })();
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var bulkForm = document.getElementById('bulkPriceUpdateForm');
            var bulkAmount = document.getElementById('bulkPriceAmount');
            var bulkUnit = document.querySelector('[data-bulk-price-unit]');
            var bulkModeBadge = document.querySelector('[data-bulk-preview-mode]');
            var bulkExplanation = document.querySelector('[data-bulk-explanation]');
            var roundingOptions = document.querySelector('[data-bulk-rounding-options]');
            var submitConfirmed = false;
            var currencyFormatter = new Intl.NumberFormat('tr-TR', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });

            function selectedValue(name) {
                return document.querySelector('input[name="' + name + '"]:checked')?.value;
            }

            function parseAmount() {
                var raw = (bulkAmount?.value || '0').replace(',', '.');
                var value = Number.parseFloat(raw);
                return Number.isFinite(value) ? value : 0;
            }

            function roundToNearest(value, multiple) {
                return Math.round(value / multiple) * multiple;
            }

            function formatTry(value) {
                return currencyFormatter.format(value) + ' TL';
            }

            function updateBulkPricePreview() {
                if (!bulkForm || !bulkAmount) return;

                var updateType = selectedValue('UpdateType');
                var rounding = selectedValue('RoundingStrategy');
                var amount = parseAmount();
                var isPercentage = updateType === '@BulkPriceUpdateType.Percentage';

                bulkUnit.textContent = isPercentage ? '%' : 'TL';
                bulkModeBadge.textContent = isPercentage ? 'Yüzdelik artış' : 'Sabit artış';
                roundingOptions.querySelectorAll('input').forEach(function (input) {
                    input.disabled = !isPercentage;
                    input.closest('.btn').classList.toggle('disabled', !isPercentage);
                });

                if (!isPercentage) {
                    roundingOptions.querySelector('input[value="@BulkPriceRoundingStrategy.None"]').checked = true;
                }

                document.querySelectorAll('[data-preview-price]').forEach(function (row) {
                    var oldPrice = Number.parseFloat(row.getAttribute('data-preview-price'));
                    var newPrice = isPercentage
                        ? oldPrice + (oldPrice * amount / 100)
                        : oldPrice + amount;

                    if (isPercentage && rounding === '@BulkPriceRoundingStrategy.Nearest5') {
                        newPrice = roundToNearest(newPrice, 5);
                    } else if (isPercentage && rounding === '@BulkPriceRoundingStrategy.Nearest10') {
                        newPrice = roundToNearest(newPrice, 10);
                    }

                    row.querySelector('[data-preview-operation]').textContent = isPercentage
                        ? '%' + currencyFormatter.format(amount) + ' artış'
                        : '+' + formatTry(amount);
                    row.querySelector('[data-preview-result]').textContent = formatTry(newPrice);
                });

                if (!isPercentage) {
                    bulkExplanation.textContent = 'Sabit artışta tüm fiyatlara aynı TL tutarı eklenir. Yuvarlama kullanılmaz.';
                } else if (rounding === '@BulkPriceRoundingStrategy.None') {
                    bulkExplanation.textContent = 'Yuvarlama yoksa küsüratlı fiyatlar aynı şekilde kalır.';
                } else {
                    bulkExplanation.textContent = rounding === '@BulkPriceRoundingStrategy.Nearest5'
                        ? 'Sonuçlar en yakın 5 TL katına yuvarlanır.'
                        : 'Sonuçlar en yakın 10 TL katına yuvarlanır.';
                }
            }

            if (bulkForm) {
                bulkForm.querySelectorAll('input[name="UpdateType"], input[name="RoundingStrategy"]').forEach(function (input) {
                    input.addEventListener('change', updateBulkPricePreview);
                });
                bulkAmount.addEventListener('input', updateBulkPricePreview);
                updateBulkPricePreview();

                bulkForm.addEventListener('submit', function (event) {
                    if (submitConfirmed) return;
                    event.preventDefault();

                    var doSubmit = function () {
                        submitConfirmed = true;
                        bulkForm.requestSubmit();
                    };

                    if (window.TumMenuAlerts) {
                        TumMenuAlerts.confirm(
                            'Toplu fiyat güncellemesi yapılsın mı?',
                            'Bu işlem menüdeki tüm ürün fiyatlarına uygulanır.',
                            'Evet, Güncelle!'
                        ).then(function (res) {
                            if (res) doSubmit();
                        });
                    } else if (window.confirm('Toplu fiyat güncellemesi yapılsın mı?')) {
                        doSubmit();
                    }
                });
            }

            var grid = document.getElementById('category-grid');
            if (grid) {
                new Sortable(grid, {
                    animation: 150,
                    handle: '.handle',
                    ghostClass: 'bg-light',
                    onEnd: function (evt) {
                        var items = Array.from(grid.querySelectorAll('.category-item'));
                        var sortData = items.map(function (item, index) {
                            return {
                                id: item.getAttribute('data-id'),
                                sortOrder: index
                            };
                        });

                        // Get CSRF token
                        var token = document.querySelector('input[name="__RequestVerificationToken"]');
                        var headers = {
                            'Content-Type': 'application/json'
                        };
                        if (token) {
                            headers['RequestVerificationToken'] = token.value;
                        }

                        // Send to backend
                        fetch(`/admin/Category/UpdateSortOrder`, {
                            method: 'POST',
                            headers: headers,
                            body: JSON.stringify({ items: sortData })
                        }).then(response => {
                            if (response.ok) {
                                // showToast('Sıralama güncellendi', 'success');
                            } else {
                                Swal.fire('Hata', 'Sıralama kaydedilemedi.', 'error');
                            }
                        }).catch(error => {
                            console.error('Error:', error);
                            Swal.fire('Hata', 'Bir hata oluştu.', 'error');
                        });
                    }
                });
            }
        });
    </script>
}
