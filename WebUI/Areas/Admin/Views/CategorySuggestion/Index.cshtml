@using Application.CategorySuggestions.DTOs
@using Application.Common.Base.Page
@model IPaginate<CategorySuggestionDTO>

@{
    ViewData["Title"] = "Kategori Önerileri";
    var statusFilter = ViewBag.StatusFilter as int?;
    var pageSize = (int)(ViewBag.PageSize ?? 12);
    var currentPage = Model.Index;
    var totalPages = Model.Pages;
}

<div class="row mb-3">
    <div class="col-12">
        <div class="horizon-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h4 class="fw-bold mb-1">
                        <i class="fas fa-lightbulb text-warning me-2"></i>Kategori Önerileri
                    </h4>
                    <p class="text-secondary small mb-0">Müşterilerinizin gönderdiği kategori önerilerini inceleyin ve kütüphaneye ekleyin.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill bg-warning bg-opacity-15 border border-warning border-opacity-25 px-3 py-2 fw-semibold">
                        @Model.Count Kayıt
                    </span>
                    <a asp-action="Create" asp-controller="CategoryLibraryItem" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Yeni Kategori
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtre Sekmeleri -->
<div class="row mb-3">
    <div class="col-12">
        <div class="horizon-card py-2">
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Index" class="btn btn-sm @(statusFilter == null ? "btn-primary" : "btn-light text-secondary")">
                    <i class="fas fa-list me-1"></i>Tümü
                </a>
                <a asp-action="Index" asp-route-status="0" class="btn btn-sm @(statusFilter == 0 ? "btn-warning" : "btn-light text-secondary")">
                    <i class="fas fa-bell me-1"></i>Yeni
                </a>
                <a asp-action="Index" asp-route-status="1" class="btn btn-sm @(statusFilter == 1 ? "btn-secondary" : "btn-light text-secondary")">
                    <i class="fas fa-eye me-1"></i>Görüldü
                </a>
                <a asp-action="Index" asp-route-status="2" class="btn btn-sm @(statusFilter == 2 ? "btn-success" : "btn-light text-secondary")">
                    <i class="fas fa-check-circle me-1"></i>Onaylanan
                </a>
                <a asp-action="Index" asp-route-status="3" class="btn btn-sm @(statusFilter == 3 ? "btn-danger" : "btn-light text-secondary")">
                    <i class="fas fa-times-circle me-1"></i>Reddedilen
                </a>
            </div>
        </div>
    </div>
</div>

@if (Model.Items.Any())
{
    <div class="row g-3">
        @foreach (var item in Model.Items)
        {
            var statusClass = item.Status switch { 2 => "border-success", 3 => "border-danger", 1 => "border-secondary", _ => "border-warning" };
            var statusBadge = item.Status switch { 2 => ("bg-success", "Onaylandı"), 3 => ("bg-danger", "Reddedildi"), 1 => ("bg-secondary", "Görüldü"), _ => ("bg-warning", "Yeni") };
            <div class="col-md-6 col-xl-4">
                <div class="horizon-card h-100 border-start border-3 @statusClass">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning flex-shrink-0"
                             style="width:46px;height:46px;font-size:18px;">
                            <i class="fas fa-lightbulb"></i>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h6 class="fw-bold text-dark mb-0 text-truncate">@item.Title</h6>
                                <span class="badge @statusBadge.Item1 text-white flex-shrink-0" style="font-size:0.65rem;">@statusBadge.Item2</span>
                            </div>
                            @if (!string.IsNullOrEmpty(item.Reason))
                            {
                                <p class="text-secondary small mb-1">
                                    <i class="fas fa-quote-left opacity-50 me-1"></i>@item.Reason
                                </p>
                            }
                            <div class="d-flex align-items-center gap-2 text-muted" style="font-size:0.78rem;">
                                <span><i class="fas fa-building me-1 opacity-50"></i>@(item.CompanyName ?? "Bilinmeyen")</span>
                                <span>•</span>
                                <span><i class="fas fa-clock me-1 opacity-50"></i>@item.CreatedAt.ToString("d MMM yyyy")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(item.AdminNote))
                            {
                                <div class="mt-2 p-2 rounded bg-danger bg-opacity-10 text-danger small">
                                    <i class="fas fa-info-circle me-1"></i>@item.AdminNote
                                </div>
                            }
                        </div>
                    </div>

                    @if (item.Status == 0 || item.Status == 1)
                    {
                        <div class="d-flex gap-2 mt-3 pt-3 border-top">
                            <a asp-controller="CategoryLibraryItem" asp-action="Create"
                               asp-route-suggestedTitle="@item.Title"
                               asp-route-suggestionId="@item.Id"
                               class="btn btn-sm btn-success flex-grow-1" title="Onayla ve Kategori Oluştur">
                                <i class="fas fa-check me-1"></i>Onayla & Ekle
                            </a>
                            <button type="button" class="btn btn-sm btn-light text-danger"
                                    data-bs-toggle="modal" data-bs-target="#rejectModal"
                                    data-id="@item.Id" data-title="@item.Title"
                                    title="Reddet">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    }
                    else if (item.Status == 2)
                    {
                        <div class="d-flex gap-2 mt-3 pt-3 border-top">
                            <a asp-controller="CategoryLibraryItem" asp-action="Create"
                               asp-route-suggestedTitle="@item.Title"
                               class="btn btn-sm btn-outline-primary flex-grow-1">
                                <i class="fas fa-plus me-1"></i>Kategori Oluştur
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="horizon-card py-2">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <small class="text-secondary">
                            Sayfa <strong>@currentPage</strong> / <strong>@totalPages</strong>
                            &nbsp;·&nbsp; Toplam <strong>@Model.Count</strong> öneri
                        </small>
                        <tummenu-pagination index="@Model.Index"
                                            pages="@Model.Pages"
                                            has-previous="@Model.HasPrevious"
                                            has-next="@Model.HasNext"
                                            route-status="@statusFilter?.ToString()"
                                            route-pageSize="@pageSize.ToString()"
                                            container-class=""
                                            list-class="pagination pagination-sm mb-0 gap-1"
                                            previous-text="Önceki"
                                            next-text="Sonraki" />
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="horizon-card text-center py-5">
                <span class="fa-stack fa-3x mb-3">
                    <i class="fas fa-circle fa-stack-2x text-warning opacity-10"></i>
                    <i class="fas fa-lightbulb fa-stack-1x text-warning opacity-50"></i>
                </span>
                <h5 class="fw-bold mb-2">Henüz öneri yok</h5>
                <p class="text-secondary small mb-0">Müşterileriniz öneri gönderdiğinde burada görünecek.</p>
            </div>
        </div>
    </div>
}

<!-- Reddet Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-times-circle text-danger me-2"></i>Öneriyi Reddet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="rejectForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="text-secondary small mb-3">
                        <strong id="rejectTitle" class="text-dark"></strong> önerisi reddedilecek.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Red Notu <span class="fw-normal text-muted">(opsiyonel)</span></label>
                        <textarea name="adminNote" class="form-control" rows="3" placeholder="Neden reddedildi?"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-arrow-left me-1"></i>Vazgeç
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Reddet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rejectModal = document.getElementById('rejectModal');
        rejectModal.addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            const id = btn.getAttribute('data-id');
            const title = btn.getAttribute('data-title');
            document.getElementById('rejectTitle').textContent = title;
            document.getElementById('rejectForm').action = `/admin/CategorySuggestion/reject/${id}`;
        });
    </script>
}
