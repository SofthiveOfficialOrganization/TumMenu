@using Application.CategorySuggestions.Commands
@model SubmitCategorySuggestionCommand

@{
    ViewData["Title"] = "Kategori Öner";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="horizon-card">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-3 d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning"
                     style="width:48px;height:48px;font-size:20px;flex-shrink:0;">
                    <i class="fas fa-lightbulb"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">Kategori Öner</h4>
                    <p class="text-secondary small mb-0">Kütüphaneye eklensin istediğiniz kategori adını gönderin.</p>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                </div>
            }

            <form asp-action="Submit" method="post">
                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold text-secondary small text-uppercase">
                        <i class="fas fa-tag me-1 opacity-50"></i>Kategori Adı <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Title" class="form-control" placeholder="Örn. Kahvaltılıklar" autofocus />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Reason" class="form-label fw-bold text-secondary small text-uppercase">
                        <i class="fas fa-comment-alt me-1 opacity-50"></i>Öneri Sebebi
                        <span class="fw-normal text-muted">(opsiyonel)</span>
                    </label>
                    <textarea asp-for="Reason" class="form-control" rows="3"
                              placeholder="Bu kategoriyi neden eklememizi öneriyorsunuz?"></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                    <div class="form-text">Kısa bir açıklama yeterli.</div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" data-tummenu-back data-fallback-url="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Geri Dön
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-paper-plane me-2"></i>Öneriyi Gönder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
