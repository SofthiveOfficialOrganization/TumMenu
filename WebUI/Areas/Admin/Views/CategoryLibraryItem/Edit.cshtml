@using Application.Categories.Commands
@model UpdateCategoryLibraryItemCommand

@{
    ViewData["Title"] = "Kategoriyi Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <h4 class="fw-bold mb-4">Kategoriyi Düzenle</h4>
            
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                         <label asp-for="Title" class="form-label text-secondary small text-uppercase fw-bold">Başlık</label>
                         <input asp-for="Title" class="form-control" placeholder="Kategori Başlığı" />
                         <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                     <div class="col-md-6 mb-3">
                         <label asp-for="Slug" class="form-label text-secondary small text-uppercase fw-bold">Slug</label>
                         <input asp-for="Slug" class="form-control" placeholder="kategori-slug" />
                         <span asp-validation-for="Slug" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-secondary small text-uppercase fw-bold">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Açıklama..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="IconKey" class="form-label text-secondary small text-uppercase fw-bold">İkon Anahtarı</label>
                    <input asp-for="IconKey" class="form-control" placeholder="örn. fa-solid fa-utensils" />
                    <span asp-validation-for="IconKey" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>İptal
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
