@using Application.Categories.Commands
@using Application.Categories.DTOs
@model CategoryLibraryItemDTO

@{
    ViewData["Title"] = "Edit Category";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <h4 class="fw-bold mb-4">Edit Category</h4>
            
            <!-- Note: The controller action for Edit[POST] expects UpdateCategoryCommand, but Edit[GET] returns CategoryDTO.
                 Ideally, we should map DTO to Command in view or have the View accept Command.
                 For now, I'll bind the form fields to match the Command properties manually or rely on Model Binding overlap.
                 UpdateCategoryCommand has properties: Id, Name, Description, SortOrder, Slug.
                 CategoryDTO has: Id, Name, Description, SortOrder, Slug (and MenuId).
                 The binding should work fine.
            -->
            
            <form asp-action="Edit" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                         <label for="Title" class="form-label text-secondary small text-uppercase fw-bold">Title</label>
                         <input name="Title" class="form-control" value="@Model.Title" placeholder="Category Title" />
                    </div>
                     <div class="col-md-6 mb-3">
                         <label for="Slug" class="form-label text-secondary small text-uppercase fw-bold">Slug</label>
                         <input name="Slug" class="form-control" value="@Model.Slug" placeholder="custom-slug" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="Description" class="form-label text-secondary small text-uppercase fw-bold">Description</label>
                    <textarea name="Description" class="form-control" rows="3" placeholder="Description...">@Model.Description</textarea>
                </div>

                <div class="mb-4">
                    <label for="IconKey" class="form-label text-secondary small text-uppercase fw-bold">Icon Key</label>
                    <input name="IconKey" class="form-control" value="@Model.IconKey" placeholder="e.g. fa-solid fa-utensils" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light text-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
