@using Application.Categories.DTOs
@model CategoryLibraryItemDTO

@{
    ViewData["Title"] = "Category Details";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-start mb-4">
                 <div>
                    <h5 class="fw-bold mb-1">Category Details</h5>
                    <p class="text-secondary small">@Model.Slug</p>
                </div>
                <div class="horizon-avatar bg-light text-warning">
                    <i class="fas fa-tags"></i>
                </div>
            </div>

            <div class="mb-3">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Name</label>
                <p class="fw-bold text-dark fs-5">@Model.Title</p>
            </div>

            <div class="mb-3">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Slug</label>
                <p class="text-dark">@Model.Slug</p>
            </div>

            <div class="mb-3">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Description</label>
                <p class="text-dark">@(!string.IsNullOrEmpty(Model.Description) ? Model.Description : "No description")</p>
            </div>
            
             <div class="mb-3">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Icon Key</label>
                <p class="text-dark">@(!string.IsNullOrEmpty(Model.IconKey) ? Model.IconKey : "No icon")</p>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-4">
                <a asp-action="Index" class="btn btn-light text-secondary">Back to List</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fas fa-edit me-2"></i> Edit Category
                </a>
            </div>
        </div>
    </div>
</div>
