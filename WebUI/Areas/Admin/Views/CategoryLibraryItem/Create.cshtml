@using Application.Categories.Commands
@model CreateCategoryLibraryItemCommand

@{
    ViewData["Title"] = "Kategori Oluştur";
    var menuId = Context.Request.Query["menuId"];
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <h4 class="fw-bold mb-4">Kategori Oluştur</h4>
            
            <form asp-action="Create" method="post">
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                         <label asp-for="Title" class="form-label text-secondary small text-uppercase fw-bold">İsim</label>
                         <input asp-for="Title" class="form-control" placeholder="Kategori Adı" />
                         <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                     <div class="col-md-6 mb-3">
                         <label asp-for="Slug" class="form-label text-secondary small text-uppercase fw-bold">Slug (İsteğe Bağlı)</label>
                         <input asp-for="Slug" class="form-control" placeholder="ozel-slug" />
                         <span asp-validation-for="Slug" class="text-danger small"></span>
                         <div class="form-text">İsimden otomatik oluşturulması için boş bırakın.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-secondary small text-uppercase fw-bold">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Kategori açıklaması..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>İptal
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-plus me-2"></i>Kategori Oluştur
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
