@using Application.Categories.Commands
@model CreateCategoryLibraryItemCommand

@{
    ViewData["Title"] = "Kategori Oluştur";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="horizon-card">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success"
                     style="width:48px; height:48px; font-size:20px; flex-shrink:0;">
                    <i class="fas fa-plus"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">Yeni Kategori Oluştur</h4>
                    <p class="text-secondary small mb-0">Kütüphaneye yeni bir kategori tanımı ekleyin.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <form asp-action="Create" method="post">
                @if (ViewBag.SuggestionId != null)
                {
                    <input type="hidden" name="suggestionId" value="@ViewBag.SuggestionId" />
                }

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label text-secondary small text-uppercase fw-bold">
                            <i class="fas fa-tag me-1 opacity-50"></i>Başlık <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" placeholder="Örn. İçecekler" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Slug" class="form-label text-secondary small text-uppercase fw-bold">
                            <i class="fas fa-link me-1 opacity-50"></i>Slug
                        </label>
                        <input asp-for="Slug" class="form-control font-monospace" placeholder="iceçekler" />
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                        <div class="form-text"><i class="fas fa-info-circle me-1 opacity-50"></i>Boş bırakırsanız başlıktan otomatik oluşturulur.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-secondary small text-uppercase fw-bold">
                        <i class="fas fa-align-left me-1 opacity-50"></i>Açıklama
                    </label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Kategori hakkında kısa bir açıklama..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ParentId" class="form-label text-secondary small text-uppercase fw-bold">
                        <i class="fas fa-level-up-alt fa-rotate-90 me-1 opacity-50"></i>Üst Kategori Şablonu (Opsiyonel)
                    </label>
                    <select asp-for="ParentId" class="form-select" id="parentCategoryLibrarySelect">
                        @if (Model.ParentId.HasValue && !string.IsNullOrEmpty((string?)ViewBag.ParentName))
                        {
                            <option value="@Model.ParentId" selected="selected">@ViewBag.ParentName</option>
                        }
                    </select>
                    <span asp-validation-for="ParentId" class="text-danger small"></span>
                    <div class="form-text small"><i class="fas fa-info-circle me-1 opacity-50"></i>Bu şablonu bir başka şablonun altına (altategori okarak) eklemek isterseniz seçin.</div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-secondary small text-uppercase fw-bold">
                        <i class="fas fa-icons me-1 opacity-50"></i>İkon Önizleme
                    </label>
                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 border">
                        <div id="iconPreview" class="rounded-3 d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary"
                             style="width:52px; height:52px; font-size:22px; flex-shrink:0; transition: all 0.2s;">
                            <i class="fas fa-tag opacity-25"></i>
                        </div>
                        <div class="flex-grow-1">
                            <input id="iconKeyInput" class="form-control font-monospace" placeholder="fas fa-utensils" />
                            <div class="form-text">Font Awesome ikon sınıfı. Örn: <code>fas fa-utensils</code></div>
                        </div>
                    </div>
                    <input asp-for="IconKey" type="hidden" id="iconKeyHidden" />
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>İptal
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-check me-2"></i>Kategori Oluştur
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const input = document.getElementById('iconKeyInput');
            const hidden = document.getElementById('iconKeyHidden');
            const preview = document.getElementById('iconPreview');

            function updatePreview() {
                const val = input.value.trim();
                hidden.value = val;
                if (val) {
                    preview.innerHTML = `<i class="${val}"></i>`;
                } else {
                    preview.innerHTML = `<i class="fas fa-tag opacity-25"></i>`;
                }
            }

            // init with existing hidden value if any
            if (hidden.value) {
                input.value = hidden.value;
                updatePreview();
            }

            input.addEventListener('input', updatePreview);

            const parentCategoryAjaxUrl = '@Url.Action("GetCategoryLibraryItems", "Category", new { area = "Admin" })';
            $('#parentCategoryLibrarySelect').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: '-- Üst Kategori Şablonu Yok --',
                allowClear: true,
                ajax: {
                    url: parentCategoryAjaxUrl,
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            search: params.term || '',
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.results,
                            pagination: {
                                more: data.pagination.more
                            }
                        };
                    },
                    cache: true
                },
                language: {
                    inputTooShort: function () { return ''; },
                    noResults: function () { return 'Sonuç bulunamadı'; },
                    searching: function () { return 'Aranıyor...'; },
                    loadingMore: function () { return 'Daha fazla yükleniyor...'; }
                }
            });
        })();
    </script>
}
