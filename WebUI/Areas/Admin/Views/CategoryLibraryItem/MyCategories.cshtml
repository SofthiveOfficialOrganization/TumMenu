@using Application.Common.Base.DTOs
@using Application.Categories.DTOs
@model PaginatedListDTO<CategoryLibraryItemDTO>

@{
    ViewData["Title"] = "Kategorilerim";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1">Kategorilerim</h4>
                    <p class="text-secondary small mb-0">Tüm menülerdeki kategorilerinizi yönetin.</p>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">Başlık</th>
                            <th>Slug</th>
                            <th>Açıklama</th>
                            <th class="text-end pe-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-warning me-3">
                                                <i class="fas fa-tags"></i>
                                            </div>
                                            <span class="fw-bold text-dark">@item.Title</span>
                                        </div>
                                    </td>
                                    <td class="text-secondary small">@item.Slug</td>
                                    <td class="text-secondary small text-truncate" style="max-width: 200px;">@item.Description</td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-slug="@item.Slug" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-sm btn-outline-secondary me-2" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        
                                         <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" id="deleteForm-@item.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Sil" onclick="TumMenuAlerts.confirm('Bu kategoriyi silmek istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Sil!').then(res => { if(res) document.getElementById('deleteForm-@item.Id').submit(); })">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-50"></i>
                                    Kategori bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
             <!-- Pagination -->
            @if (Model != null && Model.Pages > 1)
            {
               <div class="d-flex justify-content-center mt-4">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-Index="@(Model.Index - 1)">Önceki</a>
                            </li>
                             @for (int i = 1; i <= Model.Pages; i++)
                            {
                                <li class="page-item @(Model.Index == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-Index="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-Index="@(Model.Index + 1)">Sonraki</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

