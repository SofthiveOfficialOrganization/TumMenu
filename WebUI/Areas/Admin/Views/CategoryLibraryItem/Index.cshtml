@using Application.Categories.DTOs
@using Application.Common.Base.Page
@model IPaginate<CategoryLibraryItemDTO>

@{
    ViewData["Title"] = "Kategori Kütüphanesi";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="horizon-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h4 class="fw-bold mb-1">
                        <i class="fas fa-layer-group text-primary me-2"></i>Kategori Kütüphanesi
                    </h4>
                    <p class="text-secondary small mb-0">Merkezi kategori tanımlamalarını yönetin ve düzenleyin.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 fw-semibold">
                        @(Model?.Count ?? 0) Kategori
                    </span>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Yeni Kategori
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model != null && Model.Items.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-3">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="horizon-card h-100 category-lib-card" style="transition: transform 0.18s, box-shadow 0.18s; cursor:default;">
                    <div class="d-flex align-items-start gap-3">
                        <div class="category-icon-badge flex-shrink-0 bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center"
                             style="width:52px; height:52px; font-size:22px;">
                            @if (!string.IsNullOrEmpty(item.IconKey))
                            {
                                <i class="@item.IconKey"></i>
                            }
                            else
                            {
                                <span class="fw-bold fs-5">@item.Title.Substring(0, 1).ToUpper()</span>
                            }
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <h6 class="fw-bold text-dark mb-1 text-truncate">@item.Title</h6>
                            <span class="badge bg-light text-secondary border font-monospace small fw-normal">@item.Slug</span>
                            @if (!string.IsNullOrEmpty(item.IconKey))
                            {
                                <div class="mt-1">
                                    <small class="text-muted font-monospace"><i class="fas fa-icons me-1 opacity-50"></i>@item.IconKey</small>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="text-secondary small mb-0 mt-2 text-truncate" title="@item.Description">@item.Description</p>
                            }
                            else
                            {
                                <p class="text-muted small mb-0 mt-2 fst-italic">Açıklama yok</p>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top text-nowrap">
                        <a asp-action="Details" asp-route-slug="@item.Slug" class="btn btn-sm btn-light text-info" title="Detaylar ve Fotoğraflar">
                            <i class="fas fa-images"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary" title="Düzenle">
                            <i class="fas fa-pencil-alt"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" id="deleteForm-@item.Id">
                            <button type="button" class="btn btn-sm btn-light text-danger" title="Sil"
                                    onclick="TumMenuAlerts.confirm('Bu kategoriyi silmek istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Sil!').then(res => { if(res) document.getElementById('deleteForm-@item.Id').submit(); })">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <tummenu-pagination index="@Model.Index"
                        pages="@Model.Pages"
                        has-previous="@Model.HasPrevious"
                        has-next="@Model.HasNext"
                        container-class="d-flex justify-content-center mt-2" />
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="horizon-card text-center py-5">
                <div class="mb-4">
                    <span class="fa-stack fa-3x">
                        <i class="fas fa-circle fa-stack-2x text-primary opacity-10"></i>
                        <i class="fas fa-layer-group fa-stack-1x text-primary opacity-50"></i>
                    </span>
                </div>
                <h5 class="fw-bold mb-2">Henüz kategori oluşturulmadı</h5>
                <p class="text-secondary small mb-4">Kütüphanenize ilk kategoriyi ekleyerek başlayın.</p>
                <a asp-action="Create" class="btn btn-primary px-4">
                    <i class="fas fa-plus me-2"></i>Kategori Oluştur
                </a>
            </div>
        </div>
    </div>
}

<style>
    .category-lib-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(79, 70, 229, 0.12) !important;
    }
</style>
