@using Application.Categories.DTOs
@using Application.Categories.DTOs
@using Application.Common.Base.Page
@model IPaginate<CategoryLibraryItemDTO>

@{
    ViewData["Title"] = "Category Library";
}

<div class="row mb-4">
    <div class="col-md-6">
        <h2 class="fw-bold">Category Library</h2>
        <p class="text-secondary">Manage your central category definitions.</p>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus me-2"></i>New Category
        </a>
    </div>
</div>

<div class="horizon-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Title</th>
                    <th>Slug</th>
                    <th>Description</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold">@item.Title</div>
                            @if(!string.IsNullOrEmpty(item.IconKey))
                            {
                                <div class="small text-muted"><i class="@item.IconKey me-1"></i> @item.IconKey</div>
                            }
                        </td>
                        <td>@item.Slug</td>
                        <td class="text-truncate" style="max-width: 300px;">@item.Description</td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <!-- Add Pagination Here if needed -->
    @if (Model.Pages > 1)
    {
        <div class="p-3 border-top">
            <!-- Pagination Partial or Code -->
            <nav>
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-route-Page="@(Model.Index - 1)">Previous</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">@(Model.Index + 1) / @Model.Pages</span>
                    </li>
                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-route-Page="@(Model.Index + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
