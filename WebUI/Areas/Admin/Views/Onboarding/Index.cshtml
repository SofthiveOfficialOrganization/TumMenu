@model Application.Companies.Commands.CreateCompanyCommand

@{
    ViewData["Title"] = "Hoşgeldiniz - Kurulum Sihirbazı";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; 
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" 
          crossorigin=""/>
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl/dist/maplibre-gl.css" />
    <style>
        #map { height: 350px; border-radius: 0.8rem; border: 1px solid #dee2e6; z-index: 1; }
        .map-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 350px;
            background: rgba(255,255,255,0.8);
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.8rem;
            backdrop-filter: blur(2px);
            font-weight: 600;
            color: #6c757d;
        }
    </style>
}

<div class="container-fluid p-0 overflow-hidden position-relative">

    <div class="row min-vh-100 align-items-center justify-content-center bg-light mx-0">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <div class="card shadow-xl border-0 overflow-hidden rounded-4">
                <div class="card-body p-0 position-relative">
                    <div class="onboarding-progress-bar" id="progressBar"></div>
                    <div id="onboarding-wizard" class="onboarding-wizard">
                        
                        <!-- Step 1: Create Company -->
                        <div class="wizard-step w-100 p-4 p-md-5 fade-in-up" id="step-company">
                            <div class="text-center mb-5">
                                <div class="mb-4">
                                    <i class="fas fa-building fa-4x text-primary animate-bounce"></i>
                                </div>
                                <h2 class="fs-2 fs-md-1 fw-bold text-primary mb-2 mb-md-3">Hoşgeldiniz!</h2>
                                <p class="fs-6 fs-md-5 text-muted px-2 px-md-0">Hemen başlayalım. Şirketinizin adı nedir?</p>
                            </div>
                            <form id="form-company" class="onboarding-form">
                                <div class="mb-4">
                                    <label for="CompanyTitle" class="form-label h4 text-body">Şirket Adı</label>
                                    <input type="text" class="form-control form-control-xl shadow-sm" id="CompanyTitle" name="Title" required placeholder="Örn: Güzel Yemekler A.Ş.">
                                </div>
                                
                                <div class="mb-5">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                                        <label for="CompanySlug" class="form-label h6 text-muted mb-0">Şirket Linki (Opsiyonel)</label>
                                        <div class="form-check form-switch mb-0 d-flex align-items-center">
                                            <input class="form-check-input scale-110 cursor-pointer" type="checkbox" id="CompanySlugToggle">
                                            <label class="form-check-label ms-2 small text-secondary cursor-pointer" for="CompanySlugToggle">El ile düzenle</label>
                                        </div>
                                    </div>
                                    <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden border">
                                        <span class="input-group-text bg-light border-0 text-muted d-none d-sm-flex px-3 rounded-start">tummenu.com/</span>
                                        <span class="input-group-text bg-light border-0 text-muted d-flex d-sm-none px-3 rounded-start"><i class="fas fa-link"></i></span>
                                        <input type="text" class="form-control border-0 bg-white min-h-52" id="CompanySlug" name="Slug" placeholder="guzel-yemekler" readonly>
                                        <span class="input-group-text border-0 bg-white px-3 rounded-end" id="CompanySlugStatus">
                                            <i class="fas fa-lock text-secondary opacity-50" id="CompanySlugIcon"></i>
                                        </span>
                                    </div>
                                    <div id="CompanySlugFeedback" class="mt-2 fw-bold form-feedback"></div>
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary btn-xl shadow-lg hover-scale">
                                        Şirketi Oluştur ve Devam Et <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Step 2: Create Store -->
                        <div class="wizard-step w-100 p-4 p-md-5 fade-in-up" id="step-store">
                            <div class="text-center mb-5">
                                <div class="mb-4">
                                    <i class="fas fa-store-alt fa-4x text-success animate-pulse"></i>
                                </div>
                                <h2 class="fs-2 fs-md-1 fw-bold text-success mb-2 mb-md-3">Harika Gidiyoruz!</h2>
                                <p class="fs-6 fs-md-5 text-muted px-2 px-md-0">Şimdi ilk şubemizi ekleyelim. Müşteriler buraya gelecek!</p>
                            </div>
                            <form id="form-store" class="onboarding-form">
                                <input type="hidden" id="StoreCompanyId" name="CompanyId">
                                <div class="mb-4">
                                    <label for="StoreTitle" class="form-label h4 text-body">Şube Adı</label>
                                    <input type="text" class="form-control form-control-xl shadow-sm" id="StoreTitle" name="Title" required placeholder="Örn: Merkez Şube">
                                </div>
                                <div class="mb-4">
                                    <label for="StorePhone" class="form-label h4 text-body">Telefon Numarası</label>
                                    <input type="tel" class="form-control form-control-xl shadow-sm" id="StorePhone" name="PhoneNumber" required placeholder="0555 555 55 55">
                                </div>
                                 <div class="mb-5">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                                        <label for="StoreSlug" class="form-label h6 text-muted mb-0">Şube Linki (Opsiyonel)</label>
                                        <div class="form-check form-switch mb-0 d-flex align-items-center">
                                            <input class="form-check-input scale-110 cursor-pointer" type="checkbox" id="StoreSlugToggle">
                                            <label class="form-check-label ms-2 small text-secondary cursor-pointer" for="StoreSlugToggle">El ile düzenle</label>
                                        </div>
                                    </div>
                                    <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden border">
                                        <span class="input-group-text bg-light border-0 text-muted d-none d-sm-flex px-3 rounded-start">tummenu.com/sirket/</span>
                                        <span class="input-group-text bg-light border-0 text-muted d-flex d-sm-none px-3 rounded-start"><i class="fas fa-link"></i></span>
                                        <input type="text" class="form-control border-0 bg-white min-h-52" id="StoreSlug" name="Slug" placeholder="merkez-sube" readonly>
                                        <span class="input-group-text border-0 bg-white px-3 rounded-end" id="StoreSlugStatus">
                                            <i class="fas fa-lock text-secondary opacity-50" id="StoreSlugIcon"></i>
                                        </span>
                                    </div>
                                    <div id="StoreSlugFeedback" class="mt-2 fw-bold form-feedback"></div>
                                </div>

                                <div class="mb-4">
                                    <h5 class="fw-bold text-secondary text-uppercase small mb-3 border-bottom pb-2">
                                        <i class="fas fa-map-marker-alt me-2"></i> Adres Bilgileri
                                    </h5>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label for="citySelect" class="form-label small fw-bold">İl</label>
                                            <select class="form-select form-select-lg shadow-sm" id="citySelect" name="Address.CityId" required>
                                                <option value="">İl Seçiniz</option>
                                            </select>
                                            <input type="hidden" name="Address.CityName" id="cityNameInput">
                                        </div>
                                        <div class="col-md-6">
                                            <label for="districtSelect" class="form-label small fw-bold">İlçe</label>
                                            <select class="form-select form-select-lg shadow-sm" id="districtSelect" name="Address.DistrictId" disabled required>
                                                <option value="">Önce İl Seçiniz</option>
                                            </select>
                                            <input type="hidden" name="Address.DistrictName" id="districtNameInput">
                                        </div>
                                        <div class="col-12">
                                            <label for="FullAddress" class="form-label small fw-bold">Açık Adres</label>
                                            <textarea class="form-control shadow-sm" id="FullAddress" name="Address.FullAddress" rows="2" placeholder="Sokak, No, Kat..." required></textarea>
                                        </div>
                                        
                                        <div class="col-12 mt-4">
                                            <h6 class="fw-bold text-secondary small text-uppercase mb-2">Konum Belirle</h6>
                                            <div class="position-relative">
                                                <div id="mapOverlay" class="map-overlay">
                                                    <span><i class="fas fa-map-marker-alt me-2"></i>Haritayı görmek için lütfen İl/İlçe seçiniz</span>
                                                </div>
                                                <div id="map"></div>
                                                <input type="hidden" name="Address.Latitude" id="cityLatInput">
                                                <input type="hidden" name="Address.Longitude" id="cityLngInput">
                                                
                                                <div class="map-buttons-container">
                                                    <button id="centerMapBtn" type="button" class="map-button-bs">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                                            <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/>
                                                        </svg>
                                                        <span>Buraya Odakla</span>
                                                    </button>
                                                    <button id="useMyLocationBtn" type="button" class="map-button-bs">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                                            <circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4m10-10h-4M6 12H2"/>
                                                        </svg>
                                                        <span>Konumumu Kullan</span>
                                                    </button>
                                                </div>
                                            </div>
                                            <p class="text-muted small mt-2"><i class="fas fa-info-circle me-1"></i>İmleci sürükleyerek dükkanınızın tam konumunu işaretleyebilirsiniz.</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-success btn-xl shadow-lg hover-scale">
                                        Şubeyi Kaydet ve Devam Et <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Step 3: Create Main Menu -->
                        <div class="wizard-step w-100 p-4 p-md-5 fade-in-up" id="step-menu">
                            <div class="text-center mb-5">
                                <div class="mb-4">
                                    <i class="fas fa-utensils fa-4x text-info animate-shake"></i>
                                </div>
                                <h2 class="fs-2 fs-md-1 fw-bold text-info mb-2 mb-md-3">Ana Menünüzü Oluşturun</h2>
                                <p class="fs-6 fs-md-5 text-muted px-2 px-md-0">Bu menüyü ileride tüm dükkanlarınızda kullanabilirsiniz.</p>
                            </div>
                            <form id="form-menu" class="onboarding-form">
                                <input type="hidden" id="MenuCompanyId" name="CompanyId">
                                <input type="hidden" id="MenuStoreId" name="StoreId">
                                <div class="mb-5">
                                    <label for="MenuTitle" class="form-label h4 text-body">Menü Adı</label>
                                    <input type="text" class="form-control form-control-xl shadow-sm" id="MenuTitle" name="Title" required placeholder="Örn: Ana Menü">
                                </div>
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-info btn-xl text-white shadow-lg hover-scale">
                                        Kategori Ekle <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Step 4: Select Categories -->
                        <div class="wizard-step w-100 p-4 p-md-5 fade-in-up" id="step-category">
                            <input type="hidden" id="CategoryMenuId" name="MenuId">
                            <div class="text-center mb-4">
                                <i class="fas fa-tags fa-4x text-warning animate-bounce mb-3"></i>
                                <h2 class="fs-2 fs-md-1 fw-bold text-warning mb-1 mb-md-2">İlk Kategorilerin!</h2>
                                <p class="fs-6 fs-md-5 text-muted px-2 px-md-0">Kütüphaneden kategorileri seç ve menüne ekle. Dilediğin zaman tamamla.</p>
                            </div>

                            <div class="row g-3 category-container">
                                <!-- Left: Library Search -->
                                <div class="col-12 col-md-6">
                                    <div class="border rounded-3 h-100 p-3 bg-transparent shadow-sm d-flex flex-column">
                                        <h5 class="fw-bold text-muted text-uppercase mb-3">
                                            <i class="fas fa-book-open me-2"></i> Kategori Bul
                                        </h5>
                                        <input type="text" id="categorySearch" class="form-control form-control-lg mb-3 search-input-lg" placeholder="Ara...">
                                        <div id="categoryLibraryList" class="flex-grow-1 overflow-auto category-list">
                                            <div class="text-center text-muted py-5" id="libraryPlaceholder">
                                                <i class="fas fa-search fa-2x d-block mb-3 opacity-50"></i>
                                                <span class="fs-6">Aramak için yazmaya başlayın</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right: Added Categories (Sortable 2-col grid) -->
                                <div class="col-12 col-md-6">
                                    <div class="border rounded-3 h-100 p-3 bg-transparent shadow-sm d-flex flex-column">
                                        <h5 class="fw-bold text-muted text-uppercase mb-3">
                                            <i class="fas fa-list me-2"></i> Menüm
                                        </h5>
                                        <div id="addedCategoryList" class="flex-grow-1 overflow-auto row g-2 align-content-start category-list-added">
                                            <div class="col-12 text-center text-muted py-5" id="addedPlaceholder">
                                                <i class="fas fa-inbox fa-2x d-block mb-3 opacity-50"></i>
                                                <span class="fs-6">Henüz kategori eklenmedi</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="button" id="btnCompleteOnboarding" class="btn btn-warning text-dark shadow-lg hover-scale py-4 fs-4 fw-bold">
                                    Kurulumu Tamamla <i class="fas fa-check-circle ms-2"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Disable global scrolling for the wizard page layout specifically if needed */
    /* .content-wrapper { overflow: hidden; } */ 
    
    .form-control-xl {
        font-size: 1.15rem;
        padding: 0.75rem 1rem;
        border-radius: 0.8rem;
    }
    @@media (min-width: 768px) {
        .form-control-xl {
            font-size: 1.25rem;
            padding: 0.85rem 1.25rem;
        }
    }
    
    .btn-xl {
        font-size: 1.15rem;
        padding: 0.9rem 1.6rem;
        border-radius: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .scale-125 { transform: scale(1.25); }
    .scale-150 { transform: scale(1.5); }

    .hover-scale {
        transition: transform 0.2s;
    }
    .hover-scale:hover {
        transform: translateY(-3px);
    }

    .fade-in-up {
        animation: fadeInUp 0.6s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        opacity: 0;
        transform: translateY(30px);
    }

    @@keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-select-lg {
        padding-top: 0.7rem;
        padding-bottom: 0.7rem;
        font-size: 1.1rem;
        border-radius: 0.8rem;
    }

    .card {
        border-radius: 1.25rem !important;
    }

    .wizard-step {
        transition: opacity 0.4s ease;
        width: 25% !important;
        flex-shrink: 0;
        padding: 2.5rem 1rem !important;
    }
    @@media (min-width: 768px) {
        .wizard-step {
            padding: 4rem 3rem !important;
        }
    }

    .wizard-step:not(.active) {
        /* opacity: 0.5; */
    }

    .animate-bounce {
        animation: bounce 2s infinite;
    }

    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {transform: translateY(0);}
        40% {transform: translateY(-20px);}
        60% {transform: translateY(-10px);}
    }

    .animate-pulse {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {transform: scale(1);}
        50% {transform: scale(1.1);}
        100% {transform: scale(1);}
    }

    .animate-shake {
        animation: shake 3s infinite;
    }

    @@keyframes shake {
        0%, 100% {transform: rotate(0deg);}
        10%, 30%, 50%, 70%, 90% {transform: rotate(-10deg);}
        20%, 40%, 60%, 80% {transform: rotate(10deg);}
    }
</style>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" 
            crossorigin=""></script>
    <script src="https://unpkg.com/maplibre-gl/dist/maplibre-gl.js"></script>
    <script src="https://unpkg.com/@@maplibre/maplibre-gl-leaflet/leaflet-maplibre-gl.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="~/js/map-base-layer.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {

            let currentStep = @(ViewBag.InitialStep ?? 0);
            const wizard = $('#onboarding-wizard');

            // Pre-fill hidden fields if resuming
            const existingCompanyId = '@ViewBag.CompanyId';
            if (existingCompanyId) {
                $('#StoreCompanyId').val(existingCompanyId);
                $('#MenuCompanyId').val(existingCompanyId);
            }

            const existingStoreId = '@ViewBag.StoreId';
            if (existingStoreId) {
                $('#MenuStoreId').val(existingStoreId);
            }

            const existingMenuId = '@ViewBag.MenuId';
            if (existingMenuId) {
                $('#CategoryMenuId').val(existingMenuId);
            }

            // Immediately show correct step
            if (currentStep > 0) {
                 wizard.css('transform', `translateX(-${currentStep * 25}%)`);
            }
            // If resuming directly on step 4, init the category step
            if (currentStep === 3) {
                setTimeout(() => initCategoryStep(), 300);
            }
            
            // --- Shared Slug Logic ---
            function slugify(text) {
                const turkishMap = {
                    'ğ':'g','ü':'u','ş':'s','ı':'i','ö':'o','ç':'c',
                    'Ğ':'g','Ü':'u','Ş':'s','İ':'i','I':'i','Ö':'o','Ç':'c'
                };
                let result = text.trim().toLowerCase();
                result = result.split('').map(c => turkishMap[c] || c).join('');
                result = result.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                result = result.replace(/[^a-z0-9\s\-_]/g, '');
                result = result.replace(/[\s_]+/g, '-');
                result = result.replace(/-+/g, '-');
                result = result.replace(/^-|-$/g, '');
                if (result.length > 30) {
                    result = result.substring(0, 30).replace(/-$/, '');
                }
                return result;
            }

            function setupSlugHandling(prefix, checkUrl) {
                const titleInput = $('#' + prefix + 'Title');
                const slugInput = $('#' + prefix + 'Slug');
                const slugToggle = $('#' + prefix + 'SlugToggle');
                const slugIcon = $('#' + prefix + 'SlugIcon');
                const slugFeedback = $('#' + prefix + 'SlugFeedback');
                let debounceTimer = null;
                let isManual = false;

                function checkSlugAvailability(slug) {
                    if (!slug) {
                        slugFeedback.hide();
                        return;
                    }
                    $.get(checkUrl, { slug: slug }, function (data) {
                        console.log('Slug Check Response (' + prefix + '):', data); // Debugging
                        slugFeedback.show();
                        if (data.available) {
                            slugFeedback.html('<i class="fas fa-check-circle text-success me-1"></i> ' + data.message)
                                .removeClass('text-danger').addClass('text-success');
                            slugIcon.removeClass('fa-lock fa-times-circle text-danger text-secondary')
                                .addClass('fa-check-circle text-success');
                        } else {
                            slugFeedback.html('<i class="fas fa-times-circle text-danger me-1"></i> ' + data.message)
                                .removeClass('text-success').addClass('text-danger');
                            slugIcon.removeClass('fa-lock fa-check-circle text-success text-secondary')
                                .addClass('fa-times-circle text-danger');
                        }
                    });
                }

                function debouncedCheck(slug) {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(function () {
                        checkSlugAvailability(slug);
                    }, 500);
                }

                titleInput.on('input', function () {
                    if (!isManual) {
                        const slug = slugify($(this).val());
                        slugInput.val(slug);
                        debouncedCheck(slug);
                    }
                });

                slugToggle.on('change', function () {
                    isManual = $(this).is(':checked');
                    if (isManual) {
                        slugInput.prop('readonly', false).focus();
                        slugIcon.removeClass('fa-lock fa-check-circle fa-times-circle text-success text-danger text-secondary')
                            .addClass('fa-pencil-alt text-primary');
                    } else {
                        slugInput.prop('readonly', true);
                        const slug = slugify(titleInput.val());
                        slugInput.val(slug);
                        slugIcon.removeClass('fa-pencil-alt fa-check-circle fa-times-circle text-primary text-success text-danger')
                            .addClass('fa-lock text-secondary');
                        slugFeedback.hide();
                        if (slug) debouncedCheck(slug);
                    }
                });

                slugInput.on('input', function () {
                    if (isManual) {
                        let val = $(this).val().toLowerCase()
                            .replace(/[^a-z0-9\-]/g, '')
                            .replace(/-+/g, '-');
                        if (val.length > 30) val = val.substring(0, 30);
                        $(this).val(val);
                        debouncedCheck(val);
                    }
                });
            }

            setupSlugHandling('Company', '@Url.Action("CheckSlug", "Company", new { area = "Admin" })');
            setupSlugHandling('Store', '@Url.Action("CheckSlug", "Store", new { area = "Admin" })');

            // --- Address Handling for Store Step ---
            const cityInput = document.getElementById('citySelect');
            const districtSelect = $('#districtSelect');
            const citySelect = $('#citySelect'); // for select2
            
            // Re-initialize Select2
            citySelect.select2({ theme: 'bootstrap-5', width: '100%' });
            districtSelect.select2({ theme: 'bootstrap-5', width: '100%' });

            const cityNameInput = $('#cityNameInput');
            const districtNameInput = $('#districtNameInput');
            const latInput = $('#cityLatInput');
            const lngInput = $('#cityLngInput');

            let map = null;
            let marker = null;

            let state = {
                cityId: null,
                cityName: null,
                districtName: null
            };

            function initMap(lat, lng, zoom = 12) {
                if (!map) {
                    map = L.map('map').setView([lat, lng], zoom);
                    window.TumMenuMapBaseLayer.addTo(map);

                    marker = L.marker([lat, lng], { draggable: true }).addTo(map);

                    marker.on('dragend', function (e) {
                        const pos = marker.getLatLng();
                        latInput.val(pos.lat);
                        lngInput.val(pos.lng);
                    });

                    setTimeout(() => map.invalidateSize(), 300);
                } else {
                    map.setView([lat, lng], zoom);
                    marker.setLatLng([lat, lng]);
                    setTimeout(() => map.invalidateSize(), 300);
                }
                latInput.val(lat);
                lngInput.val(lng);
                $('#mapOverlay').hide();
            }

            function loadDistricts(cityId, targetDistrictName = null) {
                districtSelect.prop('disabled', true);
                fetch(`/api/location/districts/${cityId}`)
                    .then(res => res.json())
                    .then(data => {
                        districtSelect.prop('disabled', false).empty().append('<option value="">İlçe Seçiniz</option>');
                        data.forEach(d => {
                            var opt = $('<option>', { value: d.id, text: d.name });
                            if(targetDistrictName && d.name === targetDistrictName) {
                                opt.attr('selected', true);
                            }
                            districtSelect.append(opt);
                        });
                        districtSelect.trigger('change');
                    })
                    .catch(err => console.error('District load error:', err));
            }

            // Load Cities
            fetch('/api/location/provinces')
                .then(res => res.json())
                .then(data => {
                    data.forEach(p => {
                        var opt = document.createElement('option');
                        opt.value = p.id;
                        opt.textContent = p.name;
                        opt.dataset.name = p.name;
                        if(state.cityId === p.id || state.cityName === p.name) {
                            opt.selected = true;
                            state.cityId = p.id;
                            state.cityName = p.name;
                        }
                        cityInput.appendChild(opt);
                    });
                    citySelect.trigger('change');
                    if(state.cityId) {
                        loadDistricts(state.cityId, state.districtName);
                    }
                })
                .catch(err => console.error('City load error:', err));

            citySelect.on('change', function() {
                const cityId = $(this).val();
                const selectedOption = $(this).find('option:selected');
                const cityName = selectedOption.text();
                
                if (cityId) {
                    cityNameInput.val(cityName);
                    loadDistricts(cityId);

                    // Geocode city to center map
                    const url = `https://nominatim.openstreetmap.org/search?format=json&state=${encodeURIComponent(cityName)}&country=Türkiye&limit=1`;
                    fetch(url)
                        .then(res => res.json())
                        .then(data => {
                            if (data && data.length > 0) {
                                initMap(parseFloat(data[0].lat), parseFloat(data[0].lon), 10);
                            }
                        });
                } else {
                    cityNameInput.val('');
                    districtSelect.prop('disabled', true).empty().append('<option value="">Önce İl Seçiniz</option>');
                    districtSelect.trigger('change');
                    $('#mapOverlay').show();
                }
            });

            districtSelect.on('change', function() {
                const districtId = $(this).val();
                const selectedOption = $(this).find('option:selected');
                const districtName = selectedOption.text();
                const cityName = cityNameInput.val();

                if (districtId) {
                    districtNameInput.val(districtName);

                    // Geocode district to center map
                    let query = '';
                    if (districtName.toLowerCase() === 'merkez') {
                        query = `city=${encodeURIComponent(cityName)}&state=${encodeURIComponent(cityName)}`;
                    } else {
                        query = `county=${encodeURIComponent(districtName)}&state=${encodeURIComponent(cityName)}`;
                    }
                    
                    const url = `https://nominatim.openstreetmap.org/search?format=json&${query}&country=Türkiye&limit=1`;
                    fetch(url)
                        .then(res => res.json())
                        .then(data => {
                            if (data && data.length > 0) {
                                initMap(parseFloat(data[0].lat), parseFloat(data[0].lon), 13);
                            }
                        });
                } else {
                    districtNameInput.val('');
                }
            });

            const heightObserver = new ResizeObserver(entries => {
                for (let entry of entries) {
                    const stepIndex = $('.wizard-step').index(entry.target);
                    if (stepIndex === currentStep) {
                        // Add a small buffer to prevent pixel-perfect cutoffs
                        wizard.css('height', (entry.target.offsetHeight) + 'px');
                    }
                }
            });

            $('.wizard-step').each(function() {
                heightObserver.observe(this);
            });

            function updateWizardHeight() {
                const activeStep = $('.wizard-step').eq(currentStep);
                if (activeStep.length) {
                    wizard.css('height', activeStep.outerHeight() + 'px');
                }
            }

            // --- Helper to slide to next step ---
            function nextStep() {
                currentStep++;
                const progress = (currentStep / 3) * 100;
                $('.onboarding-progress-bar').css('width', progress + '%');
                
                wizard.css('transform', `translateX(-${currentStep * 25}%)`);
                updateWizardHeight();

                // Auto-init category step when reaching step 4
                if (currentStep === 3) {
                    setTimeout(() => initCategoryStep(), 300);
                }
            }
            
            // Initial progress & height
            $('.onboarding-progress-bar').css('width', (@(ViewBag.InitialStep ?? 0) / 3 * 100) + '%');
            setTimeout(updateWizardHeight, 500);
            $(window).on('resize', updateWizardHeight);
            
            // --- Helper for Error Handling ---
            function handleError(xhr, titleContext) {
                console.group(titleContext + ' Debug Info');
                console.log('Status:', xhr.status, xhr.statusText);
                console.log('Response JSON:', xhr.responseJSON);
                console.log('Response Text:', xhr.responseText);
                console.groupEnd();
                
                let errorMsg = 'Bilinmeyen bir hata oluştu.';
                let errorDetails = '';

                if (xhr.responseJSON) {
                    // Case 1: Standard ApiError with Message
                    if (xhr.responseJSON.Message) {
                        errorMsg = xhr.responseJSON.Message;
                    } 
                    else if (xhr.responseJSON.Title) {
                         // Case 2: Validation ProblemDetails (default ASP.NET)
                        errorMsg = xhr.responseJSON.Title;
                    }

                    // Case 3: Validation Errors Dictionary
                    if (xhr.responseJSON.Errors) {
                        const errors = xhr.responseJSON.Errors;
                        // Flatten errors
                        if (typeof errors === 'object') {
                            errorDetails = '<ul class="text-start mt-2 mb-0 list-unstyled">';
                            for (const key in errors) {
                                if (Array.isArray(errors[key])) {
                                    errors[key].forEach(m => errorDetails += `<li>• ${m}</li>`);
                                } else {
                                    errorDetails += `<li>• ${errors[key]}</li>`;
                                }
                            }
                            errorDetails += '</ul>';
                        }
                    }
                } else if (xhr.responseText) {
                    // Try to extract title if HTML
                    const match = xhr.responseText.match(/<title>(.*?)<\/title>/);
                    if (match && match[1]) {
                        errorMsg = 'Sunucu Hatası: ' + match[1];
                    }
                }

                // Use Toast as requested
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: errorMsg,
                    html: errorDetails,
                    showConfirmButton: false,
                    timer: 5000,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.addEventListener('mouseenter', Swal.stopTimer)
                        toast.addEventListener('mouseleave', Swal.resumeTimer)
                    }
                });
            }

            // --- Step 1: Create Company ---
            $('#form-company').on('submit', function(e) {
                e.preventDefault();
                // Basic validation: Check if slug has error
                if ($('#CompanySlugFeedback').hasClass('text-danger')) {
                     Swal.fire({ icon: 'warning', title: 'Hatalı Slug', text: 'Lütfen geçerli bir şirket linki (slug) giriniz.' });
                     return;
                }

                const btn = $(this).find('button[type="submit"]');
                const originalText = btn.html();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Kaydediliyor...');

                const formData = {
                    Title: $('#CompanyTitle').val(),
                    Slug: $('#CompanySlug').val()
                };

                $.ajax({
                    url: `/admin/Onboarding/company`,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    headers: { 
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        // Response should be CompanyDTO
                        $('#StoreCompanyId').val(response.id);
                        $('#MenuCompanyId').val(response.id);
                        btn.prop('disabled', false).html(originalText);
                        nextStep();
                    },
                    error: function(xhr) {
                        btn.prop('disabled', false).html(originalText);
                        handleError(xhr, 'Company Create');
                    }
                });
            });

            // --- Step 2: Create Store ---
            $('#form-store').on('submit', function(e) {
                e.preventDefault();
                if ($('#StoreSlugFeedback').hasClass('text-danger')) {
                     Swal.fire({ icon: 'warning', title: 'Hatalı Slug', text: 'Lütfen geçerli bir şube linki (slug) giriniz.' });
                     return;
                }

                const btn = $(this).find('button[type="submit"]');
                const originalText = btn.html();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Kaydediliyor...');

                const formData = {
                    CompanyId: $('#StoreCompanyId').val(),
                    Title: $('#StoreTitle').val(),
                    PhoneNumber: $('#StorePhone').val(),
                    Slug: $('#StoreSlug').val(),
                    Address: {
                        CityId: $('#citySelect').val(),
                        CityName: $('#cityNameInput').val(),
                        DistrictId: $('#districtSelect').val(),
                        DistrictName: $('#districtNameInput').val(),
                        FullAddress: $('#FullAddress').val(),
                        Latitude: parseFloat($('#cityLatInput').val()),
                        Longitude: parseFloat($('#cityLngInput').val())
                    }
                };

                $.ajax({
                    url: `/admin/Onboarding/store`,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    headers: { 
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        // Response should be StoreDTO — capture for menu step
                        $('#MenuStoreId').val(response.id);
                        btn.prop('disabled', false).html(originalText);
                        nextStep();
                    },
                    error: function(xhr) {
                        btn.prop('disabled', false).html(originalText);
                         handleError(xhr, 'Store Create');
                    }
                });
            });

            // --- Step 3: Create Menu ---
            $('#form-menu').on('submit', function(e) {
                e.preventDefault();
                const btn = $(this).find('button[type="submit"]');
                const originalText = btn.html();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Kaydediliyor...');

                const formData = {
                    CompanyId: $('#MenuCompanyId').val(),
                    StoreId: $('#MenuStoreId').val() || null,
                    Title: $('#MenuTitle').val()
                };

                $.ajax({
                    url: `/admin/Onboarding/menu`,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    headers: { 
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        $('#CategoryMenuId').val(response.id);
                        btn.prop('disabled', false).html(originalText);
                        nextStep();
                    },
                    error: function(xhr) {
                        btn.prop('disabled', false).html(originalText);
                        handleError(xhr, 'Menu Create');
                    }
                });
            });

            // --- Step 4: Category Library Search + Add + Sort ---
            let categorySearchTimer = null;
            const categorySearchUrl  = `/admin/CategoryLibrary/Index`;
            const menuCategoriesUrl  = `/admin/Onboarding/menu-categories`;
            const addCategoryUrl     = `/admin/Onboarding/add-category`;
            const sortUrl            = `/admin/Category/UpdateSortOrder`;

            // Called on step 4 entry: load existing menu categories into right panel,
            // then load the library (which excludes already-added ones).
            function initCategoryStep() {
                const menuId = $('#CategoryMenuId').val();
                if (!menuId) { loadCategoryLibrary(''); return; }

                $.get(menuCategoriesUrl, { menuId: menuId }, function(existingItems) {
                    if (existingItems && existingItems.length > 0) {
                        $('#addedPlaceholder').hide();
                        existingItems.forEach(function(item) {
                            appendAddedCategoryCard(item.id, item.title);
                        });
                        if (existingItems.length >= 1) initAddedCategoriesSortable();
                    }
                }).always(function() {
                    loadCategoryLibrary('');
                });
            }

            // Load library on step 4 entry — called after menu step completes
            function loadCategoryLibrary(search) {
                const menuId = $('#CategoryMenuId').val();
                if (!menuId) return;

                $('#libraryPlaceholder').hide();
                $('#categoryLibraryList').html('<div class="text-center py-3"><span class="spinner-border spinner-border-sm text-warning"></span></div>');

                $.get(categorySearchUrl, { search: search || '', menuId: menuId }, function(items) {
                    $('#categoryLibraryList').empty();
                    if (!items || items.length === 0) {
                        $('#categoryLibraryList').html('<div class="text-center text-muted py-3 small">Sonuç bulunamadı.</div>');
                        return;
                    }
                    items.forEach(function(item) {
                        const row = $(`
                            <div class="d-flex align-items-center justify-content-between p-3 rounded mb-2 library-item border bg-white shadow-sm"
                                style="cursor: pointer; transition: all 0.2s ease;"
                                data-id="${item.id}" data-title="${item.title}">
                                <span class="text-body fw-semibold fs-6 pe-2">${item.title}</span>
                                <button type="button" class="btn btn-warning btn-add-category px-3 btn-sm fw-bold flex-shrink-0" title="Ekle">
                                    <i class="fas fa-plus me-1"></i> Ekle
                                </button>
                            </div>`);
                        row.find('.btn-add-category').on('click', function() {
                            addCategoryToMenu(item.id, item.title, row);
                        });
                        row.hover(
                            function() { $(this).addClass('bg-warning bg-opacity-10'); },
                            function() { $(this).removeClass('bg-warning bg-opacity-10'); }
                        );
                        $('#categoryLibraryList').append(row);
                    });
                }).fail(function() {
                    $('#categoryLibraryList').html('<div class="text-center text-danger py-3 small">Yükleme hatası.</div>');
                });
            }

            // Debounced search input
            $('#categorySearch').on('input', function() {
                clearTimeout(categorySearchTimer);
                categorySearchTimer = setTimeout(function() {
                    loadCategoryLibrary($('#categorySearch').val());
                }, 400);
            });

            function addCategoryToMenu(libraryItemId, title, libraryRow) {
                const menuId = $('#CategoryMenuId').val();
                const sortOrder = $('#addedCategoryList .added-category-item').length;

                $.ajax({
                    url: addCategoryUrl,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ MenuId: menuId, CategoryLibraryItemId: libraryItemId, SortOrder: sortOrder }),
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(res) {
                        // Remove item from library list (already added)
                        libraryRow.fadeOut(200, function() { $(this).remove(); });
                        // Append to right panel
                        appendAddedCategoryCard(res.id, title);
                        if ($('#addedCategoryList .added-category-item').length === 1) {
                            initAddedCategoriesSortable();
                        }
                        updateWizardHeight();
                    },
                    error: function(xhr) { handleError(xhr, 'AddCategory'); }
                });
            }

            // Shared helper: build and append a category card to the right panel
            function appendAddedCategoryCard(categoryId, title) {
                $('#addedPlaceholder').hide();
                const colDiv = $('<div>').addClass('col-12 col-sm-6 added-category-item').attr('data-id', categoryId);
                const card = $('<div>')
                    .addClass('rounded-3 p-3 h-100 d-flex align-items-center gap-2 bg-warning bg-opacity-10 border border-warning border-2 position-relative')
                    .html(`
                        <i class="fas fa-grip-vertical text-secondary handle fs-5 flex-shrink-0" style="cursor:grab"></i>
                        <span class="text-body fw-bold flex-grow-1 fs-6 pe-5">${title}</span>
                        <button type="button" class="btn btn-danger btn-remove-category position-absolute d-flex align-items-center justify-content-center"
                            style="width:32px;height:32px;padding:0; top: 10px; right: 10px;" title="Kaldır">
                            <i class="fas fa-times text-white small"></i>
                        </button>`);
                card.find('.btn-remove-category').on('click', function() {
                    $.post(`/admin/Onboarding/remove-category/${categoryId}`, function() {
                        colDiv.remove();
                        if ($('#addedCategoryList .added-category-item').length === 0) {
                            $('#addedPlaceholder').show();
                        }
                        loadCategoryLibrary($('#categorySearch').val());
                        updateWizardHeight();
                    }).fail(function() {
                        Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: 'Kaldırma işlemi başarısız.', showConfirmButton: false, timer: 3000 });
                    });
                });
                colDiv.append(card);
                $('#addedCategoryList').append(colDiv);
                updateWizardHeight();
            }

            function initAddedCategoriesSortable() {
                const el = document.getElementById('addedCategoryList');
                if (el._sortable) return;
                el._sortable = new Sortable(el, {
                    animation: 150,
                    handle: '.handle',
                    ghostClass: 'bg-warning',
                    onEnd: function() {
                        const items = Array.from(el.querySelectorAll('.added-category-item')).map((item, i) => ({
                            id: item.getAttribute('data-id'),
                            sortOrder: i
                        }));
                        fetch(sortUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ items: items })
                        });
                    }
                });
            }

            // Complete wizard button
            $('#btnCompleteOnboarding').on('click', function() {
                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Tamamlanıyor...');
                const menuId = $('#CategoryMenuId').val();

                $.ajax({
                    url: `/admin/Onboarding/complete`,
                    type: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function() {
                        window.location.href = `/admin/Dashboard`;
                    },
                    error: function() {
                        btn.prop('disabled', false).html('Kurulumu Tamamla <i class="fas fa-check-circle ms-2"></i>');
                        Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: 'Hata oluştu', showConfirmButton: false, timer: 3000 });
                    }
                });
            });


            (function ($) {
  const selector = 'input[type="tel"], input[name*="Phone"]';

  const onlyDigits = (s) => String(s ?? '').replace(/\D/g, '');

  const countDigitsToPos = (str, pos) => onlyDigits(str.slice(0, pos)).length;

  const setCaret = (el, pos) => {
    try {
      el.setSelectionRange(pos, pos);
    } catch (_) {}
  };

  const caretPosFromDigitIndex = (formatted, digitIndex) => {
    if (digitIndex <= 0) return 0;

    let seen = 0;
    for (let i = 0; i < formatted.length; i++) {
      if (/\d/.test(formatted[i])) {
        seen++;
        if (seen === digitIndex) return i + 1;
      }
    }
    return formatted.length;
  };

  // Returns { digits, removedPrefix, addedPrefix }
  const normalizeTR = (rawDigits) => {
    let d = String(rawDigits ?? '');
    let removedPrefix = 0;
    let addedPrefix = 0;

    // Country code handling: 0090..., 90...
    if (d.startsWith('0090')) {
      removedPrefix = 4;
      d = d.slice(4);
    } else if (d.startsWith('90') && d.length >= 12) {
      removedPrefix = 2;
      d = d.slice(2);
    }

    // Ensure leading 0
    if (d.length > 0 && d[0] !== '0') {
      addedPrefix = 1;
      d = '0' + d;
    }

    // 11 digits max (0 + 10)
    d = d.slice(0, 11);

    return { digits: d, removedPrefix, addedPrefix };
  };

  const formatTR = (d) => {
    if (!d) return '';

    const p0 = d.slice(0, 1); // 0
    const p1 = d.slice(1, 4); // XXX
    const p2 = d.slice(4, 7); // XXX
    const p3 = d.slice(7, 9); // XX
    const p4 = d.slice(9, 11); // XX

    let out = p0;

    if (d.length > 1) out += ' (' + p1;
    if (d.length >= 4) out += ')';
    if (d.length > 4) out += ' ' + p2;
    if (d.length > 7) out += ' ' + p3;
    if (d.length > 9) out += ' ' + p4;

    return out;
  };

  const handleKeydown = (e) => {
    const el = e.target;
    const value = el.value || '';
    const start = el.selectionStart ?? 0;
    const end = el.selectionEnd ?? 0;

    if (start !== end) return; // selection varsa karışma

    if (e.key === 'Backspace') {
      let i = start - 1;
      while (i >= 0 && !/\d/.test(value[i])) i--;
      if (i !== start - 1) {
        e.preventDefault();
        setCaret(el, i + 1);
      }
    }

    if (e.key === 'Delete') {
      let i = start;
      while (i < value.length && !/\d/.test(value[i])) i++;
      if (i !== start) {
        e.preventDefault();
        setCaret(el, i);
      }
    }
  };

  const handleInput = (e) => {
    const el = e.target;
    const prev = el.value || '';
    const caret = el.selectionStart ?? prev.length;

    // caret'i digit index olarak yakala (format chars dahil değil)
    let digitIndex = countDigitsToPos(prev, caret);

    const rawDigits = onlyDigits(prev);
    const norm = normalizeTR(rawDigits);

    // digitIndex'i normalize dönüşümüne göre düzelt
    digitIndex = Math.max(0, digitIndex - norm.removedPrefix);
    if (norm.addedPrefix && digitIndex > 0) digitIndex += norm.addedPrefix;
    digitIndex = Math.min(digitIndex, norm.digits.length);

    const formatted = formatTR(norm.digits);

    if (formatted !== prev) {
      el.value = formatted;
      const newCaret = caretPosFromDigitIndex(formatted, digitIndex);
      setCaret(el, newCaret);
    }
  };

  // delegated (dinamik inputlar için sağlam)
  $(document).on('keydown', selector, handleKeydown);
  $(document).on('input', selector, handleInput);
})(jQuery);

            // Buraya odakla butonu
            $('#centerMapBtn').on('click', function() {
                if (map) {
                    const center = map.getCenter();
                    const lat = center.lat;
                    const lng = center.lng;
                    
                    // Pin'i haritanın merkezine taşı
                    if (marker) {
                        marker.setLatLng([lat, lng]);
                    } else {
                        marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                        marker.on('dragend', function(e) {
                            const pos = e.target.getLatLng();
                            $('#cityLatInput').val(pos.lat.toFixed(6).replace('.', ','));
                            $('#cityLngInput').val(pos.lng.toFixed(6).replace('.', ','));
                        });
                    }
                    
                    // Koordinatları inputlara yaz
                    $('#cityLatInput').val(lat.toFixed(6).replace('.', ','));
                    $('#cityLngInput').val(lng.toFixed(6).replace('.', ','));
                    
                    // Overlay'i gizle
                    $('#mapOverlay').hide();
                }
            });

            // Konumu kullan butonu
            $('#useMyLocationBtn').on('click', function() {
                const btn = $(this);
                const originalContent = btn.html();
                
                window.locationService.getLocation({
                    showLoading: true,
                    buttonId: 'useMyLocationBtn',
                    showErrorPopup: true,
                    onSuccess: function (pos) {
                        const lat = pos.coords.latitude;
                        const lng = pos.coords.longitude;
                        
                        $('#cityLatInput').val(lat.toFixed(6).replace('.', ','));
                        $('#cityLngInput').val(lng.toFixed(6).replace('.', ','));
                        
                        if (map) {
                            map.setView([lat, lng], 15);
                            if (marker) marker.setLatLng([lat, lng]);
                        } else {
                            initMap(lat, lng, 15);
                        }
                        
                        // Overlay'i gizle
                        $('#mapOverlay').hide();
                    },
                    onError: function (err, message) {
                        console.warn('Geolocation error:', err);
                        alert('Konum alınamadı. Lütfen tarayıcınızın konum izinlerini kontrol edin.');
                    }
                }).catch(function(error) {
                    console.warn('Location request failed:', error);
                    alert('Tarayıcınız konum özelliğini desteklemiyor.');
                });
            });


        });
    </script>
