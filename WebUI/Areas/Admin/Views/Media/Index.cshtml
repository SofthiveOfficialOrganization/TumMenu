@using Application.Medias.DTOs
@using Application.Common.Base.DTOs
@using Domain.Entities
@model PaginatedListDTO<MediaDTO>

@{
    var title = ViewData["Title"]?.ToString() ?? "Medya Yönetimi";
}

<div class="media-gallery-container">
    <div class="media-gallery-header">
        <h3 class="media-gallery-title">@title</h3>
        <div class="d-flex gap-2 align-items-center">
            @if (User.IsInRole("Owner") && title == "İçeriklerim")
            {
                <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('libraryUploadInput').click()">
                    <i class="fas fa-plus me-1"></i> Yeni İçerik Yükle
                </button>
                <input type="file" id="libraryUploadInput" hidden accept="image/*" onchange="handleLibraryUpload(this)" />
            }
            <select class="form-select form-select-sm" id="typeFilter" style="width: 150px;">
                <option value="">Tüm Tipler</option>
                @foreach (var type in Enum.GetValues<MediaRefType>().Where(t => t != MediaRefType.Unknown))
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>
    </div>

    <div class="media-grid" id="mediaLibraryGrid">
        @if (Model.Items.Any())
        {
            @foreach (var media in Model.Items)
            {
                <div class="media-item" data-media-id="@media.Id" data-type="@media.Type">
                    <img src="@media.MediaUrl" alt="@media.AltText" />
                    <div class="media-slot-badge">@media.Slot</div>
                    <div class="media-item-overlay">
                        <div class="media-hover-actions d-flex flex-column gap-2 p-2 w-100">
                             <div class="text-white small text-center mb-auto" style="text-shadow: 0 1px 4px rgba(0,0,0,0.5)">
                                <div class="fw-bold">@media.Type</div>
                                <div class="text-xs">@media.CreatedAt?.ToString("dd.MM.yyyy")</div>
                            </div>
                            <div class="d-flex justify-content-center gap-2">
                                <button type="button" class="btn btn-sm btn-light" onclick="window.open('@media.MediaUrl', '_blank')">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <button type="button" class="media-delete-btn" onclick="deleteMediaFromLibrary('@media.Id', this)">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-images fa-3x text-secondary opacity-25 mb-3"></i>
                <p class="text-secondary">Henüz bir içerik bulunmuyor.</p>
            </div>
        }
    </div>

    @if (Model.HasPrevious || Model.HasNext)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                        <a class="page-link" href="?page=@(Model.Index - 1)">Geri</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">Sayfa @Model.Index / @Model.Pages</span>
                    </li>
                    <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                        <a class="page-link" href="?page=@(Model.Index + 1)">İleri</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.getElementById('typeFilter').addEventListener('change', function() {
            const type = this.value;
            window.location.href = window.location.pathname + (type ? '?type=' + type : '');
        });

        // Sync select with current URL param
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('type')) {
            document.getElementById('typeFilter').value = urlParams.get('type');
        }

        async function handleLibraryUpload(input) {
            if (!input.files || !input.files[0]) return;

            const file = input.files[0];
            const formData = new FormData();
            formData.append('file', file);

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Show loading state if needed
            TumMenuAlerts.toast('info', 'Yükleniyor...');

            try {
                const response = await fetch(`/admin/Media/Upload`, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                if (response.ok) {
                    TumMenuAlerts.toast('success', 'Görsel başarıyla yüklendi.');
                    // Refresh grid or reload page
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    TumMenuAlerts.toast('error', 'Yükleme başarısız oldu.');
                }
            } catch (err) {
                TumMenuAlerts.toast('error', 'Bir hata oluştu.');
            } finally {
                input.value = ''; // Reset input
            }
        }

        async function deleteMediaFromLibrary(id, btn) {
            const confirmed = await TumMenuAlerts.confirm(
                'Bu görseli kalıcı olarak silmek istediğinize emin misiniz?',
                'Bu işlem geri alınamaz!',
                'Evet, Sil!'
            );

            if (!confirmed) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const response = await fetch(`/admin/Media/Delete/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                if (response.ok) {
                    btn.closest('.media-item').remove();
                    TumMenuAlerts.toast('success', 'Görsel silindi.');
                } else {
                    const error = await response.text();
                    TumMenuAlerts.toast('error', error || 'Silme işlemi başarısız.');
                }
            } catch (err) {
                TumMenuAlerts.toast('error', 'Bir hata oluştu.');
            }
        }
    </script>
}
