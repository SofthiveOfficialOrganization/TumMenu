@using Application.CustomerOrderRequests.DTOs
@using Application.Common.Base.DTOs
@using Application.Stores.DTOs
@using Domain.Entities
@model List<CustomerOrderRequestSummaryDTO>

@{
    ViewData["Title"] = "Gelen Siparişler";
    var status = ViewBag.CurrentStatus as CustomerOrderRequestStatus?;
    var currentStoreId = ViewBag.CurrentStoreId as Guid?;
    var currentDate = ViewBag.CurrentDate as string;
    var storeOptions = ViewBag.StoreOptions as PaginatedListDTO<StoreDTO>;
}

@section Styles {
    <style>
        .tm-order-requests-header {
            display: grid;
            grid-template-columns: minmax(220px, 1fr) auto;
            gap: 18px;
            align-items: end;
        }

        .tm-order-requests-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: flex-end;
            align-items: center;
        }

        .tm-order-requests-filters .form-select,
        .tm-order-requests-filters .form-control {
            min-height: 42px;
        }

        .tm-order-requests-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 18px;
        }

        .tm-order-request-card {
            display: flex;
            flex-direction: column;
            min-height: 100%;
            padding: 22px;
            border: 1px solid rgba(163, 174, 208, .24);
            border-radius: 18px;
            background: var(--horizon-card-bg);
            box-shadow: 0 18px 40px rgba(112, 144, 176, .11);
        }

        .tm-order-request-card[data-status="New"] {
            border-color: rgba(239, 68, 68, .35);
            box-shadow: 0 18px 42px rgba(239, 68, 68, .11);
        }

        .tm-order-request-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 14px;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(163, 174, 208, .18);
        }

        .tm-order-request-title {
            color: var(--horizon-text-primary);
            font-size: 1.08rem;
            font-weight: 800;
            line-height: 1.25;
            margin: 0;
            overflow-wrap: anywhere;
        }

        .tm-order-request-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 8px;
            color: var(--horizon-text-secondary);
            font-size: .86rem;
            font-weight: 700;
        }

        .tm-order-request-total {
            text-align: right;
            white-space: nowrap;
        }

        .tm-order-request-total strong {
            display: block;
            color: var(--horizon-text-primary);
            font-size: 1.22rem;
            line-height: 1.15;
        }

        .tm-order-request-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            margin: 16px 0;
        }

        .tm-order-request-summary-item {
            min-width: 0;
            padding: 10px 12px;
            border: 1px solid rgba(163, 174, 208, .18);
            border-radius: 14px;
            background: rgba(244, 247, 254, .68);
        }

        .tm-order-request-summary-item span {
            display: block;
            color: var(--horizon-text-secondary);
            font-size: .72rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .tm-order-request-summary-item strong {
            display: block;
            margin-top: 2px;
            color: var(--horizon-text-primary);
            font-size: .95rem;
            line-height: 1.25;
            overflow-wrap: anywhere;
        }

        .tm-order-products {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 18px;
        }

        .tm-order-products-heading {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            color: var(--horizon-text-secondary);
            font-size: .78rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .tm-order-product-row {
            display: grid;
            grid-template-columns: 52px minmax(0, 1fr) auto;
            gap: 12px;
            align-items: center;
            padding: 12px 0;
            border-top: 1px solid rgba(163, 174, 208, .16);
        }

        .tm-order-product-quantity {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            border-radius: 14px;
            color: #ffffff;
            background: var(--horizon-primary);
            font-weight: 900;
        }

        .tm-order-product-title {
            color: var(--horizon-text-primary);
            font-weight: 800;
            line-height: 1.3;
            overflow-wrap: anywhere;
        }

        .tm-order-product-meta {
            color: var(--horizon-text-secondary);
            font-size: .84rem;
            line-height: 1.35;
            margin-top: 3px;
            overflow-wrap: anywhere;
        }

        .tm-order-product-price {
            color: var(--horizon-text-primary);
            font-weight: 900;
            white-space: nowrap;
        }

        .tm-order-request-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 8px;
            margin-top: auto;
            padding-top: 14px;
            border-top: 1px solid rgba(163, 174, 208, .18);
        }

        html.dark-mode .tm-order-request-card,
        body.dark-mode .tm-order-request-card {
            border-color: rgba(255, 255, 255, .12);
            box-shadow: 0 18px 40px rgba(0, 0, 0, .26);
        }

        html.dark-mode .tm-order-request-summary-item,
        body.dark-mode .tm-order-request-summary-item {
            background: rgba(255, 255, 255, .04);
            border-color: rgba(255, 255, 255, .1);
        }

        @@media (max-width: 768px) {
            .tm-order-requests-header,
            .tm-order-requests-grid {
                grid-template-columns: 1fr;
            }

            .tm-order-requests-filters {
                justify-content: stretch;
            }

            .tm-order-requests-filters > * {
                flex: 1 1 150px;
            }

            .tm-order-request-top,
            .tm-order-request-summary,
            .tm-order-product-row {
                grid-template-columns: 1fr;
            }

            .tm-order-request-top {
                display: grid;
            }

            .tm-order-request-total {
                text-align: left;
            }

            .tm-order-product-row {
                gap: 8px;
            }

            .tm-order-product-price {
                justify-self: start;
            }

            .tm-order-request-actions .btn {
                flex: 1 1 auto;
            }
        }
    </style>
}

<div class="horizon-card">
    <div class="tm-order-requests-header">
        <div>
            <h4 class="fw-bold mb-1">Gelen Siparişler</h4>
            <p class="text-secondary small mb-0">QR menüden gelen sipariş taleplerini canlı takip edin.</p>
        </div>
        <form method="get" class="tm-order-requests-filters">
            <select name="status" class="form-select form-select-sm" style="width: 150px;">
                <option value="">Tüm durumlar</option>
                <option value="New" selected="@(status == CustomerOrderRequestStatus.New)">Yeni</option>
                <option value="Seen" selected="@(status == CustomerOrderRequestStatus.Seen)">Görüldü</option>
                <option value="Completed" selected="@(status == CustomerOrderRequestStatus.Completed)">Tamamlandı</option>
            </select>
            <select name="storeId" class="form-select form-select-sm" style="width: 180px;">
                <option value="">Tüm dükkanlar</option>
                @foreach (var store in storeOptions?.Items ?? [])
                {
                    <option value="@store.Id" selected="@(currentStoreId == store.Id)">@store.Title</option>
                }
            </select>
            <input type="date" name="date" value="@currentDate" class="form-control form-control-sm" style="width: 150px;" />
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="fas fa-filter me-1"></i> Filtrele
            </button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-times me-1"></i> Temizle
            </a>
        </form>
    </div>
</div>

<div id="orderRequestsGrid" class="tm-order-requests-grid">
    @if (Model.Count == 0)
    {
        <div id="orderRequestsEmptyState" class="horizon-card text-center py-5 text-secondary">
            <i class="fas fa-bell-slash fa-2x mb-3 opacity-50"></i>
            <h5>Henüz sipariş talebi yok</h5>
            <p class="small mb-0">QR menüden gelen talepler burada görünecek.</p>
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            <article class="tm-order-request-card" data-order-id="@order.Id" data-status="@order.Status">
                <div class="tm-order-request-top">
                    <div>
                        <h5 class="tm-order-request-title">@order.StoreName</h5>
                        <div class="tm-order-request-meta">
                            <span><i class="far fa-clock me-1"></i>@order.CreatedAt.ToString("HH:mm")</span>
                            <span><i class="fas fa-utensils me-1"></i>@order.ItemCount ürün</span>
                            <span class="badge @StatusClass(order.Status)" data-order-status>@StatusText(order.Status)</span>
                        </div>
                    </div>
                    <div class="tm-order-request-total">
                        <span class="text-secondary small fw-semibold">Toplam</span>
                        <strong>@order.Subtotal.ToString("N2") ₺</strong>
                    </div>
                </div>

                <div class="tm-order-request-summary">
                    <div class="tm-order-request-summary-item">
                        <span>Müşteri</span>
                        <strong>@order.CustomerName</strong>
                    </div>
                    <div class="tm-order-request-summary-item">
                        <span>Masa</span>
                        <strong>@order.TableNumber</strong>
                    </div>
                    <div class="tm-order-request-summary-item">
                        <span>Sipariş</span>
                        <strong>@order.Items.Count satır</strong>
                    </div>
                </div>

                <div class="tm-order-products">
                    <div class="tm-order-products-heading">
                        <span>Ürünler</span>
                        <span>Tutar</span>
                    </div>
                    @foreach (var item in order.Items)
                    {
                        <div class="tm-order-product-row">
                            <div class="tm-order-product-quantity">@item.Quantity</div>
                            <div>
                                <div class="tm-order-product-title">@item.ProductTitle</div>
                                @if (!string.IsNullOrWhiteSpace(item.ProductPriceSize) || !string.IsNullOrWhiteSpace(item.Note))
                                {
                                    <div class="tm-order-product-meta">
                                        @if (!string.IsNullOrWhiteSpace(item.ProductPriceSize))
                                        {
                                            <span>@item.ProductPriceSize</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Note))
                                        {
                                            <span>@(string.IsNullOrWhiteSpace(item.ProductPriceSize) ? "" : " · ")Not: @item.Note</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="tm-order-product-price">@item.LineTotal.ToString("N2") ₺</div>
                        </div>
                    }
                </div>

                <div class="tm-order-request-actions">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-order-detail="@order.Id" title="Detay">
                        <i class="fas fa-eye me-1"></i> Detay
                    </button>
                    @if (order.Status == CustomerOrderRequestStatus.New)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-order-seen="@order.Id" title="Görüldü yap">
                            <i class="fas fa-check me-1"></i> Görüldü
                        </button>
                    }
                    @if (order.Status != CustomerOrderRequestStatus.Completed)
                    {
                        <button type="button" class="btn btn-sm btn-outline-success" data-order-complete="@order.Id" title="Tamamlandı yap">
                            <i class="fas fa-check-double me-1"></i> Tamamla
                        </button>
                    }
                </div>
            </article>
        }
    }
</div>

<div class="modal fade" id="orderRequestDetailModal" tabindex="-1" aria-labelledby="orderRequestDetailTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0">
                <div>
                    <div class="text-secondary small fw-semibold">Sipariş Talebi</div>
                    <h5 class="modal-title fw-bold" id="orderRequestDetailTitle">Detay</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="orderRequestDetailBody">
                <div class="text-center text-secondary py-4">Yükleniyor...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.TumMenuOrderRequestsPage = true;
    </script>
    <script src="~/js/admin-order-requests.js" asp-append-version="true"></script>
}

@functions {
    private static string StatusText(CustomerOrderRequestStatus status) => status switch
    {
        CustomerOrderRequestStatus.New => "Yeni",
        CustomerOrderRequestStatus.Seen => "Görüldü",
        CustomerOrderRequestStatus.Completed => "Tamamlandı",
        _ => status.ToString()
    };

    private static string StatusClass(CustomerOrderRequestStatus status) => status switch
    {
        CustomerOrderRequestStatus.New => "bg-danger",
        CustomerOrderRequestStatus.Seen => "bg-warning text-dark",
        CustomerOrderRequestStatus.Completed => "bg-success",
        _ => "bg-secondary"
    };
}
