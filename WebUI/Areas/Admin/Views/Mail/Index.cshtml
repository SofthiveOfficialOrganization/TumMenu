@using WebUI.Models.Mail
@model MailPageViewModel

@{
    ViewData["Title"] = "E-posta";
    var currentFolder = Model.Folders.FirstOrDefault(folder => folder.Key == Model.CurrentFolderKey);
    var selected = Model.SelectedMessage;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-mail.css" asp-append-version="true" />
}

<div class="mail-page @(selected is null ? "" : "mail-page--selected")" data-back-url="@Url.Action("Index", "Mail", new { area = "Admin", folder = Model.CurrentFolderKey, q = Model.Search, page = Model.Page })" data-message-url="@Url.Action("Message", "Mail", new { area = "Admin" })">
    <div class="mail-page-heading">
        <div>
            <h1 class="mail-page-title">E-posta</h1>
            <p class="mail-page-subtitle">TumMenu hesabınızın gelen ve gönderilen maillerini tek ekrandan yönetin.</p>
        </div>
        <button type="button" class="btn btn-primary mail-compose-button" data-bs-toggle="modal" data-bs-target="#composeMailModal">
            <i class="fas fa-pen-to-square me-2"></i>Yeni mail
        </button>
    </div>

    @if (Model.ErrorMessage is not null)
    {
        <div class="mail-connection-state" role="alert">
            <div class="mail-state-icon"><i class="fas fa-plug-circle-xmark"></i></div>
            <div>
                <h2>Mailbox bağlantısı kurulamadı</h2>
                <p>@Model.ErrorMessage</p>
                <a class="btn btn-sm btn-primary" href="@Url.Action("Index", "Mail", new { area = "Admin" })">
                    <i class="fas fa-rotate-right me-1"></i>Tekrar dene
                </a>
            </div>
        </div>
    }
    else if (Model.Folders.Count == 0)
    {
        <div class="mail-connection-state" role="status">
            <div class="mail-state-icon"><i class="fas fa-inbox"></i></div>
            <div>
                <h2>Mailbox boş görünüyor</h2>
                <p>Bağlantı kuruldu ancak görüntülenebilir bir klasör bulunamadı.</p>
            </div>
        </div>
    }
    else
    {
        <div class="mail-toolbar">
            <form method="get" asp-area="Admin" asp-controller="Mail" asp-action="Index" class="mail-search-form">
                <input type="hidden" name="folder" value="@Model.CurrentFolderKey" />
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" name="q" value="@Model.Search" placeholder="Gönderen, konu veya içerikte ara" aria-label="Maillerde ara" />
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a class="mail-search-clear" href="@Url.Action("Index", "Mail", new { area = "Admin", folder = Model.CurrentFolderKey })" aria-label="Aramayı temizle">
                        <i class="fas fa-xmark"></i>
                    </a>
                }
                <button type="submit" class="visually-hidden">Ara</button>
            </form>
            <div class="mail-toolbar-actions">
                <span class="mail-result-count">@Model.TotalCount mail</span>
                <a class="mail-icon-button" href="@Url.Action("Index", "Mail", new { area = "Admin", folder = Model.CurrentFolderKey, q = Model.Search, page = Model.Page })" aria-label="Yenile" title="Yenile">
                    <i class="fas fa-rotate-right"></i>
                </a>
            </div>
        </div>

        <div class="mail-shell">
            <aside class="mail-folder-panel" aria-label="Mail klasörleri">
                <div class="mail-folder-panel-heading">
                    <span>Klasörler</span>
                    <span class="mail-folder-account">@User.Identity?.Name</span>
                </div>
                <nav class="mail-folder-list">
                    @foreach (var folder in Model.Folders)
                    {
                        var isActive = folder.Key == Model.CurrentFolderKey;
                        <a class="mail-folder-link @(isActive ? "is-active" : "")" data-folder-key="@folder.Key" href="@Url.Action("Index", "Mail", new { area = "Admin", folder = folder.Key, q = Model.Search })">
                            <span class="mail-folder-link-label">
                                <i class="fas @folder.Icon" aria-hidden="true"></i>
                                <span>@folder.DisplayName</span>
                            </span>
                            @if (folder.UnreadCount > 0)
                            {
                                <span class="mail-unread-count">@folder.UnreadCount</span>
                            }
                        </a>
                    }
                </nav>
                <div class="mail-folder-note">
                    <i class="fas fa-shield-halved"></i>
                    <span>Mail içerikleri canlı mailbox’tan okunur.</span>
                </div>
            </aside>

            <section class="mail-list-panel" aria-label="Mail listesi">
                <div class="mail-list-heading">
                    <div>
                        <span class="mail-list-title">@(currentFolder?.DisplayName ?? "Mailbox")</span>
                        <span class="mail-list-subtitle">@Model.TotalCount mesaj</span>
                    </div>
                    <div class="mail-list-heading-tools">
                        @if (Model.Messages.Count > 0)
                        {
                            <label class="mail-select-page">
                                <input type="checkbox" data-select-all aria-label="Bu sayfadaki maillerin tümünü seç" />
                                <span>Sayfayı seç</span>
                            </label>
                        }
                        @if (Model.TotalPages > 1)
                        {
                            <span class="mail-pagination-label">@Model.Page / @Model.TotalPages</span>
                        }
                    </div>
                </div>

                @if (Model.Messages.Count == 0)
                {
                    <div class="mail-empty-list">
                        <div class="mail-empty-list-icon"><i class="fas fa-envelope-open"></i></div>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Search) ? "Bu klasörde mail yok" : "Aramanızla eşleşen mail yok")</strong>
                        <span>@(string.IsNullOrWhiteSpace(Model.Search) ? "Yeni bir mail geldiğinde burada görünecek." : "Farklı bir arama terimi deneyin.")</span>
                    </div>
                }
                else
                {
                    <form method="post" asp-action="Bulk" asp-controller="Mail" asp-area="Admin" class="mail-bulk-form" id="mailBulkForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="folder" value="@Model.CurrentFolderKey" />
                        <input type="hidden" name="search" value="@Model.Search" />
                        <div class="mail-bulk-toolbar" data-bulk-toolbar hidden>
                            <span class="mail-bulk-count" aria-live="polite"><strong data-bulk-count>0</strong> mail seçildi</span>
                            <div class="mail-bulk-actions">
                                <button type="submit" name="operation" value="mark-read" data-bulk-action disabled title="Okundu olarak işaretle">
                                    <i class="fas fa-envelope-open" aria-hidden="true"></i><span>Okundu</span>
                                </button>
                                <button type="submit" name="operation" value="mark-unread" data-bulk-action disabled title="Okunmadı olarak işaretle">
                                    <i class="fas fa-envelope" aria-hidden="true"></i><span>Okunmadı</span>
                                </button>
                                <label class="mail-bulk-move">
                                    <span class="visually-hidden">Hedef klasör</span>
                                    <select name="destinationFolder" data-bulk-move-select aria-label="Hedef klasör">
                                        <option value="">Klasöre taşı...</option>
                                        @foreach (var folder in Model.Folders.Where(folder => folder.Key != Model.CurrentFolderKey))
                                        {
                                            <option value="@folder.Key">@folder.DisplayName</option>
                                        }
                                    </select>
                                </label>
                                <button type="submit" name="operation" value="move" data-bulk-move-button data-bulk-action disabled>
                                    <i class="fas fa-folder-open" aria-hidden="true"></i><span>Taşı</span>
                                </button>
                                <button type="submit" name="operation" value="delete" data-bulk-action disabled class="mail-bulk-delete">
                                    <i class="fas fa-trash" aria-hidden="true"></i><span>Sil</span>
                                </button>
                            </div>
                        </div>
                        <div class="mail-list-items">
                            @foreach (var message in Model.Messages)
                            {
                                var sender = string.IsNullOrWhiteSpace(message.SenderName) ? message.SenderAddress : message.SenderName;
                                var senderInitial = string.IsNullOrWhiteSpace(sender) ? '?' : sender[0];
                                var isSelected = selected?.Uid == message.Uid && selected.FolderKey == message.FolderKey;
                                <div class="mail-list-item @((message.IsRead || isSelected) ? "" : "is-unread") @(isSelected ? "is-selected" : "")" data-mail-row>
                                    <label class="mail-select-message">
                                        <input type="checkbox" name="uids" value="@message.Uid" data-mail-select aria-label="Seç: @message.Subject" />
                                        <span class="visually-hidden">Seç: @message.Subject</span>
                                    </label>
                                    <a class="mail-list-item-link" href="@Url.Action("Index", "Mail", new { area = "Admin", folder = message.FolderKey, q = Model.Search, page = Model.Page, uid = message.Uid })">
                                        <span class="mail-list-avatar">@senderInitial.ToString().ToUpperInvariant()</span>
                                        <span class="mail-list-item-content">
                                            <span class="mail-list-item-topline">
                                                <span class="mail-list-sender">@sender</span>
                                                <time datetime="@message.Date.ToString("O")">@message.Date.ToLocalTime().ToString("dd MMM HH:mm")</time>
                                            </span>
                                            <span class="mail-list-subject">@message.Subject</span>
                                            <span class="mail-list-preview">@message.Preview</span>
                                        </span>
                                        @if (message.HasAttachments)
                                        {
                                            <i class="fas fa-paperclip mail-attachment-indicator" title="Ek dosyası var" aria-label="Ek dosyası var"></i>
                                        }
                                        @if (!message.IsRead && !isSelected)
                                        {
                                            <span class="mail-unread-dot" aria-label="Okunmamış"></span>
                                        }
                                    </a>
                                </div>
                            }
                        </div>
                    </form>
                }

                @if (Model.TotalPages > 1)
                {
                    <nav class="mail-pagination" aria-label="Mail sayfaları">
                        @if (Model.Page > 1)
                        {
                            <a href="@Url.Action("Index", "Mail", new { area = "Admin", folder = Model.CurrentFolderKey, q = Model.Search, page = Model.Page - 1 })" aria-label="Önceki sayfa"><i class="fas fa-chevron-left"></i></a>
                        }
                        <span>@Model.Page / @Model.TotalPages</span>
                        @if (Model.Page < Model.TotalPages)
                        {
                            <a href="@Url.Action("Index", "Mail", new { area = "Admin", folder = Model.CurrentFolderKey, q = Model.Search, page = Model.Page + 1 })" aria-label="Sonraki sayfa"><i class="fas fa-chevron-right"></i></a>
                        }
                    </nav>
                }
            </section>

            <main class="mail-reader-panel" aria-label="Seçili mail">
                @if (selected is null)
                {
                    <div class="mail-reader-empty">
                        <div class="mail-reader-empty-mark"><i class="fas fa-envelope-open-text"></i></div>
                        <h2>Bir mail seçin</h2>
                        <p>Okumak istediğiniz maili listeden seçtiğinizde içeriği burada açılır.</p>
                    </div>
                }
                else
                {
                    <partial name="_MessageReader" model="new MailReaderViewModel { Message = selected, Folders = Model.Folders, Search = Model.Search }" />
                }
            </main>
        </div>
    }
</div>

<div class="modal fade mail-compose-modal" id="composeMailModal" tabindex="-1" aria-labelledby="composeMailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="mail-modal-kicker">Yeni mesaj</span>
                    <h2 class="modal-title" id="composeMailModalLabel">Mail oluştur</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form method="post" asp-action="Send" asp-controller="Mail" asp-area="Admin" enctype="multipart/form-data" id="composeMailForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnFolder" value="@Model.CurrentFolderKey" />
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="InReplyTo" id="composeInReplyTo" />
                <input type="hidden" name="References" id="composeReferences" />
                <div class="modal-body">
                    <div class="mail-compose-row mail-compose-recipient-row">
                        <label for="composeTo">Alıcı</label>
                        <input type="text" id="composeTo" name="To" class="form-control" placeholder="ornek@firma.com, ikinci@firma.com" required />
                        <button type="button" class="mail-copy-toggle" data-toggle-recipient="Cc">Cc</button>
                        <button type="button" class="mail-copy-toggle" data-toggle-recipient="Bcc">Bcc</button>
                    </div>
                    <div class="mail-compose-row d-none" data-recipient-row="Cc">
                        <label for="composeCc">Cc</label>
                        <input type="text" id="composeCc" name="Cc" class="form-control" placeholder="Bilgi almak isteyenler" />
                    </div>
                    <div class="mail-compose-row d-none" data-recipient-row="Bcc">
                        <label for="composeBcc">Bcc</label>
                        <input type="text" id="composeBcc" name="Bcc" class="form-control" placeholder="Gizli alıcılar" />
                    </div>
                    <div class="mail-compose-row">
                        <label for="composeSubject">Konu</label>
                        <input type="text" id="composeSubject" name="Subject" class="form-control" placeholder="Mail konusu" required maxlength="300" />
                    </div>
                    <div class="mail-compose-editor-shell">
                        <div class="mail-editor-toolbar" aria-label="Biçimlendirme araçları">
                            <button type="button" data-command="bold" title="Kalın"><i class="fas fa-bold"></i></button>
                            <button type="button" data-command="italic" title="İtalik"><i class="fas fa-italic"></i></button>
                            <button type="button" data-command="underline" title="Altı çizili"><i class="fas fa-underline"></i></button>
                            <button type="button" data-command="createLink" title="Bağlantı ekle"><i class="fas fa-link"></i></button>
                        </div>
                        <div id="composeEditor" class="mail-compose-editor" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="Mesajınızı yazın..."></div>
                        <textarea id="composeBodyHtml" name="BodyHtml" class="visually-hidden" required></textarea>
                    </div>
                    <div class="mail-compose-footer">
                        <label class="mail-attachment-picker">
                            <i class="fas fa-paperclip"></i>
                            <span>Ek dosyası ekle</span>
                            <input type="file" name="Attachments" multiple />
                        </label>
                        <span class="mail-attachment-help">Dosya başına en fazla 25 MB</span>
                    </div>
                    <div class="mail-selected-files" data-selected-files></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary mail-send-button">
                        <i class="fas fa-paper-plane me-2"></i>Gönder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-mail.js" asp-append-version="true"></script>
}
