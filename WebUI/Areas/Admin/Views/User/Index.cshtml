@using Application.Auths.DTOs
@using Application.Common.Base.DTOs
@model PaginatedListDTO<UserWithRolesDTO>

@{
    ViewData["Title"] = "Users";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                   <h4 class="fw-bold mb-1">User Management</h4>
                   <p class="text-secondary small mb-0">View all registered users and their roles.</p>
                </div>
                <div class="d-flex gap-2">
                     <form method="get" class="d-flex align-items-center">
                        <input type="text" name="Search" class="form-control me-2" placeholder="Search users..." value="@Context.Request.Query["Search"]" style="min-width: 250px;">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                    </form>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">User</th>
                            <th>Email</th>
                            <th>Roles</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-3">
                                                @item.Email?.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.FirstName @item.LastName</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-secondary">@item.Email</td>
                                    <td>
                                        @foreach(var role in item.Roles)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary me-1">@role</span>
                                        }
                                        @if(!item.Roles.Any())
                                        {
                                            <span class="badge bg-light text-secondary">No Role</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <!-- Actions placeholder -->
                                        <button class="btn btn-sm btn-light text-secondary" disabled title="Edit not implemented">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-secondary">
                                    <i class="fas fa-users fa-3x mb-3 d-block opacity-50"></i>
                                    No users found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model != null && Model.Pages > 1)
            {
               <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div class="text-secondary small">
                        Showing @Model.Items.Count of @Model.Count entries
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-Index="@(Model.Index - 1)" asp-route-Search="@Context.Request.Query["Search"]">Previous</a>
                            </li>
                            @for (int i = 1; i <= Model.Pages; i++)
                            {
                                <li class="page-item @(Model.Index == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-Index="@i" asp-route-Search="@Context.Request.Query["Search"]">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-Index="@(Model.Index + 1)" asp-route-Search="@Context.Request.Query["Search"]">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
