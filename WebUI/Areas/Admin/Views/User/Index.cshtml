@using Application.Auths.DTOs
@using Application.Common.Base.DTOs
@model PaginatedListDTO<UserWithRolesDTO>

@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                   <h4 class="fw-bold mb-1">Kullanıcı Yönetimi</h4>
                   <p class="text-secondary small mb-0">Tüm kayıtlı kullanıcıları ve rollerini görüntüleyin.</p>
                </div>
                <div class="d-flex gap-2">
                    <form asp-action="Index" method="get" class="d-flex gap-2 align-items-center">
                        <select name="WizardCompleted" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Tüm Durumlar</option>
                            <option value="true" selected="@(Context.Request.Query["WizardCompleted"] == "true")">Tamamlandı</option>
                            <option value="false" selected="@(Context.Request.Query["WizardCompleted"] == "false")">Tamamlanmadı</option>
                        </select>
                        <div class="input-group input-group-sm">
                            <input type="text" name="Search" class="form-control" placeholder="Ara..." value="@Context.Request.Query["Search"]">
                            <button class="btn btn-outline-secondary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">E-posta</th>
                            <th>Şirket Adı</th>
                            <th>Kayıt Tarihi</th>
                            <th>Wizard Durumu</th>
                            <th class="d-none d-md-table-cell">Roller</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr data-tummenu-click-url="@Url.Action("Update", new { id = item.Id })">
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.Email</span>
                                                <small class="text-muted">@item.FirstName @item.LastName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-secondary">@(item.CompanyName ?? "-")</span>
                                    </td>
                                    <td>
                                        @if (item.CreatedOn > 0)
                                        {
                                            <span class="text-secondary small">@(DateTimeOffset.FromUnixTimeSeconds(item.CreatedOn).LocalDateTime.ToString("dd.MM.yyyy HH:mm"))</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Bilinmiyor</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.WizardCompleted.HasValue)
                                        {
                                            if (item.WizardCompleted.Value)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success">Tamamlandı</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning">Tamamlanmadı</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        @foreach (var role in item.Roles)
                                        {
                                            <span class="badge bg-light text-secondary me-1">@role</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" id="deleteForm-@item.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Sil" onclick="TumMenuAlerts.confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Sil!').then(res => { if(res) document.getElementById('deleteForm-@item.Id').submit(); })">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-secondary">
                                    <div class="mb-3">
                                        <span class="fa-stack fa-2x">
                                            <i class="fas fa-circle fa-stack-2x text-light"></i>
                                            <i class="fas fa-users fa-stack-1x text-secondary opacity-50"></i>
                                        </span>
                                    </div>
                                    <h5>Kullanıcı bulunamadı</h5>
                                    <p class="small">Aradığınız kriterlere uygun kullanıcı bulunmamaktadır.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <tummenu-pagination index="@(Model?.Index ?? 1)"
                                pages="@(Model?.Pages ?? 0)"
                                has-previous="@(Model?.HasPrevious ?? false)"
                                has-next="@(Model?.HasNext ?? false)"
                                count="@(Model?.Count ?? 0)"
                                items-count="@(Model?.Items.Count ?? 0)"
                                show-summary="true"
                                container-class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top" />
        </div>
    </div>
</div>
