@model Application.Auths.Commands.UpdateUserCommand
@{
    ViewData["Title"] = "Kullanıcı Güncelle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1">Kullanıcı Düzenle</h4>
                    <p class="text-secondary small mb-0">Kullanıcı bilgilerini güncelleyin.</p>
                </div>
                <a asp-action="Index" data-tummenu-back data-fallback-url="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Geri Dön
                </a>
            </div>

            <form asp-action="Update" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label small fw-bold">Ad</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Ad" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label small fw-bold">Soyad</label>
                        <input asp-for="LastName" class="form-control" placeholder="Soyad" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label small fw-bold">E-posta</label>
                    <input asp-for="Email" class="form-control" placeholder="E-posta adresi" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
