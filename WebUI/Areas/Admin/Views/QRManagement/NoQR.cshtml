@{
    ViewData["Title"] = "QR Kod Bulunamadı";
}

<div class="horizon-card text-center p-md-5 p-4 my-5">
    <div class="mb-4">
        <span class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle" style="width: 100px; height: 100px;">
            <i class="fas fa-exclamation-triangle fa-3x"></i>
        </span>
    </div>
    <h2 class="horizon-text-primary mb-3 fw-bold">Henüz QR Kodunuz Hazır Değil</h2>
    <p class="text-secondary mb-4 mx-auto" style="max-width: 500px;">
        Görünüşe göre işletmenize atanmış bir dükkan veya QR kod bulunmuyor. Dükkanınızı oluşturduktan sonra QR kodunuz otomatik olarak burada görünecektir.
    </p>
    <div class="d-flex justify-content-center gap-3">
        <a href="@Url.Action("Index", "Store")" class="btn btn-primary px-4 py-2">
            <i class="fas fa-plus me-2"></i> Dükkanlarımı Yönet
        </a>
        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary px-4 py-2">
            Panele Dön
        </a>
    </div>
</div>
