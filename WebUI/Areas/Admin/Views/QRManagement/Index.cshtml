@model List<Application.QRs.Queries.QRListItemDTO>
@{
    ViewData["Title"] = "QR Yönetimi";
}

<div class="horizon-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="horizon-text-primary fw-bold mb-1">Global QR Yönetimi</h2>
            <p class="text-secondary mb-0">Tüm dükkanların QR kodlarını ve yönlendirme ayarlarını buradan yönetebilirsiniz.</p>
        </div>
    </div>

    <!-- Global Domain Gncelleme Formu -->
    <div class="bg-light p-4 rounded-4 mb-4" style="border: 1px dashed var(--horizon-primary);">
        <form asp-action="GlobalUpdateBaseDomain" method="post" class="row g-3 align-items-center">
            <div class="col-md-auto">
                <label class="form-label fw-bold mb-0">Global Base Domain:</label>
            </div>
            <div class="col-md-4">
                <input type="text" name="newBaseDomain" class="form-control" placeholder="Örn: https://tummenu.com" required />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-sync-alt me-2"></i> Tümünü Güncelle
                </button>
            </div>
            <div class="col-md">
                <small class="text-muted d-block">Bu işlem <strong>tüm</strong> QR kodlarının yönlendirme domainini tek seferde değiştirir.</small>
            </div>
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Şirket / Dükkan</th>
                    <th>QR Anahtarı</th>
                    <th>Yönlendirme URL</th>
                    <th>Domain</th>
                    <th>Oluşturulma</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-tummenu-click-url="@(item.StoreId.HasValue ? Url.Action("StoreDetails", "QRManagement", new { area = "Admin", storeId = item.StoreId.Value }) : null)">
                        <td>
                            <div class="fw-bold">@item.CompanyTitle</div>
                            <div class="small text-secondary">@item.StoreTitle</div>
                        </td>
                        <td>
                            <code class="bg-light px-2 py-1 rounded">@item.PublicKey</code>
                        </td>
                        <td>
                            <div class="text-truncate" style="max-width: 250px;" title="@item.TargetUrl">
                                @(item.TargetUrl ?? "/q/" + item.PublicKey)
                            </div>
                        </td>
                        <td>
                            <span class="badge @(string.IsNullOrEmpty(item.BaseDomain) ? "bg-secondary" : "bg-info text-dark")">
                                @(item.BaseDomain ?? "Default")
                            </span>
                        </td>
                        <td>
                            <div class="small">@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                        </td>
                        <td class="text-end">
                            <a href="/q/@item.PublicKey" target="_blank" class="btn btn-outline-secondary btn-sm rounded-3">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-secondary">
                            Henüz sistemde oluşturulmuş bir QR kodu bulunmuyor.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
