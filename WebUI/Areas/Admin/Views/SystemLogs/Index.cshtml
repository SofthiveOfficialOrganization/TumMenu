@using Application.SystemLogs.DTOs
@using Application.Common.Base.DTOs
@model PaginatedListDTO<SystemLogListDTO>

@{
    ViewData["Title"] = "Sistem Logları";
    var query = Context.Request.Query;
    string LevelClass(string level) => level.Equals("Error", StringComparison.OrdinalIgnoreCase)
        ? "bg-danger bg-opacity-10 text-danger"
        : "bg-warning bg-opacity-10 text-warning";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex flex-column flex-xl-row justify-content-between gap-3 mb-4">
                <div>
                    <h4 class="fw-bold mb-1">Sistem Logları</h4>
                    <p class="text-secondary small mb-0">WebUI hata kayıtlarını filtreleyin ve detaylarını inceleyin.</p>
                </div>
                <div class="d-flex flex-column align-items-xl-end gap-2">
                    <button type="button" class="btn btn-sm btn-outline-danger align-self-start align-self-xl-end" data-bs-toggle="modal" data-bs-target="#clearLogsModal">
                        <i class="fas fa-trash-alt me-1"></i> Logları Sil
                    </button>
                    <form asp-action="Index" method="get" class="row g-2 align-items-end">
                    <div class="col-6 col-lg-auto">
                        <label class="form-label small text-secondary mb-1">Başlangıç</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" value="@query["DateFrom"]" />
                    </div>
                    <div class="col-6 col-lg-auto">
                        <label class="form-label small text-secondary mb-1">Bitiş</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" value="@query["DateTo"]" />
                    </div>
                    <div class="col-6 col-lg-auto">
                        <label class="form-label small text-secondary mb-1">Saat Başlangıç</label>
                        <input type="time" name="TimeFrom" class="form-control form-control-sm" value="@query["TimeFrom"]" />
                    </div>
                    <div class="col-6 col-lg-auto">
                        <label class="form-label small text-secondary mb-1">Saat Bitiş</label>
                        <input type="time" name="TimeTo" class="form-control form-control-sm" value="@query["TimeTo"]" />
                    </div>
                    <div class="col-6 col-lg-auto">
                        <label class="form-label small text-secondary mb-1">Status</label>
                        <input type="number" name="StatusCode" class="form-control form-control-sm" placeholder="500" value="@query["StatusCode"]" />
                    </div>
                    <div class="col-12 col-lg-auto">
                        <label class="form-label small text-secondary mb-1">Kullanıcı</label>
                        <input type="text" name="User" class="form-control form-control-sm" placeholder="UserName veya UserId" value="@query["User"]" />
                    </div>
                    <div class="col-12 col-lg-auto">
                        <label class="form-label small text-secondary mb-1">Metin</label>
                        <div class="input-group input-group-sm">
                            <input type="text" name="Search" class="form-control" placeholder="Mesaj, path, trace..." value="@query["Search"]" />
                            <button class="btn btn-outline-secondary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-lg-auto">
                        <a asp-action="Index" class="btn btn-sm btn-light">Temizle</a>
                    </div>
                    </form>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">Tarih</th>
                            <th>Seviye</th>
                            <th>Status</th>
                            <th>Kullanıcı</th>
                            <th>Path</th>
                            <th>Mesaj</th>
                            <th>Trace</th>
                            <th class="text-center">Detay</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            var message = item.ResponseMessage ?? item.ExceptionMessage ?? "-";
                            <tr data-tummenu-click-url="@Url.Action("Details", new { id = item.Id })">
                                <td class="ps-3 text-nowrap">
                                    <span class="fw-semibold">@item.CreatedAt.ToString("dd.MM.yyyy")</span>
                                    <small class="text-muted d-block">@item.CreatedAt.ToString("HH:mm:ss")</small>
                                </td>
                                <td>
                                    <span class="badge @LevelClass(item.Level)">@item.Level</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary">@item.StatusCode</span>
                                </td>
                                <td>
                                    <span class="text-secondary small d-block">@(item.UserName ?? "-")</span>
                                    @if (!string.IsNullOrWhiteSpace(item.UserId))
                                    {
                                        <code class="small">@item.UserId</code>
                                    }
                                </td>
                                <td class="small text-secondary" style="max-width: 260px;">
                                    <span class="d-inline-block text-truncate" style="max-width: 260px;" title="@item.Path">@(item.Path ?? "-")</span>
                                </td>
                                <td class="small" style="max-width: 360px;">
                                    <span class="d-inline-block text-truncate" style="max-width: 360px;" title="@message">@message</span>
                                </td>
                                <td>
                                    <code class="small">@item.TraceId</code>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Detay">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <div class="mb-3">
                                    <span class="fa-stack fa-2x">
                                        <i class="fas fa-circle fa-stack-2x text-light"></i>
                                        <i class="fas fa-list-alt fa-stack-1x text-secondary opacity-50"></i>
                                    </span>
                                </div>
                                <h5>Log bulunamadı</h5>
                                <p class="small">Seçili kriterlere uygun WebUI hata kaydı bulunmuyor.</p>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.Pages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div class="text-secondary small">
                        @Model.Count kayıttan @Model.Items.Count tanesi gösteriliyor
                    </div>
                    <nav aria-label="Log sayfalama">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-Page="@(Model.Index - 1)" asp-route-DateFrom="@query["DateFrom"]" asp-route-DateTo="@query["DateTo"]" asp-route-TimeFrom="@query["TimeFrom"]" asp-route-TimeTo="@query["TimeTo"]" asp-route-StatusCode="@query["StatusCode"]" asp-route-User="@query["User"]" asp-route-Search="@query["Search"]">Önceki</a>
                            </li>
                            @for (int i = 1; i <= Model.Pages; i++)
                            {
                                <li class="page-item @(Model.Index == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-Page="@i" asp-route-DateFrom="@query["DateFrom"]" asp-route-DateTo="@query["DateTo"]" asp-route-TimeFrom="@query["TimeFrom"]" asp-route-TimeTo="@query["TimeTo"]" asp-route-StatusCode="@query["StatusCode"]" asp-route-User="@query["User"]" asp-route-Search="@query["Search"]">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-Page="@(Model.Index + 1)" asp-route-DateFrom="@query["DateFrom"]" asp-route-DateTo="@query["DateTo"]" asp-route-TimeFrom="@query["TimeFrom"]" asp-route-TimeTo="@query["TimeTo"]" asp-route-StatusCode="@query["StatusCode"]" asp-route-User="@query["User"]" asp-route-Search="@query["Search"]">Sonraki</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="clearLogsModal" tabindex="-1" aria-labelledby="clearLogsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <div>
                    <h5 class="modal-title fw-bold" id="clearLogsModalLabel">Logları Sil</h5>
                    <p class="text-secondary small mb-0">Seçtiğiniz tarih aralığı ve status kodlarına göre log kayıtları silinir.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="Clear" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body pt-0">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Başlangıç</label>
                            <input type="date" name="dateFrom" class="form-control" value="@query["DateFrom"]" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Bitiş</label>
                            <input type="date" name="dateTo" class="form-control" value="@query["DateTo"]" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Status Kodu</label>
                            <div class="d-flex flex-wrap gap-2">
                                @{
                                    var statusOptions = new[] { 200, 400, 401, 403, 404, 500 };
                                }
                                @foreach (var statusCode in statusOptions)
                                {
                                    <input type="checkbox" class="btn-check" name="statusCodes" value="@statusCode" id="clearStatus@statusCode" autocomplete="off" />
                                    <label class="btn btn-outline-secondary btn-sm" for="clearStatus@statusCode">@statusCode</label>
                                }
                            </div>
                            <div class="form-text">Status kodu seçmezseniz tarih aralığındaki tüm loglar silinir.</div>
                        </div>
                        <div class="col-12">
                            <div class="alert alert-warning mb-0 small">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Bu işlem seçili kriterlere uyan log kayıtlarını listeden kaldırır.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Logları Sil
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
