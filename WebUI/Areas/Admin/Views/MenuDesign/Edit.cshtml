@using Application.MenuDesigns.Commands
@model UpdateMenuDesignCommand

@{
    ViewData["Title"] = "Tasarım Düzenle";
}

<div class="row">
    <div class="col-lg-8">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0">Tasarım Düzenle</h4>
                <a asp-action="Index" data-tummenu-back data-fallback-url="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Geri
                </a>
            </div>

            <p class="text-muted small mb-3">
                <i class="fas fa-info-circle me-1"></i>
                Bir alanın üzerine geldiğinizde, o özelliğin menüde nerede kullanıldığına dair kısa açıklama görünür.
            </p>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <partial name="_MenuDesignFormFields" model="Model" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" data-tummenu-back data-fallback-url="@Url.Action("Index")" class="btn btn-outline-secondary">İptal</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <partial name="_MenuDesignLivePreview" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_MenuDesignFormScripts" />
}
