@using Application.MenuDesigns.Commands
@model UpdateMenuDesignCommand

@{
    ViewData["Title"] = "Tasarım Düzenle";
}

<div class="row">
    <div class="col-lg-8">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0">Tasarım Düzenle</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Geri
                </a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Tasarım Adı <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Slug <span class="text-danger">*</span></label>
                        <input asp-for="Slug" class="form-control" />
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <h6 class="fw-bold text-secondary text-uppercase small mb-3">Renkler</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Ana Renk (--pm-brand) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="PrimaryColor" />
                            <input asp-for="PrimaryColor" class="form-control font-monospace" />
                        </div>
                        <span asp-validation-for="PrimaryColor" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Koyu Ana (--pm-brand-dark) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="PrimaryDarkColor" />
                            <input asp-for="PrimaryDarkColor" class="form-control font-monospace" />
                        </div>
                        <span asp-validation-for="PrimaryDarkColor" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Vurgu (--pm-accent) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="AccentColor" />
                            <input asp-for="AccentColor" class="form-control font-monospace" />
                        </div>
                        <span asp-validation-for="AccentColor" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Arka Plan (--pm-bg) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="BackgroundColor" />
                            <input asp-for="BackgroundColor" class="form-control font-monospace" />
                        </div>
                        <span asp-validation-for="BackgroundColor" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Yüzey (--pm-surface) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="SurfaceColor" />
                            <input asp-for="SurfaceColor" class="form-control font-monospace" />
                        </div>
                        <span asp-validation-for="SurfaceColor" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Metin (--pm-text) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="TextColor" />
                            <input asp-for="TextColor" class="form-control font-monospace" />
                        </div>
                        <span asp-validation-for="TextColor" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Soluk Metin (--pm-muted) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="MutedColor" />
                            <input asp-for="MutedColor" class="form-control font-monospace" />
                        </div>
                        <span asp-validation-for="MutedColor" class="text-danger small"></span>
                    </div>
                </div>

                <h6 class="fw-bold text-secondary text-uppercase small mb-3">Stil</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Köşe Yarıçapı (--pm-radius) <span class="text-danger">*</span></label>
                        <input asp-for="BorderRadius" class="form-control font-monospace" />
                        <span asp-validation-for="BorderRadius" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Tuş Stili</label>
                        <select asp-for="ButtonStyle" class="form-select">
                            <option value="solid">Dolu (Solid)</option>
                            <option value="outline">Çerçeveli (Outline)</option>
                            <option value="ghost">Şeffaf (Ghost)</option>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="IsDefault" class="form-check-input" type="checkbox" />
                            <label asp-for="IsDefault" class="form-check-label fw-semibold">Varsayılan Tasarım</label>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold small">Header Gradyanı (--pm-header-gradient) <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <input asp-for="BackgroundGradient" class="form-control font-monospace" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Arka Plan Görseli URL <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <input asp-for="BackgroundImageUrl" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Önizleme Görseli URL <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <input asp-for="PreviewImageUrl" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Sıra</label>
                        <input asp-for="SortOrder" type="number" class="form-control" />
                    </div>
                </div>

                <h6 class="fw-bold text-secondary text-uppercase small mb-3">Menü Üst Kısım (Header)</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Header Arka Plan <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="HeaderBackgroundColor" />
                            <input asp-for="HeaderBackgroundColor" class="form-control font-monospace" placeholder="Ana renkle aynı" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Header Metin Rengi <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="HeaderTextColor" />
                            <input asp-for="HeaderTextColor" class="form-control font-monospace" placeholder="#ffffff" />
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-secondary text-uppercase small mb-3">İçerik Kartları</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Kart Kenarlık Rengi <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="CardBorderColor" />
                            <input asp-for="CardBorderColor" class="form-control font-monospace" placeholder="#e2e8f0" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Kart Gölgesi <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <input asp-for="CardShadow" class="form-control font-monospace" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Kart Görsel Köşe Yarıçapı <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <input asp-for="CardImageBorderRadius" class="form-control font-monospace" />
                    </div>
                </div>

                <h6 class="fw-bold text-secondary text-uppercase small mb-3">Footer</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Footer Arka Plan <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="FooterBackgroundColor" />
                            <input asp-for="FooterBackgroundColor" class="form-control font-monospace" placeholder="#1e293b" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Footer Metin Rengi <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="FooterTextColor" />
                            <input asp-for="FooterTextColor" class="form-control font-monospace" placeholder="#ffffff" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Footer Tuş Rengi <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color color-trigger" data-target="FooterButtonColor" />
                            <input asp-for="FooterButtonColor" class="form-control font-monospace" placeholder="Ana renkle aynı" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Footer Tuş Stili <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <select asp-for="FooterButtonStyle" class="form-select">
                            <option value="">Genel tuş stiliyle aynı</option>
                            <option value="solid">Dolu (Solid)</option>
                            <option value="outline">Çerçeveli (Outline)</option>
                            <option value="ghost">Şeffaf (Ghost)</option>
                        </select>
                    </div>
                </div>

                <h6 class="fw-bold text-secondary text-uppercase small mb-3">Tipografi</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Genel Yazı Tipi <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <input asp-for="FontFamily" class="form-control font-monospace" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Başlık Yazı Tipi <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <input asp-for="HeadingFontFamily" class="form-control font-monospace" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Ana Başlık Boyutu <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <input asp-for="HeadingFontSize" class="form-control font-monospace" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Alt Başlık Boyutu <span class="text-muted fw-normal">isteğe bağlı</span></label>
                        <input asp-for="SubheadingFontSize" class="form-control font-monospace" />
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="horizon-card sticky-top" style="top: 80px;">
            <h6 class="fw-bold mb-3">Canlı Önizleme</h6>
            <div id="livePreview" style="border-radius:16px; overflow:hidden; border:2px solid;">
                <div id="prev-header" style="padding:16px;">
                    <div class="fw-bold text-white mb-1">Şirket Adı</div>
                    <div style="color:rgba(255,255,255,.8); font-size:13px;">Dükkan Adı</div>
                </div>
                <div id="prev-body" style="padding:16px;">
                    <div id="prev-category" style="padding:12px; margin-bottom:12px;">
                        <div id="prev-category-title" style="font-weight:600; margin-bottom:4px;">Kategori Başlığı</div>
                        <div id="prev-muted" style="font-size:12px;">3 ürün</div>
                    </div>
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 12px;" id="prev-product-card">
                        <div>
                            <div id="prev-product-title" style="font-weight:600; font-size:14px;">Ürün Adı</div>
                            <div id="prev-price" style="font-size:13px;">49,90 ₺</div>
                        </div>
                        <span id="prev-btn" style="color:#fff; padding:6px 14px; font-size:12px; font-weight:600;">Ekle</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.color-trigger').forEach(picker => {
            const targetName = picker.dataset.target;
            const textInput = document.querySelector(`input[name="${targetName}"]`);
            if (!textInput) return;

            const hex = textInput.value.trim();
            if (/^#[0-9a-fA-F]{6}$/.test(hex)) picker.value = hex;

            picker.addEventListener('input', () => { textInput.value = picker.value; updatePreview(); });
            textInput.addEventListener('input', () => {
                const h = textInput.value.trim();
                if (/^#[0-9a-fA-F]{6}$/.test(h)) picker.value = h;
                updatePreview();
            });
        });

        function getVal(name) { return document.querySelector(`input[name="${name}"]`)?.value || ''; }

        function updatePreview() {
            const primary = getVal('PrimaryColor') || '#688745';
            const bg = getVal('BackgroundColor') || '#f8fafc';
            const surface = getVal('SurfaceColor') || '#ffffff';
            const text = getVal('TextColor') || '#1e293b';
            const muted = getVal('MutedColor') || '#64748b';
            const radius = document.querySelector('input[name="BorderRadius"]')?.value || '24px';

            document.getElementById('livePreview').style.borderColor = primary;
            document.getElementById('prev-header').style.background = primary;
            document.getElementById('prev-body').style.background = bg;
            document.getElementById('prev-category').style.background = surface;
            document.getElementById('prev-category').style.borderRadius = radius;
            document.getElementById('prev-product-card').style.background = surface;
            document.getElementById('prev-product-card').style.borderRadius = radius;
            document.getElementById('prev-category-title').style.color = text;
            document.getElementById('prev-muted').style.color = muted;
            document.getElementById('prev-product-title').style.color = text;
            document.getElementById('prev-price').style.color = muted;
            document.getElementById('prev-btn').style.background = primary;
            document.getElementById('prev-btn').style.borderRadius = radius;
        }

        document.querySelector('input[name="BorderRadius"]').addEventListener('input', updatePreview);
        updatePreview();
    </script>
}
