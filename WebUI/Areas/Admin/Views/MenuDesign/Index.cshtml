@using Application.MenuDesigns.DTOs
@model List<MenuDesignDTO>

@{
    ViewData["Title"] = "Menü Tasarımları";
}

<div class="row">
    <div class="col-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1">Menü Tasarımları</h4>
                    <p class="text-secondary small mb-0">Müşterilerin seçebileceği hazır tema tasarımlarını yönetin.</p>
                </div>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i> Yeni Tasarım
                </a>
            </div>

            @if (Model.Count == 0)
            {
                <div class="text-center py-5 text-secondary">
                    <i class="fas fa-palette fa-3x mb-3 d-block opacity-25"></i>
                    <h5>Henüz tasarım yok</h5>
                    <p class="small">Müşterilerin menülerine uygulayabileceği tasarımlar oluşturun.</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> İlk Tasarımı Oluştur
                    </a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var d in Model)
                    {
                        <div class="col-md-4 col-lg-3">
                            <div class="design-card" data-tummenu-click-url="@Url.Action("Edit", new { id = d.Id })" style="border-radius:16px; overflow:hidden; border:2px solid @d.PrimaryColor; background:@d.BackgroundColor;">
                                <div class="design-card-header p-3" style="background:@d.PrimaryColor;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-white small">@d.Name</span>
                                        @if (d.IsDefault)
                                        {
                                            <span class="badge bg-white text-dark" style="font-size:10px;">Varsayılan</span>
                                        }
                                    </div>
                                    <div class="small text-white opacity-75 mt-1">/@d.Slug</div>
                                </div>

                                <div class="design-card-body p-3" style="color:@d.TextColor;">
                                    <div class="d-flex gap-2 mb-3 flex-wrap">
                                        <span class="color-swatch" title="Ana Renk" style="background:@d.PrimaryColor;"></span>
                                        <span class="color-swatch" title="Koyu Ana" style="background:@d.PrimaryDarkColor;"></span>
                                        <span class="color-swatch" title="Vurgu" style="background:@d.AccentColor;"></span>
                                        <span class="color-swatch" title="Arka Plan" style="background:@d.BackgroundColor; border:1px solid #ddd;"></span>
                                        <span class="color-swatch" title="Yüzey" style="background:@d.SurfaceColor; border:1px solid #ddd;"></span>
                                        <span class="color-swatch" title="Metin" style="background:@d.TextColor; border:1px solid #ddd;"></span>
                                    </div>

                                    <div class="design-preview-mini p-2 rounded mb-3" style="background:@d.SurfaceColor;">
                                        <div class="small fw-bold mb-1" style="color:@d.TextColor;">Örnek Menü</div>
                                        <div class="small mb-2" style="color:@d.MutedColor;">Bir kategori başlığı</div>
                                        <span class="preview-btn" style="background:@d.PrimaryColor; color:#fff; border-radius:@d.BorderRadius; padding:4px 12px; font-size:11px; display:inline-block;">Buton</span>
                                    </div>

                                    <div class="small text-muted mb-3">
                                        <span class="me-2">Sıra: @d.SortOrder</span>
                                        <span>Radius: @d.BorderRadius</span>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary flex-fill">
                                            <i class="fas fa-edit me-1"></i> Düzenle
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@d.Id" method="post" id="del-@d.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="TumMenuAlerts.confirm('Bu tasarımı silmek istediğinize emin misiniz?', 'Bu tasarımı kullanan menüler varsayılan görünüme döner.', 'Evet, Sil!').then(r => { if(r) document.getElementById('del-@d.Id').submit(); })">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .color-swatch {
        display: inline-block;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .design-card { transition: box-shadow .2s; }
    .design-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,.12); }
</style>
