@using Application.Support.DTOs
@using Domain.Entities
@model OwnerIssueReportListDTO
@{
    ViewData["Title"] = "Hata Bildirimleri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var currentStatus = ViewBag.CurrentStatus as IssueReportStatus?;
    var reports = Model.Reports;
}

<style>
    .issue-card {
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.07) !important;
    }
    .issue-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,.1) !important;
    }
    .issue-card .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }
    .issue-card .card-top {
        padding: 16px;
        border-bottom: 1px solid rgba(0,0,0,.06);
    }
    .issue-card .card-preview {
        padding: 14px 16px;
        font-size: .82rem;
        color: #6c757d;
        line-height: 1.5;
        min-height: 60px;
    }
    .issue-card .card-footer-row {
        padding: 10px 16px;
        border-top: 1px solid rgba(0,0,0,.06);
        font-size: .75rem;
        color: #adb5bd;
    }
    /* Modal detail */
    .detail-section-title {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #6c757d;
        margin-bottom: 4px;
    }
    .detail-text-box {
        background: #f8f9fa;
        border: 1px solid rgba(0,0,0,.06);
        border-radius: 8px;
        padding: 10px 12px;
        font-size: .83rem;
        white-space: pre-wrap;
        line-height: 1.6;
    }
    /* Status pill tabs */
    .status-tab {
        border-radius: 20px;
        padding: 5px 14px;
        font-size: .8rem;
        font-weight: 500;
        border: 1px solid transparent;
        text-decoration: none;
        color: #6c757d;
        transition: all .15s;
    }
    .status-tab:hover { background: #f1f3f5; color: #343a40; }
    .status-tab.active { color: #fff; border-color: transparent; }
    /* Summary bar */
    .summary-stat { text-align:center; }
    .summary-stat .stat-num { font-size: 1.5rem; font-weight: 700; line-height: 1; }
    .summary-stat .stat-lbl { font-size: .72rem; color: #6c757d; margin-top: 2px; }

    html.dark-mode .issue-card,
    body.dark-mode .issue-card {
        border-color: rgba(163, 174, 208, 0.14) !important;
    }

    html.dark-mode .issue-card .card-top,
    body.dark-mode .issue-card .card-top,
    html.dark-mode .issue-card .card-footer-row,
    body.dark-mode .issue-card .card-footer-row {
        border-color: rgba(163, 174, 208, 0.12) !important;
    }

    html.dark-mode .issue-card .card-preview,
    body.dark-mode .issue-card .card-preview,
    html.dark-mode .detail-section-title,
    body.dark-mode .detail-section-title,
    html.dark-mode .summary-stat .stat-lbl,
    body.dark-mode .summary-stat .stat-lbl {
        color: var(--horizon-text-secondary);
    }

    html.dark-mode .detail-text-box,
    body.dark-mode .detail-text-box {
        background: rgba(11, 20, 55, 0.72);
        border-color: rgba(163, 174, 208, 0.14);
        color: var(--horizon-text-primary);
    }

    html.dark-mode .status-tab,
    body.dark-mode .status-tab {
        color: var(--horizon-text-secondary);
    }

    html.dark-mode .status-tab:hover,
    body.dark-mode .status-tab:hover {
        background: rgba(117, 81, 255, 0.08);
        color: var(--horizon-text-primary);
    }
</style>

<div class="container-fluid py-4">

    @* Başlık + özet istatistik bar *@
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <h4 class="mb-1 fw-bold">Hata Bildirimleri</h4>
            <p class="text-muted small mb-0">Owner'lar tarafından gönderilen hata raporları</p>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <div class="card border-0 shadow-sm px-4 py-2 d-flex flex-row gap-4">
                <div class="summary-stat">
                    <div class="stat-num text-danger">@Model.OpenCount</div>
                    <div class="stat-lbl">Yeni</div>
                </div>
                <div class="summary-stat">
                    <div class="stat-num text-warning">@Model.InProgressCount</div>
                    <div class="stat-lbl">İnceleniyor</div>
                </div>
                <div class="summary-stat">
                    <div class="stat-num text-success">@Model.ResolvedCount</div>
                    <div class="stat-lbl">Çözüldü</div>
                </div>
                <div class="summary-stat">
                    <div class="stat-num text-secondary">@Model.ClosedCount</div>
                    <div class="stat-lbl">Hatalı İstek</div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Filtre sekmeleri *@
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="status-tab @(currentStatus == null ? "active bg-dark" : "")"
           href="@Url.Action("Index", "AdminSupport", new { area = "Admin" })">
            Tümü <span class="ms-1 opacity-75">@Model.TotalCount</span>
        </a>
        @foreach (var s in Enum.GetValues<IssueReportStatus>())
        {
            var tabCount = s switch
            {
                IssueReportStatus.Open => Model.OpenCount,
                IssueReportStatus.InProgress => Model.InProgressCount,
                IssueReportStatus.Resolved => Model.ResolvedCount,
                IssueReportStatus.Closed => Model.ClosedCount,
                _ => 0
            };
            <a class="status-tab @(currentStatus == s ? "active " + StatusBgClass(s) : "")"
               href="@Url.Action("Index", "AdminSupport", new { area = "Admin", status = (int)s })">
                <span class="status-dot @StatusDotClass(s) me-1" style="vertical-align:middle"></span>
                @StatusLabel(s)
                <span class="ms-1 opacity-75">@tabCount</span>
            </a>
        }
    </div>

    @if (!reports.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-check-circle fa-3x mb-3 opacity-25"></i>
            <p class="mb-0">Bu filtrede bildirim bulunmuyor.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var r in reports)
            {
                <div class="col">
                    <div class="card shadow-sm issue-card h-100"
                         onclick="openDetail('@r.Id')"
                         title="Detayı gör">

                        @* Sağ üst köşe durum göstergesi *@
                        <div class="card-top d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center gap-2 flex-wrap" style="max-width:75%">
                                <span class="badge @StatusBadgeClass(r.Status) d-flex align-items-center gap-1">
                                    <span class="status-dot bg-white opacity-75"></span>
                                    @StatusLabel(r.Status)
                                </span>
                                <span class="fw-semibold small text-truncate" style="max-width:160px">@r.OwnerName</span>
                            </div>
                            <div class="text-end">
                                <div class="text-muted" style="font-size:.7rem">@r.CreatedAt.ToString("dd.MM.yyyy")</div>
                                <div class="text-muted" style="font-size:.7rem">@r.CreatedAt.ToString("HH:mm")</div>
                            </div>
                        </div>

                        @* Önizleme metni *@
                        <div class="card-preview">
                            <div class="text-dark small fw-medium mb-1 text-truncate">
                                <i class="fas fa-link me-1 opacity-50" style="font-size:.7rem"></i>@r.CurrentPageTitle
                            </div>
                            @{
                                var preview = r.Description.Length > 120 ? r.Description[..120] + "…" : r.Description;
                            }
                            @preview
                        </div>

                        @* Footer: şirket + admin notu varsa *@
                        <div class="card-footer-row d-flex justify-content-between align-items-center">
                            <span class="text-truncate" style="max-width:70%">
                                @if (r.CompanyTitle != null)
                                {
                                    <i class="fas fa-building me-1"></i>@r.CompanyTitle
                                }
                                else
                                {
                                    <span class="opacity-50">—</span>
                                }
                            </span>
                            @if (!string.IsNullOrWhiteSpace(r.AdminNote))
                            {
                                <span class="text-primary" title="Admin notu var"><i class="fas fa-sticky-note"></i></span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Detay modal *@
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div>
                    <span id="modalBadge" class="badge me-2"></span>
                    <strong id="modalOwner" class="small"></strong>
                    <span id="modalEmail" class="text-muted small ms-1"></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <div class="d-flex flex-wrap gap-2 mb-3 small text-muted" id="modalMeta"></div>

                <div class="mb-3">
                    <div class="detail-section-title">Karşılaşılan Hata</div>
                    <div class="detail-text-box" id="modalDescription"></div>
                </div>
                <div class="mb-3" id="modalAttemptedWrap">
                    <div class="detail-section-title">Yapmak İstediği İşlem</div>
                    <div class="detail-text-box" id="modalAttempted"></div>
                </div>
                <div id="modalAdminNoteWrap" class="mb-3">
                    <div class="detail-section-title text-primary">Admin Notu</div>
                    <div class="detail-text-box border border-primary border-opacity-25" id="modalAdminNote"></div>
                </div>

                <hr class="my-3">

                @* Durum güncelleme formu *@
                <form id="modalForm" asp-action="UpdateStatus" asp-controller="AdminSupport" asp-area="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalReportId" />
                    <input type="hidden" name="returnStatus" value="@((int?)currentStatus)" />

                    <div class="row g-3 align-items-end">
                        <div class="col-sm-5">
                            <label class="form-label small fw-semibold mb-1">Durum</label>
                            <div class="d-flex flex-wrap gap-2" id="modalStatusPills">
                                @foreach (var s in Enum.GetValues<IssueReportStatus>())
                                {
                                    <label class="status-pill-label">
                                        <input type="radio" name="status" value="@((int)s)"
                                               class="status-radio d-none"
                                               data-badge="@StatusBadgeClass(s)"
                                               data-label="@StatusLabel(s)" />
                                        <span class="btn btn-sm @StatusBadgeClass(s) bg-opacity-25 border-0 status-pill-btn"
                                              style="color:inherit">
                                            <span class="status-dot @StatusDotClass(s) me-1" style="vertical-align:middle"></span>
                                            @StatusLabel(s)
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="col-sm-7">
                            <label class="form-label small fw-semibold mb-1">Admin Notu</label>
                            <textarea name="adminNote" id="modalAdminNoteInput"
                                      class="form-control form-control-sm" rows="2"
                                      placeholder="İç not (opsiyonel)…"></textarea>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary btn-sm px-4">
                            <i class="fas fa-save me-1"></i>Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const reports = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Reports.Select(r => new {
        id          = r.Id,
        ownerName   = r.OwnerName,
        ownerEmail  = r.OwnerEmail,
        companyTitle= r.CompanyTitle,
        description = r.Description,
        attempted   = r.AttemptedAction,
        pageTitle   = r.CurrentPageTitle,
        pageUrl     = r.CurrentPageUrl,
        browser     = r.BrowserInfo,
        viewport    = r.Viewport,
        status      = (int)r.Status,
        adminNote   = r.AdminNote,
        createdAt   = r.CreatedAt.ToString("dd.MM.yyyy HH:mm"),
        resolvedAt  = r.ResolvedAt.HasValue ? r.ResolvedAt.Value.ToString("dd.MM.yyyy HH:mm") : null
    })));

    const statusLabels = { 0:'Yeni', 1:'İnceleniyor', 2:'Çözüldü', 3:'Hatalı İstek' };
    const statusBadge  = { 0:'bg-danger', 1:'bg-warning text-dark', 2:'bg-success', 3:'bg-secondary' };

    let modalInstance = null;

    function openDetail(id) {
        const r = reports.find(x => x.id === id);
        if (!r) return;

        document.getElementById('modalReportId').value = r.id;
        document.getElementById('modalOwner').textContent = r.ownerName;
        document.getElementById('modalEmail').textContent = '(' + r.ownerEmail + ')';

        const badge = document.getElementById('modalBadge');
        badge.className = 'badge me-2 ' + statusBadge[r.status];
        badge.textContent = statusLabels[r.status];

        // Meta bilgileri
        const meta = document.getElementById('modalMeta');
        meta.innerHTML = '';
        const metaItems = [
            { icon:'fa-link',    text: r.pageTitle, href: r.pageUrl },
            r.viewport  ? { icon:'fa-desktop', text: r.viewport }    : null,
            r.browser   ? { icon:'fa-globe',   text: r.browser }     : null,
            r.companyTitle ? { icon:'fa-building', text: r.companyTitle } : null,
            { icon:'fa-clock', text: r.createdAt },
            r.resolvedAt ? { icon:'fa-check-circle text-success', text: 'Çözüldü: ' + r.resolvedAt } : null
        ].filter(Boolean);
        metaItems.forEach(item => {
            const s = document.createElement('span');
            s.className = 'd-flex align-items-center gap-1';
            if (item.href) {
                s.innerHTML = `<i class="fas ${item.icon} opacity-50"></i><a href="${item.href}" target="_blank" class="text-decoration-none text-muted">${escHtml(item.text)}</a>`;
            } else {
                s.innerHTML = `<i class="fas ${item.icon} opacity-50"></i>${escHtml(item.text)}`;
            }
            meta.appendChild(s);
        });

        document.getElementById('modalDescription').textContent = r.description;

        const attemptWrap = document.getElementById('modalAttemptedWrap');
        if (r.attempted) {
            document.getElementById('modalAttempted').textContent = r.attempted;
            attemptWrap.style.display = '';
        } else {
            attemptWrap.style.display = 'none';
        }

        const noteWrap = document.getElementById('modalAdminNoteWrap');
        if (r.adminNote) {
            document.getElementById('modalAdminNote').textContent = r.adminNote;
            noteWrap.style.display = '';
        } else {
            noteWrap.style.display = 'none';
        }

        document.getElementById('modalAdminNoteInput').value = r.adminNote ?? '';

        // Durum radio pill'lerini ayarla
        document.querySelectorAll('.status-radio').forEach(radio => {
            const selected = parseInt(radio.value) === r.status;
            radio.checked = selected;
            const btn = radio.nextElementSibling;
            btn.style.opacity = selected ? '1' : '0.45';
            btn.style.fontWeight = selected ? '700' : '400';
        });

        if (!modalInstance) {
            modalInstance = new bootstrap.Modal(document.getElementById('detailModal'));
        }
        modalInstance.show();
    }

    // Pill radio görsel güncelleme
    document.querySelectorAll('.status-radio').forEach(radio => {
        radio.addEventListener('change', function () {
            document.querySelectorAll('.status-radio').forEach(r => {
                const btn = r.nextElementSibling;
                btn.style.opacity = r.checked ? '1' : '0.45';
                btn.style.fontWeight = r.checked ? '700' : '400';
            });
        });
    });

    function escHtml(str) {
        const d = document.createElement('div');
        d.appendChild(document.createTextNode(str ?? ''));
        return d.innerHTML;
    }
</script>
}

@functions {
    static string StatusLabel(IssueReportStatus s) => s switch
    {
        IssueReportStatus.Open       => "Yeni",
        IssueReportStatus.InProgress => "İnceleniyor",
        IssueReportStatus.Resolved   => "Çözüldü",
        IssueReportStatus.Closed     => "Hatalı İstek",
        _                            => s.ToString()
    };

    static string StatusBadgeClass(IssueReportStatus s) => s switch
    {
        IssueReportStatus.Open       => "bg-danger",
        IssueReportStatus.InProgress => "bg-warning text-dark",
        IssueReportStatus.Resolved   => "bg-success",
        IssueReportStatus.Closed     => "bg-secondary",
        _                            => "bg-light text-dark"
    };

    static string StatusBgClass(IssueReportStatus s) => s switch
    {
        IssueReportStatus.Open       => "bg-danger",
        IssueReportStatus.InProgress => "bg-warning text-dark",
        IssueReportStatus.Resolved   => "bg-success",
        IssueReportStatus.Closed     => "bg-secondary",
        _                            => "bg-secondary"
    };

    static string StatusDotClass(IssueReportStatus s) => s switch
    {
        IssueReportStatus.Open       => "bg-danger",
        IssueReportStatus.InProgress => "bg-warning",
        IssueReportStatus.Resolved   => "bg-success",
        IssueReportStatus.Closed     => "bg-secondary",
        _                            => "bg-secondary"
    };
}
