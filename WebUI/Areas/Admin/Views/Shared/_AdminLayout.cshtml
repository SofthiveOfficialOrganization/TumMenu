<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TumMenu Admin</title>
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Core CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin-tummenu.css" asp-append-version="true" />
    <script>
        // Apply dark mode BEFORE render to prevent white flash
        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark-mode');
        }
    </script>
    <link rel="stylesheet" href="~/css/skeleton.css" asp-append-version="true" />
</head>
<body class="horizon-admin">
    <div class="horizon-layout">
        <!-- Sidebar Overlay -->
        <div class="horizon-sidebar-overlay" id="sidebarOverlay"></div>
        
        <!-- Sidebar -->
        <aside class="horizon-sidebar">
            <div class="horizon-logo">
                TUM <span>MENU</span>
            </div>
            
            <ul class="horizon-menu">
                <li class="horizon-menu-item">
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="horizon-menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <div class="horizon-menu-icon"><i class="fas fa-home"></i></div>
                        <span>Panel</span>
                    </a>
                </li>

                @if (User.IsInRole("Admin"))
                {
                    <li class="horizon-menu-item">
                        <a href="@Url.Action("AllCompanies", "Company", new { area = "Admin" })" class="horizon-menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Company" && ViewContext.RouteData.Values["Action"]?.ToString() == "AllCompanies" ? "active" : "")">
                            <div class="horizon-menu-icon"><i class="fas fa-building"></i></div>
                            <span>Tüm Şirketler</span>
                        </a>
                    </li>
                }
                
                @if (User.IsInRole("Admin"))
                {
                    <li class="horizon-menu-item">
                        <a href="@Url.Action("Index", "Store", new { area = "Admin" })" class="horizon-menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Store" ? "active" : "")">
                            <div class="horizon-menu-icon"><i class="fas fa-store"></i></div>
                            <span>Tüm Dükkanlar</span>
                        </a>
                    </li>
                }
                
                @if (User.IsInRole("Owner"))
                {
                    <li class="horizon-menu-item">
                        <a href="@Url.Action("MyCompany", "Company", new { area = "Admin" })" class="horizon-menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Company" && ViewContext.RouteData.Values["Action"]?.ToString() == "Details" ? "active" : "")">
                            <div class="horizon-menu-icon"><i class="fas fa-building"></i></div>
                            <span>Şirketim</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Owner"))
                {
                    <li class="horizon-menu-item">
                        <a href="@Url.Action("Index", "Store", new { area = "Admin" })" class="horizon-menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Store" ? "active" : "")">
                            <div class="horizon-menu-icon"><i class="fas fa-store-alt"></i></div>
                            <span>Dükkanlarım</span>
                        </a>
                    </li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li class="horizon-menu-item">
                        <a href="@Url.Action("Index", "CategoryLibraryItem", new { area = "Admin" })" class="horizon-menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "CategoryLibraryItem" ? "active" : "")">
                            <div class="horizon-menu-icon">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M16 6.00008V4.2844C16 3.51587 16 3.13161 15.8387 2.88321C15.6976 2.66587 15.4776 2.5118 15.2252 2.45345C14.9366 2.38677 14.5755 2.51809 13.8532 2.78073L6.57982 5.4256C6.01064 5.63257 5.72605 5.73606 5.51615 5.91845C5.33073 6.07956 5.18772 6.28374 5.09968 6.51304C5 6.77264 5 7.07546 5 7.6811V12.0001M9 17.0001H15M9 13.5001H15M9 10.0001H15M8.2 21.0001H15.8C16.9201 21.0001 17.4802 21.0001 17.908 20.7821C18.2843 20.5903 18.5903 20.2844 18.782 19.9081C19 19.4802 19 18.9202 19 17.8001V9.20008C19 8.07997 19 7.51992 18.782 7.0921C18.5903 6.71577 18.2843 6.40981 17.908 6.21807C17.4802 6.00008 16.9201 6.00008 15.8 6.00008H8.2C7.0799 6.00008 6.51984 6.00008 6.09202 6.21807C5.71569 6.40981 5.40973 6.71577 5.21799 7.0921C5 7.51992 5 8.07997 5 9.20008V17.8001C5 18.9202 5 19.4802 5.21799 19.9081C5.40973 20.2844 5.71569 20.5903 6.09202 20.7821C6.51984 21.0001 7.07989 21.0001 8.2 21.0001Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <span>Kategori Kütüphanesi</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="horizon-menu-item">
                        <a href="@Url.Action("AllMenus", "Menu", new { area = "Admin" })" class="horizon-menu-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "AllMenus" ? "active" : "")">
                            <div class="horizon-menu-icon">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M16 6.00008V4.2844C16 3.51587 16 3.13161 15.8387 2.88321C15.6976 2.66587 15.4776 2.5118 15.2252 2.45345C14.9366 2.38677 14.5755 2.51809 13.8532 2.78073L6.57982 5.4256C6.01064 5.63257 5.72605 5.73606 5.51615 5.91845C5.33073 6.07956 5.18772 6.28374 5.09968 6.51304C5 6.77264 5 7.07546 5 7.6811V12.0001M9 17.0001H15M9 13.5001H15M9 10.0001H15M8.2 21.0001H15.8C16.9201 21.0001 17.4802 21.0001 17.908 20.7821C18.2843 20.5903 18.5903 20.2844 18.782 19.9081C19 19.4802 19 18.9202 19 17.8001V9.20008C19 8.07997 19 7.51992 18.782 7.0921C18.5903 6.71577 18.2843 6.40981 17.908 6.21807C17.4802 6.00008 16.9201 6.00008 15.8 6.00008H8.2C7.0799 6.00008 6.51984 6.00008 6.09202 6.21807C5.71569 6.40981 5.40973 6.71577 5.21799 7.0921C5 7.51992 5 8.07997 5 9.20008V17.8001C5 18.9202 5 19.4802 5.21799 19.9081C5.40973 20.2844 5.71569 20.5903 6.09202 20.7821C6.51984 21.0001 7.07989 21.0001 8.2 21.0001Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <span>Tüm Menüler</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Owner"))
                {
                    <li class="horizon-menu-item">
                        <a href="@Url.Action("MyMenus", "Menu", new { area = "Admin" })" class="horizon-menu-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "MyMenus" ? "active" : "")">
                            <div class="horizon-menu-icon">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M16 6.00008V4.2844C16 3.51587 16 3.13161 15.8387 2.88321C15.6976 2.66587 15.4776 2.5118 15.2252 2.45345C14.9366 2.38677 14.5755 2.51809 13.8532 2.78073L6.57982 5.4256C6.01064 5.63257 5.72605 5.73606 5.51615 5.91845C5.33073 6.07956 5.18772 6.28374 5.09968 6.51304C5 6.77264 5 7.07546 5 7.6811V12.0001M9 17.0001H15M9 13.5001H15M9 10.0001H15M8.2 21.0001H15.8C16.9201 21.0001 17.4802 21.0001 17.908 20.7821C18.2843 20.5903 18.5903 20.2844 18.782 19.9081C19 19.4802 19 18.9202 19 17.8001V9.20008C19 8.07997 19 7.51992 18.782 7.0921C18.5903 6.71577 18.2843 6.40981 17.908 6.21807C17.4802 6.00008 16.9201 6.00008 15.8 6.00008H8.2C7.0799 6.00008 6.51984 6.00008 6.09202 6.21807C5.71569 6.40981 5.40973 6.71577 5.21799 7.0921C5 7.51992 5 8.07997 5 9.20008V17.8001C5 18.9202 5 19.4802 5.21799 19.9081C5.40973 20.2844 5.71569 20.5903 6.09202 20.7821C6.51984 21.0001 7.07989 21.0001 8.2 21.0001Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <span>Menülerim</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="horizon-menu-item">
                        <a href="@Url.Action("Index", "Playground", new { area = "Admin" })" class="horizon-menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Playground" ? "active" : "")">
                            <div class="horizon-menu-icon"><i class="fas fa-flask"></i></div>
                            <span>UI Test</span>
                        </a>
                    </li>
                }

                <li class="horizon-menu-item">
                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="horizon-menu-link @(ViewContext.RouteData.Values["Area"]?.ToString() == "Identity" && ViewContext.RouteData.Values["Page"]?.ToString()?.StartsWith("/Account/Manage") == true ? "active" : "")">
                        <div class="horizon-menu-icon"><i class="fas fa-user"></i></div>
                        <span>Profil</span>
                    </a>
                </li>
                <li class="horizon-menu-item">
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Dashboard", new { area = "Admin" })" method="post">
                        <button type="submit" class="horizon-menu-link w-100 text-start border-0 bg-transparent">
                            <div class="horizon-menu-icon"><i class="fas fa-lock"></i></div>
                            <span>Çıkış Yap</span>
                        </button>
                    </form>
                </li>
            </ul>
        </aside>

        <!-- Main Content -->
        <div class="horizon-main">
            <!-- Navbar -->
            <nav class="horizon-navbar">
                <div class="d-flex align-items-center">
                    <button class="horizon-hamburger" id="sidebarToggle" aria-label="Menüyü aç">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="horizon-breadcrumb">
                        <a href="#">Sayfalar</a> / <span class="current-path">@ViewData["Title"]</span>
                    <div class="current-page">@ViewData["Title"]</div>
                    </div>
                </div>
                
@using Microsoft.AspNetCore.Identity
@using Domain.Entities
@inject UserManager<ApplicationUser> UserManager

@* ... existing code for Head ... *@

                <div class="horizon-navbar-actions">
                    <input type="text" class="horizon-search" placeholder="Ara...">
                    
                    <i class="far fa-bell horizon-navbar-icon"></i>
                    <i class="far fa-moon horizon-navbar-icon" id="theme-toggle"></i>
                    <i class="fas fa-info-circle horizon-navbar-icon"></i>
                    
                    <div class="d-flex align-items-center ms-3">
                         <div class="text-end me-2 d-none d-md-block">
                            <div class="fw-bold small mb-0">@User.Identity?.Name</div>
                            <div class="text-xs text-secondary">
                                @{
                                    var user = await UserManager.GetUserAsync(User);
                                    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
                                    @string.Join(", ", roles)
                                }
                            </div>
                        </div>
                        <div class="horizon-avatar">
                            @User.Identity?.Name?.Substring(0, 1).ToUpper()
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Skeleton Loading Screen -->
            <div class="skeleton-screen" id="skeletonScreen">
                <div class="skeleton-wrapper">
                    <!-- Skeleton: Stat Cards Row -->
                    <div class="row mb-4">
                        <div class="col-6 col-md-3">
                            <div class="skeleton-card">
                                <div class="skeleton-line" style="width:40%;height:14px;margin-bottom:12px;"></div>
                                <div class="skeleton-line" style="width:60%;height:28px;margin-bottom:8px;"></div>
                                <div class="skeleton-line" style="width:30%;height:12px;"></div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="skeleton-card">
                                <div class="skeleton-line" style="width:50%;height:14px;margin-bottom:12px;"></div>
                                <div class="skeleton-line" style="width:55%;height:28px;margin-bottom:8px;"></div>
                                <div class="skeleton-line" style="width:25%;height:12px;"></div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3 d-none d-md-block">
                            <div class="skeleton-card">
                                <div class="skeleton-line" style="width:45%;height:14px;margin-bottom:12px;"></div>
                                <div class="skeleton-line" style="width:50%;height:28px;margin-bottom:8px;"></div>
                                <div class="skeleton-line" style="width:35%;height:12px;"></div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3 d-none d-md-block">
                            <div class="skeleton-card">
                                <div class="skeleton-line" style="width:55%;height:14px;margin-bottom:12px;"></div>
                                <div class="skeleton-line" style="width:45%;height:28px;margin-bottom:8px;"></div>
                                <div class="skeleton-line" style="width:40%;height:12px;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Skeleton: Main Card with Table -->
                    <div class="skeleton-card">
                        <!-- Card header -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <div class="skeleton-line" style="width:180px;height:22px;margin-bottom:8px;"></div>
                                <div class="skeleton-line" style="width:260px;height:13px;"></div>
                            </div>
                            <div class="skeleton-line" style="width:120px;height:38px;border-radius:16px;"></div>
                        </div>

                        <!-- Table rows -->
                        <div style="border-top:1px solid rgba(163,174,208,0.15);padding-top:16px;">
                            @for (int i = 0; i < 5; i++)
                            {
                                <div class="d-flex align-items-center py-3" style="border-bottom:1px solid rgba(163,174,208,0.08);">
                                    <div class="skeleton-line skeleton-circle" style="width:40px;height:40px;flex-shrink:0;margin-right:14px;"></div>
                                    <div style="flex:1;">
                                        <div class="skeleton-line" style="width:@(40 + i * 8)%;height:14px;margin-bottom:6px;"></div>
                                        <div class="skeleton-line" style="width:@(25 + i * 5)%;height:11px;"></div>
                                    </div>
                                    <div class="skeleton-line d-none d-md-block" style="width:80px;height:14px;margin-left:20px;"></div>
                                    <div class="skeleton-line d-none d-md-block" style="width:60px;height:14px;margin-left:20px;"></div>
                                    <div class="skeleton-line" style="width:32px;height:32px;border-radius:8px;margin-left:20px;"></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Body -->
            <div class="horizon-content" id="realContent">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="horizon-footer">
                <div>
                    &copy; @DateTime.Now.Year TumMenu. Tüm Hakları Saklıdır.
                </div>
                <div>
                    <a href="#">Destek</a>
                    <a href="#">Lisans</a>
                    <a href="#">Kullanım Şartları</a>
                    <a href="#">Blog</a>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Skeleton → Content Swap -->
    <script>
        (function() {
            function showContent() {
                var skeleton = document.getElementById('skeletonScreen');
                var content = document.getElementById('realContent');
                if (skeleton && content) {
                    skeleton.classList.add('skeleton-hidden');
                    content.classList.add('content-loaded');
                }
            }
            // Show content when page fully loads (fonts, images, etc.)
            if (document.readyState === 'complete') {
                showContent();
            } else {
                window.addEventListener('load', showContent);
            }
            // Safety timeout: max 3 seconds of skeleton
            setTimeout(showContent, 3000);
        })();
    </script>
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/tummenu-alerts.js" asp-append-version="true"></script>
    
    <script>
        $(document).ready(function() {
            var successMessage = @Json.Serialize(TempData["Success"]);
            var errorMessage = @Json.Serialize(TempData["Error"]);

            if (successMessage) {
                TumMenuAlerts.toast('success', successMessage);
            }

            if (errorMessage) {
                TumMenuAlerts.toast('error', errorMessage);
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function() {
            // Submenu toggle
            $('.horizon-menu-parent').on('click', function(e) {
                e.preventDefault();
                const submenuId = $(this).data('submenu');
                const submenu = $('#' + submenuId);
                
                $(this).toggleClass('open');
                submenu.toggleClass('open');
            });

            // Auto-open submenu if a child is active
            $('.horizon-submenu-link.active').closest('.horizon-submenu').addClass('open').prev('.horizon-menu-parent').addClass('open');
        });
    </script>

    <script>
        $(document).ready(function() {
            const sidebar = $('.horizon-sidebar');
            const overlay = $('#sidebarOverlay');
            const toggleBtn = $('#sidebarToggle');

            function openSidebar() {
                sidebar.addClass('sidebar-open');
                overlay.addClass('active');
                $('body').css('overflow', 'hidden');
            }

            function closeSidebar() {
                sidebar.removeClass('sidebar-open');
                overlay.removeClass('active');
                $('body').css('overflow', '');
            }

            toggleBtn.on('click', function() {
                if (sidebar.hasClass('sidebar-open')) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            });

            overlay.on('click', function() {
                closeSidebar();
            });

            // Close sidebar when a menu link is clicked (mobile)
            $('.horizon-menu-link, .horizon-submenu-link').on('click', function() {
                if ($(window).width() <= 1200) {
                    closeSidebar();
                }
            });

            // Close on window resize if going above breakpoint
            $(window).on('resize', function() {
                if ($(window).width() > 1200) {
                    closeSidebar();
                }
            });
        });
    </script>

    <script>
        $(document).ready(function() {
            const themeToggle = $('#theme-toggle');
            const body = $('body');
            const theme = localStorage.getItem('theme');

            // Sync icon state with saved theme (class already applied in <head>)
            if (theme === 'dark') {
                body.addClass('dark-mode');
                themeToggle.removeClass('fa-moon').addClass('fa-sun');
            }

            // Toggle theme on click
            themeToggle.on('click', function() {
                body.toggleClass('dark-mode');
                $('html').toggleClass('dark-mode');
                
                if (body.hasClass('dark-mode')) {
                    localStorage.setItem('theme', 'dark');
                    themeToggle.removeClass('fa-moon').addClass('fa-sun');
                } else {
                    localStorage.setItem('theme', 'light');
                    themeToggle.removeClass('fa-sun').addClass('fa-moon');
                }
            });
        });
    </script>
</body>
</html>
