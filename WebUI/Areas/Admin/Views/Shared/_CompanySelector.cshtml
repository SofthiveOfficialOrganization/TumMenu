@* 
    _CompanySelector.cshtml 
    Reusable Company Selector Modal
*@

<div class="modal fade" id="companySelectorModal" tabindex="-1" aria-labelledby="companySelectorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="companySelectorModalLabel">Şirket Seç</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" id="companySearchInput" placeholder="Şirket ara...">
                </div>
                
                <div id="companyListContainer" class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                    <!-- Companies will be loaded here -->
                    <div class="text-center py-3 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span class="ms-2">Yükleniyor...</span>
                    </div>
                </div>

                <div id="companyPagination" class="d-flex justify-content-center mt-3">
                    <!-- Pagination controls -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
            </div>
        </div>
    </div>
</div>

<script>
    const CompanySelector = (function() {
        let currentPage = 0;
        let currentSearchTerm = '';
        let onSelectCallback = null;
        const pageSize = 10;

        function init(callback) {
            onSelectCallback = callback;
            
            const modalEl = document.getElementById('companySelectorModal');
            const searchInput = document.getElementById('companySearchInput');
            
            if (modalEl) {
                modalEl.addEventListener('show.bs.modal', function() {
                    loadCompanies(0);
                    searchInput.value = '';
                    searchInput.focus();
                });
            }

            if (searchInput) {
                let debounceTimer;
                searchInput.addEventListener('input', function(e) {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        currentSearchTerm = e.target.value;
                        loadCompanies(0);
                    }, 300);
                });
            }
        }

        async function loadCompanies(page) {
            currentPage = page;
            const container = document.getElementById('companyListContainer');
            const pagination = document.getElementById('companyPagination');
            
            container.innerHTML = `
                <div class="text-center py-3 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2">Yükleniyor...</span>
                </div>`;

            try {
                const url = `/admin/Company/Search?term=${encodeURIComponent(currentSearchTerm)}&page=${page}&pageSize=${pageSize}`;
                const response = await fetch(url);
                if (!response.ok) throw new Error('Network response was not ok');
                
                const data = await response.json();
                renderList(data.items, container);
                renderPagination(data, pagination);
                
            } catch (error) {
                console.error('Error loading companies:', error);
                container.innerHTML = `<div class="text-center py-3 text-danger">Hata oluştu. Lütfen tekrar deneyin.</div>`;
            }
        }

        function renderList(items, container) {
            if (!items || items.length === 0) {
                container.innerHTML = `<div class="text-center py-3 text-muted">Sonuç bulunamadı.</div>`;
                return;
            }

            let html = '';
            items.forEach(item => {
                html += `
                    <button type="button" class="list-group-item list-group-item-action company-item" data-id="${item.id}" data-title="${item.title}">
                        <div class="d-flex w-100 justify-content-between align-items-center">
                            <h6 class="mb-0 text-truncate">${item.title}</h6>
                            <small class="text-muted"><i class="fas fa-chevron-right"></i></small>
                        </div>
                    </button>`;
            });

            container.innerHTML = html;

            // Add click listeners
            container.querySelectorAll('.company-item').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const title = this.dataset.title;
                    if (onSelectCallback) {
                        onSelectCallback(id, title);
                    }
                    const modal = bootstrap.Modal.getInstance(document.getElementById('companySelectorModal'));
                    modal.hide();
                });
            });
        }

        function renderPagination(data, container) {
            if (data.pages <= 1) {
                container.innerHTML = '';
                return;
            }

            let html = '<nav><ul class="pagination pagination-sm mb-0">';
            
            // Previous
            html += `
                <li class="page-item ${data.hasPrevious ? '' : 'disabled'}">
                    <button class="page-link" onclick="CompanySelector.goToPage(${data.index - 1})" ${!data.hasPrevious ? 'disabled' : ''}>
                        <i class="fas fa-chevron-left"></i>
                    </button>
                </li>`;

            // Page Info
            html += `
                <li class="page-item disabled">
                    <span class="page-link text-dark border-0">
                        ${data.index + 1} / ${data.pages}
                    </span>
                </li>`;

            // Next
            html += `
                <li class="page-item ${data.hasNext ? '' : 'disabled'}">
                    <button class="page-link" onclick="CompanySelector.goToPage(${data.index + 1})" ${!data.hasNext ? 'disabled' : ''}>
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </li>`;
            
            html += '</ul></nav>';
            container.innerHTML = html;
        }

        return {
            init: init,
            goToPage: loadCompanies,
            open: function() {
                const modal = new bootstrap.Modal(document.getElementById('companySelectorModal'));
                modal.show();
            }
        };
    })();
</script>
