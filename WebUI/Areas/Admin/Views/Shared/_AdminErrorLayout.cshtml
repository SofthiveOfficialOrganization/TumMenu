<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TumMenu Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin-tummenu.css" asp-append-version="true" />
</head>
<body class="horizon-admin">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none fw-bold text-primary">
                TUM <span class="text-dark">MENU</span>
            </a>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-home me-1"></i> Panele Dön
            </a>
        </div>
        @RenderBody()
    </div>
</body>
</html>
