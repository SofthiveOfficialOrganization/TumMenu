@model PaginatedListDTO<ProductDTO>

@{
    ViewData["Title"] = "Ürünler";
    var currentPageUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="horizon-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="Create" asp-route-returnUrl="@currentPageUrl" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Ürün
        </a>
    </div>

    <!-- Filtreler -->
    <div class="mb-4">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="Search" class="form-control" placeholder="Ürün ara..." value="@Context.Request.Query["Search"]">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100">Ara</button>
            </div>
        </form>
    </div>

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Ürün Adı</th>
                        <th>Kategori</th>
                        <th>Fiyat</th>
                        <th>Durum</th>
                        <th>Sıra</th>
                        <th style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@item.Title</div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <small class="text-muted">@item.Description</small>
                                }
                            </td>
                            <td>
                                <!-- Kategori ADI gelmiyor şu an DTO'da, sadece ID var ise.
                                     DTO'ya tekrar bakmak lazım. CategoryId var. Kategori ismi yoksa boş bırakacağız veya ID basacağız şimdilik. 
                                     Model'de CategoryName yok görünüyor.
                                -->
                                @item.CategoryId
                            </td>
                            <td>
                                <span>@item.BasePrice.ToString("C2")</span>
                                @if (item.Prices.Count > 0)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 ms-1">+@item.Prices.Count seçenek</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pasif</span>
                                }
                            </td>
                            <td>@item.SortOrder</td>
                            <td class="text-center text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="@currentPageUrl" class="btn btn-sm btn-outline-secondary me-1" title="Detaylar">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnUrl="@currentPageUrl" class="btn btn-sm btn-outline-primary me-1" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id" title="Sil">
                                    <i class="fas fa-trash"></i>
                                </button>

                                <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Ürünü Sil</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p><strong>@item.Title</strong> ürününü silmek istediğinize emin misiniz?</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                                <form asp-action="Delete" asp-route-id="@item.Id" asp-route-categoryId="@item.CategoryId" asp-route-returnUrl="@currentPageUrl" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Evet, Sil</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <tummenu-pagination index="@Model.Index"
                            pages="@Model.Pages"
                            has-previous="@Model.HasPrevious"
                            has-next="@Model.HasNext"
                            show-numbers="false" />

    }
    else
    {
        <div class="alert alert-info">
            Kayıtlı ürün bulunamadı.
        </div>
    }
</div>
