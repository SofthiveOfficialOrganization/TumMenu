@model Application.Products.Commands.CreateProductCommand

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <div class="mb-4 text-center">
                <h3 class="fw-bold text-primary">@ViewData["Title"]</h3>
                <p class="text-secondary">Kategoriye yeni bir ürün ekleyin.</p>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input asp-for="CategoryId" type="hidden" />

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold text-secondary small text-uppercase">Ürün Adı</label>
                    <input asp-for="Title" class="form-control" placeholder="Örn: Karışık Pizza" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold text-secondary small text-uppercase">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Ürün içerik bilgisi vb."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-4">
                        <label asp-for="BasePrice" class="form-label fw-bold text-secondary small text-uppercase">Fiyat (₺)</label>
                        <div class="input-group">
                            <input asp-for="BasePrice" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span class="input-group-text">₺</span>
                        </div>
                        <span asp-validation-for="BasePrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label asp-for="EstimatedPreparationTimeInMinutes" class="form-label fw-bold text-secondary small text-uppercase">Hazırlık Süresi</label>
                        <div class="input-group">
                            <input asp-for="EstimatedPreparationTimeInMinutes" class="form-control" type="number" placeholder="15" />
                            <span class="input-group-text">dk</span>
                        </div>
                        <span asp-validation-for="EstimatedPreparationTimeInMinutes" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label asp-for="SortOrder" class="form-label fw-bold text-secondary small text-uppercase">Sıralama</label>
                        <input asp-for="SortOrder" class="form-control" type="number" placeholder="1" />
                        <span asp-validation-for="SortOrder" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Allergens" class="form-label fw-bold text-secondary small text-uppercase">Alerjenler</label>
                    <input asp-for="Allergens" class="form-control" placeholder="Örn: Glüten, Süt, Yumurta" />
                    <span asp-validation-for="Allergens" class="text-danger small"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="Slug" class="form-label fw-bold text-secondary small text-uppercase">URL Yolu (Slug)</label>
                    <input asp-for="Slug" class="form-control" placeholder="Otomatik oluşturulur, dilerseniz girebilirsiniz" />
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase d-block mb-3">Durum</label>
                        <div class="form-check form-switch custom-switch-lg ps-0">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsActive" id="IsActiveSwitch">
                                <label class="form-check-label text-dark" for="IsActiveSwitch">
                                    Aktif
                                    <small class="d-block text-muted fw-normal" style="font-size: 0.75rem;">Menüde görünsün</small>
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4 mb-4">
                        <label asp-for="IsVegan" class="form-label fw-bold text-secondary small text-uppercase">Vegan</label>
                        <select asp-for="IsVegan" class="form-select">
                            <option value="">Belirtilmedi</option>
                            <option value="true">Evet</option>
                            <option value="false">Hayır</option>
                        </select>
                        <span asp-validation-for="IsVegan" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label asp-for="IsVegetarian" class="form-label fw-bold text-secondary small text-uppercase">Vejetaryen</label>
                        <select asp-for="IsVegetarian" class="form-select">
                            <option value="">Belirtilmedi</option>
                            <option value="true">Evet</option>
                            <option value="false">Hayır</option>
                        </select>
                        <span asp-validation-for="IsVegetarian" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-5">
                    <a asp-action="Details" asp-controller="Category" asp-route-id="@Model.CategoryId" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>İptal
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-check-circle me-2"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
