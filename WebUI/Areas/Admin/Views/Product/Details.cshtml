@model ProductDTO

@{
    ViewData["Title"] = "Ürün Detayı";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var currentPageUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var fallbackUrl = returnUrl ?? Url.Action("Index");
    var editReturnUrl = returnUrl ?? currentPageUrl;
}

<div class="horizon-card tm-page-header">
    <div class="tm-page-header__main">
        <a href="@fallbackUrl"
           data-tummenu-back
           data-fallback-url="@fallbackUrl"
           class="btn btn-outline-secondary tm-back-button"
           title="Geri Dön">
            <i class="fas fa-arrow-left"></i>
            <span>Geri Dön</span>
        </a>

        <div class="tm-page-heading">
            <div class="tm-page-eyebrow">Ürün Yönetimi</div>
            <h1 class="tm-page-title">@Model.Title</h1>
            <div class="d-flex flex-wrap gap-2 mt-2">
                @if (Model.IsActive)
                {
                    <span class="badge tm-badge-success"><i class="fas fa-check-circle me-1"></i>Aktif</span>
                }
                else
                {
                    <span class="badge tm-badge-danger"><i class="fas fa-times-circle me-1"></i>Pasif</span>
                }
                <span class="badge tm-badge-neutral">Sıra: @Model.SortOrder</span>
            </div>
        </div>
    </div>

    <div class="tm-page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@editReturnUrl" class="btn btn-outline-primary" title="Düzenle">
            <i class="fas fa-edit me-2"></i>Düzenle
        </a>
        <button type="button" class="btn btn-outline-danger" title="Sil" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="fas fa-trash-alt me-2"></i>Sil
        </button>
    </div>
</div>

@if (Model != null)
{
    <div class="row">
        <!-- Sol Kolon -->
        <div class="col-md-7 mb-3">
            <div class="horizon-card h-100">
                <h4 class="fw-bold text-primary mb-3">Ürün Bilgileri</h4>
                


                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between border-bottom pb-2 mt-2">
                        <span class="text-secondary fw-bold small text-uppercase">Ana Fiyat</span>
                        <span class="text-success fw-bold fs-5">@Model.BasePrice.ToString("C2")</span>
                    </div>

                    <div class="border-bottom pb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary fw-bold small text-uppercase">Fiyat Seçenekleri</span>
                            @if (Model.Prices.Count > 0)
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">@Model.Prices.Count seçenek</span>
                            }
                        </div>
                        @if (Model.Prices.Count > 0)
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var price in Model.Prices.OrderBy(p => p.CreatedAt))
                                {
                                    <div class="list-group-item px-0 d-flex justify-content-between align-items-center bg-transparent">
                                        <span class="fw-semibold text-dark">@price.Size</span>
                                        <span class="text-success fw-bold">@price.Price.ToString("C2")</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">Ek fiyat seçeneği yok.</p>
                        }
                    </div>
                    
                    @if (Model.EstimatedPreparationTimeInMinutes.HasValue)
                    {
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">Hazırlama Süresi</span>
                            <span class="text-dark fw-bold"><i class="far fa-clock me-1 text-secondary"></i> @Model.EstimatedPreparationTimeInMinutes dk</span>
                        </div>
                    }
                                    @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-4">
                        <span class="text-secondary fw-bold small text-uppercase d-block mb-2">Açıklama</span>
                        <p class="text-dark mb-0 product-detail-description">@Model.Description</p>
                    </div>
                }
                </div>

            </div>
        </div>
        
        <!-- Sağ Kolon -->
        <div class="col-md-5 mb-3">
            <div class="horizon-card h-100">
                <h4 class="fw-bold text-primary mb-3">Özellikler & Alerjenler</h4>
                
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between border-bottom pb-2">
                        <span class="text-secondary fw-bold small text-uppercase">Vegan</span>
                        @if (Model.IsVegan == true)
                        {
                            <span class="text-success fw-bold"><i class="fas fa-leaf me-1"></i> Evet</span>
                        }
                        else
                        {
                            <span class="text-muted"><i class="fas fa-minus me-1"></i> Hayır</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between border-bottom pb-2">
                        <span class="text-secondary fw-bold small text-uppercase">Vejetaryen</span>
                        @if (Model.IsVegetarian == true)
                        {
                            <span class="text-success fw-bold"><i class="fas fa-seedling me-1"></i> Evet</span>
                        }
                        else
                        {
                            <span class="text-muted"><i class="fas fa-minus me-1"></i> Hayır</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Allergens))
                {
                    <div class="mt-4 p-3 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-3">
                        <h6 class="text-warning-emphasis fw-bold mb-2"><i class="fas fa-exclamation-triangle me-2"></i>Alerjen Uyarısı</h6>
                        <p class="mb-0 text-dark small">@Model.Allergens</p>
                    </div>
                }
                else
                {
                     <div class="mt-4 text-center py-3 text-secondary border rounded bg-light border-dashed">
                        <i class="fas fa-shield-alt fa-lg mb-2 d-block opacity-50"></i>
                        <p class="mb-0 small">Belirtilen bir alerjen bilgisi yok.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Silme Modalı -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white border-0">
                    <h5 class="modal-title"><i class="fas fa-exclamation-circle me-2"></i> Ürünü Sil</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <i class="fas fa-trash-alt text-danger" style="font-size: 3rem; opacity: 0.5;"></i>
                    </div>
                    <p class="mb-0"><strong>@Model.Title</strong> isimli ürünü silmek istediğinize emin misiniz?</p>
                    <p class="text-muted small mt-2">Bu işlem geri alınamaz.</p>
                </div>
                <div class="modal-footer bg-light border-0 justify-content-center">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-returnUrl="@returnUrl" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                        <button type="submit" class="btn btn-danger px-4">Evet, Sil</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <partial name="_MediaGallery" model='(Model.Id, Domain.Entities.MediaRefType.Product, Model.Medias, "default-gallery")' />
        </div>
    </div>
}

else
{
    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center">
        <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
        <div>
            <h5 class="alert-heading mb-1">Ürün Bulunamadı</h5>
            <p class="mb-0">Aradığınız ürün mevcut değil veya silinmiş olabilir.</p>
        </div>
    </div>
}
