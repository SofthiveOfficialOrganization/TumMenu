@using Application.Products.DTOs
@model IReadOnlyList<ProductPriceInputDTO>?

@{
    var prices = Model ?? [];
}

<div class="mb-4 product-price-options">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <label class="form-label fw-bold text-secondary small text-uppercase mb-0">Fiyat Seçenekleri</label>
            <div class="form-text text-muted small">Boyut, porsiyon veya hacim gibi ek fiyatları ekleyin.</div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" data-add-price-option>
            <i class="fas fa-plus me-1"></i> Seçenek Ekle
        </button>
    </div>

    <div class="d-flex flex-column gap-2" data-price-options-list>
        @for (var i = 0; i < prices.Count; i++)
        {
            <div class="row g-2 align-items-start" data-price-option-row>
                <div class="col-md-6">
                    <input name="Prices[@i].Size" value="@prices[i].Size" class="form-control" maxlength="100" placeholder="Örn: Küçük, Orta, 1 L" />
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <input name="Prices[@i].Price" value="@(prices[i].Price?.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="form-control" type="number" step="0.01" min="0" max="9999" placeholder="0.00" />
                        <input name="__Invariant" type="hidden" value="Prices[@i].Price" />
                        <span class="input-group-text">₺</span>
                    </div>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="button" class="btn btn-outline-danger" data-remove-price-option title="Seçeneği Sil">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

