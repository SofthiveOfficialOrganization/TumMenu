@using Application.Menus.Queries
@using Application.Categories.Queries
@using Application.Products.Commands
@using Application.Products.DTOs
@model CreateProductCommand

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
    var isSingleStore = ViewBag.IsSingleStore == true;
    var singleStoreId = ViewBag.SingleStoreId as Guid?;
    var returnUrl = ViewData["ReturnUrl"] as string;
    var fallbackUrl = returnUrl ?? Url.Action("Index");
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <div class="mb-4 text-center">
                <h3 class="fw-bold text-primary">@ViewData["Title"]</h3>
                <p class="text-secondary">Kategoriye yeni bir ürün ekleyin.</p>
            </div>

            <form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                @if (isSingleStore && singleStoreId.HasValue)
                {
                    <input type="hidden" name="storeId" id="storeId" value="@singleStoreId.Value" />
                }

                <div class="row">
                    @if (!isSingleStore)
                    {
                        <div class="col-md-4 mb-4">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Dükkan Seçimi</label>
                            <select name="storeId" id="storeSelect" class="form-select" required oninvalid="this.setCustomValidity('Dükkan seçimi zorunludur.')" onchange="this.setCustomValidity('')">
                                <option value="">Dükkan seçin...</option>
                            </select>
                            @Html.ValidationMessage("storeId", null, new { @class = "text-danger small" })
                        </div>
                    }

                    <div class="col-@(isSingleStore ? "md-6" : "md-4") mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Menü Seçimi</label>
                        <select name="menuId" id="menuSelect" class="form-select" required disabled oninvalid="this.setCustomValidity('Menü seçimi zorunludur.')" onchange="this.setCustomValidity('')">
                            <option value="">@(isSingleStore ? "Menü seçin..." : "Önce dükkan seçin...")</option>
                        </select>
                        @Html.ValidationMessage("menuId", null, new { @class = "text-danger small" })
                    </div>

                    <div class="col-@(isSingleStore ? "md-6" : "md-4") mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Kategori Seçimi</label>
                        <select name="categoryId" id="categorySelect" class="form-select" required disabled oninvalid="this.setCustomValidity('Kategori seçimi zorunludur.')" onchange="this.setCustomValidity('')">
                            <option value="">Önce menü seçin...</option>
                        </select>
                        @Html.ValidationMessage("categoryId", null, new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold text-secondary small text-uppercase">Ürün Adı</label>
                    <input asp-for="Title" class="form-control" placeholder="Örn: Karışık Pizza" id="titleInput" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Slug" class="form-label fw-bold text-secondary small text-uppercase mb-0">Slug (URL Yolu)</label>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="slugManualToggle">
                            <label class="form-check-label small text-secondary" for="slugManualToggle">El ile düzenle</label>
                        </div>
                    </div>
                    <div class="input-group">
                        <input asp-for="Slug" class="form-control" placeholder="otomatik oluşturulacak" id="slugInput" readonly />
                        <span class="input-group-text" style="min-width: 42px; justify-content: center;">
                            <i class="fas fa-lock text-secondary" id="slugIcon"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                    <div class="form-text text-muted small">Boş bırakılırsa ürün adından otomatik oluşturulur.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold text-secondary small text-uppercase">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Ürün içerik bilgisi vb."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="BasePrice" class="form-label fw-bold text-secondary small text-uppercase">Fiyat (₺)</label>
                        <div class="input-group">
                            <input asp-for="BasePrice" class="form-control" type="number" step="0.01" min="0" max="9999" placeholder="0.00" />
                            <span class="input-group-text">₺</span>
                        </div>
                        <span asp-validation-for="BasePrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="EstimatedPreparationTimeInMinutes" class="form-label fw-bold text-secondary small text-uppercase">Hazırlık Süresi</label>
                        <div class="input-group">
                            <input asp-for="EstimatedPreparationTimeInMinutes" class="form-control" type="number" min="0" max="99" placeholder="15" />
                            <span class="input-group-text">dk</span>
                        </div>
                        <span asp-validation-for="EstimatedPreparationTimeInMinutes" class="text-danger small"></span>
                    </div>

                </div>

                <partial name="_ProductPriceOptions" model="Model.Prices" />

                <div class="mb-4">
                    <label asp-for="Allergens" class="form-label fw-bold text-secondary small text-uppercase">Alerjenler</label>
                    <input asp-for="Allergens" class="form-control" placeholder="Örn: Glüten, Süt, Yumurta" />
                    <span asp-validation-for="Allergens" class="text-danger small"></span>
                </div>

                <partial name="_PhotoFileInput" />

                <div class="row">
                    <div class="col-md-4 mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase d-block mb-3">Durum</label>
                        <div class="form-check form-switch custom-switch-lg ps-0">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsActive" id="IsActiveSwitch">
                                <label class="form-check-label text-dark" for="IsActiveSwitch">
                                    Aktif
                                    <small class="d-block text-muted fw-normal" style="font-size: 0.75rem;">Menüde görünsün</small>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label asp-for="IsVegan" class="form-label fw-bold text-secondary small text-uppercase">Vegan</label>
                        <select asp-for="IsVegan" class="form-select">
                            <option value="">Belirtilmedi</option>
                            <option value="true">Evet</option>
                            <option value="false">Hayır</option>
                        </select>
                        <span asp-validation-for="IsVegan" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label asp-for="IsVegetarian" class="form-label fw-bold text-secondary small text-uppercase">Vejetaryen</label>
                        <select asp-for="IsVegetarian" class="form-select">
                            <option value="">Belirtilmedi</option>
                            <option value="true">Evet</option>
                            <option value="false">Hayır</option>
                        </select>
                        <span asp-validation-for="IsVegetarian" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-5">
                    <a href="@fallbackUrl" data-tummenu-back data-fallback-url="@fallbackUrl" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>İptal
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-check-circle me-2"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            const titleInput = $('#titleInput');
            const slugInput  = $('#slugInput');
            const slugToggle = $('#slugManualToggle');
            const slugIcon   = $('#slugIcon');
            const storeSelect = $('#storeSelect');
            const menuSelect = $('#menuSelect');
            const categorySelect = $('#categorySelect');
            const priceOptionsList = $('[data-price-options-list]');
            const addPriceOptionButton = $('[data-add-price-option]');
            const selectedStoreId = '@(ViewData["SelectedStoreId"]?.ToString() ?? "")';
            const selectedMenuId = '@(ViewData["SelectedMenuId"]?.ToString() ?? "")';
            const selectedCategoryId = '@(ViewData["SelectedCategoryId"]?.ToString() ?? "")';
            const isSingleStore = @(isSingleStore ? "true" : "false");
            const singleStoreId = '@(singleStoreId?.ToString() ?? "")';

            let isManual = false;

            function slugify(text) {
                const turkishMap = {
                    'ğ':'g','ü':'u','ş':'s','ı':'i','ö':'o','ç':'c',
                    'Ğ':'g','Ü':'u','Ş':'s','İ':'i','I':'i','Ö':'o','Ç':'c'
                };
                let result = text.trim().toLowerCase();
                result = result.split('').map(c => turkishMap[c] || c).join('');
                result = result.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                result = result.replace(/[^a-z0-9\s\-_]/g, '');
                result = result.replace(/[\s_]+/g, '-');
                result = result.replace(/-+/g, '-');
                result = result.replace(/^-|-$/g, '');
                if (result.length > 30) result = result.substring(0, 30).replace(/-$/, '');
                return result;
            }

            // Title → auto slug
            titleInput.on('input', function () {
                if (!isManual) {
                    slugInput.val(slugify($(this).val()));
                }
            });

            // Manual toggle
            slugToggle.on('change', function () {
                isManual = $(this).is(':checked');
                if (isManual) {
                    slugInput.prop('readonly', false).focus();
                    slugIcon.removeClass('fa-lock text-secondary').addClass('fa-pencil-alt text-primary');
                } else {
                    slugInput.prop('readonly', true);
                    slugInput.val(slugify(titleInput.val()));
                    slugIcon.removeClass('fa-pencil-alt text-primary').addClass('fa-lock text-secondary');
                }
            });

            // Manual slug: enforce lowercase slug chars as user types
            slugInput.on('input', function () {
                if (isManual) {
                    let val = $(this).val().toLowerCase()
                        .replace(/[^a-z0-9\-]/g, '')
                        .replace(/-+/g, '-');
                    if (val.length > 30) val = val.substring(0, 30);
                    $(this).val(val);
                }
            });

            function reindexPriceOptions() {
                priceOptionsList.find('[data-price-option-row]').each(function(index) {
                    $(this).find('input').each(function() {
                        const field = $(this).attr('name').endsWith('.Price') ? 'Price' : 'Size';
                        $(this).attr('name', 'Prices[' + index + '].' + field);
                    });
                });
            }

            function addPriceOption(size, price) {
                const index = priceOptionsList.find('[data-price-option-row]').length;
                const row = $(
                    '<div class="row g-2 align-items-start" data-price-option-row>' +
                        '<div class="col-md-6">' +
                            '<input name="Prices[' + index + '].Size" class="form-control" maxlength="100" placeholder="Örn: Küçük, Orta, 1 L" />' +
                        '</div>' +
                        '<div class="col-md-4">' +
                            '<div class="input-group">' +
                                '<input name="Prices[' + index + '].Price" class="form-control" type="number" step="0.01" min="0" max="9999" placeholder="0.00" />' +
                                '<span class="input-group-text">₺</span>' +
                            '</div>' +
                        '</div>' +
                        '<div class="col-md-2 d-grid">' +
                            '<button type="button" class="btn btn-outline-danger" data-remove-price-option title="Seçeneği Sil"><i class="fas fa-trash"></i></button>' +
                        '</div>' +
                    '</div>');
                row.find('input[name$=".Size"]').val(size || '');
                row.find('input[name$=".Price"]').val(price || '');
                priceOptionsList.append(row);
            }

            addPriceOptionButton.on('click', function () {
                addPriceOption();
            });

            priceOptionsList.on('click', '[data-remove-price-option]', function () {
                $(this).closest('[data-price-option-row]').remove();
                reindexPriceOptions();
            });

            function escapeHtml(value) {
                return $('<div>').text(value || '').html();
            }

            function isEmptyGuid(value) {
                return !value || value === '00000000-0000-0000-0000-000000000000';
            }

            function resetMenu(disabled) {
                const placeholder = isSingleStore
                    ? (disabled ? 'Yükleniyor...' : 'Menü seçin...')
                    : (disabled ? 'Önce dükkan seçin...' : 'Menü seçin...');
                menuSelect
                    .prop('disabled', disabled)
                    .html('<option value="">' + placeholder + '</option>');
            }

            function resetCategory(disabled) {
                categorySelect
                    .prop('disabled', disabled)
                    .html('<option value="">' + (disabled ? 'Önce menü seçin...' : 'Kategori seçin...') + '</option>');
            }

            function loadStores() {
                if (isSingleStore) {
                    // Tek dükkan modunda menüleri doğrudan yükle
                    if (!isEmptyGuid(singleStoreId)) {
                        loadMenus(singleStoreId, selectedMenuId, selectedCategoryId);
                    }
                    return;
                }

                storeSelect.prop('disabled', true).html('<option value="">Dükkanlar yükleniyor...</option>');
                resetMenu(true);
                resetCategory(true);

                $.get('@Url.Action("GetStoresForSelect2", "Store", new { area = "Admin", role = ViewContext.RouteData.Values["role"] })',
                    { pageSize: 100 },
                    function(data) {
                        storeSelect.html('<option value="">Dükkan seçin...</option>');
                        data.results.forEach(function(store) {
                            storeSelect.append('<option value="' + store.id + '">' + escapeHtml(store.text) + '</option>');
                        });
                        storeSelect.prop('disabled', false);

                        if (!isEmptyGuid(selectedStoreId)) {
                            storeSelect.val(selectedStoreId);
                            if (storeSelect.val()) {
                                loadMenus(selectedStoreId, selectedMenuId, selectedCategoryId);
                            }
                        }
                    });
            }

            function loadMenus(storeId, menuIdToSelect, categoryIdToSelect) {
                resetMenu(false);
                resetCategory(true);
                menuSelect.prop('disabled', true).html('<option value="">Menüler yükleniyor...</option>');

                $.get('@Url.Action("GetMenusForSelect2", "Menu", new { area = "Admin", role = ViewContext.RouteData.Values["role"] })',
                    { storeId: storeId, pageSize: 100 },
                    function(data) {
                        menuSelect.html('<option value="">Menü seçin...</option>');
                        data.results.forEach(function(menu) {
                            menuSelect.append('<option value="' + menu.id + '">' + escapeHtml(menu.text) + '</option>');
                        });
                        menuSelect.prop('disabled', false);

                        if (!isEmptyGuid(menuIdToSelect)) {
                            menuSelect.val(menuIdToSelect);
                            if (menuSelect.val()) {
                                loadCategories(menuIdToSelect, categoryIdToSelect);
                            }
                        }
                    });
            }

            function loadCategories(menuId, categoryIdToSelect) {
                resetCategory(false);
                categorySelect.prop('disabled', true).html('<option value="">Kategoriler yükleniyor...</option>');

                $.get('@Url.Action("GetCategoriesForSelect2", "Category", new { area = "Admin", role = ViewContext.RouteData.Values["role"] })',
                    { menuId: menuId, pageSize: 200 },
                    function(data) {
                        categorySelect.html('<option value="">Kategori seçin...</option>');
                        data.results.forEach(function(cat) {
                            categorySelect.append('<option value="' + cat.id + '">' + escapeHtml(cat.text) + '</option>');
                        });
                        categorySelect.prop('disabled', false);

                        if (!isEmptyGuid(categoryIdToSelect)) {
                            categorySelect.val(categoryIdToSelect);
                        }
                    });
            }

            if (!isSingleStore) {
                storeSelect.on('change', function() {
                    const storeId = $(this).val();
                    resetMenu(true);
                    resetCategory(true);

                    if (storeId) {
                        loadMenus(storeId);
                    }
                });
            }

            menuSelect.on('change', function() {
                const menuId = $(this).val();
                resetCategory(true);

                if (menuId) {
                    loadCategories(menuId);
                }
            });

            loadStores();
        });
    </script>
}
