@model ProductDTO

@{
    ViewData["Title"] = "Ürün Düzenle";
    var priceInputs = Model.Prices
        .OrderBy(p => p.CreatedAt)
        .Select(p => new Application.Products.DTOs.ProductPriceInputDTO
        {
            Size = p.Size,
            Price = p.Price
        })
        .ToList();
    var returnUrl = ViewData["ReturnUrl"] as string;
    var fallbackUrl = returnUrl ?? Url.Action("Details", "Category", new { id = Model.CategoryId });
}

<div class="horizon-card tm-page-header">
    <div class="tm-page-header__main">
        <a href="@fallbackUrl"
           data-tummenu-back
           data-fallback-url="@fallbackUrl"
           class="btn btn-outline-secondary tm-back-button"
           title="Geri Dön">
            <i class="fas fa-arrow-left"></i>
            <span>Geri Dön</span>
        </a>

        <div class="tm-page-heading">
            <div class="tm-page-eyebrow">Ürün Yönetimi</div>
            <h1 class="tm-page-title">@Model.Title</h1>
            <p class="tm-page-subtitle">Ürün bilgilerini, fiyat seçeneklerini, etiketleri ve fotoğrafları güncelleyin.</p>
        </div>
    </div>

    <div class="tm-page-actions">
        <button type="submit" form="editProductForm" class="btn btn-primary">
            <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
        </button>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <div class="tm-section-header">
                <div>
                    <h2 class="tm-section-title">Ürün Bilgileri</h2>
                    <p class="tm-section-subtitle">Ad, açıklama, fiyat ve menüde görünürlük bilgilerini düzenleyin.</p>
                </div>
            </div>

            <form asp-action="Edit" method="post" id="editProductForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CategoryId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold text-secondary small text-uppercase">Ürün Adı</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold text-secondary small text-uppercase">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-4">
                        <label asp-for="BasePrice" class="form-label fw-bold text-secondary small text-uppercase">Fiyat (₺)</label>
                        <div class="input-group">
                            <input asp-for="BasePrice" value="@Model.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" type="number" step="0.01" min="0" max="9999" />
                            <span class="input-group-text">₺</span>
                        </div>
                        <span asp-validation-for="BasePrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label asp-for="EstimatedPreparationTimeInMinutes" class="form-label fw-bold text-secondary small text-uppercase">Hazırlık Süresi</label>
                        <div class="input-group">
                            <input asp-for="EstimatedPreparationTimeInMinutes" class="form-control" type="number" min="0" max="99" />
                            <span class="input-group-text">dk</span>
                        </div>
                        <span asp-validation-for="EstimatedPreparationTimeInMinutes" class="text-danger small"></span>
                        <small class="text-muted">Boş bırakın veya 0 girin → menüde gösterilmez</small>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label asp-for="SortOrder" class="form-label fw-bold text-secondary small text-uppercase">Sıralama</label>
                        <input asp-for="SortOrder" class="form-control" type="number" />
                        <span asp-validation-for="SortOrder" class="text-danger small"></span>
                    </div>
                </div>

                <partial name="_ProductPriceOptions" model="priceInputs" />

                <div class="mb-4">
                    <label asp-for="Allergens" class="form-label fw-bold text-secondary small text-uppercase">Alerjenler</label>
                    <input asp-for="Allergens" class="form-control" />
                    <span asp-validation-for="Allergens" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase d-block mb-3">Durum</label>
                        <div class="form-check form-switch custom-switch-lg ps-0">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input ms-0 me-2" type="checkbox" name="IsActive" id="IsActiveSwitch" value="true" @(Model.IsActive ? "checked" : "")>
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label text-dark" for="IsActiveSwitch">
                                    Aktif
                                    <small class="d-block text-muted fw-normal" style="font-size: 0.75rem;">Menüde görünsün</small>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase d-block mb-3">Vegan</label>
                        <div class="form-check form-switch custom-switch-lg ps-0">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input ms-0 me-2" type="checkbox" name="IsVegan" id="IsVeganSwitch" value="true" @(Model.IsVegan == true ? "checked" : "")>
                                <input type="hidden" name="IsVegan" value="false" />
                                <label class="form-check-label text-dark" for="IsVeganSwitch">
                                    Vegan
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase d-block mb-3">Vejetaryen</label>
                        <div class="form-check form-switch custom-switch-lg ps-0">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input ms-0 me-2" type="checkbox" name="IsVegetarian" id="IsVegetarianSwitch" value="true" @(Model.IsVegetarian == true ? "checked" : "")>
                                <input type="hidden" name="IsVegetarian" value="false" />
                                <label class="form-check-label text-dark" for="IsVegetarianSwitch">
                                    Vejetaryen
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tm-form-footer">
                    <a href="@fallbackUrl" data-tummenu-back data-fallback-url="@fallbackUrl" class="btn btn-outline-secondary">
                        Vazgeç
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="horizon-card">
            <div class="tm-section-header">
                <div>
                    <h2 class="tm-section-title">Ürün Fotoğrafları</h2>
                    <p class="tm-section-subtitle">Menüde ürün detayı ve kart görselleri için kullanılacak fotoğrafları yönetin.</p>
                </div>
            </div>

            <partial name="_MediaGallery" model='(Model.Id, Domain.Entities.MediaRefType.Product, Model.Medias, "default-gallery")' />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            const priceOptionsList = $('[data-price-options-list]');
            const addPriceOptionButton = $('[data-add-price-option]');

            function reindexPriceOptions() {
                priceOptionsList.find('[data-price-option-row]').each(function(index) {
                    $(this).find('input[name^="Prices["]').each(function() {
                        const field = $(this).attr('name').endsWith('.Price') ? 'Price' : 'Size';
                        $(this).attr('name', 'Prices[' + index + '].' + field);
                    });
                    $(this).find('input[name="__Invariant"]').val('Prices[' + index + '].Price');
                });
            }

            function addPriceOption(size, price) {
                const index = priceOptionsList.find('[data-price-option-row]').length;
                const row = $(
                    '<div class="row g-2 align-items-start" data-price-option-row>' +
                        '<div class="col-md-6">' +
                            '<input name="Prices[' + index + '].Size" class="form-control" maxlength="100" placeholder="Örn: Küçük, Orta, 1 L" />' +
                        '</div>' +
                        '<div class="col-md-4">' +
                            '<div class="input-group">' +
                                '<input name="Prices[' + index + '].Price" class="form-control" type="number" step="0.01" min="0" max="9999" placeholder="0.00" />' +
                                '<input name="__Invariant" type="hidden" value="Prices[' + index + '].Price" />' +
                                '<span class="input-group-text">₺</span>' +
                            '</div>' +
                        '</div>' +
                        '<div class="col-md-2 d-grid">' +
                            '<button type="button" class="btn btn-outline-danger" data-remove-price-option title="Seçeneği Sil"><i class="fas fa-trash"></i></button>' +
                        '</div>' +
                    '</div>');
                row.find('input[name$=".Size"]').val(size || '');
                row.find('input[name$=".Price"]').val(price || '');
                priceOptionsList.append(row);
            }

            addPriceOptionButton.on('click', function () {
                addPriceOption();
            });

            priceOptionsList.on('click', '[data-remove-price-option]', function () {
                $(this).closest('[data-price-option-row]').remove();
                reindexPriceOptions();
            });
        });
    </script>
}
