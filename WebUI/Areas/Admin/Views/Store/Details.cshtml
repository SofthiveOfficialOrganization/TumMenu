@using Application.Stores.DTOs
@model StoreDTO

@{
    ViewData["Title"] = "Dükkan Detayı";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                     <h2 class="fw-bold text-primary mb-1">
                        @Model.Title
                    </h2>
                    <div class="text-secondary small">
                        <i class="fas fa-link me-1"></i> @Model.Slug
                    </div>
                </div>
                <div class="d-flex gap-2 flex-shrink-0">
                    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="Düzenle" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="@(ViewData["ReturnUrl"] ?? Url.Action("Index"))" class="btn btn-sm btn-outline-secondary shadow-sm px-3" title="Geri Dön" style="height: 36px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-arrow-left"></i> <span class="d-none d-md-inline ms-2">Geri Dön</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="horizon-card h-100">
            <h4 class="fw-bold text-primary mb-3">Genel Bilgiler</h4>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Telefon</span>
                    <span class="text-dark fw-bold">@Model.PhoneNumber</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Şirket</span>
                    <span class="text-end">
                         @if (Model.Company != null)
                        {
                            <a asp-area="Admin" asp-controller="Company" asp-action="Details" asp-route-id="@Model.Company.Id" class="fw-bold text-primary text-decoration-none">
                                <i class="fas fa-building me-1"></i> @Model.Company.Title
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </span>
                </div>
                 <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Oluşturulma Tarihi</span>
                    <span class="text-dark fw-bold">@Model.CreatedAt?.ToString("d")</span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 mb-3">
        <div class="horizon-card h-100">
             <h4 class="fw-bold text-primary mb-3">Adres Bilgisi</h4>
            @if (Model.Address != null)
            {
                <div class="d-flex flex-column gap-3">
                    @if (!string.IsNullOrEmpty(Model.Address.CityName))
                    {
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">İl</span>
                            <span class="text-dark fw-bold">@Model.Address.CityName</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Address.DistrictName))
                    {
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">İlçe</span>
                            <span class="text-dark fw-bold">@Model.Address.DistrictName</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Address.Neighborhood))
                    {
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">Mahalle</span>
                            <span class="text-dark fw-bold">@Model.Address.Neighborhood</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Address.FullAddress))
                    {
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">Tam Adres</span>
                            <span class="text-dark text-end" style="max-width:60%;">@Model.Address.FullAddress</span>
                        </div>
                    }
                    @if (Model.Address.Latitude.HasValue && Model.Address.Longitude.HasValue)
                    {
                        <div class="d-flex justify-content-between pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">Koordinat</span>
                            <small class="text-secondary font-monospace">
                                <i class="fas fa-crosshairs me-1"></i>@Model.Address.Latitude, @Model.Address.Longitude
                            </small>
                        </div>
                    }
                    @if (!Model.Address.Latitude.HasValue && string.IsNullOrEmpty(Model.Address.FullAddress) && string.IsNullOrEmpty(Model.Address.CityName))
                    {
                        <div class="text-center py-4 text-secondary">
                            <i class="fas fa-map-marked-alt fa-2x mb-2 opacity-50"></i>
                            <p class="mb-0">Adres bilgisi girilmemiş.</p>
                        </div>
                    }
                </div>
            }
            else
            {
                 <div class="text-center py-4 text-secondary">
                    <i class="fas fa-map-marked-alt fa-2x mb-2 opacity-50"></i>
                    <p class="mb-0">Adres bilgisi bulunamadı.</p>
                </div>
            }
        </div>

    </div>

    <div class="col-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                 <h4 class="fw-bold text-primary mb-0">Personel Listesi</h4>
                 <span class="badge bg-light text-primary border">@Model.Staffs.Count Personel</span>
            </div>
           
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="bg-light">
                        <tr class="text-secondary small text-uppercase">
                            <th class="ps-3 border-bottom-0">Ad Soyad</th>
                            <th class="border-bottom-0">E-Posta</th>
                            <th class="border-bottom-0">Rol</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model.Staffs.Any())
                        {
                            foreach (var staff in Model.Staffs)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-2" style="width: 32px; height: 32px; font-size: 14px;">
                                                @staff.FirstName.Substring(0,1)@staff.LastName.Substring(0,1)
                                            </div>
                                            @staff.FirstName @staff.LastName
                                        </div>
                                    </td>
                                    <td class="text-secondary">@staff.Email</td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">@staff.Role</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-secondary">
                                    <i class="fas fa-users-slash fa-2x mb-2 opacity-50"></i>
                                    <p class="mb-0">Henüz personel eklenmemiş.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-12 mt-4">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="horizon-card h-100 p-0 overflow-hidden">
                    <div class="bg-light px-3 py-2 border-bottom">
                        <span class="text-secondary fw-bold small text-uppercase">Dükkan Logosu</span>
                    </div>
                    <div class="p-3 d-flex justify-content-center align-items-center" style="min-height: 200px;">
                        @{
                            var logo = Model.Medias.FirstOrDefault(m => m.Slot == "logo");
                            if (logo != null)
                            {
                                <img src="@logo.MediaUrl" class="img-fluid rounded shadow-sm" style="max-height: 160px;" alt="Logo" />
                            }
                            else
                            {
                                <div class="text-muted small text-center">
                                    <i class="fas fa-image fa-2x mb-2 opacity-25"></i><br/>Logo yüklenmemiş
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="horizon-card h-100 p-0 overflow-hidden">
                    <div class="bg-light px-3 py-2 border-bottom">
                        <span class="text-secondary fw-bold small text-uppercase">Dükkan Banner</span>
                    </div>
                    <div class="p-0 position-relative" style="min-height: 200px; background: #f8f9fa;">
                         @{
                            var banner = Model.Medias.FirstOrDefault(m => m.Slot == "banner");
                            if (banner != null)
                            {
                                <img src="@banner.MediaUrl" class="w-100 h-100" style="object-fit: cover; position: absolute;" alt="Banner" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted small">
                                    <i class="fas fa-panorama fa-2x mb-2 opacity-25"></i><br/>Banner yüklenmemiş
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="horizon-card p-0 overflow-hidden">
                    <div class="bg-light px-3 py-2 border-bottom">
                        <span class="text-secondary fw-bold small text-uppercase">Görsel Galerisi</span>
                    </div>
                    <div class="p-3">
                        <div class="d-flex flex-wrap gap-2">
                             @{
                                var galleryPhotos = Model.Medias.Where(m => m.Slot == "default-gallery").ToList();
                                if (galleryPhotos.Any())
                                {
                                    foreach(var photo in galleryPhotos)
                                    {
                                        <div class="media-preview-item" style="width: 120px; height: 120px;">
                                            <img src="@photo.MediaUrl" class="w-100 h-100 rounded object-fit-cover shadow-sm clickable-img" 
                                                 style="cursor: pointer" onclick="window.open('@photo.MediaUrl', '_blank')" />
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small py-4 w-100 text-center">
                                        Galeri boş.
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

</div>
