@using Application.Stores.DTOs
@using Domain.Entities
@model StoreDTO

@{
    ViewData["Title"] = "Dükkan Detayı";
    var returnUrl = ViewData["ReturnUrl"] as string ?? Url.Action("Index");
    var socialLinks = Model.SocialLinks
        .Where(x => !string.IsNullOrWhiteSpace(x.Url))
        .OrderBy(x => x.SortOrder)
        .ToList();
}

<div class="horizon-card tm-page-header">
    <div class="tm-page-header__main">
        <a href="@returnUrl"
           data-tummenu-back
           data-fallback-url="@returnUrl"
           class="btn btn-outline-secondary tm-back-button"
           title="Geri Dön">
            <i class="fas fa-arrow-left"></i>
            <span>Geri Dön</span>
        </a>

        <div class="tm-page-heading">
            <div class="tm-page-eyebrow">Dükkan Yönetimi</div>
            <h1 class="tm-page-title">@Model.Title</h1>
            <p class="tm-page-subtitle"><i class="fas fa-link me-1"></i>@Model.Slug</p>
        </div>
    </div>

    <div class="tm-page-actions">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-outline-primary" title="Düzenle">
            <i class="fas fa-edit me-2"></i>Düzenle
        </a>
        <form id="deleteStoreForm" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="button"
                    class="btn btn-outline-danger"
                    title="Sil"
                    onclick="TumMenuAlerts.confirm('Bu dükkanı silmek istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Sil!').then(res => { if(res) document.getElementById('deleteStoreForm').submit(); })">
                <i class="fas fa-trash-alt me-2"></i>Sil
            </button>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="horizon-card h-100">
            <h4 class="fw-bold text-primary mb-3">Genel Bilgiler</h4>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Telefon</span>
                    <span class="text-dark fw-bold">@Model.PhoneNumber</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.SecondaryPhoneNumber))
                {
                    <div class="d-flex justify-content-between border-bottom pb-2">
                        <span class="text-secondary fw-bold small text-uppercase">İkinci telefon</span>
                        <span class="text-dark fw-bold">@Model.SecondaryPhoneNumber</span>
                    </div>
                }
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Arama/listede görünür</span>
                    <span class="text-dark fw-bold">@(Model.ShowInSearchAndListings ? "Açık" : "Kapalı")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Menü butonu göster</span>
                    <span class="text-dark fw-bold">@(Model.ShowMenuButton ? "Açık" : "Kapalı")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">QR menüde kapak kartı</span>
                    <span class="text-dark fw-bold">@(Model.ShowCoverPhotoOnQrMenu ? "Açık" : "Kapalı")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Menüde fiyat göster</span>
                    <span class="text-dark fw-bold">@(Model.ShowPricesOnMenu ? "Açık" : "Kapalı")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Menüde sosyal linkleri göster</span>
                    <span class="text-dark fw-bold">@(Model.ShowSocialLinksOnMenu ? "Açık" : "Kapalı")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Menüde telefon numarasını göster</span>
                    <span class="text-dark fw-bold">@(Model.ShowPhoneNumberOnMenu ? "Açık" : "Kapalı")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Menüde adresi göster</span>
                    <span class="text-dark fw-bold">@(Model.ShowAddressOnMenu ? "Açık" : "Kapalı")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Görsel uyarısı</span>
                    <span class="text-dark fw-bold">@(Model.ShowRepresentativeImagesDisclaimer ? "Açık" : "Kapalı")</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Şirket</span>
                    <span class="text-end">
                         @if (Model.Company != null)
                        {
                            <a asp-area="Admin" asp-controller="Company" asp-action="Details" asp-route-id="@Model.Company.Id" class="fw-bold text-primary text-decoration-none">
                                <i class="fas fa-building me-1"></i> @Model.Company.Title
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </span>
                </div>
                 <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-secondary fw-bold small text-uppercase">Oluşturulma Tarihi</span>
                    <span class="text-dark fw-bold">@Model.CreatedAt?.ToString("d")</span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 mb-3">
        <div class="horizon-card h-100">
             <h4 class="fw-bold text-primary mb-3">Adres Bilgisi</h4>
            @if (Model.Address != null)
            {
                <div class="d-flex flex-column gap-3">
                    @if (!string.IsNullOrEmpty(Model.Address.CityName))
                    {
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">İl</span>
                            <span class="text-dark fw-bold">@Model.Address.CityName</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Address.DistrictName))
                    {
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">İlçe</span>
                            <span class="text-dark fw-bold">@Model.Address.DistrictName</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Address.Neighborhood))
                    {
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">Mahalle</span>
                            <span class="text-dark fw-bold">@Model.Address.Neighborhood</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Address.FullAddress))
                    {
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">Tam Adres</span>
                            <span class="text-dark text-end" style="max-width:60%;">@Model.Address.FullAddress</span>
                        </div>
                    }
                    @if (Model.Address.Latitude.HasValue && Model.Address.Longitude.HasValue)
                    {
                        <div class="d-flex justify-content-between pb-2">
                            <span class="text-secondary fw-bold small text-uppercase">Koordinat</span>
                            <small class="text-secondary font-monospace">
                                <i class="fas fa-crosshairs me-1"></i>@Model.Address.Latitude, @Model.Address.Longitude
                            </small>
                        </div>
                    }
                    @if (!Model.Address.Latitude.HasValue && string.IsNullOrEmpty(Model.Address.FullAddress) && string.IsNullOrEmpty(Model.Address.CityName))
                    {
                        <div class="text-center py-4 text-secondary">
                            <i class="fas fa-map-marked-alt fa-2x mb-2 opacity-50"></i>
                            <p class="mb-0">Adres bilgisi girilmemiş.</p>
                        </div>
                    }
                </div>
            }
            else
            {
                 <div class="text-center py-4 text-secondary">
                    <i class="fas fa-map-marked-alt fa-2x mb-2 opacity-50"></i>
                    <p class="mb-0">Adres bilgisi bulunamadı.</p>
                </div>
            }
        </div>

    </div>

    <div class="col-12 mb-3">
        <div class="horizon-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-primary mb-0">Sosyal Linkler</h4>
                <span class="badge bg-light text-primary border">@socialLinks.Count Link</span>
            </div>

            @if (socialLinks.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="text-secondary small text-uppercase">
                                <th class="ps-3 border-bottom-0">Platform</th>
                                <th class="border-bottom-0">Görünen Ad</th>
                                <th class="border-bottom-0">URL</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var link in socialLinks)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="d-inline-flex align-items-center gap-2 fw-bold text-dark">
                                            <span class="d-inline-grid place-items-center text-primary" style="width: 24px; height: 24px;">
                                                @switch (link.Platform)
                                                {
                                                    case StoreSocialPlatform.Twitter:
                                                        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M18.24 2H21.9l-8 9.14L23.3 22h-7.37l-5.77-6.86L3.56 22H-.1l8.56-9.78L-.55 2h7.56l5.2 6.16L18.24 2Zm-1.28 18.08h2.03L5.9 3.82H3.72l13.24 16.26Z" /></svg>
                                                        break;
                                                    case StoreSocialPlatform.Instagram:
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg>
                                                        break;
                                                    case StoreSocialPlatform.Facebook:
                                                        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M14 8.6V6.8c0-.86.2-1.3 1.42-1.3H17V2.22A21.3 21.3 0 0 0 14.25 2C11.5 2 9.6 3.68 9.6 6.78V8.6H6.5V12h3.1v10H14V12h2.92l.46-3.4H14Z" /></svg>
                                                        break;
                                                    case StoreSocialPlatform.YouTube:
                                                        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M22.54 6.42a2.8 2.8 0 0 0-1.97-1.98C18.83 4 12 4 12 4s-6.83 0-8.57.44a2.8 2.8 0 0 0-1.97 1.98A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.8 2.8 0 0 0 1.97 1.98C5.17 20 12 20 12 20s6.83 0 8.57-.44a2.8 2.8 0 0 0 1.97-1.98A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58ZM9.75 15.15v-6.3L15.5 12l-5.75 3.15Z" /></svg>
                                                        break;
                                                    default:
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 0 20"></path><path d="M12 2a15.3 15.3 0 0 0 0 20"></path></svg>
                                                        break;
                                                }
                                            </span>
                                            @SocialLabel(link.Platform, null)
                                        </span>
                                    </td>
                                    <td class="text-secondary">@(string.IsNullOrWhiteSpace(link.DisplayName) ? "-" : link.DisplayName)</td>
                                    <td>
                                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="text-primary text-decoration-none fw-bold">
                                            @link.Url
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-secondary">
                    <i class="fas fa-share-alt fa-2x mb-2 opacity-50"></i>
                    <p class="mb-0">Henüz sosyal link eklenmemiş.</p>
                </div>
            }
        </div>
    </div>

    <div class="col-12">
        <!-- <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                 <h4 class="fw-bold text-primary mb-0">Personel Listesi</h4>
                 <span class="badge bg-light text-primary border">@Model.Staffs.Count Personel</span>
            </div>
           
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="bg-light">
                        <tr class="text-secondary small text-uppercase">
                            <th class="ps-3 border-bottom-0">Ad Soyad</th>
                            <th class="border-bottom-0">E-Posta</th>
                            <th class="border-bottom-0">Rol</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model.Staffs.Any())
                        {
                            foreach (var staff in Model.Staffs)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-2" style="width: 32px; height: 32px; font-size: 14px;">
                                                @staff.FirstName.Substring(0,1)@staff.LastName.Substring(0,1)
                                            </div>
                                            @staff.FirstName @staff.LastName
                                        </div>
                                    </td>
                                    <td class="text-secondary">@staff.Email</td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">@staff.Role</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-secondary">
                                    <i class="fas fa-users-slash fa-2x mb-2 opacity-50"></i>
                                    <p class="mb-0">Henüz personel eklenmemiş.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
