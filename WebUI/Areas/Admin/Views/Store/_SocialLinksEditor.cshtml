@using Domain.Entities
@model Application.Stores.DTOs.StoreDTO

@{
    var links = Model.SocialLinks
        .OrderBy(x => x.SortOrder)
        .ToList();
}

<div class="mb-4 js-social-links-editor">
    <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
        <div>
            <label class="form-label fw-bold text-secondary small text-uppercase mb-1">Sosyal Linkler</label>
            <div class="form-text text-muted small">Twitter, Instagram, Facebook, YouTube veya diğer bağlantıları ekleyin.</div>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm js-add-social-link">
            <span aria-hidden="true">+</span> Link ekle
        </button>
    </div>

    <div class="js-social-link-list d-grid gap-2">
        @for (var i = 0; i < links.Count; i++)
        {
            <div class="border rounded p-3 js-social-link-row">
                <input type="hidden" data-social-field="Id" name="SocialLinks[@i].Id" value="@links[i].Id" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small text-secondary">Logo</label>
                        <select class="form-select" data-social-field="Platform" name="SocialLinks[@i].Platform">
                            <option value="@((int)StoreSocialPlatform.Twitter)" selected="@(links[i].Platform == StoreSocialPlatform.Twitter)">Twitter</option>
                            <option value="@((int)StoreSocialPlatform.Instagram)" selected="@(links[i].Platform == StoreSocialPlatform.Instagram)">Instagram</option>
                            <option value="@((int)StoreSocialPlatform.Facebook)" selected="@(links[i].Platform == StoreSocialPlatform.Facebook)">Facebook</option>
                            <option value="@((int)StoreSocialPlatform.YouTube)" selected="@(links[i].Platform == StoreSocialPlatform.YouTube)">YouTube</option>
                            <option value="@((int)StoreSocialPlatform.Other)" selected="@(links[i].Platform == StoreSocialPlatform.Other)">Diğer</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-secondary">Görünen ad</label>
                        <input class="form-control" data-social-field="DisplayName" name="SocialLinks[@i].DisplayName" value="@links[i].DisplayName" placeholder="örn. TikTok" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small text-secondary">Link</label>
                        <input class="form-control" data-social-field="Url" name="SocialLinks[@i].Url" value="@links[i].Url" placeholder="https://..." />
                    </div>
                    <div class="col-md-1 d-grid">
                        <button type="button" class="btn btn-outline-danger js-remove-social-link" aria-label="Sosyal linki kaldır">Sil</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <template class="js-social-link-template">
        <div class="border rounded p-3 js-social-link-row">
            <input type="hidden" data-social-field="Id" value="00000000-0000-0000-0000-000000000000" />
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-secondary">Logo</label>
                    <select class="form-select" data-social-field="Platform">
                        <option value="@((int)StoreSocialPlatform.Twitter)">Twitter</option>
                        <option value="@((int)StoreSocialPlatform.Instagram)">Instagram</option>
                        <option value="@((int)StoreSocialPlatform.Facebook)">Facebook</option>
                        <option value="@((int)StoreSocialPlatform.YouTube)">YouTube</option>
                        <option value="@((int)StoreSocialPlatform.Other)" selected>Diğer</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-secondary">Görünen ad</label>
                    <input class="form-control" data-social-field="DisplayName" placeholder="örn. TikTok" />
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-secondary">Link</label>
                    <input class="form-control" data-social-field="Url" placeholder="https://..." />
                </div>
                <div class="col-md-1 d-grid">
                    <button type="button" class="btn btn-outline-danger js-remove-social-link" aria-label="Sosyal linki kaldır">Sil</button>
                </div>
            </div>
        </div>
    </template>
</div>
