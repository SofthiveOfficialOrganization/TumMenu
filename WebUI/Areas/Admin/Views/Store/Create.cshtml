@using Application.Companies.Queries
@using Application.Stores.Commands
@model Application.Stores.DTOs.StoreDTO
@{
    ViewData["Title"] = "Yeni Dükkan Ekle";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Yeni Dükkan Ekle</h3>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Dükkan Adı</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Slug" class="form-label">Slug (URL Kısmı)</label>
                <input asp-for="Slug" class="form-control" required />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Telefon Numarası</label>
                <input asp-for="PhoneNumber" class="form-control" required />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CompanyId" class="form-label">Şirket</label>
                <div class="input-group">
                    <input type="text" class="form-control" id="companyNameDisplay" value="@ViewBag.CurrentCompanyName" placeholder="Şirket Seçiniz" readonly style="background-color: #fff; cursor: pointer;" onclick="CompanySelector.open()">
                    <button class="btn btn-outline-secondary" type="button" onclick="CompanySelector.open()"><i class="fas fa-search"></i></button>
                </div>
                <input type="hidden" asp-for="CompanyId" id="selectedCompanyId" />
                <span asp-validation-for="CompanyId" class="text-danger"></span>
            </div>

            <!-- Include Modal -->
            <partial name="_CompanySelector" />

            @section Scripts {
                <script>
                    $(document).ready(function() {
                        CompanySelector.init(function(id, title) {
                            $('#selectedCompanyId').val(id);
                            $('#companyNameDisplay').val(title);
                        });
                    });
                </script>
            }

            <div class="form-footer">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-link">İptal</a>
            </div>
        </form>
    </div>
</div>
