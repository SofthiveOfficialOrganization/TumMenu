@using Application.Categories.DTOs
@using Application.Common.Base.DTOs
@model PaginatedListDTO<CategoryListDTO>

@{
    ViewData["Title"] = "Kategorilerim";
    var currentPageUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1">Kategorilerim</h4>
                    <p class="text-secondary small mb-0">Size ait menülerdeki kategorileri yönetin.</p>
                </div>
                <a asp-action="CreateCategory" asp-route-returnUrl="@currentPageUrl" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Kategori Ekle
                </a>
            </div>

            <!-- Aktif Filtreler (Chipler) -->
            @{
                var hasSearch = !string.IsNullOrEmpty(Context.Request.Query["Search"]);
                var hasCompany = !string.IsNullOrEmpty(Context.Request.Query["CompanyId"]);
                var hasStore = !string.IsNullOrEmpty(Context.Request.Query["StoreId"]);
                var hasMenu = !string.IsNullOrEmpty(Context.Request.Query["MenuId"]);
                var hasAnyFilter = hasSearch || hasCompany || hasStore || hasMenu;
            }
            @if (hasAnyFilter)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="text-secondary small fw-bold me-1"><i class="fas fa-filter text-muted me-1"></i> Aktif Filtreler:</span>
                    @if (hasSearch) { <span class="badge bg-light text-dark border px-2 py-1 shadow-sm"><i class="fas fa-search text-muted me-1"></i> @Context.Request.Query["Search"]</span> }
                    @if (hasCompany) { <span class="badge bg-light text-dark border px-2 py-1 shadow-sm"><i class="fas fa-building text-muted me-1"></i> Şirket</span> }
                    @if (hasStore) { <span class="badge bg-light text-dark border px-2 py-1 shadow-sm"><i class="fas fa-store text-muted me-1"></i> Dükkan</span> }
                    @if (hasMenu) { <span class="badge bg-light text-dark border px-2 py-1 shadow-sm"><i class="fas fa-book-open text-muted me-1"></i> Menü</span> }
                    <a href="@Url.Action("MyCategories")" class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle text-decoration-none px-2 py-1 ms-1 hover-danger"><i class="fas fa-times me-1"></i> Temizle</a>
                </div>
            }

            <!-- Filtreler -->
            <div class="mb-4">
                <form method="get" class="bg-light p-3 rounded border shadow-sm">
                    <!-- Temel Arama Satırı -->
                    <div class="row g-2 g-md-3 align-items-center m-0">
                        <div class="col-12 col-md">
                            <div class="input-group">
                                <span class="input-group-text bg-white text-secondary border-end-0"><i class="fas fa-search"></i></span>
                                <input type="text" name="Search" class="form-control border-start-0 shadow-none" placeholder="Kategori adı ara..." value="@Context.Request.Query["Search"]">
                            </div>
                        </div>
                        <div class="col-12 col-md-auto">
                            <div class="d-flex gap-2">
                                @{
                                    var isAdvancedFilterOpen = hasCompany || hasStore || hasMenu;
                                    var collapseClass = isAdvancedFilterOpen ? "collapse show" : "collapse";
                                }
                                <button type="button" class="btn btn-outline-secondary px-3 flex-grow-1 flex-md-grow-0" data-bs-toggle="collapse" data-bs-target="#advancedFilters" aria-expanded="@(isAdvancedFilterOpen ? "true" : "false")" aria-controls="advancedFilters">
                                    <i class="fas fa-sliders-h me-1"></i> Detaylı Filtre
                                </button>
                                <button type="submit" class="btn btn-primary px-3 shadow-sm flex-grow-0"><i class="fas fa-search"></i></button>
                            </div>
                        </div>
                    </div>

                    <!-- Detaylı Filtreler (Collapse) -->
                    <div class="@collapseClass" id="advancedFilters">
                        <div class="row g-3 p-3 mt-3 border-top align-items-end mx-0 mb-0">
                            <!-- Kapsam -->
                            <div class="col-lg-2 col-md-3">
                                <label class="form-label text-secondary small mb-2 fw-bold text-uppercase">Kapsam</label>
                                <div class="btn-group w-100" role="group" aria-label="Kapsam seçimi">
                                    <input type="radio" class="btn-check" name="FilterType" id="filterCompany" value="company" autocomplete="off" @(string.IsNullOrEmpty(Context.Request.Query["StoreId"]) ? "checked" : "")>
                                    <label class="btn btn-outline-secondary" for="filterCompany"><i class="fas fa-building me-1"></i>Şirket</label>

                                    <input type="radio" class="btn-check" name="FilterType" id="filterStore" value="store" autocomplete="off" @(!string.IsNullOrEmpty(Context.Request.Query["StoreId"]) ? "checked" : "")>
                                    <label class="btn btn-outline-secondary" for="filterStore"><i class="fas fa-store me-1"></i>Dükkan</label>
                                </div>
                            </div>

                            <!-- Şirket Seç / Dükkan Seç -->
                            <div class="col-lg-4 col-md-4" id="companyContainer">
                                <label class="form-label text-secondary small mb-2 fw-bold text-uppercase">Şirket Filtresi</label>
                                <div class="w-100">
                                    <select name="CompanyId" id="companySelect" class="form-select select2-ajax w-100" data-url="@Url.Action("GetCompaniesForSelect2", "Company", new { area = "Admin", role = ViewContext.RouteData.Values["role"] })" data-placeholder="Şirket Seçin...">
                                        @if (!string.IsNullOrEmpty(Context.Request.Query["CompanyId"])) { <option value="@Context.Request.Query["CompanyId"]" selected>@(Model.FilterNames.TryGetValue(Context.Request.Query["CompanyId"].ToString()!, out var companyName) ? companyName : "Seçili Filtre")</option> }
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-4" id="storeContainer" style="display: none;">
                                <label class="form-label text-secondary small mb-2 fw-bold text-uppercase">Dükkan Filtresi</label>
                                <div class="w-100">
                                    <select name="StoreId" id="storeSelect" class="form-select select2-ajax w-100" data-url="@Url.Action("GetStoresForSelect2", "Store", new { area = "Admin", role = ViewContext.RouteData.Values["role"] })" data-placeholder="Dükkan Seçin...">
                                        @if (!string.IsNullOrEmpty(Context.Request.Query["StoreId"])) { <option value="@Context.Request.Query["StoreId"]" selected>@(Model.FilterNames.TryGetValue(Context.Request.Query["StoreId"].ToString()!, out var storeName) ? storeName : "Seçili Filtre")</option> }
                                    </select>
                                </div>
                            </div>

                            <!-- Menü -->
                            <div class="col-lg-4 col-md-5">
                                <label class="form-label text-secondary small mb-2 fw-bold text-uppercase">Menü</label>
                                <div class="w-100">
                                    <select name="MenuId" id="menuSelect" class="form-select select2-ajax w-100" data-url="@Url.Action("GetMenusForSelect2", "Menu", new { area = "Admin", role = ViewContext.RouteData.Values["role"] })" data-placeholder="Menü Seçin...">
                                        @if (!string.IsNullOrEmpty(Context.Request.Query["MenuId"])) { <option value="@Context.Request.Query["MenuId"]" selected>@(Model.FilterNames.TryGetValue(Context.Request.Query["MenuId"].ToString()!, out var menuName) ? menuName : "Seçili Filtre")</option> }
                                    </select>
                                </div>
                            </div>

                            <!-- Butonlar (Son Sütun) -->
                            <div class="col-lg-2 col-md-12 d-flex justify-content-lg-end justify-content-start align-items-end mt-3 mt-lg-0">
                                <div class="d-flex gap-2 w-100 w-lg-auto">
                                    <a href="@Url.Action("MyCategories")" class="btn btn-outline-secondary h-100 px-3" title="Filtreleri Temizle"><i class="fas fa-times"></i></a>
                                    <button type="submit" class="btn btn-primary px-3 shadow-sm flex-grow-1"><i class="fas fa-filter me-1"></i> Uygula</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">Kategori Adı</th>
                            <th>Üst Kategori</th>
                            <th>Bağlı Olduğu Şirket / Dükkan</th>
                            <th>Menü</th>
                            <th class="text-center">Ürün Sayısı</th>
                            <th>Sıra</th>
                            <th>Durum</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-primary me-3">
                                                @if (!string.IsNullOrEmpty(item.IconKey))
                                                {
                                                    <i class="@item.IconKey"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-tags"></i>
                                                }
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.Title</span>
                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    <small class="text-muted">@item.Description</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ParentName))
                                        {
                                            <span class="badge bg-light text-secondary border"><i class="fas fa-level-up-alt fa-rotate-90 me-1"></i> @item.ParentName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.StoreName))
                                        {
                                            <div class="d-inline-flex align-items-center p-1 px-2 border rounded bg-light">
                                                <span class="badge bg-info bg-opacity-10 text-info me-2"><i class="fas fa-store"></i> Dükkan</span>
                                                <small class="text-dark fw-medium">@item.StoreName</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-inline-flex align-items-center p-1 px-2 border rounded bg-light">
                                                <span class="badge bg-primary bg-opacity-10 text-primary me-2"><i class="fas fa-building"></i> Şirket</span>
                                                <small class="text-dark fw-medium">@item.CompanyName</small>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-secondary">@item.MenuName</td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark fw-normal">@item.ProductCount Ürün</span>
                                    </td>
                                    <td class="text-secondary">@item.SortOrder</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">AKTİF</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary">PASİF</span>
                                        }
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <a asp-action="Create" asp-route-menuId="@item.MenuId" asp-route-parentId="@item.Id" asp-route-returnUrl="@currentPageUrl" class="btn btn-sm btn-outline-primary me-1" title="Alt Kategori Ekle">
                                            <i class="fas fa-plus"></i> <i class="fas fa-level-down-alt"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="@currentPageUrl" class="btn btn-sm btn-outline-secondary me-1" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteCatModal-@item.Id" title="Sil">
                                            <i class="fas fa-trash"></i>
                                        </button>

                                        <div class="modal fade" id="deleteCatModal-@item.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Kategoriyi Sil</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p><strong>@item.Title</strong> kategorisini menüden kaldırmak istediğinize emin misiniz?</p>
                                                        @if (item.ProductCount > 0)
                                                        {
                                                            <div class="alert alert-warning mb-0">
                                                                <i class="fas fa-exclamation-triangle me-1"></i>
                                                                Bu kategoride <strong>@item.ProductCount ürün</strong> bulunmaktadır.
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                                        <form asp-action="Delete" asp-route-id="@item.Id" asp-route-menuId="@item.MenuId" asp-route-returnUrl="@currentPageUrl" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger">Evet, Kaldır</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-secondary">
                                    <div class="mb-3">
                                        <span class="fa-stack fa-2x">
                                            <i class="fas fa-circle fa-stack-2x text-light"></i>
                                            <i class="fas fa-tags fa-stack-1x text-secondary opacity-50"></i>
                                        </span>
                                    </div>
                                    <h5>Kategori bulunamadı</h5>
                                    <p class="small">Aradığınız kriterlere uygun, size ait bir kategori yok.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Sayfalama -->
            @if (Model != null && Model.Pages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav aria-label="Sayfa navigasyonu">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-PageIndex="@(Model.Index - 1)"
                                   asp-route-Search="@Context.Request.Query["Search"]">Önceki</a>
                            </li>
                            @for (int i = 1; i <= Model.Pages; i++)
                            {
                                <li class="page-item @(Model.Index == i ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-PageIndex="@i"
                                       asp-route-Search="@Context.Request.Query["Search"]">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-PageIndex="@(Model.Index + 1)"
                                   asp-route-Search="@Context.Request.Query["Search"]">Sonraki</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function toggleFilterType() {
                if ($('#filterCompany').is(':checked')) {
                    $('#companyContainer').show();
                    $('#storeContainer').hide();
                    if ($('#storeSelect').val()) {
                        $('#storeSelect').val(null).trigger('change');
                    }
                } else {
                    $('#companyContainer').hide();
                    $('#storeContainer').show();
                    if ($('#companySelect').val()) {
                        $('#companySelect').val(null).trigger('change');
                    }
                }
            }

            $('input[name="FilterType"]').change(toggleFilterType);
            
            // Initial load
            if ($('#filterStore').is(':checked')) {
                $('#companyContainer').hide();
                $('#storeContainer').show();
            } else {
                $('#companyContainer').show();
                $('#storeContainer').hide();
            }

            $('.select2-ajax').each(function() {
                var $this = $(this);
                var url = $this.data('url');
                var placeholder = $this.data('placeholder');

                $this.select2({
                    theme: 'bootstrap-5',
                    placeholder: placeholder,
                    allowClear: true,
                    width: '100%',
                    ajax: {
                        url: url,
                        dataType: 'json',
                        delay: 250,
                        data: function(params) {
                            return {
                                search: params.term,
                                page: params.page || 1,
                                companyId: $('#companySelect').val(),
                                storeId: $('#storeSelect').val(),
                                menuId: $('#menuSelect').val()
                            };
                        },
                        processResults: function(data, params) {
                            params.page = params.page || 1;
                            return {
                                results: data.results,
                                pagination: {
                                    more: data.pagination.more
                                }
                            };
                        },
                        cache: true
                    }
                });
            });
        });
    </script>
}
