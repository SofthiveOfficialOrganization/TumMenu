@using Application.Common.Base.DTOs
@using Application.Categories.DTOs
@model PaginatedListDTO<CategoryDTO>

@{
    ViewData["Title"] = "Categories";
}

<div class="row">
    <div class="col-md-12">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold">Categories</h4>
                <div class="d-flex gap-2">
                     <form method="get" class="d-flex align-items-center">
                         <!-- Assumes request might have MenuId filter -->
                         @if(Context.Request.Query.ContainsKey("menuId"))
                         {
                             <input type="hidden" name="menuId" value="@Context.Request.Query["menuId"]" />
                         }
                        <input type="text" name="Search" class="form-control me-2" placeholder="Search categories..." value="@Context.Request.Query["Search"]" style="min-width: 250px;">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                    </form>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-hover">
                    <thead>
                        <tr class="text-secondary small text-uppercase border-bottom">
                            <th class="ps-3">Name</th>
                            <th>Slug</th>
                            <th>Description</th>
                            <th>Order</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="horizon-avatar bg-light text-warning me-3">
                                                <i class="fas fa-tags"></i>
                                            </div>
                                            <span class="fw-bold text-dark">@item.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-secondary small">@item.Slug</td>
                                    <td class="text-secondary small text-truncate" style="max-width: 250px;">@item.Description</td>
                                    <td><span class="badge bg-light text-dark">@item.SortOrder</span></td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-slug="@item.Slug" class="btn btn-sm btn-light text-primary me-2" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-success me-2" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light text-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="fas fa-tags fa-3x mb-3 d-block opacity-50"></i>
                                    No categories found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

             <!-- Pagination -->
            @if (Model != null && Model.Pages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div class="text-secondary small">
                        Showing @Model.Items.Count of @Model.Count entries
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-Index="@(Model.Index - 1)" asp-route-Search="@Context.Request.Query["Search"]" asp-route-menuId="@Context.Request.Query["menuId"]">Previous</a>
                            </li>
                            @for (int i = 1; i <= Model.Pages; i++)
                            {
                                <li class="page-item @(Model.Index == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-Index="@i" asp-route-Search="@Context.Request.Query["Search"]" asp-route-menuId="@Context.Request.Query["menuId"]">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-Index="@(Model.Index + 1)" asp-route-Search="@Context.Request.Query["Search"]" asp-route-menuId="@Context.Request.Query["menuId"]">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
