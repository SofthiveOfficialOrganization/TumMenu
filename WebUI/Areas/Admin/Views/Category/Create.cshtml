@using Application.Menus.Commands
@model AddCategoryToMenuCommand

@{
    ViewData["Title"] = "Menüye Kategori Ekle";
    var excludeIds = ViewBag.ExcludeIds as string ?? "";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var fallbackUrl = returnUrl ?? Url.Action("Details", "Menu", new { id = Model.MenuId });
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <div class="mb-4 text-center">
                <h3 class="fw-bold text-primary">Menüye Kategori Ekle</h3>
                <p class="text-secondary">Bu menüye eklemek için kütüphaneden bir kategori seçin.</p>
            </div>

            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="MenuId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <input type="hidden" id="excludeIdsInput" value="@excludeIds" />

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success mb-4">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="CategoryLibraryItemId" class="form-label fw-bold text-secondary small text-uppercase">Kategori Kütüphanesi Öğesi</label>
                    <div class="d-flex gap-2 align-items-start">
                        <div style="flex: 1; min-width: 0;">
                            <select asp-for="CategoryLibraryItemId" class="form-select" id="categoryLibraryItemSelect">
                            </select>
                        </div>
                        <a asp-controller="CategorySuggestion" asp-action="Submit" class="btn btn-outline-primary flex-shrink-0" title="Kategori Öner" style="height: 38px; white-space: nowrap;">
                            <i class="fas fa-plus"></i>
                        </a>
                    </div>
                    <span asp-validation-for="CategoryLibraryItemId" class="text-danger small"></span>
                    <div class="form-text text-muted small">Kütüphaneden bir kategori şablonu seçin. Aramak için yazmaya başlayın.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="ParentId" class="form-label fw-bold text-secondary small text-uppercase">Üst Kategori (Opsiyonel)</label>
                    <select asp-for="ParentId" class="form-select" id="parentCategorySelect">
                        @if (Model.ParentId.HasValue && !string.IsNullOrEmpty((string?)ViewBag.ParentName))
                        {
                            <option value="@Model.ParentId" selected="selected">@ViewBag.ParentName</option>
                        }
                        else
                        {
                            <option value="">-- Üst Kategori Yok --</option>
                        }
                    </select>
                    <span asp-validation-for="ParentId" class="text-danger small"></span>
                    <div class="form-text text-muted small">Bu kategoriyi başka bir kategorinin altına eklemek isterseniz seçin.</div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="SortOrder" class="form-label fw-bold text-secondary small text-uppercase">Sıralama</label>
                        <input asp-for="SortOrder" class="form-control" type="number" placeholder="Örn: 1" />
                        <span asp-validation-for="SortOrder" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase d-block">&nbsp;</label>
                        <div class="form-check form-switch custom-switch-lg ps-0">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsActive" id="IsActiveSwitch">
                                <label class="form-check-label text-dark" for="IsActiveSwitch">
                                    Menüde Aktif
                                    <small class="d-block text-muted fw-normal" style="font-size: 0.75rem;">Bu kategori görünür olsun</small>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-5">
                    <a href="@fallbackUrl" data-tummenu-back data-fallback-url="@fallbackUrl" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Geri Dön
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-check-circle me-2"></i> Ekle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    $(document).ready(function () {
        const excludeIds = $('#excludeIdsInput').val();
        const ajaxUrl = '@Url.Action("GetCategoryLibraryItems", "Category", new { area = "Admin" })';

        $('#categoryLibraryItemSelect').select2({
            theme: 'bootstrap-5',
            width: '100%',
            placeholder: '-- Kategori Seç --',
            allowClear: true,
            minimumInputLength: 0,
            ajax: {
                url: ajaxUrl,
                dataType: 'json',
                delay: 300,
                data: function (params) {
                    return {
                        search: params.term || '',
                        excludeIds: excludeIds,
                        page: params.page || 1,
                        pageSize: 15
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.results,
                        pagination: {
                            more: data.pagination.more
                        }
                    };
                },
                cache: true
            },
            language: {
                inputTooShort: function () { return ''; },
                noResults: function () { return 'Sonuç bulunamadı'; },
                searching: function () { return 'Aranıyor...'; },
                loadingMore: function () { return 'Daha fazla yükleniyor...'; }
            }
        });

        const menuId = '@Model.MenuId';
        const parentCategoryAjaxUrl = '@Url.Action("GetCategoriesForSelect2", "Category", new { area = "Admin" })';
        
        $('#parentCategorySelect').select2({
            theme: 'bootstrap-5',
            width: '100%',
            placeholder: '-- Üst Kategori Yok --',
            allowClear: true,
            ajax: {
                url: parentCategoryAjaxUrl,
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        search: params.term || '',
                        menuId: menuId,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.results,
                        pagination: {
                            more: data.pagination.more
                        }
                    };
                },
                cache: true
            }
        });
    });
    </script>
}
