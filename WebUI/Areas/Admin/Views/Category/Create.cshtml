@using Application.Menus.Commands
@model AddCategoryToMenuCommand

@{
    ViewData["Title"] = "Add Category to Menu";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Add Category to Menu</h5>
                    <p class="text-secondary small mb-0">Select a category from the library to add to this menu.</p>
                </div>
                <a asp-controller="Menu" asp-action="Details" asp-route-id="@Model.MenuId" class="btn btn-sm btn-light text-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Back to Menu
                </a>
            </div>

            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="MenuId" />

                <div class="mb-3">
                    <label asp-for="CategoryLibraryItemId" class="form-label text-secondary small text-uppercase fw-bold">Category Library Item</label>
                    <select asp-for="CategoryLibraryItemId" class="form-select form-select-lg" asp-items="ViewBag.CategoryLibraryItems">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryLibraryItemId" class="text-danger"></span>
                    <div class="form-text">Choose a category template from the library.</div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="SortOrder" class="form-label text-secondary small text-uppercase fw-bold">Sort Order</label>
                        <input asp-for="SortOrder" class="form-control" type="number" />
                        <span asp-validation-for="SortOrder" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-check mt-4 pt-2">
                             <input class="form-check-input" type="checkbox" asp-for="IsActive">
                             <label class="form-check-label text-dark fw-bold" asp-for="IsActive">
                                Active on Menu
                             </label>
                        </div>
                    </div>
                </div>

                <div class="text-end border-top pt-3 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-plus me-1"></i> Add Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
