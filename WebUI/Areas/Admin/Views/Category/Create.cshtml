@using Application.Categories.Commands
@model CreateCategoryCommand

@{
    ViewData["Title"] = "Create Category";
    var menuId = Context.Request.Query["menuId"];
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <h4 class="fw-bold mb-4">Create Category</h4>
            
            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="MenuId" value="@menuId" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                         <label asp-for="Title" class="form-label text-secondary small text-uppercase fw-bold">Name</label>
                         <input asp-for="Title" class="form-control" placeholder="Category Name" />
                         <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                     <div class="col-md-6 mb-3">
                         <label asp-for="Slug" class="form-label text-secondary small text-uppercase fw-bold">Slug (Optional)</label>
                         <input asp-for="Slug" class="form-control" placeholder="custom-slug" />
                         <span asp-validation-for="Slug" class="text-danger small"></span>
                         <div class="form-text">Leave empty to auto-generate from name.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-secondary small text-uppercase fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Description of the category..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="SortOrder" class="form-label text-secondary small text-uppercase fw-bold">Sort Order</label>
                    <input asp-for="SortOrder" class="form-control" type="number" value="0" />
                    <span asp-validation-for="SortOrder" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Menu" asp-action="Details" asp-route-id="@menuId" class="btn btn-light text-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
