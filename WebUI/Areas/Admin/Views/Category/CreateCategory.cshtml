@using Application.Menus.Queries
@using Application.Menus.Commands
@using Application.Categories.DTOs
@model AddCategoryToMenuCommand

@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="horizon-card">
            <div class="mb-4 text-center">
                <h3 class="fw-bold text-primary">@ViewData["Title"]</h3>
                <p class="text-secondary">Menüye yeni bir kategori ekleyin.</p>
            </div>

            <form asp-action="CreateCategory" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Menü Seçimi</label>
                    <select name="menuId" id="menuSelect" class="form-select" required>
                        <option value="">Menü seçin...</option>
                    </select>
                    <span class="text-danger small" data-valmsg-for="menuId"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Üst Kategori (İsteğe Bağlı)</label>
                    <select name="parentId" id="parentSelect" class="form-select">
                        <option value="">Yok (Ana Kategori)</option>
                    </select>
                    <small class="form-text text-muted">Boş bırakılırsa ana kategori oluşturulur.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Kategori Kütüphanesi Seçimi</label>
                    <select name="categoryLibraryItemId" id="categoryLibrarySelect" class="form-select" required>
                        <option value="">Kategori seçin...</option>
                    </select>
                    <span class="text-danger small" data-valmsg-for="categoryLibraryItemId"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-5">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>İptal
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-check-circle me-2"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            let menuCategories = {};
            
            // Load menus
            $.get('@Url.Action("GetMenusForSelect2", "Menu", new { area = "Admin", role = ViewContext.RouteData.Values["role"] })', 
                function(data) {
                    data.results.forEach(function(menu) {
                        $('#menuSelect').append('<option value="' + menu.id + '">' + menu.text + '</option>');
                    });
                });

            // When menu changes, load its categories and update parent category dropdown
            $('#menuSelect').on('change', function() {
                var menuId = $(this).val();
                $('#parentSelect').html('<option value="">Yok (Ana Kategori)</option>');
                $('#categoryLibrarySelect').html('<option value="">Kategori seçin...</option>');
                
                if (menuId) {
                    // Load existing categories for parent dropdown
                    $.get('@Url.Action("GetCategoriesForSelect2", "Category", new { area = "Admin", role = ViewContext.RouteData.Values["role"] })', 
                        { menuId: menuId }, 
                        function(data) {
                            menuCategories[menuId] = data.results;
                            data.results.forEach(function(cat) {
                                $('#parentSelect').append('<option value="' + cat.id + '">' + cat.text + '</option>');
                            });
                        });
                    
                    // Load category library items (excluding existing ones)
                    $.get('@Url.Action("GetCategoryLibraryItems", "Category", new { area = "Admin", role = ViewContext.RouteData.Values["role"] })', 
                        { menuId: menuId }, 
                        function(data) {
                            data.results.forEach(function(item) {
                                $('#categoryLibrarySelect').append('<option value="' + item.id + '">' + item.text + '</option>');
                            });
                        });
                }
            });
        });
    </script>
}
