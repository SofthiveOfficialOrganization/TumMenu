@using Application.Categories.DTOs
@model CategoryDTO

@{
    ViewData["Title"] = "Kategori Detayları";
    ViewData["AdminPageClass"] = "admin-page-category-details";
    var returnUrl = ViewData["ReturnUrl"] as string
        ?? Url.Action("Details", "Menu", new { id = Model.MenuId });
    var currentPageUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var subCategoryCount = Model.SubCategories?.Count ?? 0;
    var productCount = Model.Products?.Count ?? 0;
}

<div class="d-none">
    @Html.AntiForgeryToken()
</div>

<div class="category-details-page">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-dismissible fade show mb-3" role="alert" style="background-color: #d4edda; border-color: #c3e6cb; color: #155724;">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-dismissible fade show mb-3" role="alert" style="background-color: #f8d7da; border-color: #f5c6cb; color: #721c24;">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row category-details-layout">
        <div class="col-md-4 category-details-column">
            <div class="horizon-card category-details-card category-details-info-card">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width:56px; height:56px; font-size:24px; flex-shrink:0; background-color: rgba(var(--horizon-primary-rgb), 0.1); color: var(--horizon-primary);">
                    @if (!string.IsNullOrEmpty(Model.CategoryLibraryItem.IconKey))
                    {
                        <i class="@Model.CategoryLibraryItem.IconKey"></i>
                    }
                    else
                    {
                        <span class="fw-bold fs-4">@Model.CategoryLibraryItem.Title.Substring(0, 1).ToUpper()</span>
                    }
                </div>
                <div>
                    <h5 class="fw-bold m-0">Kategori Bilgileri</h5>
                    <small class="text-secondary">@Model.CategoryLibraryItem.Title</small>
                </div>
            </div>

            <div class="mb-3">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">İsim</label>
                <div class="p-2 border rounded bg-light text-dark fw-semibold">@Model.CategoryLibraryItem.Title</div>
            </div>

            <div class="mb-3">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Kategori Tipi</label>
                @if (Model.ParentId.HasValue)
                {
                    <span class="badge bg-info bg-opacity-10 text-info border">Alt Kategori</span>
                }
                else
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary border">Ana Kategori</span>
                }
            </div>

            <div class="mb-3">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Durum</label>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">AKTİF</span>
                }
                else
                {
                    <span class="badge bg-light text-secondary border">PASİF</span>
                }
            </div>

            <form asp-controller="Category"
                  asp-action="SetVisibility"
                  asp-route-id="@Model.Id"
                  asp-route-isActive="@(!Model.IsActive)"
                  asp-route-returnUrl="@currentPageUrl"
                  method="post"
                  class="mb-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn @(Model.IsActive ? "btn-outline-warning" : "btn-outline-success") w-100">
                    <i class="fas @(Model.IsActive ? "fa-eye-slash" : "fa-eye") me-2"></i>
                    @(Model.IsActive ? "Kategoriyi Gizle" : "Kategoriyi Göster")
                </button>
            </form>

            <div class="mb-3 d-none d-md-block">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Sıralama</label>
                <div class="p-2 border rounded bg-light text-dark fw-semibold">@Model.SortOrder</div>
            </div>

            <div class="mb-3 d-none d-md-block">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Alt Kategori Sayısı</label>
                <div class="p-2 border rounded bg-light text-dark fw-semibold">@subCategoryCount</div>
            </div>

            <div class="mb-4 d-none d-md-block">
                <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Ürün Sayısı</label>
                <div class="p-2 border rounded bg-light text-dark fw-semibold">@productCount</div>
            </div>

            <div class="d-grid gap-2">
                <a href="@returnUrl" data-tummenu-back data-fallback-url="@returnUrl" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Geri Dön
                </a>
            </div>

            <div class="mt-4 pt-3 border-top text-center text-muted small">
                Oluşturuldu: @Model.CreatedAt?.ToString("d")
            </div>
        </div>
    </div>

        <div class="col-md-8 category-details-column category-details-main">
            <div class="horizon-card category-details-card category-details-section category-details-section--subcategories">
                <div class="d-flex justify-content-between align-items-center mb-4 category-details-section-header">
                <div>
                    <h5 class="fw-bold mb-1">Kategoriler</h5>
                    <p class="text-secondary small mb-0">Bu kategorinin altındaki kategorileri yönetin.</p>
                </div>
                <a asp-controller="Category" asp-action="Create" asp-route-menuId="@Model.MenuId" asp-route-parentId="@Model.Id" asp-route-returnUrl="@currentPageUrl" class="btn btn-sm btn-primary">
                    <i class="fas fa-plus me-1"></i> Alt Kategori Ekle
                </a>
            </div>

                <div id="subcategory-grid" class="row category-details-scroll">
                @if (Model.SubCategories != null && Model.SubCategories.Any())
                {
                    foreach (var sub in Model.SubCategories.OrderBy(c => c.SortOrder))
                    {
                        var subCategoryDetailsUrl = Url.Action("Details", "Category", new { id = sub.Id, returnUrl = currentPageUrl });
                        <div class="col-md-6 mb-3 subcategory-item" data-id="@sub.Id">
                            <div class="card h-100 shadow-sm border-0 cursor-move" data-tummenu-click-url="@subCategoryDetailsUrl">
                                <div class="card-body d-flex align-items-center">
                                    <div class="me-3 text-secondary handle">
                                        <i class="fas fa-grip-vertical"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-dark mb-1">@sub.CategoryLibraryItem.Title</h6>
                                        @if (!sub.IsActive)
                                        {
                                            <span class="badge bg-secondary" style="font-size: 0.65em;">PASİF</span>
                                        }
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="@subCategoryDetailsUrl" class="btn btn-sm btn-outline-secondary" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-center py-4 border rounded"
                             style="background-color: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.12); color: rgba(255,255,255,0.88);">
                            <i class="fas fa-layer-group fa-lg mb-2 d-block" style="color: rgba(255,255,255,0.65);"></i>
                            <p class="mb-0 small" style="color: rgba(255,255,255,0.88);">Alt kategori bulunamadı.</p>
                        </div>
                    </div>
                }
            </div>
            </div>

            <div class="horizon-card category-details-card category-details-section category-details-section--products">
                <div class="d-flex justify-content-between align-items-center mb-4 category-details-section-header">
                <div>
                    <h5 class="fw-bold mb-1">Ürünler</h5>
                    <p class="text-secondary small mb-0">Bu kategorideki ürünleri yönetin.</p>
                </div>
                <a asp-controller="Product" asp-action="Create" asp-route-categoryId="@Model.Id" asp-route-returnUrl="@currentPageUrl" class="btn btn-sm btn-primary">
                    <i class="fas fa-plus me-1"></i> Yeni Ürün Ekle
                </a>
            </div>

                <div id="product-grid" class="row category-details-scroll">
                @if (Model.Products != null && Model.Products.Any())
                {
                    foreach (var product in Model.Products.OrderBy(c => c.SortOrder))
                    {
                        var productDetailsUrl = Url.Action("Details", "Product", new { id = product.Id, returnUrl = currentPageUrl });
                        <div class="col-md-12 mb-3 product-item" data-id="@product.Id">
                            <div class="card h-100 shadow-sm border-0 cursor-move" data-tummenu-click-url="@productDetailsUrl">
                                <div class="card-body d-flex align-items-center">
                                    <div class="me-3 text-secondary handle">
                                        <i class="fas fa-grip-vertical fa-lg"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <h6 class="fw-bold text-dark mb-1">@product.Title</h6>
                                            @if (!product.IsActive)
                                            {
                                                <span class="badge bg-secondary" style="font-size: 0.65em;">PASİF</span>
                                            }
                                        </div>
                                        <p class="text-muted small mb-0 d-flex gap-3 mt-1">
                                            <span class="fw-bold" style="color: var(--horizon-primary);">@product.BasePrice.ToString("C")</span>
                                            @if (product.Prices.Count > 0)
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">+@product.Prices.Count seçenek</span>
                                            }
                                            @if (product.IsVegan == true)
                                            {
                                                <span class="badge" style="background-color: rgba(var(--horizon-primary-rgb), 0.1); color: var(--horizon-primary);"><i class="fas fa-leaf me-1"></i>Vegan</span>
                                            }
                                            @if (product.IsVegetarian == true)
                                            {
                                                <span class="badge" style="background-color: rgba(var(--horizon-primary-rgb), 0.1); color: var(--horizon-primary);"><i class="fas fa-seedling me-1"></i>Vejetaryen</span>
                                            }
                                        </p>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" asp-route-returnUrl="@currentPageUrl" class="btn btn-sm btn-outline-primary" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" asp-route-categoryId="@Model.Id" asp-route-returnUrl="@currentPageUrl" method="post" class="d-inline" id="deleteProduct-@product.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="TumMenuAlerts.confirm('Bu ürünü silmek istediğinize emin misiniz?', 'Bu işlem geri alınamaz!', 'Evet, Sil!').then(res => { if(res) document.getElementById('deleteProduct-@product.Id').submit(); })">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-center py-5 border rounded"
                             style="background-color: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.12); color: rgba(255,255,255,0.88);">
                            <i class="fas fa-hamburger fa-2x mb-3 d-block" style="color: rgba(255,255,255,0.65);"></i>
                            <p class="mb-0" style="color: rgba(255,255,255,0.88);">Bu kategoride henüz ürün yok. Yukarıdan ekleyebilirsiniz.</p>
                        </div>
                    </div>
                }
            </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var requestToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            var grid = document.getElementById('product-grid');
            if (grid && grid.querySelectorAll('.product-item').length > 0) {
                new Sortable(grid, {
                    animation: 150,
                    handle: '.handle',
                    ghostClass: 'bg-light',
                    onEnd: function () {
                        var items = Array.from(grid.querySelectorAll('.product-item'));
                        var itemsData = items.map(function (item, index) {
                            return {
                                id: item.getAttribute('data-id'),
                                sortOrder: index
                            };
                        });

                        var headers = {
                            'Content-Type': 'application/json'
                        };

                        if (requestToken) {
                            headers.RequestVerificationToken = requestToken;
                        }

                        fetch('/admin/Product/UpdateSortOrder', {
                            method: 'POST',
                            headers: headers,
                            body: JSON.stringify({ items: itemsData })
                        }).then(response => {
                            if (!response.ok) {
                                console.error('Product sort order update failed');
                            }
                        }).catch(error => {
                            console.error('Error:', error);
                        });
                    }
                });
            }

            var subgrid = document.getElementById('subcategory-grid');
            if (subgrid && subgrid.querySelectorAll('.subcategory-item').length > 0) {
                new Sortable(subgrid, {
                    animation: 150,
                    handle: '.handle',
                    ghostClass: 'bg-light',
                    onEnd: function () {
                        var items = Array.from(subgrid.querySelectorAll('.subcategory-item'));
                        var itemsData = items.map(function (item, index) {
                            return {
                                id: item.getAttribute('data-id'),
                                sortOrder: index
                            };
                        });

                        var headers = {
                            'Content-Type': 'application/json'
                        };

                        if (requestToken) {
                            headers.RequestVerificationToken = requestToken;
                        }

                        fetch('/admin/Category/UpdateSortOrder', {
                            method: 'POST',
                            headers: headers,
                            body: JSON.stringify({ items: itemsData })
                        }).then(response => {
                            if (!response.ok) {
                                console.error('Subcategory sort order update failed');
                            }
                        }).catch(error => {
                            console.error('Error:', error);
                        });
                    }
                });
            }
        });
    </script>
}
