@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Kayıt Onayı";
}

@section Head {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}
<div class="confirmation-container">

    <h1 class="confirmation-title">Kayıt İşleminizi Tamamlayın!</h1>
    
    <p class="confirmation-message">
        Kayıt işleminiz başarıyla tamamlandı! <br>
        Hesabınızı aktive etmek için lütfen e-posta adresinizi kontrol edin.
    </p>

    <div class="email-display">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        @Model.Email
    </div>

    <div class="instruction-list">
        <div class="instruction-item">
            <div class="instruction-number">1</div>
            <div class="instruction-text">E-posta kutunuzu açın</div>
        </div>
        <div class="instruction-item">
            <div class="instruction-number">2</div>
            <div class="instruction-text">TumMenu'dan gelen e-postayı bulun</div>
        </div>
        <div class="instruction-item">
            <div class="instruction-number">3</div>
            <div class="instruction-text">"Hesabımı Onayla" butonuna tıklayın</div>
        </div>
    </div>

