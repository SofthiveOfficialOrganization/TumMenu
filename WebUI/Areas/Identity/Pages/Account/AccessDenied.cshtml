@page
@model AccessDeniedModel
@{
    bool isAdmin = !string.IsNullOrEmpty(Model.ReturnUrl) && Model.ReturnUrl.Contains("admin", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isAdmin ? "Erişim Engellendi" : "Erişim Engellendi";
    Layout = isAdmin ? "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml" : "/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card shadow-lg border-0" style="max-width: 500px; width: 100%;">
        <div class="card-body text-center p-5">
            <div class="mb-4">
                <i class="bi bi-shield-lock-fill text-danger display-1"></i>
            </div>
            <h2 class="card-title text-danger mb-3 fw-bold">@ViewData["Title"]</h2>
            <p class="card-text text-muted mb-4 fs-5">
                Bu sayfaya erişim yetkiniz bulunmamaktadır.
                @if (isAdmin)
                {
                    <span>Lütfen yöneticinizle iletişime geçin.</span>
                }
            </p>
            
            <div class="d-grid gap-2">
                @if (isAdmin)
                {
                    <a href="/Admin/Dashboard" class="btn btn-primary btn-lg">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard'a Dön
                    </a>
                }
                else
                {
                    <a href="/" class="btn btn-primary btn-lg">
                        <i class="bi bi-house-door me-2"></i>Anasayfaya Dön
                    </a>
                }
            </div>
        </div>
    </div>
</div>
