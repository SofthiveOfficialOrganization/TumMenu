@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Kişisel Veriler";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>Hesabınız, bize verdiğiniz kişisel verileri içerir. Bu sayfa, bu verileri indirmenize veya silmenize olanak tanır.</p>
        <p>
            <strong>Bu verilerin silinmesi hesabınızı kalıcı olarak kaldıracaktır ve bu işlem geri alınamaz.</strong>
        </p>
        <div class="d-flex gap-3 mt-3">
            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                <button class="btn btn-primary px-4" type="submit">
                    <i class="fas fa-download me-2"></i>İndir
                </button>
            </form>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger px-4">
                <i class="fas fa-trash me-2"></i>Sil
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
