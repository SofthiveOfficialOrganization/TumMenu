@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<ul class="nav flex-column manage-nav">
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded @ManageNavPages.IndexNavClass(ViewContext)"
           id="profile" asp-page="./Index">
            <i class="fas fa-user"></i>
            <span>Profil</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded @ManageNavPages.EmailNavClass(ViewContext)"
           id="email" asp-page="./Email">
            <i class="fas fa-envelope"></i>
            <span>E-posta</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded @ManageNavPages.ChangePasswordNavClass(ViewContext)"
           id="change-password" asp-page="./ChangePassword">
            <i class="fas fa-key"></i>
            <span>Şifre</span>
        </a>
    </li>
    @if (hasExternalLogins)
    {
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded @ManageNavPages.ExternalLoginsNavClass(ViewContext)"
               id="external-login" asp-page="./ExternalLogins">
                <i class="fas fa-link"></i>
                <span>Harici Girişler</span>
            </a>
        </li>
    }
    <li class="nav-item">
        @* <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)"
           id="two-factor" asp-page="./TwoFactorAuthentication">
            <i class="fas fa-shield-alt"></i>
            <span>İki Faktörlü Doğrulama</span>
        </a> *@
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded @ManageNavPages.PersonalDataNavClass(ViewContext)"
           id="personal-data" asp-page="./PersonalData">
            <i class="fas fa-database"></i>
            <span>Kişisel Veriler</span>
        </a>
    </li>
</ul>
