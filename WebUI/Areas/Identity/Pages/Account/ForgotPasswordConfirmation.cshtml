@page "/forgot-password-confirmation"
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Şifre Sıfırlama Onayı";
}

@section Head {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-container">
        <h1 class="auth-title">@ViewData["Title"]</h1>
        <p class="auth-subtitle">
            Şifre sıfırlama bağlantısı e-posta adresinize gönderildi.<br>
            Lütfen e-postanızı kontrol edin ve bağlantıya tıklayarak şifrenizi sıfırlayın.
        </p>

        <div class="auth-links" style="margin-top: 1.5rem;">
            <a href="/login" class="btn btn--primary btn--full">Giriş Sayfasına Dön</a>
        </div>
    </div>
</div>


