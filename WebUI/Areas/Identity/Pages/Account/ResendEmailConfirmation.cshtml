@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Onay E-postasını Tekrar Gönder";
}

@section Head {
    <link rel="stylesheet" href="~/css/auth.css?v=@DateTime.Now.Ticks" asp-append-version="true" />
}

<div class="confirmation-container" style="max-width: 500px;">
    <h1 class="confirmation-title">@ViewData["Title"]</h1>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.StatusMessage.Contains("başarıyla") ? "alert-success" : "alert-info") mb-4">
            @Model.StatusMessage
        </div>
    }

    <p class="confirmation-message">
        Hesabınızı onaylamak için e-posta adresinize gönderilen linke tıklamanız gerekiyor.
        E-postayı almadıysanız, aşağıdan tekrar gönderebilirsiniz.
    </p>

    <form method="post" class="mt-4">
        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
            <label asp-for="Input.Email" class="form-label">E-posta Adresi</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn-resend w-100">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            E-postayı Tekrar Gönder
        </button>
    </form>

    <div class="resend-section mt-4">
        <a asp-page="./Login" class="btn-resend" style="background: #6c757d; border-color: #6c757d;">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
            </svg>
            Giriş Sayfasına Dön
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
