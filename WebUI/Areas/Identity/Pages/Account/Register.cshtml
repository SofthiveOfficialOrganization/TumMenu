@page "/kayit"
@using Application.SystemSettings.DTOs
@model RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
    var legalVersions = Model.LegalVersions ?? new LegalVersionSettingsDTO();
}

@section Head {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-container">
        <h1 class="auth-title">Kayıt Ol</h1>
        <p class="auth-subtitle">Yeni bir hesap oluşturun.</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            
            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">E-posta Adresi</label>
                <input asp-for="Input.Email" class="form-input" autocomplete="username" aria-required="true" placeholder="ornek@email.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
                <div id="emailLiveFeedback" class="live-check-message" aria-live="polite"></div>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">Şifre</label>
                <div class="password-wrapper">
                    <input asp-for="Input.Password" class="form-input" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="password-toggle" tabindex="-1" aria-label="Şifreyi Göster/Gizle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
                <ul id="passwordLiveCheck" class="password-live-check" aria-live="polite">
                    <li data-password-rule="length">En az 6 karakter</li>
                    <li data-password-rule="uppercase">En az bir büyük harf</li>
                    <li data-password-rule="lowercase">En az bir küçük harf</li>
                    <li data-password-rule="digit">En az bir rakam</li>
                    <li data-password-rule="symbol">En az bir sembol</li>
                </ul>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="form-label">Şifre Tekrar</label>
                <div class="password-wrapper">
                    <input asp-for="Input.ConfirmPassword" class="form-input" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="password-toggle" tabindex="-1" aria-label="Şifreyi Göster/Gizle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                <div id="confirmPasswordLiveFeedback" class="live-check-message" aria-live="polite"></div>
            </div>

            <div class="form-group">
                <div class="form-check mb-2">
                    <input asp-for="Input.AcceptTerms" class="form-check-input" type="checkbox" id="acceptTerms" />
                    <label class="form-check-label" for="acceptTerms">
                        <a href="/yasal-bilgiler#section-terms" target="_blank" rel="noopener">Kullanıcı Sözleşmesi</a>
                        (Sürüm: @legalVersions.TermsVersion) metnini okudum ve kabul ediyorum.
                    </label>
                </div>
                <span asp-validation-for="Input.AcceptTerms" class="text-danger"></span>
            </div>

            <div class="form-group">
                <div class="form-check mb-2">
                    <input asp-for="Input.AcceptKvkkNotice" class="form-check-input" type="checkbox" id="acceptKvkkNotice" />
                    <label class="form-check-label" for="acceptKvkkNotice">
                        <a href="/yasal-bilgiler#section-kvkk" target="_blank" rel="noopener">KVKK Aydınlatma Metni</a>
                        (Sürüm: @legalVersions.KvkkVersion) kapsamında bilgilendirildiğimi kabul ediyorum.
                    </label>
                </div>
                <span asp-validation-for="Input.AcceptKvkkNotice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <div class="form-check mb-2">
                    <input asp-for="Input.AcceptPrivacyNotice" class="form-check-input" type="checkbox" id="acceptPrivacyNotice" />
                    <label class="form-check-label" for="acceptPrivacyNotice">
                        <a href="/yasal-bilgiler#section-privacy" target="_blank" rel="noopener">Gizlilik Politikası</a>
                        (Sürüm: @legalVersions.PrivacyVersion) metnini okudum.
                    </label>
                </div>
                <span asp-validation-for="Input.AcceptPrivacyNotice" class="text-danger"></span>
            </div>

            <partial name="_TurnstileWidget" />

            <button id="registerSubmit" type="submit" class="btn btn--primary btn--full">Kayıt Ol</button>
            
            <div class="auth-links">
                <span>
                    Zaten hesabın var mı? 
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Giriş Yap</a>
                </span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('registerForm');
            const submitButton = document.getElementById('registerSubmit');
            const emailInput = document.getElementById('Input_Email');
            const emailFeedback = document.getElementById('emailLiveFeedback');
            const passwordInput = document.getElementById('Input_Password');
            const confirmPasswordInput = document.getElementById('Input_ConfirmPassword');
            const confirmPasswordFeedback = document.getElementById('confirmPasswordLiveFeedback');
            const passwordRules = document.querySelectorAll('#passwordLiveCheck [data-password-rule]');
            let emailCheckTimer;
            let emailAbortController;
            let emailState = 'idle';

            const setLiveMessage = (element, state, message) => {
                if (!element) {
                    return;
                }

                element.textContent = message || '';
                element.className = 'live-check-message';

                if (!message) {
                    return;
                }

                element.classList.add('is-visible', `live-check-message--${state}`);
            };

            const setEmailState = (state, message) => {
                emailState = state;
                setLiveMessage(emailFeedback, state, message);
                if (emailInput) {
                    emailInput.setAttribute('aria-invalid', state === 'error' ? 'true' : 'false');
                }
                if (submitButton) {
                    submitButton.disabled = state === 'checking' || state === 'error';
                }
            };

            const updatePasswordRules = () => {
                if (!passwordInput) {
                    return;
                }

                const password = passwordInput.value;
                const checks = {
                    length: password.length >= 6,
                    uppercase: /\p{Lu}/u.test(password),
                    lowercase: /\p{Ll}/u.test(password),
                    digit: /\p{Nd}/u.test(password),
                    symbol: /[^\p{L}\p{N}]/u.test(password)
                };

                passwordRules.forEach(rule => {
                    const isValid = checks[rule.dataset.passwordRule];
                    rule.classList.toggle('is-valid', Boolean(isValid));
                    rule.classList.toggle('is-invalid', password.length > 0 && !isValid);
                });
            };

            const updateConfirmPassword = () => {
                if (!passwordInput || !confirmPasswordInput) {
                    return;
                }

                if (!confirmPasswordInput.value) {
                    setLiveMessage(confirmPasswordFeedback, 'idle', '');
                    return;
                }

                if (confirmPasswordInput.value === passwordInput.value) {
                    setLiveMessage(confirmPasswordFeedback, 'success', 'Şifreler eşleşiyor.');
                    return;
                }

                setLiveMessage(confirmPasswordFeedback, 'error', 'Şifreler eşleşmiyor.');
            };

            const checkEmailAvailability = () => {
                if (!emailInput) {
                    return;
                }

                window.clearTimeout(emailCheckTimer);
                if (emailAbortController) {
                    emailAbortController.abort();
                }

                const email = emailInput.value.trim();
                if (!email) {
                    setEmailState('idle', '');
                    return;
                }

                if (!emailInput.validity.valid) {
                    setEmailState('idle', '');
                    return;
                }

                emailCheckTimer = window.setTimeout(async () => {
                    emailAbortController = new AbortController();
                    setEmailState('checking', 'E-posta kontrol ediliyor...');

                    try {
                        const response = await fetch(`${window.location.pathname}?handler=CheckEmail&email=${encodeURIComponent(email)}`, {
                            headers: { 'Accept': 'application/json' },
                            signal: emailAbortController.signal
                        });

                        if (!response.ok) {
                            throw new Error('Email check failed.');
                        }

                        const result = await response.json();
                        if (emailInput.value.trim() !== email) {
                            return;
                        }

                        setEmailState(result.isValid ? 'success' : 'error', result.message);
                    } catch (error) {
                        if (error.name === 'AbortError') {
                            return;
                        }

                        setEmailState('idle', '');
                    }
                }, 350);
            };

            document.querySelectorAll('.password-toggle').forEach(button => {
                button.addEventListener('click', function() {
                    const input = this.previousElementSibling;
                    const type = input.type === 'password' ? 'text' : 'password';
                    input.type = type;
                    
                    if (type === 'text') {
                        this.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
                    } else {
                        this.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
                    }
                });
            });

            emailInput?.addEventListener('input', checkEmailAvailability);
            passwordInput?.addEventListener('input', function() {
                updatePasswordRules();
                updateConfirmPassword();
            });
            confirmPasswordInput?.addEventListener('input', updateConfirmPassword);

            form?.addEventListener('submit', function(event) {
                if (emailState === 'checking' || emailState === 'error') {
                    event.preventDefault();
                    emailInput?.focus();
                }
            });

            updatePasswordRules();
        });
    </script>
}

