@page "/kayit"
@model RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

@section Head {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-container">
        <h1 class="auth-title">Kayıt Ol</h1>
        <p class="auth-subtitle">Yeni bir hesap oluşturun.</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            
            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">E-posta Adresi</label>
                <input asp-for="Input.Email" class="form-input" autocomplete="username" aria-required="true" placeholder="ornek@email.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">Şifre</label>
                <div class="password-wrapper">
                    <input asp-for="Input.Password" class="form-input" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="password-toggle" tabindex="-1" aria-label="Şifreyi Göster/Gizle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="form-label">Şifre Tekrar</label>
                <div class="password-wrapper">
                    <input asp-for="Input.ConfirmPassword" class="form-input" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="password-toggle" tabindex="-1" aria-label="Şifreyi Göster/Gizle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>

            <partial name="_TurnstileWidget" />

            <button id="registerSubmit" type="submit" class="btn btn--primary btn--full">Kayıt Ol</button>
            
            <div class="auth-links">
                <span>
                    Zaten hesabın var mı? 
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Giriş Yap</a>
                </span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.password-toggle').forEach(button => {
                button.addEventListener('click', function() {
                    const input = this.previousElementSibling;
                    const type = input.type === 'password' ? 'text' : 'password';
                    input.type = type;
                    
                    if (type === 'text') {
                        this.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
                    } else {
                        this.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
                    }
                });
            });
        });
    </script>
}

