@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Şifre Sıfırlandı";
}

@section Head {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-container">
        <h1 class="auth-title">@ViewData["Title"]</h1>
        <p class="auth-subtitle">
            Şifreniz başarıyla sıfırlandı.<br>
            Yeni şifrenizle giriş yapabilirsiniz.
        </p>

        <a asp-page="./Login" class="btn btn--primary btn--full" style="margin-top: 1.5rem;">Giriş Yap</a>
    </div>
</div>
