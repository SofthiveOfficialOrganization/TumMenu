@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

@section Head {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-container">
        <h1 class="auth-title">Giriş Yap</h1>
        <p class="auth-subtitle">Hesabınıza giriş yaparak devam edin.</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            
            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">E-posta Adresi</label>
                <input asp-for="Input.Email" class="form-input" autocomplete="username" aria-required="true" placeholder="ornek@email.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">Şifre</label>
                <input asp-for="Input.Password" class="form-input" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <label class="form-check">
                <input asp-for="Input.RememberMe" />
                <span>Beni Hatırla</span>
            </label>

            <button id="login-submit" type="submit" class="btn btn--primary btn--full">Giriş Yap</button>

            <div class="auth-links">
                <a id="forgot-password" asp-page="./ForgotPassword" class="auth-link">Şifremi Unuttum?</a>
                <span>
                    Hesabın yok mu? 
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Kayıt Ol</a>
                </span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
