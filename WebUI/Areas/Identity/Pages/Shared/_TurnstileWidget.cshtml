@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    var siteKey = Configuration["CloudflareTurnstile:SiteKey"];
    var enabled = Configuration.GetValue<bool>("CloudflareTurnstile:Enabled", true);
}

@if (enabled)
{
    <div class="form-group turnstile-widget" style="display: flex; justify-content: center; margin-bottom: 15px;">
        <div class="cf-turnstile" 
             data-sitekey="@siteKey" 
             data-theme="light" 
             data-language="tr" 
             ></div>
    </div>

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
}