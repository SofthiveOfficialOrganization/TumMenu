@model ProductDTO

@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <!-- Update action is distinct from Create. Note that we post to Update/Id, but controller expects UpdateProductCommand which uses Id in body usually or route.
                         Controller signature: public async Task<IActionResult> Update(UpdateProductCommand req, CancellationToken ct)
                         Route usually binds properties. We must ensure Id is included.
                    -->
                    <form asp-action="Update">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Title" class="form-label">Ürün Adı</label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label">Kategori</label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">Seçiniz...</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BasePrice" class="form-label">Fiyat</label>
                                <div class="input-group">
                                    <input asp-for="BasePrice" class="form-control" type="number" step="0.01" />
                                    <span class="input-group-text">₺</span>
                                </div>
                                <span asp-validation-for="BasePrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EstimatedPreparationTimeInMinutes" class="form-label">Hazırlama Süresi (dk)</label>
                                <input asp-for="EstimatedPreparationTimeInMinutes" class="form-control" type="number" />
                                <span asp-validation-for="EstimatedPreparationTimeInMinutes" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SortOrder" class="form-label">Sıralama</label>
                                <input asp-for="SortOrder" class="form-control" type="number" />
                                <span asp-validation-for="SortOrder" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Allergens" class="form-label">Alerjenler</label>
                                <input asp-for="Allergens" class="form-control" />
                                <span asp-validation-for="Allergens" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                            <label class="form-check-label" asp-for="IsActive">Aktif (Listede görünsün)</label>
                                        </div>
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" asp-for="IsVegan">
                                            <label class="form-check-label" asp-for="IsVegan">Vegan</label>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" asp-for="IsVegetarian">
                                            <label class="form-check-label" asp-for="IsVegetarian">Vejetaryen</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary">İptal</a>
                            <button type="submit" class="btn btn-primary px-4">Güncelle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
