@{
    ViewData["Title"] = "Email Gönder";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">📧 Email Gönder</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success">
                            <strong>✅ Başarılı!</strong> @ViewBag.Success
                        </div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <strong>❌ Hata!</strong> @ViewBag.Error
                        </div>
                    }

                    <form method="post" asp-action="Send">
                        <div class="mb-3">
                            <label for="toEmail" class="form-label">Email Adresi</label>
                            <input type="email" class="form-control" id="toEmail" name="toEmail" 
                                   placeholder="email@example.com" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="subject" class="form-label">Konu</label>
                            <input type="text" class="form-control" id="subject" name="subject" 
                                   placeholder="Email konusu" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="message" class="form-label">Mesaj</label>
                            <textarea class="form-control" id="message" name="message" rows="5" 
                                      placeholder="Email içeriği" required></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-paper-plane me-2"></i>
                            Email Gönder
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
