@{
    ViewData["Title"] = "QR'lı Ol";
    ViewData["Description"] = "İşletmeni dijital dünyaya taşı. QR menü ile maliyetleri düşür, müşteri memnuniyetini artır, menünü saniyeler içinde güncelle.";
}

@section Head {
    <link rel="stylesheet" href="~/css/BeQr.css" asp-append-version="true" />
}

<!-- HERO SECTION -->
<section class="qr-hero" aria-labelledby="qr-hero-heading">
   
    <div class="container qr-hero__inner">
        <div class="qr-hero__content">

            
            <h1 id="qr-hero-heading" class="qr-hero__title">
                <span>Menünü</span>
                dijital dünyaya taşı.
            </h1>
            
            <p class="qr-hero__subtitle">
                QR menü ile maliyetleri düşür, müşteri memnuniyetini artır, menünü saniyeler içinde güncelle.
                Kağıt menüye veda et, geleceğe merhaba de.
            </p>
            
            <div class="qr-hero__stats">
                <div class="qr-hero__stat">
                    <div class="qr-hero__stat-number" data-target="6">0</div>
                    <div class="qr-hero__stat-label">Kurulum Adımı</div>
                </div>
                <div class="qr-hero__stat">
                    <div class="qr-hero__stat-number" data-target="1">0</div>
                    <div class="qr-hero__stat-label">Sabit QR Kod</div>
                </div>
                <div class="qr-hero__stat">
                    <div class="qr-hero__stat-number" data-target="24">0</div>
                    <div class="qr-hero__stat-label">Saat Erişim</div>
                </div>
            </div>
            
            <div class="qr-hero__cta">
                <a class="btn btn--primary btn--large" href="/kayit">
                    Ücretsiz Başla
                </a>
                <a href="#benefits" class="btn btn--ghost btn--large">
                    Daha Fazla Öğren
                </a>
            </div>
        </div>
        
        <div class="qr-hero__visual">
            <div class="qr-hero__qr-container" id="qr-scan-trigger">
                <div class="qr-hero__qr-code">
                    <div class="qr-hero__qr-inner" id="qr-real-code">
                        <!-- Real QR Code will be generated by JS -->
                    </div>
                    
                    <!-- Phone Scan Overlay -->
                    <div class="qr-phone-overlay" id="qr-phone-overlay">
                        <div class="qr-phone-frame">
                            <div class="qr-phone-notch"></div>
                            <div class="qr-phone-screen">
                                <div class="qr-camera-ui">
                                    <div class="qr-camera-corners"></div>
                                    <div class="qr-scan-beam"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Menu Preview (shown after scan) -->
                    <div class="qr-menu-preview" id="qr-menu-preview">
                        <div class="qr-menu-preview__header">
                            <span class="qr-menu-preview__icon"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-menu")"></use></svg></span>
                            <span class="qr-menu-preview__title">TümMenu</span>
                        </div>
                        <div class="qr-menu-preview__items">
                            <div class="qr-menu-preview__item"></div>
                            <div class="qr-menu-preview__item"></div>
                            <div class="qr-menu-preview__item"></div>
                        </div>
                        <div class="qr-menu-preview__badge"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-check")"></use></svg> Menü Açıldı</div>
                    </div>
                </div>
                
                <!-- Mobile Touch Trigger -->
                <div class="qr-touch-hint" id="qr-touch-hint">
                    <span class="qr-touch-hint__icon"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-phone")"></use></svg></span>
                    <span class="qr-touch-hint__text">Dokun ve tara</span>
                </div>
            </div>
        </div>
    </div>
</section>

