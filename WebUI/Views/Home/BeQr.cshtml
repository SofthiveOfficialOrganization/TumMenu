<!-- 6-STEP ROADMAP -->
<section class="section qr-roadmap" aria-labelledby="roadmap-heading">
    <div class="container">
        <div class="section-heading section-heading--center">
            <h2 id="roadmap-heading" class="section__title">Kurulum Bu Kadar Basit</h2>
            <p class="section__subtitle">
                Hesabını aç, menünü oluştur, QR kodunu müşterinle paylaş.
            </p>
        </div>

        <div class="qr-roadmap__stage" id="roadmapWrapper">
            <svg class="qr-roadmap__road" id="roadSvg" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                    <filter id="qrRoadRoughen" x="-15%" y="-5%" width="130%" height="110%">
                        <feTurbulence type="fractalNoise" baseFrequency="0.03 0.05" numOctaves="3" result="noise" seed="12"></feTurbulence>
                        <feDisplacementMap in="SourceGraphic" in2="noise" scale="5" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
                    </filter>
                    <linearGradient id="qrRoadGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#7f9d58"></stop>
                        <stop offset="35%" stop-color="#9a9c52"></stop>
                        <stop offset="65%" stop-color="#a6904e"></stop>
                        <stop offset="100%" stop-color="#8b6340"></stop>
                    </linearGradient>
                </defs>
                <path id="roadShadow" fill="none" stroke="rgba(63,48,36,0.15)" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"></path>
                <path id="roadWhite" fill="none" stroke="white" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" filter="url(#qrRoadRoughen)" opacity="0.97"></path>
                <path id="roadColor" fill="none" stroke="url(#qrRoadGradient)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"></path>
                <g id="dotsGroup"></g>
            </svg>

            <article class="qr-roadmap__step-row qr-roadmap__step-row--left" style="--c:#7f9d58;">
                <div class="qr-roadmap__video-block">
                    <div class="tm-anim tm-anim--s1" aria-hidden="true">
                        <div class="tm-a-main">
                            <div class="tm-a-topbar">
                                <div class="tm-a-brand">TUM <span>MENU</span></div>
                            </div>
                            <div class="tm-a-body">
                                <div class="tm-a-card">
                                    <div class="tm-a-card-title">Hesap Oluştur</div>
                                    <div class="tm-a-field">
                                        <div class="tm-a-lbl">İşletme Adı</div>
                                        <div class="tm-a-input">Kafe Aroma<span class="tm-a-caret"></span></div>
                                    </div>
                                    <div class="tm-a-field">
                                        <div class="tm-a-lbl">E-posta</div>
                                        <div class="tm-a-input">info@kafearoma.com</div>
                                    </div>
                                    <div class="tm-a-btn">Hesap Oluştur →</div>
                                </div>
                            </div>
                        </div>
                        <div class="tm-a-toast">✓ Hesabın hazır, menüne geçelim!</div>
                    </div>
                </div>
                <div class="qr-roadmap__text-block">
                    <div class="qr-roadmap__step-header">
                        <span class="qr-roadmap__step-badge">01</span>
                        <span class="qr-roadmap__step-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                                <line x1="9" y1="9" x2="15" y2="9"></line>
                                <line x1="9" y1="13" x2="13" y2="13"></line>
                            </svg>
                        </span>
                        <h3 class="qr-roadmap__title">Hesabını Oluştur</h3>
                    </div>
                    <p class="qr-roadmap__desc">TümMenu'ya ücretsiz kayıt ol, işletme bilgilerini gir ve menü sayfanı dakikalar içinde hazır hale getir.</p>
                </div>
            </article>

            <article class="qr-roadmap__step-row qr-roadmap__step-row--right" style="--c:#8fa455;">
                <div class="qr-roadmap__video-block">
                    <div class="tm-anim tm-anim--s2" aria-hidden="true">
                        <div class="tm-a-sidebar">
                            <div class="tm-a-brand">TUM <span>MENU</span></div>
                            <div class="tm-a-item">📊 Dashboard</div>
                            <div class="tm-a-item tm-a-item--active">🏷 Kategoriler</div>
                            <div class="tm-a-item">🛍 Ürünler</div>
                            <div class="tm-a-item">🖼 İçerik</div>
                            <div class="tm-a-item">📱 QR</div>
                        </div>
                        <div class="tm-a-main">
                            <div class="tm-a-topbar">
                                <div class="tm-a-breadcrumb">Admin › Kategoriler</div>
                                <div class="tm-a-avatar">E</div>
                            </div>
                            <div class="tm-a-body">
                                <div class="tm-a-pt">Kategoriler</div>
                                <div class="tm-a-card">
                                    <div class="tm-a-trow">
                                        <div class="tm-a-tname">🍜 Çorbalar</div>
                                        <div class="tm-a-tcount">3 ürün</div>
                                        <div class="tm-a-badge tm-a-badge--green">AKTİF</div>
