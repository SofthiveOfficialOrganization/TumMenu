@section Scripts {
    <script>
        function switchTab(tabId) {
            // Update URL hash without scrolling
            history.pushState(null, null, '#' + tabId);

            // Hide all sections
            document.querySelectorAll('.legal-section').forEach(s => s.classList.remove('is-active'));

            // Deactivate all buttons
            document.querySelectorAll('.legal-tab-btn').forEach(b => {
                b.classList.remove('is-active');
                b.setAttribute('aria-selected', 'false');
            });

            // Activate target
            document.getElementById('section-' + tabId).classList.add('is-active');

            const btn = document.getElementById('tab-' + tabId);
            if (btn) {
                btn.classList.add('is-active');
                btn.setAttribute('aria-selected', 'true');

                // Scroll button into view on mobile
                btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
        }

        // Handle initial hash
        document.addEventListener('DOMContentLoaded', () => {
             // If no hash, default to privacy
            const hash = window.location.hash.replace('#', '') || 'privacy';
            // Verify if section exists
            if (document.getElementById('section-' + hash)) {
                switchTab(hash);
            }
        });

        // Handle back/forward navigation
        window.addEventListener('hashchange', () => {
             const hash = window.location.hash.replace('#', '');
             if (hash && document.getElementById('section-' + hash)) {
                 switchTab(hash);
             }
        });
    </script>
}
