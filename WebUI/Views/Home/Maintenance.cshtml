@{
    ViewData["Title"] = "Güncelleniyor";
    ViewData["Description"] = "Tüm Menü kısa bir güncelleme için geçici olarak bakım modunda.";
    ViewData["Robots"] = "noindex,nofollow";
    ViewData["HideFooter"] = true;
    ViewData["CompactHeader"] = true;
    ViewData["LogoOnlyHeader"] = true;
}

@section Head {
    <style>
        .maintenance-page {
            min-height: calc(100vh - var(--site-header-height, 72px));
            display: grid;
            place-items: center;
            padding: clamp(40px, 8vw, 96px) 24px;
            background:
                radial-gradient(circle at 18% 18%, rgba(175, 199, 148, 0.42), transparent 32%),
                linear-gradient(180deg, var(--color-primary), var(--color-primary-light));
            color: #fff;
            overflow: hidden;
        }

        .maintenance-shell {
            width: min(1040px, 100%);
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            align-items: center;
            gap: clamp(28px, 5vw, 64px);
        }

        @@media (min-width: 860px) {
            .maintenance-shell {
                grid-template-columns: minmax(0, 1fr) minmax(280px, 0.76fr);
            }
        }

        .maintenance-copy {
            max-width: 680px;
        }

        .maintenance-eyebrow {
            display: inline-flex;
            align-items: center;
            min-height: 32px;
            margin: 0 0 18px;
            padding: 6px 13px;
            border: 1px solid rgba(255, 255, 255, 0.24);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.14);
            color: rgba(255, 255, 255, 0.92);
            font-size: 13px;
            font-weight: 800;
        }

        .maintenance-title {
            margin: 0;
            color: var(--color-bg);
            font-size: clamp(42px, 7vw, 84px);
            font-weight: 850;
            line-height: 0.94;
            letter-spacing: 0;
        }

        .maintenance-title span {
            display: block;
            color: #3f3024;
        }

        .maintenance-lead {
            max-width: 560px;
            margin: 24px 0 0;
            color: rgba(255, 255, 255, 0.94);
            font-size: clamp(17px, 2vw, 20px);
            font-weight: 600;
            line-height: 1.7;
        }

        .maintenance-status {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 28px;
        }

        .maintenance-pill {
            display: inline-flex;
            align-items: center;
            min-height: 42px;
            padding: 9px 15px;
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.16);
            color: #fff;
            font-size: 14px;
            font-weight: 800;
        }

        .maintenance-visual {
            position: relative;
            min-height: 300px;
            border-radius: 28px;
            background: rgba(255, 255, 255, 0.16);
            box-shadow: 0 24px 60px rgba(75, 58, 45, 0.18);
            overflow: hidden;
        }

        .maintenance-board {
            position: absolute;
            inset: 34px;
            display: grid;
            gap: 14px;
            align-content: center;
        }

        .maintenance-line {
            height: 18px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.72);
        }

        .maintenance-line:nth-child(1) { width: 72%; }
        .maintenance-line:nth-child(2) { width: 92%; }
        .maintenance-line:nth-child(3) { width: 58%; }

        .maintenance-progress {
            height: 12px;
            margin-top: 12px;
            overflow: hidden;
            border-radius: 999px;
            background: rgba(63, 48, 36, 0.18);
        }

        .maintenance-progress::before {
            content: "";
            display: block;
            width: 62%;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(135deg, #fffdf9, #d7e3bf);
        }
    </style>
}

<section class="maintenance-page" aria-labelledby="maintenance-heading">
    <div class="maintenance-shell">
        <div class="maintenance-copy">
            <p class="maintenance-eyebrow">Kısa bir güncelleme</p>
            <h1 id="maintenance-heading" class="maintenance-title">
                Menüler
                <span>yenileniyor.</span>
            </h1>
            <p class="maintenance-lead">
                Tüm Menü'yü daha stabil ve hızlı hale getirmek için kısa bir bakım yapıyoruz.
                Lütfen birkaç dakika sonra tekrar deneyin.
            </p>
            <div class="maintenance-status" aria-label="Güncelleme durumu">
                <span class="maintenance-pill">Tahmini süre: kısa</span>
                <span class="maintenance-pill">Sayfa otomatik yenilenebilir</span>
            </div>
        </div>

        <div class="maintenance-visual" aria-hidden="true">
            <div class="maintenance-board">
                <span class="maintenance-line"></span>
                <span class="maintenance-line"></span>
                <span class="maintenance-line"></span>
                <span class="maintenance-progress"></span>
            </div>
        </div>
    </div>
</section>
