                    <div class="restaurant-card__meta">
                        <span><span class="restaurant-card__icon">★</span> 4.9 (320)</span>
                        <span><span class="restaurant-card__icon">📍</span> 2.3 km</span>
                        <span><span class="restaurant-card__icon">$</span> $$–$$$</span>
