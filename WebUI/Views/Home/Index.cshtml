                        <div class="home-store-card__no-img">🥗</div>
                        <span class="home-store-card__badge">Yeni</span>
                    </div>
                    <div class="home-store-card__body">
                        <h3 class="home-store-card__name">Yeşil Bahçe</h3>
                        <p class="home-store-card__location">📍 Moda, İstanbul</p>
                    </div>
                </a>
                <a class="home-store-card" href="#">
                    <div class="home-store-card__img-wrap">
                        <div class="home-store-card__no-img">🥩</div>
                        <span class="home-store-card__badge">Yeni</span>
                    </div>
