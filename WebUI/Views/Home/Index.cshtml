        </div>
    </div>
</section>

<!-- CTA BANDI -->
<section class="cta" aria-labelledby="cta-heading">
    <div class="container cta__inner">
        <div>
            <h2 id="cta-heading" class="cta__title">Ready to Transform Your Restaurant?</h2>
            <p class="cta__subtitle">
                Join thousands of restaurants providing digital menus to their customers.
            </p>
        </div>
        <a href="#" class="btn btn--primary cta__button">Start Your Free Trial</a>
    </div>
</section>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          var toggle = document.querySelector('.hero-toggle');
          var buttons = document.querySelectorAll('.hero-toggle__button');

          var benefitsCustomers = document.querySelector('.hero-benefits--customers');
          var benefitsBusiness  = document.querySelector('.hero-benefits--business');

          var imgCustomers = document.getElementById('hero-main-image--customer');
          var imgBusiness  = document.getElementById('hero-main-image--business');

          function setMode(mode){
            // pill konumu
            if (toggle) toggle.style.setProperty('--toggle-x', mode === 'business' ? '100%' : '0%');

            buttons.forEach(function(b){
              var active = (b.dataset.mode === mode);
              b.classList.toggle('is-active', active);
              b.setAttribute('aria-selected', active ? 'true' : 'false');
            });

            // benefits
            if (benefitsCustomers && benefitsBusiness){
              benefitsCustomers.classList.toggle('is-active', mode === 'customers');
              benefitsCustomers.setAttribute('aria-hidden', mode === 'customers' ? 'false' : 'true');

              benefitsBusiness.classList.toggle('is-active', mode === 'business');
              benefitsBusiness.setAttribute('aria-hidden', mode === 'business' ? 'false' : 'true');
            }

            // images
            if (imgCustomers && imgBusiness){
              imgCustomers.classList.toggle('is-active', mode === 'customers');
              imgBusiness.classList.toggle('is-active', mode === 'business');
            }
          }

          setMode('customers');

          buttons.forEach(function(btn){
            btn.addEventListener('click', function(){
              setMode(btn.dataset.mode || 'customers');
            });
          });
        });
    </script>
}
