    <div class="container">
        <div class="section-heading">
            <h2 id="daily-heading" class="section__title"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-star")"></use></svg> Günün restoranları</h2>
