<section class="section" aria-labelledby="home-guides-heading">
    <div class="container">
        <div class="section-heading">
            <h2 id="home-guides-heading" class="section__title">Restoranlar için pratik rehberler</h2>
            <p class="section__subtitle">
                QR menüye geçmeden önce dijital menü, fiyatlandırma, fotoğraf ve müşteri deneyimi konularında
                karar vermenize yardımcı olacak kaynakları okuyabilirsiniz.
            </p>
        </div>

        <div class="features-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
            <article class="home-store-card" style="padding:22px;">
                <div class="home-store-card__body">
                    <h3 class="home-store-card__name">QR menüye başlangıç</h3>
                    <p class="home-store-card__location">QR menünün nasıl çalıştığını ve restoranlarda nasıl uygulanacağını adım adım öğrenin.</p>
                    <p class="home-store-card__location"><a href="/blog/qr-menu-nedir-nasil-calisir">QR menü nedir?</a> · <a href="/blog/qr-menu-kurulumu-adim-adim-restoran-rehberi">Kurulum rehberi</a></p>
                </div>
            </article>
            <article class="home-store-card" style="padding:22px;">
                <div class="home-store-card__body">
                    <h3 class="home-store-card__name">Menü kalitesi ve satış</h3>
                    <p class="home-store-card__location">Menü tasarımı, ürün fotoğrafı ve fiyatlandırma kararlarını daha bilinçli planlayın.</p>
                    <p class="home-store-card__location"><a href="/blog/restoran-menusu-nasil-tasarlanir">Menü tasarımı</a> · <a href="/blog/restoran-menu-fiyatlandirma-stratejileri">Fiyatlandırma</a></p>
                </div>
            </article>
            <article class="home-store-card" style="padding:22px;">
                <div class="home-store-card__body">
                    <h3 class="home-store-card__name">Büyüme ve pazarlama</h3>
                    <p class="home-store-card__location">Sosyal medya, online sipariş ve restoran teknolojileriyle dijital menünüzü daha verimli kullanın.</p>
                    <p class="home-store-card__location"><a href="/blog/restoranlar-icin-sosyal-medya-menu-tanitimi">Sosyal medya</a> · <a href="/blog/online-siparise-hazirlik-rehberi">Online sipariş</a></p>
                </div>
            </article>
            <article class="home-store-card" style="padding:22px;">
                <div class="home-store-card__body">
                    <h3 class="home-store-card__name">Ücretsiz karar araçları</h3>
                    <p class="home-store-card__location">QR menüye hazır olup olmadığınızı test edin ve kağıt menü baskı maliyetinizi hesaplayın.</p>
                    <p class="home-store-card__location"><a href="/qr-menu-uygunluk-testi">Uygunluk testi</a> · <a href="/menu-baski-maliyeti-hesaplayici">Maliyet hesaplayıcı</a></p>
                </div>
            </article>
        </div>
    </div>
</section>


<section class="section" aria-labelledby="guide-heading">
    <div class="container">
        <div class="section-heading">
            <h2 id="guide-heading" class="section__title">TümMenü ne işe yarar?</h2>
            <p class="section__subtitle">
                TümMenü iki ihtiyacı birleştirir: müşteriler gitmeden önce menü ve fiyatları görebilir,
                işletmeler ise QR menüsünü tek panelden güncel tutabilir.
            </p>
        </div>

        <div class="features-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
            <article class="home-store-card" style="padding:22px;">
                <div class="home-store-card__body">
                    <h3 class="home-store-card__name">Müşteriler için</h3>
                    <p class="home-store-card__location">Yakındaki restoranları keşfetmek, menüye önceden bakmak ve fiyatları karşılaştırmak daha kolay hale gelir. Karar süreci masaya oturmadan önce başlar.</p>
                </div>
            </article>
            <article class="home-store-card" style="padding:22px;">
                <div class="home-store-card__body">
                    <h3 class="home-store-card__name">İşletmeler için</h3>
                    <p class="home-store-card__location">Kağıt menü baskısı, eski fiyatlar ve stokta olmayan ürünlerin görünmesi gibi sorunlar azalır. Menü değişiklikleri yönetim panelinden güncellenir.</p>
                </div>
            </article>
            <article class="home-store-card" style="padding:22px;">
                <div class="home-store-card__body">
                    <h3 class="home-store-card__name">Google için anlaşılır yapı</h3>
                    <p class="home-store-card__location">Açıklayıcı sayfalar, yasal bilgiler, fiyatlandırma, SSS ve blog içerikleri sitenin yalnızca bir araç değil, restoran teknolojileri hakkında kaynak olduğunu gösterir.</p>
                </div>
            </article>
        </div>

        <p class="section__subtitle" style="margin-top:24px;">
            QR menüye geçişi araştırıyorsanız <a href="/ozellikler">özellikleri</a>,
            <a href="/fiyatlandirma">planları</a>, <a href="/sss">sık sorulan soruları</a> ve
            <a href="/blog">restoran teknolojileri blogunu</a> inceleyebilirsiniz. Karar vermeden önce
            <a href="/restoran-kaynaklari">restoran kaynaklarını</a> da gözden geçirebilirsiniz.
        </p>
    </div>
</section>


<!-- CTA -->
<section class="cta" aria-labelledby="cta-heading">
    <div class="container cta__inner">
        <div>
            <h2 id="cta-heading" class="cta__title">İşletmeni dijital menüye taşı</h2>
            <p class="cta__subtitle">
                QR menü ile menünü saniyeler içinde güncelle, daha fazla müşteriye ulaş.
            </p>
        </div>
        <a asp-controller="Home" asp-action="BeQr" class="btn btn--primary cta__button">Hemen Başla</a>
    </div>
</section>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://unpkg.com/maplibre-gl/dist/maplibre-gl.js"></script>
    <script src="https://unpkg.com/@@maplibre/maplibre-gl-leaflet/leaflet-maplibre-gl.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/map-base-layer.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          // Hero toggle
          var buttons = document.querySelectorAll('.hero-toggle__button');
          var benefitsCustomers = document.querySelector('.hero-benefits--customers');
          var benefitsBusiness  = document.querySelector('.hero-benefits--business');
          var imgCustomers = document.getElementById('hero-main-image--customer');
          var imgBusiness  = document.getElementById('hero-main-image--business');

          function setMode(mode){
            buttons.forEach(function(b){
              var active = (b.dataset.mode === mode);
              b.classList.toggle('is-active', active);
              b.setAttribute('aria-pressed', active ? 'true' : 'false');
            });

            if (benefitsCustomers && benefitsBusiness){
              benefitsCustomers.classList.toggle('is-active', mode === 'customers');
              benefitsBusiness.classList.toggle('is-active', mode === 'business');

              benefitsCustomers.setAttribute('aria-hidden', mode === 'customers' ? 'false' : 'true');
              benefitsBusiness.setAttribute('aria-hidden', mode === 'business' ? 'false' : 'true');
            }

            if (imgCustomers && imgBusiness){
              imgCustomers.classList.toggle('is-active', mode === 'customers');
              imgBusiness.classList.toggle('is-active', mode === 'business');
            }
          }

          setMode('customers');

          buttons.forEach(function(btn){
            btn.addEventListener('click', function(){
              setMode(btn.dataset.mode || 'customers');
            });
          });

          // Search form → redirect to Restaurants page
          var homeSearchForm = document.getElementById('homeSearchForm');
          var homeSearchInput = document.getElementById('homeSearchInput');

          homeSearchForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var term = homeSearchInput.value.trim();
            var params = new URLSearchParams();
            if (term) params.set('search', term);

            // Pass selected categories to restaurants page
            var selectedCats = $('#homeCategoryInput').val() || [];
            if (selectedCats.length > 0) {
                params.set('categories', selectedCats.join(','));
            }

            var url = '/restoranlar';
            var qs = params.toString();
            if (qs) url += '?' + qs;
            window.location.href = url;
          });

          // Chips → redirect to Restaurants with search
          var chips = document.querySelectorAll('.chip-row .chip');
          chips.forEach(function(chip) {
            chip.addEventListener('click', function() {
              var text = chip.textContent.trim();
              window.location.href = '/restoranlar?search=' + encodeURIComponent(text);
            });
          });

          // Carousel Arrows Logic
          var wrappers = document.querySelectorAll('.home-store-grid-wrapper');
          wrappers.forEach(function(wrapper) {
            var grid = wrapper.querySelector('.home-store-grid');
            var leftBtn = wrapper.querySelector('.scroll-arrow--left');
            var rightBtn = wrapper.querySelector('.scroll-arrow--right');

            if (!grid || !leftBtn || !rightBtn) return;

            // Scroll amount (approx card width + gap)
            var scrollAmount = 240; 

            leftBtn.addEventListener('click', function() {
              grid.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            });

            rightBtn.addEventListener('click', function() {
              grid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            });
          });
          // --- Homepage Map Integration ---
          let homeMap = null;
          let homeUserMarker = null;
          let homeStoreLayerGroup = null;
          const homePermissionWarningEl = document.getElementById('homeMapPermissionWarning');
          const homePermissionWarningDismissBtn = document.getElementById('homeMapPermissionWarningDismiss');

          function showHomePermissionWarning() {
            if (homePermissionWarningEl) {
              homePermissionWarningEl.classList.add('is-visible');
              homePermissionWarningEl.hidden = false;
            }
          }

          function hideHomePermissionWarning() {
            if (homePermissionWarningEl) {
              homePermissionWarningEl.classList.remove('is-visible');
              homePermissionWarningEl.hidden = true;
            }
          }

          if (homePermissionWarningDismissBtn) {
            homePermissionWarningDismissBtn.addEventListener('click', function () {
              hideHomePermissionWarning();
            });
          }

          function initHomeCategorySelect2() {
            if ($('#homeCategoryInput').length) {
                $('#homeCategoryInput').select2({
                    theme: 'bootstrap-5',
                    placeholder: 'Kategori Seçin...',
                    allowClear: true,
                    language: {
                        noResults: function () { return 'Sonuç bulunamadı'; }
                    }
                }).off('change').on('change', function() {
                    renderHomeSelectedCategories();
                    if (homeUserMarker) {
                        const pos = homeUserMarker.getLatLng();
                        fetchNearbyStores(pos.lat, pos.lng);
                    }
                });

                renderHomeSelectedCategories();
            }
          }

          function renderHomeSelectedCategories() {
            const $select = $('#homeCategoryInput');
            const $container = $('#homeSelectedCategories');
            if (!$container.length) return;

            $container.empty();
            const selectedData = $select.select2('data');

            selectedData.forEach(item => {
                const $chip = $(`
                    <div class="rest-selected-item" data-id="${item.id}">
                        <span>${item.text}</span>
                        <button type="button" class="rest-selected-item__remove" aria-label="Kaldır">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                <path d="M18 6 6 18M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>
                `);

                $chip.find('.rest-selected-item__remove').on('click', function() {
                    const id = $(this).parent().data('id');
                    const currentVals = $select.val() || [];
                    const newVals = currentVals.filter(v => v !== String(id));
                    $select.val(newVals).trigger('change');
                });

                $container.append($chip);
            });
          }

          function initHomeMap(lat, lng, zoom = 10, addMarker = true) {
            const mapContainer = document.getElementById('homeRestMap');
            if (!mapContainer) return;

            if (!homeMap) {
                homeMap = L.map('homeRestMap', { attributionControl: false }).setView([lat, lng], zoom);
                window.TumMenuMapBaseLayer.addTo(homeMap);
                homeStoreLayerGroup = L.layerGroup().addTo(homeMap);

                if (addMarker) {
                    homeUserMarker = L.marker([lat, lng], { draggable: true }).addTo(homeMap);
                    homeUserMarker.on('dragend', function() {
                        const pos = homeUserMarker.getLatLng();
                        hideHomePermissionWarning();
                        fetchNearbyStores(pos.lat, pos.lng);
                    });
                }

                homeMap.on('click', function(e) {
                    const pos = e.latlng;
                    if (!homeUserMarker) {
                        homeUserMarker = L.marker([pos.lat, pos.lng], { draggable: true }).addTo(homeMap);
                        homeUserMarker.on('dragend', function() {
                            const pos = homeUserMarker.getLatLng();
                            hideHomePermissionWarning();
                            fetchNearbyStores(pos.lat, pos.lng);
                        });
                    } else {
                        homeUserMarker.setLatLng(pos);
                    }
                    hideHomePermissionWarning();
                    fetchNearbyStores(pos.lat, pos.lng);
                });
            } else {
                homeMap.setView([lat, lng], zoom);
                if (addMarker) {
                    if (!homeUserMarker) {
                        homeUserMarker = L.marker([lat, lng], { draggable: true }).addTo(homeMap);
                        homeUserMarker.on('dragend', function() {
                           const pos = homeUserMarker.getLatLng();
                           hideHomePermissionWarning();
                           fetchNearbyStores(pos.lat, pos.lng);
                        });
                    } else {
                        homeUserMarker.setLatLng([lat, lng]);
                    }
                }
            }

            // Fix map rendering issues after initialization/navigation
            setTimeout(() => {
                if (homeMap) homeMap.invalidateSize();
            }, 300);
          }

          function fetchNearbyStores(lat, lng) {
            const categories = $('#homeCategoryInput').val() || [];
            // Cache breaker ekleyerek her seferinde fresh sonuç al
            const timestamp = new Date().getTime();
            let url = `/api/stores/search?UserLatitude=${lat}&UserLongitude=${lng}&MaxDistanceKm=5&Page=0&PageSize=20&_t=${timestamp}`;
            if (categories.length > 0) {
                url += `&CategoryLibraryItemIds=${categories.join(',')}`;
            }

            console.log('Fetching nearby stores:', url); // Debug log

            fetch(url)
              .then(res => res.json())
              .then(data => {
                console.log('Stores received:', data); // Debug log
                updateHomeMapMarkers(data.items);
              })
              .catch(err => console.error('Error fetching stores for homepage map:', err));
          }

          function updateHomeMapMarkers(stores) {
            if (!homeStoreLayerGroup) return;
            homeStoreLayerGroup.clearLayers();

            const customIcon = L.icon({
                iconUrl: '/images/pin-exact.png',
                iconSize: [24, 38],
                iconAnchor: [12, 38]
            });

            stores.forEach(store => {
                if (store.latitude && store.longitude) {
                    const marker = L.marker([store.latitude, store.longitude], { icon: customIcon })
                        .addTo(homeStoreLayerGroup);

                    marker.bindTooltip(store.title, {
                        permanent: false,
                        direction: 'top',
                        offset: [0, -38]
                    });

                    marker.on('click', function() {
                        window.location.href = '/' + store.companySlug + '/' + store.slug;
                    });
                }
            });
          }

          function requestHomeUserLocation() {
            if (!window.locationService) {
                console.warn('Location service not available');
                initHomeMap(41.0082, 28.9784, 12);
                fetchNearbyStores(41.0082, 28.9784);
                return;
            }

            const btn = document.getElementById('homeUseMyLocation');
            const originalContent = btn ? btn.innerHTML : '';

            if (btn) {
                btn.innerHTML = '<span class="rest-spinner" style="width:14px;height:14px;border-width:2px;margin-right:5px;display:inline-block; border-top-color: var(--color-primary);"></span><span>Bulunuyor...</span>';
            }

            window.locationService.getLocation({
                showLoading: false, // Custom loading
                buttonId: 'homeUseMyLocation',
                forceFresh: true,
                enableHighAccuracy: true,
                showErrorPopup: false, // Handle errors manually
                onSuccess: function (position) {
                    if (btn) btn.innerHTML = originalContent;
                    hideHomePermissionWarning();
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;
                    initHomeMap(lat, lng, 13);
                    fetchNearbyStores(lat, lng);
                },
                onError: function (error, message) {
                    console.warn('Geolocation error:', { code: error.code, message: error.message });
                    if (btn) btn.innerHTML = originalContent;
                    if (error && error.code === 1) {
                        showHomePermissionWarning();
                    }
                    
                    // Fallback to default location
                    initHomeMap(41.0082, 28.9784, 12);
                    fetchNearbyStores(41.0082, 28.9784);
                }
            }).catch(function(error) {
                console.warn('Location request failed:', error);
                if (btn) btn.innerHTML = originalContent;
                if (error && error.code === 1) {
                    showHomePermissionWarning();
                }
                initHomeMap(41.0082, 28.9784, 12);
                fetchNearbyStores(41.0082, 28.9784);
            });
          }

          function setupHomepage() {
            initHomeCategorySelect2();

            // Sayfa açılışında izin isteme: varsa cache konumu kullan, yoksa default konuma düş.
            const cachedPosition = window.locationService?.getCachedPosition?.();
            if (cachedPosition?.coords?.latitude && cachedPosition?.coords?.longitude) {
                const lat = cachedPosition.coords.latitude;
                const lng = cachedPosition.coords.longitude;
                initHomeMap(lat, lng, 13);
                fetchNearbyStores(lat, lng);
            } else {
                const defaultLat = 41.0082;
                const defaultLng = 28.9784;
                initHomeMap(defaultLat, defaultLng, 12);
                fetchNearbyStores(defaultLat, defaultLng);
            }
          }

          // Initial setup
          setupHomepage();

          // Handle back-forward cache and navigation issues
          window.addEventListener('pageshow', function(event) {
              if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
                  if (homeMap) {
                      homeMap.invalidateSize();
                  } else {
                      setupHomepage();
                  }
              }
          });

          document.getElementById('homeUseMyLocation').addEventListener('click', function() {
              requestHomeUserLocation();
          });
        });
    </script>
}
