                }
            </div>

            <button class="scroll-arrow scroll-arrow--right" aria-label="Sağa kaydır" type="button"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-chevron-right")"></use></svg></button>
        </div>
