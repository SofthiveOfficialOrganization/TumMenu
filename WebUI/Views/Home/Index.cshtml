                                {
                                    <p class="home-store-card__location"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-location")"></use></svg> @(store.District ?? "") @(store.City ?? "")</p>
                                }
