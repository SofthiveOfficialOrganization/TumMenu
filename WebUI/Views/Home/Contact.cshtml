@using Application.SystemSettings.DTOs
@model WebUI.Models.ContactViewModel
@{
    ViewData["Title"] = "İletişim";
    ViewData["Description"] = "Tüm Menü ile iletişime geçin. Sorularınız, önerileriniz veya destek talepleriniz için bize ulaşın.";
    var legalVersions = ViewBag.LegalVersions as LegalVersionSettingsDTO ?? new LegalVersionSettingsDTO();
}

@section Head {
    <link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />
}

<!-- HERO -->
<section class="contact-hero" aria-labelledby="contact-heading" style='background-image: url("@ImageUrlBuilder.Build("~/images/contact-us-background.png")");'>
    <div class="container contact-hero__inner">
        <p class="contact-hero__eyebrow">Bize Ulaşın</p>
        <h1 id="contact-heading" class="contact-hero__title">Size nasıl yardımcı olabiliriz?</h1>
        <p class="contact-hero__lead">
            Sorularınız, önerileriniz veya destek talepleriniz için formu doldurun — size en kısa sürede dönüş yapalım.
        </p>
    </div>
</section>

<!-- CONTACT CONTENT -->
<section class="section contact-content">
    <div class="container contact-content__grid">

        <!-- FORM CARD -->
        <div class="contact-card">
            <h2 class="contact-card__title"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-message")"></use></svg> Mesaj Gönderin</h2>

            <form asp-action="Contact" asp-controller="Home" method="post" class="contact-form" id="contactForm">
                <div asp-validation-summary="ModelOnly" class="contact-form__errors"></div>

                <div class="contact-form__group">
                    <label asp-for="Name" class="contact-form__label"></label>
                    <input asp-for="Name" class="contact-form__input" placeholder="Adınızı girin" />
                    <span asp-validation-for="Name" class="contact-form__validation"></span>
                </div>

                <div class="contact-form__group">
                    <label asp-for="Email" class="contact-form__label"></label>
                    <input asp-for="Email" type="email" class="contact-form__input" placeholder="ornek@email.com" />
                    <span asp-validation-for="Email" class="contact-form__validation"></span>
                </div>

                <div class="contact-form__group">
                    <label asp-for="Subject" class="contact-form__label"></label>
                    <input asp-for="Subject" class="contact-form__input" placeholder="Mesajınızın konusu" />
                    <span asp-validation-for="Subject" class="contact-form__validation"></span>
                </div>

                <div class="contact-form__group">
                    <label asp-for="Message" class="contact-form__label"></label>
                    <textarea asp-for="Message" class="contact-form__input contact-form__textarea" 
                              rows="5" placeholder="Mesajınızı buraya yazın..."></textarea>
                    <span asp-validation-for="Message" class="contact-form__validation"></span>
                </div>

                <div class="contact-form__group">
                    <div class="form-check">
                        <input asp-for="AcceptContactNotice" class="form-check-input" type="checkbox" id="acceptContactNotice" />
                        <label class="form-check-label" for="acceptContactNotice">
                            <a href="/yasal-bilgiler#privacy" target="_blank" rel="noopener">Gizlilik Politikası</a>
                            (Sürüm: @legalVersions.PrivacyVersion) ve
                            <a href="/yasal-bilgiler#kvkk" target="_blank" rel="noopener">KVKK Aydınlatma Metni</a>
                            (Sürüm: @legalVersions.KvkkVersion) kapsamında verilerimin işlenmesine ilişkin bilgilendirildiğimi kabul ediyorum.
                        </label>
                    </div>
                    <span asp-validation-for="AcceptContactNotice" class="contact-form__validation"></span>
                </div>

                <button type="submit" class="btn btn--primary contact-form__submit" id="contactSubmitBtn">
                    <span class="contact-form__submit-text">Gönder</span>
                    <span class="contact-form__submit-icon">→</span>
                </button>
            </form>
        </div>

        <!-- INFO PANEL -->
        <div class="contact-info">
            <div class="contact-info__card">
                <div class="contact-info__icon"><svg class="tm-icon tm-icon--xl" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-mail")"></use></svg></div>
                <h3 class="contact-info__title">E-posta</h3>
                <a href="mailto:destek@tummenu.com.tr" class="contact-info__link">destek@tummenu.com.tr</a>
            </div>

            <div class="contact-info__card">
                <div class="contact-info__icon"><svg class="tm-icon tm-icon--xl" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-refresh")"></use></svg></div>
                <h3 class="contact-info__title">Çalışma Saatleri</h3>
                <p class="contact-info__text">Pazartesi – Cuma</p>
                <p class="contact-info__text contact-info__text--highlight">09:00 – 18:00</p>
            </div>

            <div class="contact-info__card">
                <div class="contact-info__icon"><svg class="tm-icon tm-icon--xl" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-location")"></use></svg></div>
                <h3 class="contact-info__title">Adres</h3>
                <p class="contact-info__text">Manisa/Turgutlu, Türkiye</p>
            </div>

            <div class="contact-info__card">
                <div class="contact-info__icon"><svg class="tm-icon tm-icon--xl" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-globe")"></use></svg></div>
                <h3 class="contact-info__title">Sosyal Medya</h3>
                <div class="contact-info__socials">
                    <a href="https://www.instagram.com/softhive_" class="contact-info__social-link" aria-label="Instagram">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                        </svg>
                    </a>
                    <a href="https://x.com/Softhive_" class="contact-info__social-link" aria-label="X (Twitter)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
