@{
    ViewData["Title"] = "Kafeler İçin Dijital Menü Rehberi";
    ViewData["Description"] = "Kafe, kahve dükkanı ve pastaneler için dijital menü kategori düzeni, dönemsel ürünler, fotoğraf ve QR yerleşimi rehberi.";
}

@section Head {
    <link rel="stylesheet" href="~/css/resources.css" asp-append-version="true" />
}

<div class="resource-page">
    <section class="resource-hero" aria-labelledby="cafe-guide-heading">
        <div class="container resource-hero__inner">
            <p class="resource-eyebrow">Kafe işletmeleri için rehber</p>
            <h1 id="cafe-guide-heading" class="resource-title">Kafe menüsü hızlı değişir; dijital menü bu yüzden değerlidir.</h1>
            <p class="resource-lead">
                Kafelerde kahve çeşitleri, tatlılar, kahvaltı tabakları ve sezonluk ürünler sık güncellenir. Dijital menü,
                bu değişiklikleri müşteriye daha düzenli ve güncel göstermek için pratik bir yapı sunar.
            </p>
        </div>
    </section>

    <section class="resource-section resource-band">
        <div class="container">
            <div class="resource-grid">
                <article class="resource-card">
                    <h2>Kategori planı</h2>
                    <p>Kahveler, soğuk içecekler, kahvaltı, tatlılar ve paket ürünler gibi ana başlıklar müşterinin hızlı karar vermesini sağlar. Çok uzun kategori adlarından kaçının.</p>
                </article>
                <article class="resource-card">
                    <h2>Sezonluk ürünler</h2>
                    <p>Yazlık soğuk içecekler, kışlık sıcak içecekler veya dönemsel tatlılar için ayrı kategori açmak menüyü güncel ve canlı gösterir.</p>
                </article>
                <article class="resource-card">
                    <h2>İçerik bilgisi</h2>
                    <p>Süt alternatifi, kafein bilgisi, alerjenler ve porsiyon açıklamaları özellikle kafe menülerinde müşterinin soru sorma ihtiyacını azaltır.</p>
                </article>
                <article class="resource-card">
                    <h2>QR kod yerleşimi</h2>
                    <p>QR kodu masaya, kasa önüne ve vitrine koyabilirsiniz. Paket servis alanında menü linki, kararsız müşterinin sırada beklerken karar vermesine yardımcı olur.</p>
                </article>
                <article class="resource-card">
                    <h2>Fotoğraf önceliği</h2>
                    <p>Her kahveyi çekmek yerine imza içecekler, yeni tatlılar ve kahvaltı tabaklarıyla başlayın. Görsel seçimi menünün en çok merak edilen ürünlerinden başlamalı.</p>
                </article>
                <article class="resource-card">
                    <h2>İlgili kaynaklar</h2>
                    <ul>
                        <li><a href="/blog/kucuk-kafeler-icin-qr-menu-avantajlari">Küçük kafeler için QR menü avantajları</a></li>
                        <li><a href="/restoran-menu-fotografi-rehberi">Menü fotoğrafı rehberi</a></li>
                        <li><a href="/menu-baski-maliyeti-hesaplayici">Baskı maliyeti hesaplayıcı</a></li>
                    </ul>
                </article>
            </div>
        </div>
    </section>
</div>
