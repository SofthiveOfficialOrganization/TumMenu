@{
    ViewData["Title"] = "Ne Yesem?";
    ViewData["Description"] = "Bugün ne yesem diye düşünmeyi bırak! 3 dokunuşta sana en uygun yemeği buluyoruz. Çarkı çevir, chip'leri seç, kararını ver.";
}

@section Head {
    <link rel="stylesheet" href="~/css/WhatToEat.css" asp-append-version="true" />
}

<div class="wte-page">

    <!-- ARKA PLAN BLOB'LARI -->
    <div class="wte-blobs" aria-hidden="true">
        <div class="wte-blob wte-blob--1"></div>
        <div class="wte-blob wte-blob--2"></div>
        <div class="wte-blob wte-blob--3"></div>
    </div>

    <!-- ═══════════════════════════════════
         1) HERO SECTION
         ═══════════════════════════════════ -->
    <section class="wte-section wte-hero" aria-labelledby="wte-hero-heading">
        <div class="container wte-hero__inner">
            <span class="wte-hero__emoji" aria-hidden="true">🍽️</span>
            <h1 id="wte-hero-heading" class="wte-hero__title">Bugün ne yesem?</h1>
            <p class="wte-hero__subtitle">3 dokunuşta karar veriyoruz. ✨</p>
            <div class="wte-hero__ctas">
                <button class="wte-btn wte-btn--primary" id="wte-quick-suggest" onclick="document.getElementById('wte-wheel-area').scrollIntoView({behavior:'smooth'})">
                    ⚡ Hızlı öner
                </button>
                <button class="wte-btn wte-btn--secondary" id="wte-custom-flow" onclick="document.getElementById('wte-chips-area').scrollIntoView({behavior:'smooth'})">
                    🎯 Kendime göre seç
                </button>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════
         2) CHIP BARI
         ═══════════════════════════════════ -->
    <section class="wte-section wte-chips" id="wte-chips-area" aria-labelledby="wte-chips-heading">
        <div class="container">
            <p class="wte-chips__title" id="wte-chips-heading">🎨 Bugün ne moddasın?</p>
            <div class="wte-chips__wrap" id="wte-chips-wrap">
                <button class="wte-chip" data-tag="hafif">🥗 Hafif</button>
                <button class="wte-chip" data-tag="aci">🌶️ Acı</button>
                <button class="wte-chip" data-tag="tatli">🍰 Tatlı</button>
                <button class="wte-chip" data-tag="vegan">🌱 Vegan</button>
                <button class="wte-chip" data-tag="hizli">⏱️ 10 dk</button>
                <button class="wte-chip" data-tag="ekonomik">💰 Ekonomik</button>
                <button class="wte-chip" data-tag="protein">💪 Protein</button>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════
         3) ÇARK / İNTERAKSİYON ALANI
         ═══════════════════════════════════ -->
    <section class="wte-section wte-wheel-section" id="wte-wheel-area" aria-labelledby="wte-wheel-heading">
        <div class="container">
            <div class="wte-wheel__inner">
                <p class="wte-fun-text" id="wte-fun-text">Sürprize açık mısın? 🎲</p>

                <div class="wte-wheel-container">
                    <div class="wte-wheel__pointer"></div>
                    <div class="wte-wheel" id="wte-wheel">
                        <div class="wte-wheel__face">
                            <span class="wte-wheel__label">🍕 Pizza</span>
                            <span class="wte-wheel__label">🥗 Salata</span>
                            <span class="wte-wheel__label">🍔 Burger</span>
                            <span class="wte-wheel__label">🍜 Çorba</span>
                            <span class="wte-wheel__label">🌯 Dürüm</span>
                            <span class="wte-wheel__label">🍣 Sushi</span>
                            <span class="wte-wheel__label">🥘 Güveç</span>
                            <span class="wte-wheel__label">🍝 Makarna</span>
                        </div>
                        <div class="wte-wheel__center">🎰</div>
                    </div>
                </div>

                <button class="wte-spin-btn" id="wte-spin-btn">
                    🎡 Çarkı Çevir!
                </button>

                <p class="wte-shake-hint">📱 Telefonunu salla → yeni öneri!</p>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════
         4) SONUÇ KARTLARI
         ═══════════════════════════════════ -->
    <section class="wte-section wte-results is-hidden" id="wte-results" aria-labelledby="wte-results-heading">
        <div class="container wte-results__inner">
            <div class="wte-results__header">
                <h2 id="wte-results-heading" class="wte-results__title">İşte sana öneriler! 🎉</h2>
                <p class="wte-results__fun" id="wte-results-fun">Tam senlik bir şey buldum 😌</p>
            </div>

            <div class="wte-results__grid" id="wte-results-grid">
                <!-- JS ile doldurulacak -->
            </div>

            <div style="text-align:center; margin-top:28px;">
                <button class="wte-btn wte-btn--purple" id="wte-refresh-btn">
                    🔄 Tekrar Dene
                </button>
            </div>
        </div>
    </section>

    <!-- Konfeti canvas -->
    <canvas class="wte-confetti-canvas" id="wte-confetti-canvas"></canvas>

    <!-- ═══════════════════════════════════
         5) ALT BÖLÜM: "Kararsızlara Özel"
         ═══════════════════════════════════ -->
    <section class="wte-section wte-extras" aria-labelledby="wte-extras-heading">
        <div class="container">
            <h2 id="wte-extras-heading" class="wte-extras__title">Kararsızlara Özel 🤔</h2>
            <p class="wte-extras__subtitle">Hâlâ karar veremeyen varsa…</p>

            <div class="wte-extras__grid">

                <!-- Bugün Trend -->
                <div class="wte-extra-card">
                    <div class="wte-extra-card__header">
                        <span class="wte-extra-card__icon">🔥</span>
                        <h3 class="wte-extra-card__title">Bugün Trend</h3>
                    </div>
                    <ul class="wte-trend-list">
                        <li class="wte-trend-item">
                            <span class="wte-trend-item__rank">1</span>
                            <span class="wte-trend-item__emoji">🍕</span>
                            <span>Margarita Pizza</span>
                        </li>
                        <li class="wte-trend-item">
                            <span class="wte-trend-item__rank">2</span>
                            <span class="wte-trend-item__emoji">🥙</span>
                            <span>Tavuk Dürüm</span>
                        </li>
                        <li class="wte-trend-item">
                            <span class="wte-trend-item__rank">3</span>
                            <span class="wte-trend-item__emoji">🍔</span>
                            <span>Cheese Burger</span>
                        </li>
                        <li class="wte-trend-item">
                            <span class="wte-trend-item__rank">4</span>
                            <span class="wte-trend-item__emoji">🍜</span>
                            <span>Mercimek Çorba</span>
                        </li>
                    </ul>
                </div>

                <!-- Mevsim Önerisi -->
                <div class="wte-extra-card">
                    <div class="wte-extra-card__header">
                        <span class="wte-extra-card__icon">🌿</span>
                        <h3 class="wte-extra-card__title">Mevsim Önerisi</h3>
                    </div>
                    <div class="wte-season-card" id="wte-season-card">
                        <div class="wte-season-item wte-season-item--winter">
                            <span class="wte-season-item__emoji">❄️</span>
                            <span>Kış → Sıcak çorba & güveç</span>
                        </div>
                        <div class="wte-season-item wte-season-item--spring">
                            <span class="wte-season-item__emoji">🌸</span>
                            <span>İlkbahar → Taze salata & wrap</span>
                        </div>
                        <div class="wte-season-item wte-season-item--summer">
                            <span class="wte-season-item__emoji">☀️</span>
                            <span>Yaz → Hafif salata & smoothie</span>
                        </div>
                        <div class="wte-season-item wte-season-item--autumn">
                            <span class="wte-season-item__emoji">🍂</span>
                            <span>Sonbahar → Fırın yemekleri</span>
                        </div>
                    </div>
                </div>

                <!-- Bütçene Göre -->
                <div class="wte-extra-card">
                    <div class="wte-extra-card__header">
                        <span class="wte-extra-card__icon">💸</span>
                        <h3 class="wte-extra-card__title">Bütçene Göre</h3>
                    </div>
                    <div class="wte-budget__display">
                        <span class="wte-budget__amount" id="wte-budget-amount">₺100</span>
                        <span class="wte-budget__label">kişi başı bütçe</span>
                    </div>
                    <input
                        type="range"
                        class="wte-budget__slider"
                        id="wte-budget-slider"
                        min="30"
                        max="500"
                        value="100"
                        step="10"
                    />
                    <div class="wte-budget__range-labels">
                        <span>₺30</span>
                        <span>₺500</span>
                    </div>
                    <div class="wte-budget__suggestions" id="wte-budget-suggestions">
                        <!-- JS ile doldurulacak -->
                    </div>
                </div>

            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/whattoeat.js" asp-append-version="true"></script>
}
