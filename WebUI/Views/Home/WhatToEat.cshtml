@{
    ViewData["Title"] = "Ne Yesem?";
    ViewData["Description"] = "Bugün ne yiyeceğine daha hızlı karar ver. Tercihlerini seç, önerileri gör, bütçene uygun seçenekleri karşılaştır.";
    ViewData["BodyClass"] = "wte-shell";
}

@section Head {
    <link rel="stylesheet" href="~/css/WhatToEatRedesign.css" asp-append-version="true" />
}

<div class="wte-page">
    <section class="wte-hero" aria-labelledby="wte-hero-heading">
        <div class="container">
            <div class="wte-hero__grid">
                <div class="wte-hero__copy">
                    <h1 id="wte-hero-heading" class="wte-hero__title">
                        <span>Bugün ne yesem</span>
                        sorusunu hızlı çözelim.
                    </h1>
                    <p class="wte-hero__subtitle">
                        Yakınındaki restoranlardan menüleri incele, bütçene ve moduna uyan seçimi
                        bul, kararsız kaldığında da sistemi devreye sok.
                    </p>

                    <div class="wte-hero__actions">
                        <button class="wte-btn wte-btn--primary" id="wte-quick-suggest" type="button">
                            Hemen öner
                        </button>
                        <button class="wte-btn wte-btn--secondary" id="wte-custom-flow" type="button">
                            Tercihlerimi seç
                        </button>
                    </div>
                </div>

                <div class="wte-hero__visual" aria-hidden="true">
                    <div class="wte-hero__orb"></div>

                    <div class="wte-map-card">
                        <div class="wte-map-card__surface">
                            <span class="wte-map-card__road wte-map-card__road--one"></span>
                            <span class="wte-map-card__road wte-map-card__road--two"></span>
                            <span class="wte-map-card__road wte-map-card__road--three"></span>
                            <span class="wte-map-card__road wte-map-card__road--four"></span>
                            <span class="wte-map-card__park wte-map-card__park--one"></span>
                            <span class="wte-map-card__park wte-map-card__park--two"></span>
                            <span class="wte-map-card__water"></span>

                            <span class="wte-map-card__pin wte-map-card__pin--one">
                                <img src="~/images/pin-exact.png" alt="" />
                            </span>
                            <span class="wte-map-card__pin wte-map-card__pin--two">
                                <img src="~/images/pin-exact.png" alt="" />
                            </span>
                            <span class="wte-map-card__pin wte-map-card__pin--three">
                                <img src="~/images/pin-exact.png" alt="" />
                            </span>
                        </div>
                    </div>

                    <div class="wte-phone-card">
                        <span class="wte-phone-card__notch"></span>
                        <div class="wte-phone-card__screen">
                            <div class="wte-phone-card__header">
                                <strong>Restoranlar</strong>
                            </div>
                            <div class="wte-phone-card__item">
                                <span class="wte-phone-card__emoji"></span>
                                <div>
                                    <strong>Peynirli Burger</strong>
                                    <span>15 dk</span>
                                </div>
                            </div>
                            <div class="wte-phone-card__item">
                                <span class="wte-phone-card__emoji"></span>
                                <div>
                                    <strong>Margarita Pizza</strong>
                                    <span>21 dk</span>
                                </div>
                            </div>
                            <div class="wte-phone-card__item">
                                <span class="wte-phone-card__emoji"></span>
                                <div>
                                    <strong>Tavuk Dürüm</strong>
                                    <span>11 dk</span>
                                </div>
                            </div>
                            <div class="wte-phone-card__item">
                                <span class="wte-phone-card__emoji"></span>
                                <div>
                                    <strong>Sezar Salata</strong>
                                    <span>17 dk</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="wte-section wte-preferences" id="wte-chips-area" aria-labelledby="wte-chips-heading">
        <div class="container">
            <div class="wte-preferences__inner">
                <div class="wte-section-heading">
                    <p class="wte-section-heading__eyebrow">Tercihler</p>
                    <h2 id="wte-chips-heading" class="wte-section-heading__title">Bugün nasıl bir seçim istiyorsun?</h2>
                </div>

                <div class="wte-chips__wrap" id="wte-chips-wrap">
                    <button class="wte-chip" data-tag="hafif" type="button"><span class="wte-chip__emoji"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-leaf")"></use></svg></span> Hafif</button>
                    <button class="wte-chip" data-tag="aci" type="button"><span class="wte-chip__emoji"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-warning")"></use></svg></span> Acılı</button>
                    <button class="wte-chip" data-tag="tatli" type="button"><span class="wte-chip__emoji"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-star")"></use></svg></span> Tatlı</button>
                    <button class="wte-chip" data-tag="vegan" type="button"><span class="wte-chip__emoji"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-leaf")"></use></svg></span> Vegan</button>
                    <button class="wte-chip" data-tag="hizli" type="button"><span class="wte-chip__emoji"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-bolt")"></use></svg></span> Hızlı</button>
                    <button class="wte-chip" data-tag="ekonomik" type="button"><span class="wte-chip__emoji"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-money")"></use></svg></span> Ekonomik</button>
                    <button class="wte-chip" data-tag="protein" type="button"><span class="wte-chip__emoji"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-burger")"></use></svg></span> Protein ağırlıklı</button>
                </div>
            </div>
        </div>
    </section>

    <section class="wte-section wte-decision" id="wte-wheel-area" aria-labelledby="wte-wheel-heading">
        <div class="container">
            <div class="wte-decision__intro">
                <p class="wte-section-heading__eyebrow">Kararsız kaldığında</p>
                <h2 id="wte-wheel-heading" class="wte-decision__title">Seçimini sistem yapsın.</h2>
                <p class="wte-decision__subtitle">Filtrelerini kullan, çarkı çevir, sonra çıkana göre restoranlara geç.</p>
                <div class="wte-stage__status">
                    <span class="wte-stage__status-label">Canlı seçim modu</span>
                    <strong id="wte-fun-text">Standart öneriler hazır.</strong>
                </div>
            </div>

            <div class="wte-wheel-container">
                <div class="wte-wheel__pointer" aria-hidden="true"></div>
                <div class="wte-wheel" id="wte-wheel" aria-label="Yemek seçim çarkı">
                    <div class="wte-wheel__face">
                        <span class="wte-wheel__label" aria-label="Pizza"><img class="wte-wheel__icon" src="~/images/wte/pizza.svg" alt="" /></span>
                        <span class="wte-wheel__label" aria-label="Dürüm"><img class="wte-wheel__icon" src="~/images/wte/durum.svg" alt="" /></span>
                        <span class="wte-wheel__label" aria-label="Burger"><img class="wte-wheel__icon" src="~/images/wte/burger.svg" alt="" /></span>
                        <span class="wte-wheel__label" aria-label="Çorba"><img class="wte-wheel__icon" src="~/images/wte/corba.svg" alt="" /></span>
                        <span class="wte-wheel__label" aria-label="Salata"><img class="wte-wheel__icon" src="~/images/wte/salata.svg" alt="" /></span>
                        <span class="wte-wheel__label" aria-label="Suşi"><img class="wte-wheel__icon" src="~/images/wte/sushi.svg" alt="" /></span>
                        <span class="wte-wheel__label" aria-label="Güveç"><img class="wte-wheel__icon" src="~/images/wte/guvec.svg" alt="" /></span>
                        <span class="wte-wheel__label" aria-label="Makarna"><img class="wte-wheel__icon" src="~/images/wte/makarna.svg" alt="" /></span>
                    </div>
                    <div class="wte-wheel__center"><svg class="tm-icon tm-icon--xl" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-menu")"></use></svg></div>
                </div>
            </div>

            <div class="wte-decision__actions">
                <button class="wte-spin-btn" id="wte-spin-btn" type="button">Seçimi yap</button>
                <div class="wte-stage__footer">
                    <span>1. Tercihlerini seç</span>
                    <span>2. Çarkı çevir</span>
                    <span>3. Üç seçimi karşılaştır</span>
                </div>
            </div>
        </div>
    </section>

    <section class="wte-section wte-results is-hidden" id="wte-results" aria-labelledby="wte-results-heading">
        <div class="container">
            <div class="wte-results__header">
                <div>
                    <p class="wte-section-heading__eyebrow">Öneriler</p>
                    <h2 id="wte-results-heading" class="wte-results__title">Bugün için seçilmiş alternatifler</h2>
                </div>
                <p class="wte-results__fun" id="wte-results-fun">Seçim listesi hazır.</p>
            </div>

            <div class="wte-results__grid" id="wte-results-grid"></div>
        </div>
    </section>

    <section class="wte-section wte-extras" aria-labelledby="wte-extras-heading">
        <div class="container">
            <div class="wte-section-heading">
                <p class="wte-section-heading__eyebrow">Ek filtreler</p>
                <h2 id="wte-extras-heading" class="wte-section-heading__title">Seçimini son bir kez daralt.</h2>
            </div>

            <div class="wte-extras__grid">
                <div class="wte-extra-card">
                    <div class="wte-extra-card__header">
                        <h3 class="wte-extra-card__title">Öne çıkan tabaklar</h3>
                    </div>
                    <ul class="wte-trend-list">
                        <li class="wte-trend-item">
                            <span class="wte-trend-item__icon"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-pizza")"></use></svg></span>
                            <span>Margarita Pizza</span>
                        </li>
                        <li class="wte-trend-item">
                            <span class="wte-trend-item__icon"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-bowl")"></use></svg></span>
                            <span>Tavuk Dürüm</span>
                        </li>
                        <li class="wte-trend-item">
                            <span class="wte-trend-item__icon"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-burger")"></use></svg></span>
                            <span>Peynirli Burger</span>
                        </li>
                        <li class="wte-trend-item">
                            <span class="wte-trend-item__icon"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-burger")"></use></svg></span>
                            <span>Protein ağırlıklı</span>
                        </li>
                    </ul>
                </div>

                <div class="wte-extra-card">
                    <div class="wte-extra-card__header">
                        <h3 class="wte-extra-card__title">Mevsime göre</h3>
                    </div>
                    <div class="wte-season-card" id="wte-season-card">
                        <div class="wte-season-item wte-season-item--winter">
                            <span class="wte-season-item__icon"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-season-winter")"></use></svg></span>
                            <span>Kış: sıcak çorba ve güveç</span>
                        </div>
                        <div class="wte-season-item wte-season-item--spring">
                            <span class="wte-season-item__icon"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-season-spring")"></use></svg></span>
                            <span>İlkbahar: taze salata ve dürüm</span>
                        </div>
                        <div class="wte-season-item wte-season-item--summer">
                            <span class="wte-season-item__icon"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-season-summer")"></use></svg></span>
                            <span>Yaz: hafif tabaklar ve soğuk kaseler</span>
                        </div>
                        <div class="wte-season-item wte-season-item--autumn">
                            <span class="wte-season-item__icon"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-season-autumn")"></use></svg></span>
                            <span>Sonbahar: fırın yemekleri ve makarna</span>
                        </div>
                    </div>
                </div>

                <div class="wte-extra-card">
                    <div class="wte-extra-card__header">
                        <h3 class="wte-extra-card__title">Bütçe aralığı</h3>
                    </div>
                    <div class="wte-budget__slider-wrap">
                        <div class="wte-budget__range-labels">
                            <span>₺100</span>
                            <span>₺500</span>
                        </div>
                        <input
                            type="range"
                            class="wte-budget__slider"
                            id="wte-budget-slider"
                            min="30"
                            max="500"
                            value="100"
                            step="10" />
                    </div>
                    <div class="wte-budget__display">
                        <span class="wte-budget__amount" id="wte-budget-amount">₺100</span>
                        <span class="wte-budget__label">kişi başı ortalama</span>
                    </div>
                    <div class="wte-budget__suggestions" id="wte-budget-suggestions"></div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/whattoeat.js" asp-append-version="true"></script>
}
