@using Application.Companies.DTOs

@model CompanyDTO

@{
    ViewData["Title"] = "Company Details";
}

<h2>Company Details</h2>

<div class="card" style="padding:20px;">
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Slug</dt>
        <dd class="col-sm-9">@Model.Slug</dd>

        <dt class="col-sm-3">Owner Id</dt>
        <dd class="col-sm-9">@Model.OwnerId</dd>

        <dt class="col-sm-3">Created At</dt>
        <dd class="col-sm-9">@Model.CreatedAt</dd>

        <dt class="col-sm-3">Updated At</dt>
        <dd class="col-sm-9">@Model.ModifiedAt</dd>
    </dl>

    <div class="d-flex gap-2">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-sm bg-white text-primary border border-primary shadow-sm" title="Edit" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-edit"></i>
        </a>
        <a href="@(ViewData["ReturnUrl"] ?? Url.Action("Index"))" class="btn btn-sm bg-white text-dark border border-dark shadow-sm px-3" title="Back to List" style="height: 36px; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-arrow-left"></i> <span class="d-none d-md-inline ms-2">Back to List</span>
        </a>
    </div>
</div>

