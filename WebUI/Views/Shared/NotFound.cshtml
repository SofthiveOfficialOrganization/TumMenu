@{
    Layout = "_Layout";
    ViewData["Title"] = "Üzgünüz, Sayfa Bulunamadı";
}

@section Head {
    <style>
        :root {
            --nf-primary: #688745;
            --nf-bg: #FCF4EE;
            --nf-text: #4B3A2D;
        }

        .nf-container {
            min-height: 80vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 40px 20px;
            overflow: hidden;
            text-align: center;
        }

        .nf-bg-text {
            position: absolute;
            font-size: 30vw;
            font-weight: 900;
            color: rgba(104, 135, 69, 0.04);
            z-index: 0;
            user-select: none;
            pointer-events: none;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            line-height: 1;
        }

        .nf-content {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .nf-tray-wrapper {
            position: relative;
            animation: nf-float 6s ease-in-out infinite;
            max-width: 600px;
            width: 100%;
        }

        .nf-image {
            width: 100%;
            height: auto;
            filter: drop-shadow(0 20px 40px rgba(0,0,0,0.1));
        }

        .nf-btn-anchor {
            position: absolute;
            top: 48%; /* El-tepsi görselindeki tepsi seviyesine göre ayarlandı */
            left: 50%;
            transform: translate(-50%, -50%);
            width: fit-content;
        }

        .btn-premium {
            background: var(--nf-primary);
            color: #fff !important;
            padding: 16px 42px;
            border-radius: 50px;
            font-size: 18px;
            font-weight: 700;
            text-decoration: none;
            box-shadow: 0 10px 30px rgba(104, 135, 69, 0.3);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: inline-block;
            border: none;
            cursor: pointer;
            letter-spacing: 0.5px;
        }

        .btn-premium:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 40px rgba(104, 135, 69, 0.4);
            background: #7a9c53;
        }

        .nf-message {
            margin-top: 40px;
            font-size: 1.2rem;
            color: var(--nf-text);
            font-weight: 500;
            opacity: 0.8;
            max-width: 400px;
        }

        @@keyframes nf-float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        @@media (max-width: 768px) {
            .nf-bg-text { font-size: 40vw; }
            .btn-premium { padding: 12px 32px; font-size: 16px; }
            .nf-tray-wrapper { max-width: 90%; }
        }
    </style>
}

<div class="nf-container">
    <div class="nf-bg-text">404</div>
    
    <div class="nf-content">
        <div class="nf-tray-wrapper">
            <img src="~/images/404.png" alt="Sayfa Bulunamadı" class="nf-image" />
            
            <div class="nf-btn-anchor">
                <a asp-controller="Home" asp-action="Index" class="btn-premium">
                    Ana Sayfaya Git
                </a>
            </div>
        </div>
        
        <p class="nf-message">
            Aradığınız lezzeti burada bulamadık ama mutfağımızda sizi bekleyen çok şey var.
        </p>
    </div>
</div>
