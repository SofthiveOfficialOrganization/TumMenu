@{
    Layout = "_Layout";
    ViewData["Title"] = "Üzgünüz, Sayfa Bulunamadı";
}

@section Head {
    <style>
        :root {
            --nf-primary: #688745;
            --nf-bg: #FCF4EE;
            --nf-text: #4B3A2D;
        }

        .nf-container {
            min-height: 80vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 40px 20px;
            overflow: hidden;
            text-align: center;
        }

        .nf-bg-text {
            position: absolute;
            font-size: 30vw;
            font-weight: 900;
            color: rgba(104, 135, 69, 0.04);
            z-index: 0;
            user-select: none;
            pointer-events: none;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            line-height: 1;
        }

        .nf-content {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .nf-tray-wrapper {
            position: relative;
            width: min(100%, 900px);
            margin: 0 auto;
        }

        .nf-image {
            display: block;
            width: 100%;
            height: auto;
            filter: drop-shadow(0 20px 40px rgba(0,0,0,0.1));
        }

        .btn-overlay {
            position: absolute;
            left: 62%; /* Daha da sağa kaydırıldı */
            top: 48%; /* Yukarıya çekildi */
            transform: translate(-50%, -50%);
            z-index: 100;

            display: flex;
            align-items: center;
            justify-content: center;

            width: clamp(280px, 35vw, 420px); /* Daha uzun bir alanı kaplaması sağlandı */
            height: clamp(60px, 7vw, 120px);

            text-decoration: none;
            background: transparent;
            border: 0;
            border-radius: 999px;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .btn-overlay:hover {
            background: rgba(255, 255, 255, 0.08); /* Hover belirginliği hafif artırıldı */
        }

        .nf-message {
            margin-top: 40px;
            font-size: 1.1rem;
            color: var(--nf-text);
            font-weight: 500;
            opacity: 0.7;
            max-width: 450px;
        }

        @@media (max-width: 768px) {
            .nf-bg-text { font-size: 40vw; }
            .nf-tray-wrapper { max-width: 90%; }
            .btn-overlay { 
                left: 62%;
                top: 47%; /* Mobilde de hizalama korundu */
                width: clamp(200px, 50vw, 320px);
                height: clamp(40px, 12vw, 70px);
            }
        }
    </style>
}

<div class="nf-container">
    <div class="nf-bg-text">404</div>
    
        <div class="nf-content">
            <div class="nf-tray-wrapper">
                <img src="~/images/404.png" alt="Sayfa Bulunamadı" class="nf-image" />
                
                <a asp-controller="Home" asp-action="Index" class="btn-overlay" aria-label="Ana Sayfaya Git"></a>
            </div>
        
            <p class="nf-message">
                Aradığınız lezzeti burada bulamadık ama mutfağımızda sizi bekleyen çok şey var.
            </p>
        </div>
</div>
