@using Application.MenuDesigns
@using Application.MenuDesigns.DTOs
@model MenuDesignDTO
@{
    string? googleFontsUrl = null;
    if (Model is not null)
    {
        Func<string?, string?> extractFontName = f => f?.Split(',').FirstOrDefault()?.Trim();
        Func<string?, bool> isGeneric = n =>
            n is null || n == "sans-serif" || n == "serif" || n == "monospace" || n == "cursive" || n == "fantasy";

        var bodyFont    = extractFontName(Model.FontFamily);
        var headingFont = extractFontName(Model.HeadingFontFamily);

        var families = new List<string>();
        if (!isGeneric(bodyFont))
            families.Add(Uri.EscapeDataString(bodyFont!) + ":wght@300;400;500;600;700;800");
        if (!isGeneric(headingFont) && headingFont != bodyFont)
            families.Add(Uri.EscapeDataString(headingFont!) + ":wght@400;700");

        if (families.Count > 0)
            googleFontsUrl = "https://fonts.googleapis.com/css2?" +
                string.Join("&", families.Select(f => "family=" + f)) +
                "&display=swap";
    }

    string normalizeStyle(string? style) => style?.Trim().ToLowerInvariant() switch
    {
        "outline" => "outline",
        "ghost" => "ghost",
        _ => "solid"
    };

    string buttonStyle = Model is null ? "solid" : normalizeStyle(Model.ButtonStyle);
    string footerButtonStyle = Model is null ? "solid" : normalizeStyle(Model.FooterButtonStyle ?? Model.ButtonStyle);
    var buttonTextColor = Model?.ButtonTextColor ?? (buttonStyle == "solid" ? "#ffffff" : Model?.PrimaryColor ?? "#ffffff");
    var buttonBorderColor = Model?.ButtonBorderColor ?? (buttonStyle == "ghost" ? "transparent" : Model?.PrimaryColor ?? "#688745");
    var buttonRadius = string.IsNullOrWhiteSpace(Model?.ButtonBorderRadius) ? Model?.BorderRadius ?? "18px" : Model.ButtonBorderRadius;
    string? normalizeBackgroundImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return null;

        var trimmed = url.Trim();
        return ImageUrlBuilder.Build(trimmed.StartsWith("~/", StringComparison.Ordinal)
            ? Url.Content(trimmed)
            : trimmed);
    }

    string escapeCssUrl(string url) => url
        .Replace("\\", "\\\\")
        .Replace("'", "\\'")
        .Replace("\r", "")
        .Replace("\n", "");

    var backgroundImageUrl = normalizeBackgroundImageUrl(Model?.BackgroundImageUrl);
    var backgroundImageCss = backgroundImageUrl is null
        ? "none"
        : $"url('{escapeCssUrl(backgroundImageUrl)}')";

    int ParseOpacityPercent(string? value, int fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
            return fallback;
        var trimmed = value.Trim().TrimEnd('%');
        return int.TryParse(trimmed, out var n) ? Math.Clamp(n, 0, 100) : fallback;
    }

    string SafeColor(string? value, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
            return fallback;
        var v = value.Trim();
        var isValid =
            System.Text.RegularExpressions.Regex.IsMatch(v, @"^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$") ||
            v.StartsWith("rgb", StringComparison.OrdinalIgnoreCase) ||
            v.StartsWith("hsl", StringComparison.OrdinalIgnoreCase) ||
            v.StartsWith("oklch", StringComparison.OrdinalIgnoreCase) ||
            v.StartsWith("oklab", StringComparison.OrdinalIgnoreCase) ||
            v.StartsWith("var(", StringComparison.OrdinalIgnoreCase) ||
            v.StartsWith("color-mix(", StringComparison.OrdinalIgnoreCase) ||
            v.StartsWith("color(", StringComparison.OrdinalIgnoreCase) ||
            v.Equals("transparent", StringComparison.OrdinalIgnoreCase) ||
            v.Equals("currentColor", StringComparison.OrdinalIgnoreCase) ||
            v.Equals("inherit", StringComparison.OrdinalIgnoreCase);
        return isValid ? v : fallback;
    }

    var pageBgTop = ParseOpacityPercent(Model?.PageBackgroundOverlayOpacity, int.Parse(MenuDesignOpacityDefaults.PageBackgroundOverlay));
    var pageBgMid = Math.Clamp(pageBgTop - 14, 0, 100);
    var pageBgEnd = Math.Clamp(pageBgTop + 4, 0, 100);
}
@if (Model is not null)
{
    @if (googleFontsUrl is not null)
    {
        <link rel="stylesheet" href="@googleFontsUrl" />
    }
    <style>
        :root {
            --pm-brand:         @SafeColor(Model.PrimaryColor, "#688745");
            --pm-brand-dark:    @SafeColor(Model.PrimaryDarkColor, "#4a6130");
            --pm-accent:        @SafeColor(Model.AccentColor, "#8bc34a");
            --pm-bg:            @SafeColor(Model.BackgroundColor, "#f8fafc");
            --pm-surface:       @SafeColor(Model.SurfaceColor, "#ffffff");
            --pm-surface-solid: @SafeColor(Model.SurfaceColor, "#ffffff");
            --pm-text:          @SafeColor(Model.TextColor, "#1e293b");
            --pm-muted:         @SafeColor(Model.MutedColor, "#64748b");
            --pm-radius:        @Model.BorderRadius;
            --pm-header-bg:     @SafeColor(Model.HeaderBackgroundColor, SafeColor(Model.PrimaryColor, "#688745"));
            --pm-header-gradient: @(Model.BackgroundGradient ?? "linear-gradient(135deg, var(--pm-header-bg) 0%, var(--pm-brand-dark) 100%)");
            --pm-header-text:   @SafeColor(Model.HeaderTextColor, "#ffffff");
            --pm-bg-image:      @Html.Raw(backgroundImageCss);
            --pm-footer-bg:     @SafeColor(Model.FooterBackgroundColor, SafeColor(Model.PrimaryDarkColor, "#4a6130"));
            --pm-footer-text:   @SafeColor(Model.FooterTextColor, "#ffffff");
            --pm-footer-button: @SafeColor(Model.FooterButtonColor, SafeColor(Model.AccentColor, "#8bc34a"));
            --pm-button-bg:     @(buttonStyle == "solid" ? "var(--pm-brand)" : "transparent");
            --pm-button-text:   @SafeColor(buttonTextColor, "#ffffff");
            --pm-button-border: @SafeColor(buttonBorderColor, "var(--pm-brand)");
            --pm-button-radius: @buttonRadius;
            --pm-button-hover-bg: @(buttonStyle == "solid" ? "var(--pm-brand-dark)" : "color-mix(in srgb, var(--pm-brand) 10%, transparent)");
            --pm-heading-color: @SafeColor(Model.HeadingTextColor, "var(--pm-text)");
            --pm-heading-border-width: @(string.IsNullOrWhiteSpace(Model.HeadingBorderWidth) ? "0" : Model.HeadingBorderWidth);
            --pm-heading-border-color: @SafeColor(Model.HeadingBorderColor, "var(--pm-brand)");
            --pm-heading-weight: @(Model.HeadingFontWeight ?? "800");
            --pm-link:            @SafeColor(Model.LinkColor, "var(--pm-brand)");
            --pm-price:           @SafeColor(Model.PriceColor, "var(--pm-muted)");
            --pm-card-bg:         @SafeColor(Model.CardBackgroundColor, "var(--pm-surface)");
            --pm-card-border-width: @(string.IsNullOrWhiteSpace(Model.CardBorderWidth) ? "1px" : Model.CardBorderWidth);
            --pm-surface-opacity: @MenuDesignOpacityHelper.ToPercent(Model.SurfaceOpacity, MenuDesignOpacityDefaults.Surface);
            --pm-card-opacity: @MenuDesignOpacityHelper.ToPercent(Model.CardOpacity, MenuDesignOpacityDefaults.Card);
            --pm-header-subtitle-opacity: @MenuDesignOpacityHelper.ToPercent(Model.HeaderSecondaryTextOpacity, MenuDesignOpacityDefaults.HeaderSecondaryText);
            --pm-header-accent-opacity: @MenuDesignOpacityHelper.ToPercent(Model.HeaderAccentTextOpacity, MenuDesignOpacityDefaults.HeaderAccentText);
            --pm-page-bg-scrim-top: @(pageBgTop)%;
            --pm-page-bg-scrim-mid: @(pageBgMid)%;
            --pm-page-bg-scrim-end: @(pageBgEnd)%;
            --pm-muted-text-opacity: @MenuDesignOpacityHelper.ToPercent(Model.MutedTextOpacity, MenuDesignOpacityDefaults.MutedText);
            --pm-panel-opacity: @MenuDesignOpacityHelper.ToPercent(Model.PanelOpacity, MenuDesignOpacityDefaults.Panel);
            --pm-header-chip-opacity: @MenuDesignOpacityHelper.ToPercent(Model.HeaderChipOpacity, MenuDesignOpacityDefaults.HeaderChip);
            --pm-muted-foreground: color-mix(in srgb, var(--pm-muted) var(--pm-muted-text-opacity), transparent);
            --pm-footer-button-bg: @(footerButtonStyle == "solid" ? "var(--pm-footer-button)" : "transparent");
            --pm-footer-button-text: @(footerButtonStyle == "solid" ? "#ffffff" : "var(--pm-footer-button)");
            --pm-footer-button-border: @(footerButtonStyle == "ghost" ? "transparent" : "var(--pm-footer-button)");
            --pm-footer-button-hover-bg: @(footerButtonStyle == "solid" ? "color-mix(in srgb, var(--pm-footer-button) 82%, #000000)" : "color-mix(in srgb, var(--pm-footer-button) 14%, transparent)");
            --pm-count-pill-bg: @SafeColor(Model.CountPillBackgroundColor, "color-mix(in srgb, var(--pm-brand) 10%, var(--pm-surface-solid))");
            --pm-count-pill-text: @SafeColor(Model.CountPillTextColor, "var(--pm-brand-dark)");
            --pm-count-pill-border: @SafeColor(Model.CountPillBorderColor, "color-mix(in srgb, var(--pm-brand) 22%, transparent)");
            --pm-count-pill-opacity: @MenuDesignOpacityHelper.ToPercent(Model.CountPillOpacity, MenuDesignOpacityDefaults.CountPill);
            --pm-phone-link: @SafeColor(Model.PhoneLinkColor, "var(--pm-brand-dark)");
            --pm-social-color: @SafeColor(Model.SocialIconColor, "var(--pm-brand-dark)");
            --pm-social-bg: @SafeColor(Model.SocialIconBackgroundColor, "color-mix(in srgb, var(--pm-brand) 10%, var(--pm-surface-solid))");
            --pm-social-border: @SafeColor(Model.SocialIconBorderColor, "color-mix(in srgb, var(--pm-brand) 24%, var(--pm-border))");
            --pm-social-opacity: @MenuDesignOpacityHelper.ToPercent(Model.SocialIconOpacity, MenuDesignOpacityDefaults.SocialIcon);
            @if (!string.IsNullOrEmpty(Model.CardShadow))
            {
                <text>--pm-shadow: @Model.CardShadow;</text>
            }
            @if (!string.IsNullOrEmpty(Model.CardBorderColor))
            {
                <text>--pm-border: @Model.CardBorderColor;</text>
            }
            @if (!string.IsNullOrEmpty(Model.CardImageBorderRadius))
            {
                <text>--pm-card-img-radius: @Model.CardImageBorderRadius;</text>
            }
            @if (!string.IsNullOrEmpty(Model.FontFamily))
            {
                <text>--pm-font: @Model.FontFamily;</text>
            }
            @if (!string.IsNullOrEmpty(Model.HeadingFontFamily))
            {
                <text>--pm-heading-font: @Model.HeadingFontFamily;</text>
            }
            @if (!string.IsNullOrEmpty(Model.HeadingFontSize))
            {
                <text>--pm-heading-size: @Model.HeadingFontSize;</text>
            }
            @if (!string.IsNullOrEmpty(Model.SubheadingFontSize))
            {
                <text>--pm-subheading-size: @Model.SubheadingFontSize;</text>
            }
            @if (!string.IsNullOrEmpty(Model.BodyFontSize))
            {
                <text>--pm-body-size: @Model.BodyFontSize;</text>
            }
        }

        .site-header {
            background-image: var(--pm-header-gradient);
            background-position: center top;
            background-repeat: no-repeat;
            background-size: 100vw var(--pm-header-hero-gradient-height);
            color: var(--pm-header-text);
        }

        .site-header__logo,
        .site-header__nav-link,
        .site-header__mobile-link {
            color: var(--pm-header-text);
        }

        .site-header__nav {
            background: color-mix(in srgb, var(--pm-header-text) 16%, transparent);
        }

        .site-header__nav-link:hover,
        .site-header__mobile-link:hover {
            color: var(--pm-header-text);
            background: color-mix(in srgb, var(--pm-header-text) 12%, transparent);
        }

        .btn--header {
            background: var(--pm-footer-button-bg);
            border: 1px solid var(--pm-footer-button-border);
            color: var(--pm-footer-button-text);
        }

        .btn--header:hover {
            background: var(--pm-footer-button-hover-bg);
            color: var(--pm-footer-button-text);
        }

        .site-header__burger {
            border-color: color-mix(in srgb, var(--pm-header-text) 42%, transparent);
            color: var(--pm-header-text);
        }

        .site-header__burger[aria-expanded="true"],
        .site-header__mobile-inner {
            background: var(--pm-brand-dark);
        }

        .site-header__burger-lines,
        .site-header__burger-lines::before,
        .site-header__burger-lines::after {
            background-color: var(--pm-header-text);
        }
    </style>
}
