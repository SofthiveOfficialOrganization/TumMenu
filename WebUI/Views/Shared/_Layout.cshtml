                        <li><a href="/#new-section">Yeni Restoranlar</a></li>
                    </ul>
                </details>

                <details class="site-footer__acc">
                    <summary>İşletmeler</summary>
                    <ul class="site-footer__links">
                        <li><a href="/ozellikler">Özellikler</a></li>
                        <li><a href="/fiyatlandirma">Fiyatlandırma</a></li>
                        <li><a href="/sss">SSS</a></li>
                        <li><a href="/restoran-kaynaklari">Kaynaklar</a></li>
                        <li><a href="/qr-menu-uygunluk-testi">QR Uygunluk Testi</a></li>
                        <li><a href="/menu-baski-maliyeti-hesaplayici">Baskı Maliyeti Hesaplayıcı</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Login">Hesabım</a></li>
                        <li><a href="/qr-kod">QR'lı Ol</a></li>
                    </ul>
                </details>

                <details class="site-footer__acc">
                    <summary>Hakkımızda</summary>
                    <ul class="site-footer__links">
                        <li><a href="/hakkimizda">Hakkımızda</a></li>
                        <li><a href="/iletisim">İletişim</a></li>
                        <li><a href="/blog">Blog</a></li>
                        <li><a href="/yasal-bilgiler#privacy">Gizlilik Politikası</a></li>
                        <li><a href="/yasal-bilgiler#cookie">Çerez Politikası</a></li>
                        <li><a href="/yasal-bilgiler#terms">Kullanıcı Sözleşmesi</a></li>
