@{
    const string siteTitle = "Tüm Menü";
    var pageTitle = ViewData["Title"] as string ?? siteTitle;
    var fullTitle = string.Equals(pageTitle, siteTitle, StringComparison.OrdinalIgnoreCase)
        ? siteTitle
        : $"{pageTitle} | {siteTitle}";
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var isPublicMenuPage = string.Equals(ViewContext.RouteData.Values["Controller"]?.ToString(), "Menu", StringComparison.OrdinalIgnoreCase)
        && string.IsNullOrEmpty(ViewContext.RouteData.Values["Area"]?.ToString());
    var hideFooter = ViewData["HideFooter"] is bool hideFooterValue ? hideFooterValue : isPublicMenuPage;
    var compactHeader = ViewData["CompactHeader"] is bool compactHeaderValue ? compactHeaderValue : isPublicMenuPage;
    var logoOnlyHeader = ViewData["LogoOnlyHeader"] is bool logoOnlyHeaderValue ? logoOnlyHeaderValue : isPublicMenuPage;
    var headerClass = "site-header"
        + (compactHeader ? " site-header--compact" : string.Empty)
        + (logoOnlyHeader ? " site-header--logo-only" : string.Empty);

    var description = ViewData["Description"] as string
        ?? "QR menülü restoranları keşfet, menülere gitmeden bak, fiyatları karşılaştır ve işletmen için dijital menü oluştur.";

    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var requestPath = Context.Request.Path.Value ?? string.Empty;
    var systemNoIndexPrefixes = new[]
    {
        "/Admin",
        "/Identity",
        "/api",
        "/user",
        "/owner",
        "/error",
        "/status-code"
    };
    var systemNoIndexExactPaths = new[]
    {
        "/giris",
        "/kayit",
        "/hesap-aktivasyon",
        "/Account/AccountActivationSuccess"
    };
    var robotsContent = ViewData["Robots"] as string
        ?? (systemNoIndexPrefixes.Any(prefix => requestPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            || systemNoIndexExactPaths.Any(path => string.Equals(requestPath, path, StringComparison.OrdinalIgnoreCase))
                ? "noindex,nofollow"
                : "index,follow");
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <meta name="robots" content="@robotsContent" />
    <link rel="canonical" href="@canonical" />

    <meta name="theme-color" content="#688745" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />

    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />

    @RenderSection("Head", required: false)
    
    <!-- Organization Schema Markup -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "Tüm Menü",
      "alternateName": "TumMenu",
      "url": "https://tummenu.com",
      "logo": "https://tummenu.com/images/logo.png",
      "description": "Restoranlar ve kafeler için yeni nesil QR menü ve sipariş yönetim sistemi.",
      "parentOrganization": {
        "@@type": "Organization",
        "name": "SoftHive",
        "description": "Yazılım ve Teknoloji Çözümleri"
      },
      "contactPoint": {
        "@@type": "ContactPoint",
        "contactType": "Müşteri Destek",
        "email": "destek@tummenu.com",
        "availableLanguage": "Turkish"
      }
    }
    </script>
    
    <!-- AdSense loader. Manual ad placements are intentionally kept out of the layout to avoid intrusive UX. -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7675210368255349"
        crossorigin="anonymous">
        </script>
</head>
<body class="app-shell @bodyClass">
    <!-- HEADER -->
    <header class="@headerClass" role="banner">
        <div class="container site-header__inner">

            <a asp-area="" asp-controller="Home" asp-action="Index" class="site-header__logo" aria-label="Tüm Menü ana sayfa">
                <picture>
                    <source srcset='@ImageUrlBuilder.Build("~/images/tum-menu-logo-safe-3.webp")' type="image/webp" />
                    <img class="site-header__logo-icon"
                         src='@ImageUrlBuilder.Build("~/images/tum-menu-logo-safe-3.png")'
                         alt=""
                         decoding="async" />
                </picture>
                <!-- <span class="site-header__logo-text">Tüm Menü</span> -->
            </a>

            @if (!logoOnlyHeader)
            {
                <!-- Menü ORTA -->
                <nav class="site-header__nav" aria-label="Ana menü">
                    <a href="/" class="site-header__nav-link">Ana Sayfa</a>
                    <a href="/ne-yesem" class="site-header__nav-link">Ne yesem?</a>
                    <a href="/restoranlar" class="site-header__nav-link">Restoranlar</a>
                    <a href="/blog" class="site-header__nav-link">Blog</a>
                    <a href="/iletisim" class="site-header__nav-link">İletişim</a>
                </nav>

                <!-- QR SAĞ -->
                <div class="site-header__actions">
                    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "BeQr")
                    {
                        <a class="btn btn--header" asp-area="Identity" asp-page="/Account/Login">Hesabım</a>
                    }
                    @if (ViewContext.RouteData.Values["Controller"]?.ToString() != "Home" || ViewContext.RouteData.Values["Action"]?.ToString() != "BeQr")
                    {
                        <a href="/qr-kod" class="btn btn--header">QR'lı Ol</a>
                    }
                    <button class="site-header__burger"
                            type="button"
                            aria-label="Menüyü aç"
                            aria-expanded="false"
                            aria-controls="mobileMenu">
                        <span class="site-header__burger-lines"></span>
                    </button>
                </div>
            }

        </div>
        @if (!logoOnlyHeader)
        {
            <div id="mobileMenu" class="site-header__mobile" hidden>
                <div class="site-header__mobile-inner">
                    <a class="site-header__mobile-link" href="/">Ana Sayfa</a>
                    <a class="site-header__mobile-link" href="/ne-yesem">Ne yesem?</a>
                    <a class="site-header__mobile-link" href="/restoranlar">Restoranlar</a>
                    <a class="site-header__mobile-link" href="/blog">Blog</a>
                    <a class="site-header__mobile-link" href="/iletisim">İletişim</a>
                    @if (ViewContext.RouteData.Values["Controller"]?.ToString() != "Home" || ViewContext.RouteData.Values["Action"]?.ToString() != "BeQr")
                    {
                        <a class="site-header__mobile-link" href="/qr-kod">QR'lı Ol</a>
                    }
                </div>
            </div>
        }
    </header>

    <!-- ANA İÇERİK -->
    <main id="main-content">
        @RenderBody()
    </main>

