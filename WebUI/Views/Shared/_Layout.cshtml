    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var successMessage = @Json.Serialize(TempData["Success"]);
            var errorMessage = @Json.Serialize(TempData["Error"]);

            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            if (successMessage) {
                Toast.fire({
                    icon: 'success',
                    title: successMessage
                });
            }

            if (errorMessage) {
                Toast.fire({
                    icon: 'error',
                    title: errorMessage
                });
            }
        });
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Location Service -->
    <script src="~/js/location-service.js?v=@DateTime.Now.Ticks"></script>

    @RenderSection("Scripts", required: false)

    <script>
        (function () {
          const btn = document.querySelector(".site-header__burger");
          const menu = document.getElementById("mobileMenu");
          const header = document.querySelector(".site-header");

          if (!btn || !menu || !header) return;

          function setOpen(open) {
            btn.setAttribute("aria-expanded", open ? "true" : "false");
            menu.hidden = !open;

            document.documentElement.classList.toggle("no-scroll", open);
            document.body.classList.toggle("no-scroll", open);
          }

          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const isOpen = btn.getAttribute("aria-expanded") === "true";
            setOpen(!isOpen);
          });

          menu.addEventListener("click", (e) => {
            if (e.target.closest("a")) setOpen(false);
          });

          document.addEventListener("click", (e) => {
            if (!menu.hidden && !header.contains(e.target)) {
              setOpen(false);
            }
          });

          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") setOpen(false);
          });

          window.addEventListener("resize", () => {
            if (window.innerWidth > 720) setOpen(false);
          });
        })();
    </script>

    <section id="cookieConsent" class="cookie-consent" aria-labelledby="cookieConsentTitle" hidden>
        <div class="cookie-consent__inner">
            <h2 id="cookieConsentTitle" class="cookie-consent__title">Çerez tercihleri</h2>
            <p class="cookie-consent__text">
                TümMenü zorunlu çerezleri oturum, güvenlik ve form işlemleri için kullanır. Detaylar için
                <a href="/yasal-bilgiler#cookie">Çerez Politikası</a> metnini inceleyebilirsiniz.
            </p>

            <div id="cookiePreferencePanel" class="cookie-consent__preferences" hidden>
                <label class="cookie-consent__option">
                    <input type="checkbox" checked disabled />
                    <span><strong>Zorunlu çerezler</strong> Oturum, güvenlik, antiforgery ve temel site işlevleri için gereklidir.</span>
                </label>
                <label class="cookie-consent__option">
                    <input id="cookieAdsConsent" type="checkbox" />
                    <span><strong>Reklam ve ölçüm çerezleri</strong> AdSense ve benzeri üçüncü taraf reklam/ölçüm servisleri için kullanılır.</span>
                </label>
            </div>

            <div class="cookie-consent__actions">
                <button type="button" class="cookie-consent__btn cookie-consent__btn--primary" data-cookie-accept>Tümünü kabul et</button>
                <button type="button" class="cookie-consent__btn" data-cookie-reject>Zorunlu olmayanları reddet</button>
            </div>
        </div>
    </section>

    <script>
        (function () {
            const storageKey = 'tummenu.cookieConsent.v1';
            const adsEnabled = @Json.Serialize(enableAdSense);
            const ga4MeasurementId = @Json.Serialize(ga4MeasurementId);
            const banner = document.getElementById('cookieConsent');
            const preferencePanel = document.getElementById('cookiePreferencePanel');
            const adsCheckbox = document.getElementById('cookieAdsConsent');
            const saveButton = document.querySelector('[data-cookie-save]');
            let adsScriptLoaded = false;
            let analyticsScriptLoaded = false;
            const adFallbackThrottleMs = 2 * 60 * 60 * 1000;
            const adFallbackStorageKey = 'tummenu.adFallbackLastShownAt';

            function tumMenuCanShowAdFallbackModal() {
                try {
                    const raw = window.localStorage.getItem(adFallbackStorageKey);
                    if (!raw) {
                        return true;
                    }
                    const last = parseInt(raw, 10);
                    if (isNaN(last)) {
                        return true;
                    }
                    return Date.now() - last >= adFallbackThrottleMs;
                } catch (_) {
                    return true;
                }
            }

            function tumMenuMarkAdFallbackShown() {
                try {
                    window.localStorage.setItem(adFallbackStorageKey, String(Date.now()));
                } catch (_) {
                }
            }

            function readConsent() {
                try {
                    const raw = window.localStorage.getItem(storageKey);
                    return raw ? JSON.parse(raw) : null;
                } catch (_) {
                    return null;
                }
            }

            function writeConsent(consent) {
                const payload = {
                    necessary: true,
                    ads: Boolean(consent.ads),
                    decidedAt: new Date().toISOString()
                };

                try {
                    window.localStorage.setItem(storageKey, JSON.stringify(payload));
                } catch (_) {
                    // If localStorage is unavailable, keep the choice for this page view only.
                }

                applyConsent(payload);
                hideBanner();
            }

            function tumMenuShowAdFallbackModal() {
                if (!tumMenuCanShowAdFallbackModal()) {
                    return;
                }
                const el = document.getElementById('tummenu-ad-fallback-modal');
                if (!el) {
                    return;
                }
                tumMenuMarkAdFallbackShown();
                el.hidden = false;
                document.documentElement.classList.add('no-scroll');
                document.body.classList.add('no-scroll');
            }

            function tumMenuHideAdFallbackModal() {
                const el = document.getElementById('tummenu-ad-fallback-modal');
                if (!el) {
                    return;
                }
                el.hidden = true;
                document.documentElement.classList.remove('no-scroll');
                document.body.classList.remove('no-scroll');
            }

            document.querySelectorAll('[data-tummenu-ad-fallback-close]').forEach(function (node) {
                node.addEventListener('click', tumMenuHideAdFallbackModal);
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    const el = document.getElementById('tummenu-ad-fallback-modal');
                    if (el && !el.hidden) {
                        tumMenuHideAdFallbackModal();
                    }
                }
            });

            function loadAdSense() {
                if (!adsEnabled || document.querySelector('script[data-tummenu-adsense]')) {
                    return;
                }
                if (adsScriptLoaded) {
                    return;
                }

                const script = document.createElement('script');
                script.async = true;
                script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7675210368255349';
                script.crossOrigin = 'anonymous';
                script.dataset.tummenuAdsense = 'true';
                script.onload = function () {
                    adsScriptLoaded = true;
                };
                script.onerror = function () {
                    tumMenuShowAdFallbackModal();
                };
                document.head.appendChild(script);
            }

            function loadGoogleAnalytics() {
                if (!ga4MeasurementId || analyticsScriptLoaded || document.querySelector('script[data-tummenu-ga4]')) {
                    return;
                }

                window.dataLayer = window.dataLayer || [];
                window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
                window.gtag('js', new Date());
                window.gtag('config', ga4MeasurementId, { anonymize_ip: true });

                const script = document.createElement('script');
                script.async = true;
                script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ga4MeasurementId);
                script.dataset.tummenuGa4 = 'true';
                document.head.appendChild(script);
                analyticsScriptLoaded = true;
            }

            function applyConsent(consent) {
                if (consent && consent.ads) {
                    loadGoogleAnalytics();
                    loadAdSense();
                }
            }

            function showBanner(openPreferences) {
                if (!banner) return;

                banner.hidden = false;
                if (openPreferences && preferencePanel && saveButton) {
                    preferencePanel.hidden = false;
                    saveButton.hidden = false;
                    const consent = readConsent();
                    if (adsCheckbox) {
                        adsCheckbox.checked = Boolean(consent && consent.ads);
                    }
                }
            }

            function hideBanner() {
                if (banner) {
                    banner.hidden = true;
                }
            }

            document.querySelectorAll('[data-cookie-preferences]').forEach((trigger) => {
                trigger.addEventListener('click', () => showBanner(true));
            });

            document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
                writeConsent({ ads: true });
            });

            document.querySelector('[data-cookie-reject]')?.addEventListener('click', () => {
                writeConsent({ ads: false });
            });

            document.querySelector('[data-cookie-toggle]')?.addEventListener('click', () => {
                if (!preferencePanel || !saveButton) return;
                const nextHidden = !preferencePanel.hidden;
                preferencePanel.hidden = nextHidden;
                saveButton.hidden = nextHidden;
            });

            saveButton?.addEventListener('click', () => {
                writeConsent({ ads: Boolean(adsCheckbox && adsCheckbox.checked) });
            });

            const existingConsent = readConsent();
            if (existingConsent) {
                applyConsent(existingConsent);
            } else {
                showBanner(false);
            }
        })();
    </script>


</body>
</html>
