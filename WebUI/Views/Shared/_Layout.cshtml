@{
    var pageTitle = ViewData["Title"] as string ?? "Ana Sayfa";
    var fullTitle = pageTitle + " - Full Menu";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@fullTitle</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Temel SEO -->
    <meta name="description"
          content="QR menülü restoranları keşfet, menülere gitmeden bak, fiyatları karşılaştır ve kendi dijital menünü oluştur." />
    <meta name="robots" content="index,follow" />

    <!-- Open Graph -->
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description"
          content="Müşteriler için QR menülü restoranları keşfet, işletmeler için dakikalar içinde dijital menüye geç." />
    <meta property="og:type" content="website" />

    <!-- Domainini eklediğinde canonical aç -->
    @* <link rel="canonical" href="https://www.senin-domainin.com@Context.Request.Path" /> *@

    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Head", required: false)
</head>
<body class="app-shell">
    <!-- HEADER -->
    <header class="site-header">
        <div class="container site-header__inner">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="site-header__logo">
                <div class="site-header__logo-icon" aria-hidden="true">🍽</div>
                <div class="site-header__logo-text">
                    <span class="site-header__logo-text-main">full</span>
                    <span class="site-header__logo-text-accent">menu</span>
                </div>
            </a>

            <nav class="site-header__nav" aria-label="Ana menü">
                <a asp-controller="Home" asp-action="Index" class="site-header__nav-link">
                    Ne yesem?
                </a>
                <a asp-controller="Home" asp-action="Restoranlar" class="site-header__nav-link">
                    Restoranlar
                </a>
            </nav>

            <div class="site-header__actions">
                <a asp-controller="Home" asp-action="BeQr"
                   class="btn btn--primary">
                    Be QR
                </a>
            </div>
        </div>
    </header>

    <!-- ANA İÇERİK -->
    <main class="app-main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="container">
            <div class="site-footer__top">
                <div class="site-footer__brand">
                    <div class="site-footer__brand-title">
                        <span>full</span><span> menu</span>
                    </div>
                    <p>
                        Full Menu ile menüleri keşfet, restoranları karşılaştır ve dijital menü sayesinde daha akıllı sipariş ver.
                    </p>
                </div>

                <div>
                    <h3 class="site-footer__column-title">Müşteriler için</h3>
                    <ul class="site-footer__links">
                        <li><a href="#">Restoran bul</a></li>
                        <li><a href="#">Menülere göz at</a></li>
                        <li><a href="#">Popüler yemekler</a></li>
                        <li><a href="#">Mutfak türleri</a></li>
                        <li><a href="#">Konumlar</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="site-footer__column-title">İşletmeler için</h3>
                    <ul class="site-footer__links">
                        <li><a href="#">Be QR iş ortağı</a></li>
                        <li><a href="#">Fiyatlandırma</a></li>
                        <li><a href="#">Özellikler</a></li>
                        <li><a href="#">Başarı hikâyeleri</a></li>
                        <li><a href="#">Kaynaklar</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="site-footer__column-title">Şirket</h3>
                    <ul class="site-footer__links">
                        <li><a href="#">Hakkımızda</a></li>
                        <li><a href="#">İletişim</a></li>
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Kariyer</a></li>
                        <li><a href="#">Basın</a></li>
                    </ul>
                </div>
            </div>

            <div class="site-footer__bottom">
                <span>© 2024 Full Menu. Tüm hakları saklıdır.</span>
                <div class="site-footer__social">
                    <a href="#" aria-label="Facebook"><span>f</span></a>
                    <a href="#" aria-label="Instagram"><span>ig</span></a>
                    <a href="#" aria-label="Twitter"><span>tw</span></a>
                    <a href="#" aria-label="LinkedIn"><span>in</span></a>
                </div>
            </div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
