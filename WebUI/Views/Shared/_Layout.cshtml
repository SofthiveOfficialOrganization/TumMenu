@*
    Ortak layout:
    - Head (SEO + CSS)
    - Header (logo + menü)
    - Opsiyonel Hero (@section Hero)
    - Body (@RenderBody)
    - Footer
*@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - tümmenü | Dijital QR Menü Platformu</title>

    <meta name="description"
          content="tümmenü; küçük esnaf ve müşteriler için dijital QR menü platformu. Restoranları keşfedin, menülere gitmeden göz atın, işletmeniz için saniyeler içinde QR menü oluşturun." />

    <!-- Basit Open Graph -->
    <meta property="og:title" content="tümmenü - Dijital QR Menü Platformu" />
    <meta property="og:description" content="Restoranların QR menülerini keşfedin, işletmeniz için saniyeler içinde dijital menü oluşturun." />
    <meta property="og:type" content="website" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Tema değişkenleri -->
    <link rel="stylesheet" href="~/css/globals.css" asp-append-version="true" />

    <!-- Otomatik WebUI stilleri (varsın dursun) -->
    <link rel="stylesheet" href="~/WebUI.styles.css" asp-append-version="true" />

    <!-- Body + layout -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Header + hero + footer -->
    <link rel="stylesheet" href="~/css/footer-header.css" asp-append-version="true" />
</head>
<body>
    <header class="tm-header">
        <div class="tm-container tm-header-inner">
            <a asp-controller="Home" asp-action="Index"
               class="tm-logo" aria-label="Tüm Menü ana sayfa">
                <div class="tm-logo-icon">TM</div>
                <span class="tm-logo-text">tümmenü</span>
            </a>

            <nav class="tm-nav" id="tmNav">
                <a href="#search" class="tm-nav-link">Ne yesem?</a>
                <a href="#restaurants" class="tm-nav-link">Restoranlar</a>
                <button class="tm-btn tm-btn-primary" id="qrliOlBtn" type="button">
                    QR'lı ol
                </button>
            </nav>

            <button class="tm-nav-toggle" id="navToggle"
                    aria-label="Menüyü aç veya kapat">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </header>

    <main class="tm-main" role="main">
        @RenderBody()
    </main>

    <footer class="tm-footer" id="footer">
        <div class="tm-container tm-footer-inner">
            <div class="tm-footer-main">
                <div class="tm-footer-brand">
                    <div class="tm-logo">
                        <div class="tm-logo-icon">TM</div>
                        <span class="tm-logo-text">tümmenü</span>
                    </div>
                    <p>
                        Klasik menü ve baskı derdini bırak. Tüm Menü ile hem
                        müşteriler hem işletmeler için sade bir QR menü deneyimi sun.
                    </p>
                </div>

                <div class="tm-footer-columns">
                    <div class="tm-footer-col">
                        <h4>Ürün</h4>
                        <a href="#hero">Nasıl çalışır?</a>
                        <a href="#search">Restoran ara</a>
                        <a href="#restaurants">Popüler işletmeler</a>
                    </div>
                    <div class="tm-footer-col">
                        <h4>İşletmeler</h4>
                        <button type="button" id="qrliOlFooterBtn">QR menüye geç</button>
                        <a href="#search">Demo talep et</a>
                        <a href="#footer">Sık sorulan sorular</a>
                    </div>
                </div>
            </div>

            <div class="tm-footer-bottom">
                <span>© 2025 Tüm Menü. Tüm hakları saklıdır.</span>
                <span>
                    <a href="#footer">KVKK</a> ·
                    <a href="#footer">Çerez politikası</a>
                </span>
            </div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
