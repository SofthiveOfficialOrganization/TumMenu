                        <li><a href="/menu-baski-maliyeti-hesaplayici">Baskı Maliyeti Hesaplayıcı</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Login">Hesabım</a></li>
                        <li><a href="/qr-kod">QR'lı Ol</a></li>
                    </ul>
                </div>

                <div class="site-footer__col">
                    <h3 class="site-footer__column-title">Şirket</h3>
                    <ul class="site-footer__links">
                        <li><a href="/hakkimizda">Hakkımızda</a></li>
                        <li><a href="/iletisim">İletişim</a></li>
                        <li><a href="/blog">Blog</a></li>
                        <li><a href="/yasal-bilgiler#privacy">Gizlilik Politikası</a></li>
                        <li><a href="/yasal-bilgiler#cookie">Çerez Politikası</a></li>
