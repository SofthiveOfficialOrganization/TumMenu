@{
    var pageTitle = ViewData["Title"] as string ?? "Tüm Menü";
    var fullTitle = $"{pageTitle} | Tüm Menü";

    var description = ViewData["Description"] as string
        ?? "QR menülü restoranları keşfet, menülere gitmeden bak, fiyatları karşılaştır ve işletmen için dijital menü oluştur.";

    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="@canonical" />

    <meta name="theme-color" content="#688745" />

    <!-- Open Graph -->
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />

    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Head", required: false)
</head>
<body class="app-shell">
    <!-- HEADER -->
    <header class="site-header" role="banner">
        <div class="container site-header__inner">

            <a asp-controller="Home" asp-action="Index" class="site-header__logo" aria-label="Tüm Menü ana sayfa">
                <img class="site-header__logo-icon" src="~/images/tum-menu-logo-safe.png" />
                <!-- <span class="site-header__logo-text">Tüm Menü</span> -->
            </a>

            <!-- Menü ORTA -->
            <nav class="site-header__nav" aria-label="Ana menü">
                <a asp-controller="Home" asp-action="WhatToEat" class="site-header__nav-link">Ne yesem?</a>
                <a asp-controller="Home" asp-action="Restaurants" class="site-header__nav-link">Restoranlar</a>
                <a asp-controller="Home" asp-action="Pricing" class="site-header__nav-link">Fiyatlandırma</a>
            
            </nav>

            <!-- QR SAĞ -->
            <div class="site-header__actions">
                @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "BeQr")
                {
                    <a class="btn btn--header btn--ghost" asp-area="Identity" asp-page="/Account/Login">Hesabım</a>
                }
                @if (ViewContext.RouteData.Values["Controller"]?.ToString() != "Home" || ViewContext.RouteData.Values["Action"]?.ToString() != "BeQr")
                {
                    <a asp-area="" asp-controller="Home" asp-action="BeQr" class="btn btn--header">QR’lı Ol</a>
                }
                <button class="site-header__burger"
                        type="button"
                        aria-label="Menüyü aç"
                        aria-expanded="false"
                        aria-controls="mobileMenu">
                    <span class="site-header__burger-lines"></span>
                </button>
            </div>

        </div>
        <div id="mobileMenu" class="site-header__mobile" hidden>
            <div class="site-header__mobile-inner">
                <a class="site-header__mobile-link" asp-area="" asp-controller="Home" asp-action="WhatToEat">Ne yesem?</a>
                <a class="site-header__mobile-link" asp-area="" asp-controller="Home" asp-action="Restaurants">Restoranlar</a>
                <a class="site-header__mobile-link" asp-area="" asp-controller="Home" asp-action="Pricing">Fiyatlandırma</a>
                @if (ViewContext.RouteData.Values["Controller"]?.ToString() != "Home" || ViewContext.RouteData.Values["Action"]?.ToString() != "BeQr")
                {
                    <a class="site-header__mobile-link" asp-area="" asp-controller="Home" asp-action="BeQr">QR’lı Ol</a>
                }
            </div>
        </div>
    </header>

    <!-- ANA İÇERİK -->
    <main id="main-content">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="site-footer" role="contentinfo">
        <div class="container">

            <!-- Desktop footer -->
            <div class="site-footer__top site-footer__top--desktop">
                <div class="site-footer__brand">
                    <div class="site-footer__brand-title">Tüm Menü</div>
                    <p>Menüleri keşfet, fiyatları karşılaştır, işletmen için dijital menüye geç.</p>
                </div>

                <div class="site-footer__col">
                    <h3 class="site-footer__column-title">Müşteriler</h3>
                    <ul class="site-footer__links">
                        <li><a href="/#popular-section">Popüler Restoranlar</a></li>
                        <li><a href="/#daily-section">Günün Restoranları</a></li>
                        <li><a href="/#new-section">Yeni Restoranlar</a></li>
                    </ul>
                </div>

                <div class="site-footer__col">
                    <h3 class="site-footer__column-title">İşletmeler</h3>
                    <ul class="site-footer__links">
                        <li><a asp-area="Identity" asp-page="/Account/Login">Hesabım</a></li>
                        <li><a href="/Home/BeQr">QR'lı Ol</a></li>
                        <li><a href="/Home/Pricing">Fiyatlandırma</a></li>
                    </ul>
                </div>

                <div class="site-footer__col">
                    <h3 class="site-footer__column-title">Şirket</h3>
                    <ul class="site-footer__links">
                        <li><a href="/Home/About">Hakkımızda</a></li>
                        <li><a href="/Home/Contact">İletişim</a></li>
                        <li><a href="/Home/Legal">Yasal Bilgiler</a></li>
                    </ul>
                </div>
            </div>

            <!-- Mobile footer -->
            <div class="site-footer__top site-footer__top--mobile">
                <div class="site-footer__brand">
                    <div class="site-footer__brand-title">Tüm Menü</div>
                    <p>Menüleri keşfet, fiyatları karşılaştır, dijital menüye geç.</p>
                </div>

                <details class="site-footer__acc">
                    <summary>Müşteriler</summary>
                    <ul class="site-footer__links">
                        <li><a href="/#popular-section">Popüler Restoranlar</a></li>
                        <li><a href="/#daily-section">Günün Restoranları</a></li>
                        <li><a href="/#new-section">Yeni Restoranlar</a></li>
                    </ul>
                </details>

                <details class="site-footer__acc">
                    <summary>İşletmeler</summary>
                    <ul class="site-footer__links">
                        <li><a asp-area="Identity" asp-page="/Account/Login">Hesabım</a></li>
                        <li><a href="/Home/BeQr">QR'lı Ol</a></li>
                        <li><a href="/Home/Pricing">Fiyatlandırma</a></li>
                    </ul>
                </details>

                <details class="site-footer__acc">
                    <summary>Hakkımızda</summary>
                    <ul class="site-footer__links">
                        <li><a href="/Home/About">Hakkımızda</a></li>
                        <li><a href="/Home/Legal#section-privacy">Politikamız</a></li>
                        <li><a href="/Home/Legal#section-kvkk">KVKK &amp; Gizlilik</a></li>
                        <li><a href="/Home/Contact">İletişim</a></li>
                    </ul>
                </details>
            </div>

            <div class="site-footer__bottom">
                <span>© @DateTime.Now.Year Tüm Menü. Tüm hakları saklıdır.</span>
                <div class="site-footer__social">
                    <a href="#" aria-label="Instagram">ig</a>
                    <a href="#" aria-label="X">x</a>
                    <a href="#" aria-label="LinkedIn">in</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var successMessage = @Json.Serialize(TempData["Success"]);
            var errorMessage = @Json.Serialize(TempData["Error"]);

            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            if (successMessage) {
                Toast.fire({
                    icon: 'success',
                    title: successMessage
                });
            }

            if (errorMessage) {
                Toast.fire({
                    icon: 'error',
                    title: errorMessage
                });
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
    <script>
        (function () {
          const btn = document.querySelector(".site-header__burger");
          const menu = document.getElementById("mobileMenu");
          const header = document.querySelector(".site-header");

          if (!btn || !menu || !header) return;

          function setOpen(open) {
            btn.setAttribute("aria-expanded", open ? "true" : "false");
            menu.hidden = !open;

            document.documentElement.classList.toggle("no-scroll", open);
            document.body.classList.toggle("no-scroll", open);
          }

          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const isOpen = btn.getAttribute("aria-expanded") === "true";
            setOpen(!isOpen);
          });

          menu.addEventListener("click", (e) => {
            if (e.target.closest("a")) setOpen(false);
          });

          document.addEventListener("click", (e) => {
            if (!menu.hidden && !header.contains(e.target)) {
              setOpen(false);
            }
          });

          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") setOpen(false);
          });

          window.addEventListener("resize", () => {
            if (window.innerWidth > 720) setOpen(false);
          });
        })();
    </script>


</body>
</html>
