                    </ul>
                </div>

                <div class="site-footer__col">
                    <h3 class="site-footer__column-title">İşletmeler</h3>
                    <ul class="site-footer__links">
                        <li><a href="/ozellikler">Özellikler</a></li>
                        <li><a href="/fiyatlandirma">Fiyatlandırma</a></li>
