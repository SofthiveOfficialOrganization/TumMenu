@using Microsoft.AspNetCore.Hosting
@model ErrorViewModel
@inject IWebHostEnvironment Env

@{
    ViewData["Title"] = "Bir hata oluştu";
    var message = (ViewData["Message"] as string) ?? "İşleminiz şu anda tamamlanamadı.";
}

<div class="container py-5">
    <h1 class="text-danger">Bir hata oluştu</h1>
    <p class="text-muted">@message</p>

    @if(Model?.ShowRequestId == true)
    {
        <p class="mt-3">
            <strong>Referans:</strong> <code>@Model!.RequestId</code>
        </p>
    }

    <div class="mt-4">
        <a class="btn btn-primary" href="/">Ana sayfaya dön</a>
        <button class="btn btn-outline-secondary" type="button" data-tummenu-back data-fallback-url="/">Geri dön</button>
    </div>

    @if(Env.IsDevelopment())
    {
        <hr class="my-4" />
        <h3>Development</h3>
        <pre style="white-space: pre-wrap;">@(ViewData["Message"] ?? "")</pre>
    }
</div>
