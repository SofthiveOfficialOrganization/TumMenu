@{
    Layout = "_Layout";
    ViewData["Title"] = "İstek Tamamlanamadı";
    var message = ViewData["Message"] as string ?? "İstek güvenlik veya doğrulama kontrolünden geçemedi.";
}

@section Head {
    <style>
        .br-container {
            min-height: 72vh;
            display: grid;
            place-items: center;
            padding: 48px 20px;
            text-align: center;
        }

        .br-card {
            width: min(100%, 620px);
            padding: clamp(28px, 5vw, 52px);
            border: 1px solid rgba(104, 135, 69, 0.18);
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 18px 50px rgba(24, 18, 12, 0.08);
        }

        .br-code {
            margin: 0 0 10px;
            color: #688745;
            font-size: clamp(3rem, 12vw, 6rem);
            font-weight: 900;
            line-height: 0.95;
        }

        .br-title {
            margin: 0 0 14px;
            color: #15120f;
            font-size: clamp(1.4rem, 4vw, 2rem);
            font-weight: 850;
        }

        .br-message {
            margin: 0 auto 28px;
            max-width: 44rem;
            color: #756f66;
            line-height: 1.65;
        }

        .br-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }
    </style>
}

<div class="br-container">
    <section class="br-card" aria-labelledby="bad-request-title">
        <p class="br-code">400</p>
        <h1 id="bad-request-title" class="br-title">İstek tamamlanamadı</h1>
        <p class="br-message">
            @message
        </p>
        <div class="br-actions">
            <a class="btn btn--primary" href="/">Ana sayfaya dön</a>
            <button class="btn btn--ghost" type="button" data-tummenu-back data-fallback-url="/">Geri dön</button>
        </div>
    </section>
</div>
