@using Application.Categories.DTOs
@using Domain.Entities
@using WebUI.Services
@model Application.Menus.DTOs.MenuDTO

@{
    var storeName = Model.StoreName ?? Model.Title;
    var companyName = Model.CompanyName ?? "";
    var categories = Model.Categories.Where(c => c.IsActive).OrderBy(c => c.SortOrder).ToList();
    var totalProductCount = categories.Sum(CountActiveProducts);
    var companySlug = ViewContext.RouteData.Values["companySlug"]?.ToString() ?? "";
    var storeSlug = ViewContext.RouteData.Values["storeSlug"]?.ToString() ?? "";

    // Fiyat görünürlüğü: ShowPricesOnMenu true ise veya isQr=true parametresi varsa göster
    var isQr = Context.Request.Query["isQr"].ToString().ToLower() == "true";
    var showPricesOnPublicMenu = Model.ShowPricesOnMenu || isQr;
    var visibleSocialLinks = Model.ShowSocialLinksOnMenu
        ? Model.SocialLinks.Where(x => !string.IsNullOrWhiteSpace(x.Url)).OrderBy(x => x.SortOrder).ToList()
        : [];
    var showMenuPhone = Model.ShowPhoneNumberOnMenu && !string.IsNullOrWhiteSpace(Model.StorePhoneNumber);
    var showMenuSecondaryPhone = Model.ShowPhoneNumberOnMenu && !string.IsNullOrWhiteSpace(Model.StoreSecondaryPhoneNumber);
    var showMenuAddress = Model.ShowAddressOnMenu && !string.IsNullOrWhiteSpace(Model.StoreFullAddress);
    var hasBusinessInfo = visibleSocialLinks.Count > 0 || showMenuPhone || showMenuSecondaryPhone || showMenuAddress;
    var showQrCover = isQr && Model.ShowCoverPhotoOnQrMenu;
    var sprite = Url.Content("~/assets/icons/tm-sprite.svg");
    var qrCoverTelHref = !string.IsNullOrWhiteSpace(Model.StorePhoneNumber) ? TelHref(Model.StorePhoneNumber) : null;
    string? qrCoverMapsUrl = null;
    var hasQrCoverCoords = Model.StoreLatitude is double lat0 && Model.StoreLongitude is double lng0
        && lat0 is >= -90 and <= 90 && lng0 is >= -180 and <= 180;

    if (hasQrCoverCoords)
    {
        var lat = Model.StoreLatitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lng = Model.StoreLongitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        qrCoverMapsUrl = $"https://www.google.com/maps?q={Uri.EscapeDataString($"{lat},{lng}")}";
    }
    else if (!string.IsNullOrWhiteSpace(Model.StoreFullAddress))
    {
        qrCoverMapsUrl = $"https://www.google.com/maps?q={Uri.EscapeDataString(Model.StoreFullAddress)}";
    }

    ViewData["Title"] = $"{storeName} Menüsü";
    ViewData["Description"] = showPricesOnPublicMenu
        ? $"{storeName} dijital menüsü – kategoriler, ürünler ve fiyatlar."
        : $"{storeName} dijital menüsü – kategoriler ve ürünler.";
    ViewData["HideFooter"] = true;
    ViewData["CompactHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/css/public-menu.css" asp-append-version="true" />
    @await Html.PartialAsync("_MenuTheme", Model.MenuDesign)
}

<div class="pm-wrapper">
    <main class="pm-main">
        <div class="pm-shell">
            <header class="pm-hero">
                <div class="pm-hero-inner">
                    <div class="pm-hero-main">
                        @if (!string.IsNullOrWhiteSpace(companyName))
                        {
                            <p class="pm-eyebrow">@companyName</p>
                        }
                        <h1 class="pm-store">@storeName</h1>
                    </div>

                    <div class="pm-meta-row" aria-label="Menü özeti">
                        <span class="pm-stat">
                            <svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-menu")"></use></svg>
                            @categories.Count kategori
                        </span>
                        <span class="pm-stat">
                            <svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-tag")"></use></svg>
                            @totalProductCount ürün
                        </span>
                    </div>
                    @if (Model.ShowRepresentativeImagesDisclaimer)
                    {
                        <p class="pm-disclaimer" role="note">Görseller temsilidir</p>
                    }
                    @if (hasBusinessInfo)
                    {
                        <button type="button" class="pm-info-button" data-pm-info-open>
                            <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 16v-4"></path>
                                <path d="M12 8h.01"></path>
                            </svg>
                            <span>İşletme bilgileri</span>
                        </button>
                    }
@* 
                    @if (categories.Count > 0)
                    {
                        <nav class="pm-chip-row" aria-label="Kategoriler">
                            @foreach (var cat in categories.Take(8))
                            {
                                var categoryUrl = $"/{companySlug}/{storeSlug}/{cat.CategoryLibraryItem.Slug}";
                                <a href="@categoryUrl" class="pm-chip">@cat.CategoryLibraryItem.Title</a>
                            }
                        </nav>
                    } *@
                </div>
            </header>

            <div class="pm-content-area">
                @if (!showQrCover)
                {
                    @await Component.InvokeAsync("Ad", new { slotKey = "menu_top" })
                }

                <section id="pm-menu-content" class="pm-panel pm-panel--spacious">
                    <div class="pm-section-head">
                        <div>
                            <h2 class="pm-section-title">Kategoriler</h2>
                            @* <p class="pm-section-note">İştahına göre bir bölüm seç.</p> *@
                        </div>
                        @* <span class="pm-count-pill">@categories.Count kategori</span> *@
                    </div>

                    @if (categories.Count == 0)
                    {
                        <div class="pm-empty">
                            <span class="pm-empty-icon" aria-hidden="true">
                                <svg class="tm-icon tm-icon--xl"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-menu")"></use></svg>
                            </span>
                            <p>Henüz menüde kategori bulunmuyor.</p>
                        </div>
                    }
                    else
                    {
                        <div class="pm-category-grid">
                            @{ int categoryCounter = 0; }
                            @foreach (var cat in categories)
                            {
                                categoryCounter++;
                                var productCount = CountActiveProducts(cat);
                                var categoryUrl = $"/{companySlug}/{storeSlug}/{cat.CategoryLibraryItem.Slug}";
                                <a href="@categoryUrl" class="pm-cat-card">
                                    <div class="pm-cat-card-photo">
                                        @if (!string.IsNullOrEmpty(cat.CategoryLibraryItem.ImageUrl))
                                        {
                                            <img src="@ImageUrlBuilder.Build(cat.CategoryLibraryItem.ImageUrl, width: 400, height: 250, fit: ImageFitMode.CoverCenter)" alt="@cat.CategoryLibraryItem.Title" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="pm-cat-card-photo-placeholder">
                                                @{
                                                    var iconKey = cat.CategoryLibraryItem.IconKey;
                                                    if (string.IsNullOrWhiteSpace(iconKey))
                                                    {
                                                        <svg class="tm-icon tm-icon--xl" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-menu")"></use></svg>
                                                    }
                                                    else if (iconKey.StartsWith("fa"))
                                                    {
                                                        <i class="@iconKey" aria-hidden="true"></i>
                                                    }
                                                    else
                                                    {
                                                        <svg class="tm-icon tm-icon--xl" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#{iconKey}")"></use></svg>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="pm-cat-card-info">
                                        <h3 class="pm-cat-card-title">@cat.CategoryLibraryItem.Title</h3>
                                        <div class="pm-card-footer">
                                            <span class="pm-cat-card-count">@productCount ürün</span>
                                            <span class="pm-card-arrow" aria-hidden="true">
                                                <svg class="tm-icon"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-chevron-right")"></use></svg>
                                            </span>
                                        </div>
                                    </div>
                                </a>

                                if (categoryCounter % 4 == 0 && categoryCounter < categories.Count)
                                {
                                    <div class="pm-ad-in-feed">
                                        @await Component.InvokeAsync("Ad", new { slotKey = "menu_in_feed" })
                                    </div>
                                }
                            }
                        </div>
                    }
                </section>
            </div>
        </div>
    </main>
</div>

@if (showQrCover)
{
    <div class="pm-qr-cover-modal" data-pm-qr-cover-modal hidden>
        <div class="pm-qr-cover-backdrop" aria-hidden="true"></div>
        <section class="pm-qr-cover-dialog" role="dialog" aria-modal="true" aria-labelledby="qrCoverTitle" aria-label="İşletme bilgileri">
            @if (!string.IsNullOrWhiteSpace(Model.StoreBannerUrl))
            {
                <div class="pm-qr-cover-media" aria-hidden="true">
                    <img src="@ImageUrlBuilder.Build(Model.StoreBannerUrl, width: 960, height: 420, fit: ImageFitMode.CoverCenter)"
                         alt=""
                         width="960"
                         height="420" />
                </div>
            }

            <div class="pm-qr-cover-card">
                <div class="pm-qr-cover-logo @(string.IsNullOrEmpty(Model.StoreLogoUrl) ? "pm-qr-cover-logo--placeholder" : null)">
                    @if (!string.IsNullOrEmpty(Model.StoreLogoUrl))
                    {
                        <img src="@ImageUrlBuilder.Build(Model.StoreLogoUrl, width: 208, height: 208, fit: ImageFitMode.CoverCenter)"
                             alt="@storeName logosu"
                             width="208"
                             height="208" />
                    }
                    else
                    {
                        <svg class="tm-icon" aria-hidden="true" width="36" height="36"><use href="@($"{sprite}#icon-menu")"></use></svg>
                    }
                </div>

                <div class="pm-qr-cover-head">
                    @if (!string.IsNullOrWhiteSpace(companyName))
                    {
                        <span class="pm-qr-cover-kicker">@companyName</span>
                    }
                    <h2 id="qrCoverTitle" class="pm-qr-cover-title">@storeName</h2>
                </div>

                <div class="pm-qr-cover-meta">
                    @if (qrCoverTelHref != null)
                    {
                        <a class="pm-qr-cover-chip" href="@qrCoverTelHref" aria-label="Telefon ile ara">
                            <svg class="tm-icon" aria-hidden="true"><use href="@($"{sprite}#icon-phone")"></use></svg>
                            <span>@Model.StorePhoneNumber</span>
                        </a>
                    }
                    @if (qrCoverMapsUrl != null)
                    {
                        <a class="pm-qr-cover-chip pm-qr-cover-chip--muted" href="@qrCoverMapsUrl" target="_blank" rel="noopener noreferrer" aria-label="Konumu aç">
                            <svg class="tm-icon" aria-hidden="true"><use href="@($"{sprite}#icon-location")"></use></svg>
                            <span>Konum</span>
                        </a>
                    }
                </div>

                <button type="button" class="pm-qr-cover-button" data-pm-qr-cover-enter>
                    <svg class="tm-icon" aria-hidden="true"><use href="@($"{sprite}#icon-menu")"></use></svg>
                    <span>Menüyü gör</span>
                </button>
            </div>

            <div class="pm-qr-cover-ad">
                @await Component.InvokeAsync("Ad", new { slotKey = "menu_top" })
            </div>
        </section>
    </div>

    <script>
        (() => {
            const modal = document.querySelector('[data-pm-qr-cover-modal]');
            const enterButton = document.querySelector('[data-pm-qr-cover-enter]');
            const target = document.getElementById('pm-menu-content');
            if (!modal || !enterButton) return;

            const open = () => {
                modal.hidden = false;
                requestAnimationFrame(() => modal.classList.add('is-open'));
                document.body.classList.add('pm-qr-cover-open');
                enterButton.focus({ preventScroll: true });
            };

            const close = () => {
                modal.classList.remove('is-open');
                document.body.classList.remove('pm-qr-cover-open');
                window.setTimeout(() => {
                    modal.hidden = true;
                    target?.scrollIntoView({ block: 'start', behavior: 'smooth' });
                }, 180);
            };

            enterButton.addEventListener('click', close);
            window.addEventListener('pageshow', open, { once: true });
        })();
    </script>
}

@if (hasBusinessInfo)
{
    <div class="pm-business-info-modal" data-pm-info-modal hidden>
        <button type="button" class="pm-business-info-backdrop" data-pm-info-close aria-label="İşletme bilgilerini kapat"></button>
        <section class="pm-business-info-dialog" role="dialog" aria-modal="true" aria-labelledby="businessInfoTitle">
            <div class="pm-business-info-head">
                <div>
                    <p class="pm-business-info-kicker">@companyName</p>
                    <h2 id="businessInfoTitle">İşletme bilgileri</h2>
                </div>
                <button type="button" class="pm-business-info-close" data-pm-info-close aria-label="Kapat">
                    <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                </button>
            </div>

            <div class="pm-business-info-body">
                @if (showMenuPhone || showMenuSecondaryPhone)
                {
                    <div class="pm-business-info-group">
                        <span class="pm-business-info-icon" aria-hidden="true">
                            <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.35 1.9.66 2.8a2 2 0 0 1-.45 2.11L8.05 9.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.31 1.84.53 2.8.66A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                        </span>
                        <div>
                            <h3>Telefon</h3>
                            @if (showMenuPhone)
                            {
                                <a href="@TelHref(Model.StorePhoneNumber)">@Model.StorePhoneNumber</a>
                            }
                            @if (showMenuSecondaryPhone)
                            {
                                <a href="@TelHref(Model.StoreSecondaryPhoneNumber)">@Model.StoreSecondaryPhoneNumber</a>
                            }
                        </div>
                    </div>
                }

                @if (showMenuAddress)
                {
                    <div class="pm-business-info-group">
                        <span class="pm-business-info-icon" aria-hidden="true">
                            <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </span>
                        <div>
                            <h3>Adres</h3>
                            <p>@Model.StoreFullAddress</p>
                        </div>
                    </div>
                }

                @if (visibleSocialLinks.Count > 0)
                {
                    <div class="pm-business-info-socials" aria-label="Sosyal medya hesapları">
                        @foreach (var link in visibleSocialLinks)
                        {
                            <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="pm-business-info-social" aria-label="@SocialLabel(link.Platform, link.DisplayName)">
                                @switch (link.Platform)
                                {
                                    case StoreSocialPlatform.Twitter:
                                        <svg class="tm-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2H21.9l-8 9.14L23.3 22h-7.37l-5.77-6.86L3.56 22H-.1l8.56-9.78L-.55 2h7.56l5.2 6.16L18.24 2Zm-1.28 18.08h2.03L5.9 3.82H3.72l13.24 16.26Z" /></svg>
                                        break;
                                    case StoreSocialPlatform.Instagram:
                                        <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg>
                                        break;
                                    case StoreSocialPlatform.Facebook:
                                        <svg class="tm-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8.6V6.8c0-.86.2-1.3 1.42-1.3H17V2.22A21.3 21.3 0 0 0 14.25 2C11.5 2 9.6 3.68 9.6 6.78V8.6H6.5V12h3.1v10H14V12h2.92l.46-3.4H14Z" /></svg>
                                        break;
                                    case StoreSocialPlatform.YouTube:
                                        <svg class="tm-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.54 6.42a2.8 2.8 0 0 0-1.97-1.98C18.83 4 12 4 12 4s-6.83 0-8.57.44a2.8 2.8 0 0 0-1.97 1.98A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.8 2.8 0 0 0 1.97 1.98C5.17 20 12 20 12 20s6.83 0 8.57-.44a2.8 2.8 0 0 0 1.97-1.98A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58ZM9.75 15.15v-6.3L15.5 12l-5.75 3.15Z" /></svg>
                                        break;
                                    default:
                                        <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 0 20"></path><path d="M12 2a15.3 15.3 0 0 0 0 20"></path></svg>
                                        break;
                                }
                                <span>@SocialLabel(link.Platform, link.DisplayName)</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </section>
    </div>

    <script>
        (() => {
            const modal = document.querySelector('[data-pm-info-modal]');
            const openButton = document.querySelector('[data-pm-info-open]');
            if (!modal || !openButton) return;

            const closeButtons = modal.querySelectorAll('[data-pm-info-close]');
            const open = () => {
                modal.hidden = false;
                requestAnimationFrame(() => modal.classList.add('is-open'));
                document.body.classList.add('pm-info-modal-open');
            };
            const close = () => {
                modal.classList.remove('is-open');
                document.body.classList.remove('pm-info-modal-open');
                window.setTimeout(() => { modal.hidden = true; }, 180);
            };

            openButton.addEventListener('click', open);
            closeButtons.forEach(button => button.addEventListener('click', close));
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape' && !modal.hidden) close();
            });
        })();
    </script>
}

@functions {
    private static int CountActiveProducts(CategoryDTO category)
    {
        var directProductCount = category.Products?.Count(p => p.IsActive) ?? 0;
        var subCategoryProductCount = category.SubCategories?.Where(c => c.IsActive).Sum(CountActiveProducts) ?? 0;

        return directProductCount + subCategoryProductCount;
    }

    private static string TelHref(string? phone)
    {
        var digits = new string((phone ?? string.Empty).Where(c => char.IsDigit(c) || c == '+').ToArray());
        return $"tel:{digits}";
    }

    private static string SocialLabel(StoreSocialPlatform platform, string? displayName)
    {
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            return displayName;
        }

        return platform switch
        {
            StoreSocialPlatform.Twitter => "Twitter",
            StoreSocialPlatform.Instagram => "Instagram",
            StoreSocialPlatform.Facebook => "Facebook",
            StoreSocialPlatform.YouTube => "YouTube",
            _ => "Web sitesi"
        };
    }
}
