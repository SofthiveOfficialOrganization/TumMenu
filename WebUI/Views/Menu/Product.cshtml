@using Domain.Entities
@using WebUI.Seo
@model Application.Menus.Queries.ProductPageDTO

@{
    // Fiyat görünürlüğü: ShowPricesOnMenu true ise veya isQr=true parametresi varsa göster
    var isQr = Context.Request.Query["isQr"].ToString().ToLower() == "true";
    var showPricesOnPublicMenu = Model.ShowPricesOnMenu || isQr;

    ViewData["Title"] = $"{Model.ProductTitle} – {Model.StoreName}";
    ViewData["Description"] = showPricesOnPublicMenu
        ? $"{Model.StoreName} – {Model.ProductTitle}"
        : $"{Model.StoreName} – {Model.ProductTitle} (fiyat yayında gösterilmiyor).";
    ViewData["OgImage"] = Model.ImageUrls.FirstOrDefault();
    ViewData["HideFooter"] = true;
    ViewData["CompactHeader"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var backUrl = $"/{Model.CompanySlug}/{Model.StoreSlug}/{Model.CategorySlug}";
    var backHref = backUrl + (ViewBag.IsQrSource == true ? "?isQr=true" : "");
    var hasImages = Model.ImageUrls.Count > 0;
}

@section Head {
    <link rel="stylesheet" href="~/css/public-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-order-cart.css" asp-append-version="true" />
    @await Html.PartialAsync("_MenuTheme", Model.MenuDesign)
    @{
        var menuPageUrl = $"/{Model.CompanySlug}/{Model.StoreSlug}";
        var categoryPageUrl = $"/{Model.CompanySlug}/{Model.StoreSlug}/{Model.CategorySlug}";
        var productPageUrl = $"{categoryPageUrl}/{Model.ProductSlug}";
        var breadcrumbs = new List<(string Name, string Url)>
        {
            ("Ana Sayfa", "/"),
            ($"{Model.StoreName} Menüsü", menuPageUrl),
            (Model.CategoryTitle, categoryPageUrl),
            (Model.ProductTitle, productPageUrl)
        };
        var productImage = Model.ImageUrls.FirstOrDefault();
    }
    @await Html.PartialAsync("Seo/_BreadcrumbJsonLd", breadcrumbs)
    @await Html.PartialAsync("Seo/_MenuItemJsonLd", new MenuItemJsonLdModel
    {
        Name = Model.ProductTitle,
        PageUrl = productPageUrl,
        Description = Model.ProductDescription,
        ImageUrl = productImage,
        Price = Model.BasePrice,
        IncludeOffer = showPricesOnPublicMenu
    })
}

@section Scripts {
    <script>
        window.TumMenuPublicOrder = { storeId: '@Model.StoreId' };
    </script>
    <script src="~/js/public-order-cart.js" asp-append-version="true"></script>
}

<div class="pm-wrapper">
    <main class="pm-main">
        <div class="pm-shell">
            <header class="pm-hero">
                <div class="pm-hero-inner">
                    <div class="pm-hero-actions">
                        <a href="@backHref" data-tummenu-back data-fallback-url="@backHref" class="pm-back-link">
                            <svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-chevron-left")"></use></svg>
                            <span>Geri Dön</span>
                        </a>
                    </div>

                    <div class="pm-hero-main">
                        <p class="pm-eyebrow">@Model.CompanyName / @Model.StoreName</p>
                        <h1 class="pm-store">@Model.CategoryTitle</h1>
                        <p class="pm-subtitle">@Model.ProductTitle</p>
                    </div>
                    @if (Model.ShowRepresentativeImagesDisclaimer)
                    {
                        <p class="pm-disclaimer" role="note">Görseller temsilidir</p>
                    }
                </div>
            </header>

            <div class="pm-content-area">
                @if (ViewBag.IsQrSource == true)
                {
                    @await Component.InvokeAsync("Ad", new { slotKey = "product_top" })
                }

                <section class="pm-product-detail @(hasImages ? "" : "pm-product-detail--no-media")">
                    @if (hasImages)
                    {
                        <div class="pm-product-detail-gallery">
                            @foreach (var imgUrl in Model.ImageUrls)
                            {
                                <img src="@ImageUrlBuilder.Build(imgUrl, width: 800, height: 620, fit: ImageFitMode.CoverCenter)" alt="@Model.ProductTitle" class="pm-product-detail-img" loading="lazy" />
                            }
                        </div>
                    }

                    <div class="pm-product-detail-body">
                        <div class="pm-meta-row" aria-label="Ürün yolu">
                            <span class="pm-count-pill">@Model.CategoryTitle</span>
                            @if (Model.EstimatedPreparationTimeInMinutes.HasValue && Model.EstimatedPreparationTimeInMinutes > 0)
                            {
                                <span class="pm-count-pill">@Model.EstimatedPreparationTimeInMinutes dk</span>
                            }
                        </div>

                        <div class="pm-product-detail-header">
                            <h1 class="pm-product-detail-title">@Model.ProductTitle</h1>
                            @if (showPricesOnPublicMenu)
                            {
                                <span class="pm-product-price pm-product-price--lg">@Model.BasePrice.ToString("N2") ₺</span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ProductDescription))
                        {
                            <p class="pm-product-detail-desc">@Model.ProductDescription</p>
                        }

                        @if (showPricesOnPublicMenu && Model.Prices.Count > 0)
                        {
                            <div class="pm-price-options" aria-label="Fiyat seçenekleri">
                                @foreach (var price in Model.Prices.OrderBy(p => p.CreatedAt))
                                {
                                    <div class="pm-price-option">
                                        <span class="pm-price-option-size">@price.Size</span>
                                        <span class="pm-price-option-price">@price.Price.ToString("N2") ₺</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="pm-product-badges">
                            @if (Model.IsVegan == true) { <span class="pm-badge pm-badge-vegan"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-leaf")"></use></svg> Vegan</span> }
                            @if (Model.IsVegetarian == true) { <span class="pm-badge pm-badge-veg"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-leaf")"></use></svg> Vejeteryan</span> }
                            @if (Model.EstimatedPreparationTimeInMinutes.HasValue && Model.EstimatedPreparationTimeInMinutes > 0)
                            {
                                <span class="pm-badge pm-badge-time"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-refresh")"></use></svg> @Model.EstimatedPreparationTimeInMinutes dk hazırlık</span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Allergens))
                        {
                            <div class="pm-allergen-box">
                                <span class="pm-badge pm-badge-allergen"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-warning")"></use></svg> Alerjen Bilgisi</span>
                                <p class="pm-allergen-text">@Model.Allergens</p>
                            </div>
                        }

                        <form class="tm-order-product-form" data-order-product-form>
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <input type="hidden" name="productTitle" value="@Model.ProductTitle" />
                            <input type="hidden" name="basePrice" value="@Model.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />

                            <div class="tm-order-product-form-row">
                                <label>
                                    Seçenek
                                    <select name="priceOption">
                                        <option value=""
                                                data-size=""
                                                data-price="@Model.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            Standart - @Model.BasePrice.ToString("N2") ₺
                                        </option>
                                        @foreach (var price in Model.Prices.OrderBy(p => p.CreatedAt))
                                        {
                                            <option value="@price.Id"
                                                    data-size="@price.Size"
                                                    data-price="@price.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                @(string.IsNullOrWhiteSpace(price.Size) ? "Seçenek" : price.Size) - @price.Price.ToString("N2") ₺
                                            </option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    Adet
                                    <input type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" />
                                </label>
                            </div>

                            <label>
                                Ürün Notu
                                <textarea name="note" maxlength="500" rows="2" placeholder="Örn. acısız, soğansız"></textarea>
                            </label>

                            <button type="submit" class="tm-order-submit">
                                Sepete ekle
                            </button>
                        </form>
                    </div>
                </section>
            </div>
        </div>
    </main>
</div>
