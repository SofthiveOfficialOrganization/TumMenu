@model Application.Menus.Queries.CategoryPageDTO

@{
    ViewData["Title"] = $"{Model.CategoryTitle} – {Model.StoreName}";
    ViewData["Description"] = $"{Model.StoreName} – {Model.CategoryTitle} kategorisindeki ürünler.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var backUrl = string.IsNullOrEmpty(Model.ParentCategorySlug) 
        ? $"/{Model.CompanySlug}/{Model.StoreSlug}" 
        : $"/{Model.CompanySlug}/{Model.StoreSlug}/{Model.ParentCategorySlug}";
    var backLabel = string.IsNullOrEmpty(Model.ParentCategorySlug) ? "Menüye Dön" : "Geri Dön";
}

@section Head {
    <link rel="stylesheet" href="~/css/public-menu.css" asp-append-version="true" />
    @await Html.PartialAsync("_MenuTheme", Model.MenuDesign)
}

<div class="pm-wrapper">
    <main class="pm-main">

        <!-- HERO HEADER -->
        <header class="pm-header">
            <div class="pm-header-bg"></div>
            <div class="pm-header-content">
                <p class="pm-company">@Model.CompanyName</p>
                <h1 class="pm-store">@Model.StoreName</h1>
                <p class="pm-subtitle">@Model.CategoryTitle</p>
            </div>
        </header>

        <div class="pm-content-area">

            <div class="pm-view active">
                <div class="pm-view-header">
                    <a href="@backUrl" class="pm-btn-back">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
                        </svg>
                        <span>@backLabel</span>
                    </a>
                </div>

                <!-- Category Top Ad - Show to all visitors for approval -->
                @await Component.InvokeAsync("Ad", new { slotKey = "category_top" })

                <h2 class="pm-view-title mb-2">@Model.CategoryTitle</h2>

                @if (!string.IsNullOrEmpty(Model.CategoryDescription))
                {
                    <p class="pm-cat-desc">@Model.CategoryDescription</p>
                }

                @if (Model.SubCategories != null && Model.SubCategories.Count > 0)
                {
                    <div class="mb-5">
                        <h4 class="pm-section-title mb-4">Alt Kategoriler</h4>
                        <div class="pm-category-grid">
                            @foreach (var subCat in Model.SubCategories)
                            {
                                var subCategoryUrl = $"/{Model.CompanySlug}/{Model.StoreSlug}/{subCat.Slug}";
                                <a href="@subCategoryUrl" class="pm-cat-card">
                                    <div class="pm-cat-card-photo">
                                        @if (!string.IsNullOrEmpty(subCat.ImageUrl))
                                        {
                                            <img src="@subCat.ImageUrl" alt="@subCat.Title" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="pm-cat-card-photo-placeholder">
                                                @{
                                                    if (string.IsNullOrWhiteSpace(subCat.IconKey))
                                                    {
                                                        <svg class="tm-icon tm-icon--xl" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-menu")"></use></svg>
                                                    }
                                                    else if (subCat.IconKey.StartsWith("fa"))
                                                    {
                                                        <i class="@subCat.IconKey" aria-hidden="true"></i>
                                                    }
                                                    else
                                                    {
                                                        <svg class="tm-icon tm-icon--xl" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#{subCat.IconKey}")"></use></svg>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="pm-cat-card-info">
                                        <h3 class="pm-cat-card-title">@subCat.Title</h3>
                                        <span class="pm-cat-card-count">@subCat.ProductCount ürün</span>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (Model.Products != null && Model.Products.Count > 0)
                {
                    <h4 class="pm-section-title mb-4">Ürünler</h4>
                    <div class="pm-product-list">
                        @{ int productCounter = 0; }
                        @foreach (var product in Model.Products)
                        {
                            productCounter++;
                            var productUrl = $"/{Model.CompanySlug}/{Model.StoreSlug}/{Model.CategorySlug}/{product.Slug}";
                            <a href="@productUrl" class="pm-product-card">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <div class="pm-product-img-wrap">
                                        <img src="@product.ImageUrl" alt="@product.Title" class="pm-product-img" loading="lazy" />
                                    </div>
                                }
                                <div class="pm-product-content">
                                    <div class="pm-product-header">
                                        <h3 class="pm-product-title">@product.Title</h3>
                                        <span class="pm-product-price">@product.BasePrice.ToString("N2") ₺</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(product.Description))
                                    {
                                        <p class="pm-product-desc">@product.Description</p>
                                    }
                                    <div class="pm-product-badges">
                                        @if (product.IsVegan == true) { <span class="pm-badge pm-badge-vegan"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-leaf")"></use></svg> Vegan</span> }
                                        @if (product.IsVegetarian == true) { <span class="pm-badge pm-badge-veg"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-leaf")"></use></svg> Veg</span> }
                                        @if (product.EstimatedPreparationTimeInMinutes.HasValue) { <span class="pm-badge pm-badge-time"><svg class="tm-icon" aria-hidden="true"><use href="@($"{Url.Content("~/assets/icons/tm-sprite.svg")}#icon-refresh")"></use></svg> @product.EstimatedPreparationTimeInMinutes dk</span> }
                                    </div>
                                </div>
                            </a>

                            if (productCounter % 5 == 0 && productCounter < Model.Products.Count)
                            {
                                <div class="pm-ad-in-feed">
                                    @await Component.InvokeAsync("Ad", new { slotKey = "menu_in_feed" })
                                </div>
                            }
                        }
                    </div>
                }
                else if (Model.SubCategories == null || Model.SubCategories.Count == 0)
                {
                    <div class="pm-empty-products">Bu kategoride henüz ürün yok.</div>
                }
            </div>

        </div>
    </main>
</div>
