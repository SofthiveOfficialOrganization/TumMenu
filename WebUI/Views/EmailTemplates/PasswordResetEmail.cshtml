@model PasswordResetEmailModel
@{
    Layout = null;
}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TumMenu - Şifre Sıfırlama</title>
    <style type="text/css">
        #outlook a { padding: 0; }
        .ExternalClass { width: 100%; }
        .ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div { line-height: 100%; }
        table { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
        body { margin: 0; padding: 0; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; background-color: #f8f9fa; }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fa;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#f8f9fa" style="background-color: #f8f9fa;">
        <tr>
            <td align="center" style="padding: 20px 0;">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#688745" style="max-width: 600px; background-color: #688745; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);">
                    <tr>
                        <td align="center" bgcolor="#688745" style="padding: 40px 30px; background-color: #688745;">
                            <div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 32px; font-weight: bold; color: #ffffff; margin-bottom: 10px;"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -4px; margin-right: 6px;"><path d="M4 5h16v2H4zM4 11h16v2H4zM4 17h16v2H4z"/></svg>TumMenu</div>
                            <div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #e1e8db; font-size: 16px;">Şifre Sıfırlama İşlemi</div>
                        </td>
                    </tr>
                    <tr>
                        <td bgcolor="#ffffff" style="background-color: #ffffff; padding: 40px 30px;">
                            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td align="center">
                                        <h1 style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333333; font-size: 28px; font-weight: 600; margin: 0 0 20px 0;"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -4px; margin-right: 6px;"><path d="M7 10V7a5 5 0 1 1 10 0v3h2v12H5V10h2zm2 0h6V7a3 3 0 1 0-6 0v3z"/></svg>Şifre Sıfırlama</h1>
                                        <p style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #666666; font-size: 16px; line-height: 1.6; margin: 0 0 30px 0;">
                                            Merhaba <strong>@Model.UserName</strong>! Hesabınız için şifre sıfırlama talebinde bulundunuz. 
                                            Şifrenizi yenilemek için aşağıdaki butona tıklayın.
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding: 20px 0 40px 0;">
                                        <a href="@Model.PasswordResetUrl" style="background-color:#688745; border-radius:25px; color:#ffffff; display:inline-block; font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:16px; font-weight:bold; line-height:50px; text-align:center; text-decoration:none; width:220px; -webkit-text-size-adjust:none;">
                                            <span style="color:#ffffff;">Şifremi Sıfırla</span>
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#fdf3f2" style="margin-bottom: 30px; background-color: #fdf3f2; border-left: 4px solid #970001; border-radius: 8px;">
                                            <tr>
                                                <td style="padding: 20px;">
                                                    <div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #970001; font-size: 16px; font-weight: bold; margin-bottom: 5px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -2px; margin-right: 4px;"><path d="M12 3 1.8 21h20.4L12 3zm1 13h-2v-6h2v6zm0 3h-2v-2h2v2z"/></svg>Dikkat</div>
                                                    <div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #666666; font-size: 14px; line-height: 1.5;">Bu link @Model.ExpiryHours saat boyunca geçerlidir. Bu talebi siz yapmadıysanız lütfen bu e-postayı dikkate almayın.</div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" bgcolor="#f8f9fa" style="background-color: #f8f9fa; padding: 30px; border-top: 1px solid #e9ecef;">
                            <p style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #999999; font-size: 12px; margin-bottom: 10px;">
                                © 2025 TumMenu. Tüm hakları saklıdır.
                            </p>
                            <p style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #999999; font-size: 12px; margin: 0;">
                                Destek için: <a href="mailto:destek@tummenu.com" style="color: #688745; text-decoration: none;"><span style="color:#688745;">destek@tummenu.com</span></a>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
