@model RegistrationEmailModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TumMenu - Hoş Geldiniz!</title>
</head>
<body style="margin: 0; padding: 20px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f8f9fa; color: #333333;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 0 auto; background-color: #688745; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);">
        <tr>
            <td style="padding: 40px 30px; text-align: center; background-color: rgba(255, 255, 255, 0.1);">
                <div style="font-size: 32px; font-weight: bold; color: white; margin-bottom: 10px; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);">🍽️ TumMenu</div>
                <div style="color: rgba(255, 255, 255, 0.9); font-size: 16px;">Restoranınızı Dijitalleştirin</div>
            </td>
        </tr>
        <tr>
            <td style="background-color: #ffffff; padding: 40px 30px;">
                <h1 style="color: #333333; font-size: 28px; font-weight: 600; margin-bottom: 20px; text-align: center;">Hoş Geldiniz! 👋</h1>
                <p style="color: #666666; font-size: 16px; line-height: 1.6; margin-bottom: 30px; text-align: center;">
                    Merhaba <strong>@Model.UserName</strong>! TumMenu ailesine katıldığınız için çok mutluyuz. 
                    Restoranınızı dijitalleştirme yolculuğunuzda size destek olmak için buradayız.
                </p>
                
                <div style="width: 60px; height: 3px; background-color: #688745; margin: 30px auto; border-radius: 2px;"></div>
                
                <!-- Features -->
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 30px;">
                    <tr>
                        <td style="background-color: #f8f9fa; border-radius: 15px; padding: 25px; border-left: 4px solid #688745;">
                            <div style="color: #333333; font-size: 18px; font-weight: 600; margin-bottom: 10px; display: flex; align-items: center;">
                                <span style="width: 24px; height: 24px; background-color: #688745; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-right: 12px; color: white; font-size: 14px;">📱</span>
                                Dijital Menü
                            </div>
                            <div style="color: #666666; font-size: 14px; line-height: 1.5;">
                                QR kod ile menünüze kolayca erişim sağlayın. Müşterileriniz telefonlarıyla menünüzü anında görüntüleyebilir.
                            </div>
                        </td>
                    </tr>
                </table>
                
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 30px;">
                    <tr>
                        <td style="background-color: #f8f9fa; border-radius: 15px; padding: 25px; border-left: 4px solid #688745;">
                            <div style="color: #333333; font-size: 18px; font-weight: 600; margin-bottom: 10px; display: flex; align-items: center;">
                                <span style="width: 24px; height: 24px; background-color: #688745; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-right: 12px; color: white; font-size: 14px;">📊</span>
                                Analitik ve Raporlama
                            </div>
                            <div style="color: #666666; font-size: 14px; line-height: 1.5;">
                                Restoranınızın performansını gerçek zamanlı olarak takip edin. En çok sipariş edilen ürünleri ve müşteri tercihlerini analiz edin.
                            </div>
                        </td>
                    </tr>
                </table>
                
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 30px;">
                    <tr>
                        <td style="background-color: #f8f9fa; border-radius: 15px; padding: 25px; border-left: 4px solid #688745;">
                            <div style="color: #333333; font-size: 18px; font-weight: 600; margin-bottom: 10px; display: flex; align-items: center;">
                                <span style="width: 24px; height: 24px; background-color: #688745; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-right: 12px; color: white; font-size: 14px;">🎨</span>
                                Kolay Yönetim
                            </div>
                            <div style="color: #666666; font-size: 14px; line-height: 1.5;">
                                Ürünlerinizi, fiyatlarınızı ve menünüzü tek tıkla güncelleyin. Modern arayüzümüzle yönetim hiç bu kadar kolay olmamıştı.
                            </div>
                        </td>
                    </tr>
                </table>
                
                <!-- Action Buttons -->
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 40px 0;">
                    <tr>
                        <td style="text-align: center;">
                            <a href="@Model.ConfirmationUrl" style="display: inline-block; padding: 15px 35px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 16px; background-color: #688745; color: white; box-shadow: 0 10px 25px rgba(104, 135, 69, 0.3); margin: 10px;">
                                ✅ Hesabımı Onayla
                            </a>
                            <a href="@Model.AccountActivationUrl" style="display: inline-block; padding: 15px 35px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 16px; background-color: white; color: #688745; border: 2px solid #688745; margin: 10px;">
                                🚀 Hesabımı Aç
                            </a>
                        </td>
                    </tr>
                </table>
                
                <p style="color: #666666; font-size: 16px; line-height: 1.6; margin-bottom: 30px; text-align: center;">
                    Hesabınızı onayladıktan sonra hemen menünüzü oluşturmaya başlayabilirsiniz. 
                    Sizlere en iyi hizmeti sunmak için 7/24 destek ekibimiz hazır bekliyor.
                </p>
            </td>
        </tr>
        <tr>
            <td style="background-color: #f8f9fa; padding: 30px; text-align: center; border-top: 1px solid #e9ecef;">
                <p style="color: #666666; font-size: 14px; margin-bottom: 15px;">
                    Bu e-posta TumMenu tarafından gönderilmiştir.<br>
                    Herhangi bir sorunuz için bize ulaşın: destek@tummenu.com
                </p>
                
                <div style="margin-bottom: 20px;">
                    <a href="#" style="display: inline-block; width: 40px; height: 40px; background-color: #688745; color: white; border-radius: 50%; text-align: center; line-height: 40px; margin: 0 8px; text-decoration: none; font-size: 18px;">f</a>
                    <a href="#" style="display: inline-block; width: 40px; height: 40px; background-color: #688745; color: white; border-radius: 50%; text-align: center; line-height: 40px; margin: 0 8px; text-decoration: none; font-size: 18px;">t</a>
                    <a href="#" style="display: inline-block; width: 40px; height: 40px; background-color: #688745; color: white; border-radius: 50%; text-align: center; line-height: 40px; margin: 0 8px; text-decoration: none; font-size: 18px;">in</a>
                    <a href="#" style="display: inline-block; width: 40px; height: 40px; background-color: #688745; color: white; border-radius: 50%; text-align: center; line-height: 40px; margin: 0 8px; text-decoration: none; font-size: 18px;">📧</a>
                </div>
                
                <p style="color: #999999; font-size: 12px; margin: 0;">
                    © 2025 TumMenu. Tüm hakları saklıdır.<br>
                    Bu e-postayı almak istemiyorsanız lütfen bize bildirin.
                </p>
            </td>
        </tr>
    </table>
</body>
</html>
