@model RegistrationEmailModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TumMenu - Hoş Geldiniz!</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            padding: 20px;
            margin: 0;
        }
        
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }
        
        .email-header {
            background: rgba(255, 255, 255, 0.1);
            padding: 40px 30px;
            text-align: center;
            backdrop-filter: blur(10px);
        }
        
        .logo {
            font-size: 32px;
            font-weight: bold;
            color: white;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        }
        
        .tagline {
            color: rgba(255, 255, 255, 0.9);
            font-size: 16px;
        }
        
        .email-body {
            background: white;
            padding: 40px 30px;
        }
        
        .welcome-title {
            color: #333;
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 20px;
            text-align: center;
        }
        
        .welcome-message {
            color: #666;
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 30px;
            text-align: center;
        }
        
        .feature-box {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            border-left: 4px solid #667eea;
        }
        
        .feature-title {
            color: #333;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }
        
        .feature-icon {
            width: 24px;
            height: 24px;
            background: #667eea;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            color: white;
            font-size: 14px;
        }
        
        .feature-description {
            color: #666;
            font-size: 14px;
            line-height: 1.5;
        }
        
        .button-container {
            text-align: center;
            margin: 40px 0;
        }
        
        .btn {
            display: inline-block;
            padding: 15px 35px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            font-size: 16px;
            margin: 10px;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(102, 126, 234, 0.4);
        }
        
        .btn-secondary {
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
        }
        
        .btn-secondary:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
        }
        
        .email-footer {
            background: #f8f9fa;
            padding: 30px;
            text-align: center;
            border-top: 1px solid #e9ecef;
        }
        
        .footer-text {
            color: #666;
            font-size: 14px;
            margin-bottom: 15px;
        }
        
        .social-links {
            margin-bottom: 20px;
        }
        
        .social-link {
            display: inline-block;
            width: 40px;
            height: 40px;
            background: #667eea;
            color: white;
            border-radius: 50%;
            text-align: center;
            line-height: 40px;
            margin: 0 8px;
            text-decoration: none;
            font-size: 18px;
        }
        
        .social-link:hover {
            background: #764ba2;
            transform: translateY(-2px);
        }
        
        .divider {
            width: 60px;
            height: 3px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            margin: 30px auto;
            border-radius: 2px;
        }
        
        @@media (max-width: 600px) {
            .email-container {
                margin: 10px;
                border-radius: 15px;
            }
            
            .email-header, .email-body, .email-footer {
                padding: 25px 20px;
            }
            
            .welcome-title {
                font-size: 24px;
            }
            
            .btn {
                display: block;
                margin: 10px auto;
                width: 90%;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Header -->
        <div class="email-header">
            <div class="logo">🍽️ TumMenu</div>
            <div class="tagline">Restoranınızı Dijitalleştirin</div>
        </div>
        
        <!-- Body -->
        <div class="email-body">
            <h1 class="welcome-title">Hoş Geldiniz! 👋</h1>
            <p class="welcome-message">
                Merhaba <strong>@Model.UserName</strong>! TumMenu ailesine katıldığınız için çok mutluyuz. 
                Restoranınızı dijitalleştirme yolculuğunuzda size destek olmak için buradayız.
            </p>
            
            <div class="divider"></div>
            
            <!-- Features -->
            <div class="feature-box">
                <div class="feature-title">
                    <span class="feature-icon">📱</span>
                    Dijital Menü
                </div>
                <div class="feature-description">
                    QR kod ile menünüze kolayca erişim sağlayın. Müşterileriniz telefonlarıyla menünüzü anında görüntüleyebilir.
                </div>
            </div>
            
            <div class="feature-box">
                <div class="feature-title">
                    <span class="feature-icon">📊</span>
                    Analitik ve Raporlama
                </div>
                <div class="feature-description">
                    Restoranınızın performansını gerçek zamanlı olarak takip edin. En çok sipariş edilen ürünleri ve müşteri tercihlerini analiz edin.
                </div>
            </div>
            
            <div class="feature-box">
                <div class="feature-title">
                    <span class="feature-icon">🎨</span>
                    Kolay Yönetim
                </div>
                <div class="feature-description">
                    Ürünlerinizi, fiyatlarınızı ve menünüzü tek tıkla güncelleyin. Modern arayüzümüzle yönetim hiç bu kadar kolay olmamıştı.
                </div>
            </div>
            
            <!-- Action Buttons -->
            <div class="button-container">
                <a href="@Model.ConfirmationUrl" class="btn btn-primary">
                    ✅ Hesabımı Onayla
                </a>
                <a href="@Model.AccountActivationUrl" class="btn btn-secondary">
                    🚀 Hesabımı Aç
                </a>
            </div>
            
            <p class="welcome-message">
                Hesabınızı onayladıktan sonra hemen menünüzü oluşturmaya başlayabilirsiniz. 
                Sizlere en iyi hizmeti sunmak için 7/24 destek ekibimiz hazır bekliyor.
            </p>
        </div>
        
        <!-- Footer -->
        <div class="email-footer">
            <p class="footer-text">
                Bu e-posta TumMenu tarafından gönderilmiştir.<br>
                Herhangi bir sorunuz için bize ulaşın: destek@tummenu.com
            </p>
            
            <div class="social-links">
                <a href="#" class="social-link">f</a>
                <a href="#" class="social-link">t</a>
                <a href="#" class="social-link">in</a>
                <a href="#" class="social-link">📧</a>
            </div>
            
            <p class="footer-text" style="font-size: 12px; color: #999;">
                © 2025 TumMenu. Tüm hakları saklıdır.<br>
                Bu e-postayı almak istemiyorsanız lütfen bize bildirin.
            </p>
        </div>
    </div>
</body>
</html>
