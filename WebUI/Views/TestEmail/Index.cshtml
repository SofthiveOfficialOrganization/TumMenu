@{
    ViewData["Title"] = "Email Test";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">📧 SMTP Email Test</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>✅ Başarılı!</strong> @ViewBag.Success
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>❌ Hata!</strong> @ViewBag.Error
                            @if (ViewBag.ErrorDetails != null)
                            {
                                <details class="mt-2">
                                    <summary>Detaylar</summary>
                                    <pre class="mt-2 p-2 bg-light small">@ViewBag.ErrorDetails</pre>
                                </details>
                            }
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" asp-action="SendTestEmail">
                        <div class="mb-3">
                            <label for="toEmail" class="form-label">Test Email Adresi</label>
                            <input type="email" class="form-control" id="toEmail" name="toEmail" 
                                   placeholder="test@example.com" required
                                   value="@ViewBag.TestEmail">
                            <div class="form-text">Kendi email adresinizi yazarak test edebilirsiniz</div>
                        </div>
                        
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-paper-plane me-2"></i>
                                Test Email Gönder
                            </button>
                        </div>
                    </form>

                    <hr class="my-4">

                    <div class="text-muted small">
                        <h6>📋 SMTP Ayarları Kontrolü</h6>
                        <ul class="mb-0">
                            <li>SMTP Server: <code>mail.tummenu.com</code></li>
                            <li>Port: <code>587</code></li>
                            <li>SSL: <code>Aktif</code></li>
                            <li>From: <code>noreply@tummenu.com</code></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

