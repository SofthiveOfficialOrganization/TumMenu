@{
    ViewData["Title"] = "Hesap Aktivasyonu";
    Layout = "_Layout";
}

@section Head {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <style>
        /* Email Verification Success Screen - Redesigned */
        .success-container {
            text-align: center;
            padding: 50px 40px;
            background: #ffffff;
            border-radius: 20px;
            color: var(--color-text-main);
            margin: 40px auto;
            max-width: 540px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
            border: 1px solid rgba(107, 114, 128, 0.08);
        }

        .success-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 24px;
            background: linear-gradient(135deg, #688745 0%, #495E31 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: white;
            box-shadow: 0 4px 12px rgba(104, 135, 69, 0.2);
        }

        .success-title {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 12px;
            color: var(--color-primary-dark);
            line-height: 1.2;
        }

        .success-message {
            font-size: 16px;
            margin-bottom: 32px;
            color: var(--color-muted);
            line-height: 1.6;
            max-width: 420px;
            margin-left: auto;
            margin-right: auto;
        }

        .success-message strong {
            color: var(--color-text-main);
            font-weight: 600;
        }

        .features-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
            margin: 32px 0;
            text-align: left;
        }

        .feature-card {
            background: #FAFAF9;
            padding: 20px;
            border-radius: 16px;
            border: 1px solid rgba(107, 114, 128, 0.06);
            transition: all 0.2s ease;
        }

        .feature-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
        }

        .feature-icon-small {
            font-size: 24px;
            margin-bottom: 12px;
            color: var(--color-primary);
        }

        .feature-title-small {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--color-text-main);
        }

        .feature-description-small {
            font-size: 14px;
            color: var(--color-muted);
            line-height: 1.5;
        }

        .btn-dashboard {
            display: inline-block;
            padding: 14px 32px;
            background: var(--color-primary);
            color: white;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 600;
            font-size: 16px;
            transition: all 0.2s ease;
            border: 1px solid var(--color-primary);
            margin: 8px;
        }

        .btn-dashboard:hover {
            background: var(--color-primary-dark);
            border-color: var(--color-primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(104, 135, 69, 0.25);
        }

        .btn-secondary {
            background: transparent;
            color: var(--color-primary);
            border: 1px solid var(--color-primary);
        }

        .btn-secondary:hover {
            background: var(--color-primary);
            color: white;
        }

        /* Error Container - Updated for consistency */
        .error-container {
            text-align: center;
            padding: 50px 40px;
            background: #ffffff;
            border-radius: 20px;
            color: var(--color-text-main);
            margin: 40px auto;
            max-width: 540px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
            border: 1px solid rgba(107, 114, 128, 0.08);
        }

        .error-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 24px;
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: white;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
        }

        .error-title {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 12px;
            color: #dc3545;
            line-height: 1.2;
        }

        .error-message {
            font-size: 16px;
            margin-bottom: 32px;
            color: var(--color-muted);
            line-height: 1.6;
            max-width: 420px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .success-container, .error-container {
                margin: 20px 16px;
                padding: 40px 24px;
                max-width: none;
            }

            .success-title, .error-title {
                font-size: 28px;
            }

            .success-message, .error-message {
                font-size: 15px;
                margin-bottom: 28px;
            }

            .btn-dashboard {
                display: block;
                margin: 8px auto;
                width: 100%;
                max-width: 280px;
            }

            .feature-card {
                padding: 18px;
            }

            .success-icon, .error-icon {
                width: 56px;
                height: 56px;
                font-size: 24px;
                margin-bottom: 20px;
            }
        }

        @@media (max-width: 480px) {
            .success-container, .error-container {
                padding: 32px 20px;
                margin: 16px 12px;
            }

            .success-title, .error-title {
                font-size: 26px;
            }

            .btn-dashboard {
                padding: 12px 24px;
                font-size: 15px;
            }
        }
    </style>
}

@if (ViewBag.IsSuccess == true)
{
    <div class="success-container">
        <div class="success-icon">🎉</div>
        <h1 class="success-title">Başarılı! Hesabınız Açıldı</h1>
        <p class="success-message">
            @ViewBag.Message<br>
            <strong>@ViewBag.UserName</strong> olarak TumMenu ailesine katıldınız!
        </p>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon-small">📱</div>
                <div class="feature-title-small">Dijital Menü</div>
                <div class="feature-description-small">QR kod ile menünüzü müşterilerinize ulaştırın</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon-small">📊</div>
                <div class="feature-title-small">Analitikler</div>
                <div class="feature-description-small">Restoran performansınızı gerçek zamanlı takip edin</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon-small">🎨</div>
                <div class="feature-title-small">Kolay Yönetim</div>
                <div class="feature-description-small">Modern arayüz ile menünüzü kolayca yönetin</div>
            </div>
        </div>

        <div>
            <a href="/Admin" class="btn-dashboard">
                🚀 Panele Git
            </a>
            <a href="/" class="btn-dashboard btn-secondary">
                🏠 Ana Sayfa
            </a>
        </div>
    </div>
}
else
{
    <div class="error-container">
        <div class="error-icon">😞</div>
        <h1 class="error-title">Hata Oluştu</h1>
        <p class="error-message">
            @ViewBag.Message<br>
            Lütfen daha sonra tekrar deneyin veya destek ekibimizle iletişime geçin.
        </p>

        <div>
            <a href="/giris" class="btn-dashboard">
                🔐 Giriş Yap
            </a>
            <a href="/" class="btn-dashboard btn-secondary">
                🏠 Ana Sayfa
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Add any additional JavaScript if needed
        console.log('Account activation page loaded');
    </script>
}
