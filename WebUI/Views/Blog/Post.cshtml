@using Application.BlogPosts.DTOs
@using WebUI.Seo
@model BlogPostDTO
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var plainText = System.Text.RegularExpressions.Regex.Replace(Model.Content ?? string.Empty, "<.*?>", " ");
    var wordCount = plainText.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
    var readMinutes = Math.Max(1, (int)Math.Ceiling(wordCount / 220.0));
    var primaryTag = Model.Tags?
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(tag => tag.Trim())
        .FirstOrDefault(tag => !string.IsNullOrWhiteSpace(tag));
    var postCulture = new System.Globalization.CultureInfo("tr-TR");
    var eyebrowText = string.IsNullOrWhiteSpace(primaryTag) ? "TumMenu Rehberi" : primaryTag;
    var fallbackCoverImageUrl = "/images/hero-illustration-business.png";
    var imageCaption = string.IsNullOrWhiteSpace(Model.Summary)
        ? $"{Model.Title} yazısı için kapak görseli."
        : $"Görsel: {Model.Summary}";
    var ctaLookup = $"{Model.Slug},{Model.Tags}".ToLowerInvariant();
    var ctaTitle = "QR menüye hazır olup olmadığınızı kontrol edin";
    var ctaDescription = "İşletmenizin dijital menüye geçiş için hangi bilgileri tamamlaması gerektiğini kısa sorularla değerlendirin.";
    var ctaHref = "/qr-menu-uygunluk-testi";
    var ctaLabel = "Uygunluk testini aç";
    var resourceTitle = "Bu yazıya yakın kaynaklar";
    var resourceIntro = "Okuduğunuz konuya göre seçilmiş kaynaklarla menünüzü daha somut kontrol edebilirsiniz.";
    var relatedTools = new[]
    {
        new { Title = "QR menü uygunluk testi", Description = "İşletmenizin QR menüye ne kadar hazır olduğunu kısa sorularla değerlendirin.", Href = "/qr-menu-uygunluk-testi", Label = "Teste git" },
        new { Title = "Kurulum kontrol listesi", Description = "Kategori, ürün, fiyat ve QR yerleşimi için yayına alma adımlarını kontrol edin.", Href = "/qr-menu-kurulum-kontrol-listesi", Label = "Listeyi aç" },
        new { Title = "Kaynak merkezi", Description = "Kontrol listeleri, blog rehberleri ve karar araçlarını tek sayfada inceleyin.", Href = "/restoran-kaynaklari", Label = "Kaynaklara dön" }
    };

    if (ctaLookup.Contains("foto"))
    {
        ctaTitle = "Ürün fotoğraflarınızı güçlendirin";
        ctaDescription = "Menü görsellerinizin sipariş kararını nasıl etkilediğini ve hangi karelerin daha iyi çalıştığını kontrol edin.";
        ctaHref = "/restoran-menu-fotografi-rehberi";
        ctaLabel = "Fotoğraf rehberini aç";
        resourceTitle = "Fotoğraf ve içerik kaynakları";
        relatedTools = new[]
        {
            new { Title = "Fotoğraf rehberi", Description = "Işık, açı ve gerçek ürün temsili için pratik kontrol noktaları.", Href = "/restoran-menu-fotografi-rehberi", Label = "Rehberi aç" },
            new { Title = "Menü tasarımı", Description = "Kategori düzeni, açıklama uzunluğu ve görsel kullanımını birlikte planlayın.", Href = "/blog/restoran-menusu-nasil-tasarlanir", Label = "Yazıyı oku" },
            new { Title = "İçerik kontrol listesi", Description = "Ürün adı, fiyat, açıklama ve görsel alanlarını yayından önce gözden geçirin.", Href = "/blog/restoran-menu-icerigi-kontrol-listesi", Label = "Listeyi oku" }
        };
    }
    else if (ctaLookup.Contains("seo"))
    {
        ctaTitle = "Online menünüzü Google için netleştirin";
        ctaDescription = "Başlık, açıklama, kategori ve ürün içeriklerini arama motorları ve kullanıcılar için daha anlaşılır hale getirin.";
        ctaHref = "/restoran-online-menu-seo-rehberi";
        ctaLabel = "SEO rehberini aç";
        resourceTitle = "SEO ve yayın kalitesi kaynakları";
        relatedTools = new[]
        {
            new { Title = "Online menü SEO rehberi", Description = "Menü sayfalarının başlık, açıklama ve içerik kalitesini kontrol edin.", Href = "/restoran-online-menu-seo-rehberi", Label = "Rehberi aç" },
            new { Title = "İçerik kontrol listesi", Description = "Boş kategori, eksik açıklama ve eski fiyat risklerini azaltın.", Href = "/blog/restoran-menu-icerigi-kontrol-listesi", Label = "Listeyi oku" },
            new { Title = "Kaynak merkezi", Description = "AdSense öncesi içerik ve kullanıcı deneyimi kaynaklarını inceleyin.", Href = "/restoran-kaynaklari", Label = "Kaynaklara dön" }
        };
    }
    else if (ctaLookup.Contains("fiyat") || ctaLookup.Contains("maliyet"))
    {
        ctaTitle = "Kağıt menü maliyetinizi hesaplayın";
        ctaDescription = "Baskı, tasarım ve güncelleme maliyetlerini yıllık düşünerek dijital menü geçişini daha somut değerlendirin.";
        ctaHref = "/menu-baski-maliyeti-hesaplayici";
        ctaLabel = "Maliyeti hesapla";
        resourceTitle = "Maliyet ve geçiş kaynakları";
        relatedTools = new[]
        {
            new { Title = "Baskı maliyeti hesaplayıcı", Description = "Kağıt menünün yıllık tahmini maliyetini kendi verilerinizle görün.", Href = "/menu-baski-maliyeti-hesaplayici", Label = "Hesaplayıcıyı aç" },
            new { Title = "QR ve kağıt menü", Description = "İki yaklaşımı maliyet, kullanım ve güncelleme açısından karşılaştırın.", Href = "/blog/qr-menu-ile-kagit-menu-karsilastirmasi", Label = "Karşılaştırmayı oku" },
            new { Title = "Plan soruları", Description = "İşletmenizin kullanım ihtiyacını konuşmak için destek ekibine yazın.", Href = "/iletisim", Label = "İletişime geç" }
        };
    }
    else if (ctaLookup.Contains("sosyal"))
    {
        ctaTitle = "Instagram trafiğini menüye bağlayın";
        ctaDescription = "Bio, hikaye ve gönderi bağlantılarından gelen kullanıcıların güncel ürün ve fiyatlara ulaşmasını kolaylaştırın.";
        ctaHref = "/blog/restoranlar-icin-sosyal-medya-menu-tanitimi";
        ctaLabel = "Sosyal medya rehberini oku";
    }
    else if (ctaLookup.Contains("alerjen"))
    {
        ctaTitle = "Alerjen bilgisini standartlaştırın";
        ctaDescription = "Ürün açıklamalarında içerik, alerjen ve uygunluk bilgisini aynı dille göstererek müşteri güvenini artırın.";
        ctaHref = "/blog/dijital-menude-alerjen-ve-icerik-bilgisi";
        ctaLabel = "Alerjen rehberini oku";
    }
}

@section Head {
    @{
        var baseUrl = PublicSeo.GetCanonicalBaseUrl(Context);
        var articleSchema = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Article",
            ["headline"] = Model.Title,
            ["description"] = Model.Summary,
            ["url"] = $"{baseUrl}/blog/{Model.Slug}",
            ["mainEntityOfPage"] = new Dictionary<string, object?>
            {
                ["@type"] = "WebPage",
                ["@id"] = $"{baseUrl}/blog/{Model.Slug}"
            },
            ["datePublished"] = Model.PublishedAt.ToString("yyyy-MM-dd"),
            ["dateModified"] = Model.PublishedAt.ToString("yyyy-MM-dd"),
            ["inLanguage"] = "tr-TR",
            ["image"] = string.IsNullOrWhiteSpace(Model.CoverImageUrl)
                ? $"{baseUrl}{fallbackCoverImageUrl}"
                : $"{baseUrl}{Model.CoverImageUrl}",
            ["author"] = new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                ["name"] = "TumMenu Ekibi",
                ["url"] = baseUrl
            },
            ["publisher"] = new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                ["name"] = "Tüm Menü",
                ["url"] = baseUrl,
                ["logo"] = new Dictionary<string, object?>
                {
                    ["@type"] = "ImageObject",
                    ["url"] = $"{baseUrl}/images/logo.png"
                }
            }
        };
    }

    <style>
        .blog-trust-note,
        .blog-related-tools {
            border: 1px solid rgba(73, 85, 56, 0.12);
            border-radius: 8px;
            padding: 22px;
            background: #fff;
            box-shadow: 0 14px 34px rgba(48, 44, 35, 0.06);
        }

        .blog-trust-note {
            margin: 22px 0;
        }

        .blog-trust-note h2,
        .blog-related-tools h2 {
            color: var(--color-secondary-dark);
            font-size: 1.2rem;
            margin: 0 0 10px;
        }

        .blog-trust-note p,
        .blog-related-tools p,
        .blog-related-tools li {
            color: var(--color-text-muted);
            line-height: 1.65;
        }

        .blog-related-tools {
            margin: 26px 0;
        }

        .blog-related-tools__grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px;
            margin-top: 14px;
        }
    </style>

    <script type="application/ld+json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(articleSchema))
    </script>
}

<article class="blog-post section">
    <div class="container blog-post__container">
        <header class="blog-post-hero-new">
            <nav class="blog-post-hero-new__breadcrumbs" aria-label="Breadcrumb">
                <a href="/">Ana Sayfa</a>
                <span aria-hidden="true">•</span>
                <a href="/blog">Blog</a>
                @if (!string.IsNullOrWhiteSpace(primaryTag))
                {
                    <span aria-hidden="true">•</span>
                    <a href="/blog/etiket/@primaryTag">@primaryTag</a>
                }
            </nav>

            <p class="blog-post-hero-new__eyebrow">@eyebrowText</p>
            <h1 class="blog-post-hero-new__title">@Model.Title</h1>

            <div class="blog-post-hero-new__meta">
                <div class="blog-post-hero-new__author">
                    <span class="blog-post-hero-new__avatar" aria-hidden="true">TM</span>
                    <div class="blog-post-hero-new__author-copy">
                        <span class="blog-post-hero-new__author-name">TumMenu Ekibi</span>
                        <span class="blog-post-hero-new__author-role">TumMenu Geliştirici ve Sahipleri</span>
                    </div>
                </div>

                <div class="blog-post-hero-new__meta-items">
                    <span class="blog-post-hero-new__meta-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <time datetime="@Model.PublishedAt.ToString("yyyy-MM-dd")">
                            @Model.PublishedAt.ToString("d MMMM yyyy", postCulture)
                        </time>
                    </span>
                    <span class="blog-post-hero-new__meta-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg>
                        <span>@readMinutes dk okuma</span>
                    </span>
                </div>
            </div>
        </header>

        <figure class="blog-post-cover-new">
            <img src="@ImageUrlBuilder.Build(string.IsNullOrEmpty(Model.CoverImageUrl) ? fallbackCoverImageUrl : Model.CoverImageUrl)" alt="@Model.Title" class="blog-post-cover-new__img" />
            <figcaption class="blog-post-cover-new__caption">@imageCaption</figcaption>
        </figure>

        <section class="blog-post__content">
            @Html.Raw(Model.Content)
        </section>

        <aside class="blog-trust-note" aria-labelledby="blog-trust-heading">
            <h2 id="blog-trust-heading">@ctaTitle</h2>
            <p>@ctaDescription</p>
            <p><a href="@ctaHref">@ctaLabel</a></p>
        </aside>

        <aside class="blog-related-tools" aria-labelledby="blog-related-tools-heading">
            <h2 id="blog-related-tools-heading">@resourceTitle</h2>
            <p>@resourceIntro</p>
            <div class="blog-related-tools__grid">
                @foreach (var tool in relatedTools)
                {
                    <article>
                        <h3>@tool.Title</h3>
                        <p>@tool.Description</p>
                        <a href="@tool.Href">@tool.Label</a>
                    </article>
                }
            </div>
        </aside>

        <div class="blog-post__footer">
            <p>Bu yazıyı faydalı bulduysan diğer rehberlere de göz atabilirsin.</p>
            <a href="/blog" class="btn btn--primary">Diğer Yazılar</a>
        </div>

        <!-- Author Card -->
        <div class="blog-author-card">
            <img src='@ImageUrlBuilder.Build("/images/logo.png")' alt="TumMenu" class="blog-author-card__avatar" />
            <div class="blog-author-card__body">
                <span class="blog-author-card__name">TumMenu Ekibi</span>
                <p class="blog-author-card__bio">Restoran teknolojileri, QR menü çözümleri ve yemek kültürü üzerine içerikler üreten TumMenu editör ekibi.</p>
                <div class="blog-author-card__actions">
                    <a href="/blog" class="blog-author-card__action" aria-label="Tüm yazılar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                    </a>
                    <a href="mailto:blog@tummenu.com" class="blog-author-card__action" aria-label="İletişim">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </a>
                </div>
            </div>
        </div>

    </div>
</article>
