@using Application.BlogPosts.DTOs
@model BlogPostDTO
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var plainText = System.Text.RegularExpressions.Regex.Replace(Model.Content ?? string.Empty, "<.*?>", " ");
    var wordCount = plainText.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
    var readMinutes = Math.Max(1, (int)Math.Ceiling(wordCount / 220.0));
    var primaryTag = Model.Tags?
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(tag => tag.Trim())
        .FirstOrDefault(tag => !string.IsNullOrWhiteSpace(tag));
    var postCulture = new System.Globalization.CultureInfo("tr-TR");
    var eyebrowText = string.IsNullOrWhiteSpace(primaryTag) ? "TumMenu Rehberi" : primaryTag;
    var imageCaption = string.IsNullOrWhiteSpace(Model.Summary)
        ? $"{Model.Title} yazısı için kapak görseli."
        : $"Görsel: {Model.Summary}";
}

@section Head {
    <style>
        .blog-trust-note,
        .blog-related-tools {
            border: 1px solid rgba(73, 85, 56, 0.12);
            border-radius: 8px;
            padding: 22px;
            background: #fff;
            box-shadow: 0 14px 34px rgba(48, 44, 35, 0.06);
        }

        .blog-trust-note {
            margin: 22px 0;
        }

        .blog-trust-note h2,
        .blog-related-tools h2 {
            color: var(--color-secondary-dark);
            font-size: 1.2rem;
            margin: 0 0 10px;
        }

        .blog-trust-note p,
        .blog-related-tools p,
        .blog-related-tools li {
            color: var(--color-text-muted);
            line-height: 1.65;
        }

        .blog-related-tools {
            margin: 26px 0;
        }

        .blog-related-tools__grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px;
            margin-top: 14px;
        }
    </style>

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Article",
      "headline": "@Model.Title",
      "description": "@Model.Summary",
      "datePublished": "@Model.PublishedAt.ToString("yyyy-MM-dd")"
    }
    </script>
}

<article class="blog-post section">
    <div class="container blog-post__container">
        <header class="blog-post-hero-new">
            <nav class="blog-post-hero-new__breadcrumbs" aria-label="Breadcrumb">
                <a href="/">Ana Sayfa</a>
                <span aria-hidden="true">•</span>
                <a href="/blog">Blog</a>
                @if (!string.IsNullOrWhiteSpace(primaryTag))
                {
                    <span aria-hidden="true">•</span>
                    <a href="/blog/etiket/@primaryTag">@primaryTag</a>
                }
            </nav>

            <p class="blog-post-hero-new__eyebrow">@eyebrowText</p>
            <h1 class="blog-post-hero-new__title">@Model.Title</h1>

            <div class="blog-post-hero-new__meta">
                <div class="blog-post-hero-new__author">
                    <span class="blog-post-hero-new__avatar" aria-hidden="true">TM</span>
                    <div class="blog-post-hero-new__author-copy">
                        <span class="blog-post-hero-new__author-name">TumMenu Ekibi</span>
                        <span class="blog-post-hero-new__author-role">TumMenu Geliştirici ve Sahipleri</span>
                    </div>
                </div>

                <div class="blog-post-hero-new__meta-items">
                    <span class="blog-post-hero-new__meta-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <time datetime="@Model.PublishedAt.ToString("yyyy-MM-dd")">
                            @Model.PublishedAt.ToString("d MMMM yyyy", postCulture)
                        </time>
                    </span>
                    <span class="blog-post-hero-new__meta-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg>
                        <span>@readMinutes dk okuma</span>
                    </span>
                </div>
            </div>
        </header>

        <figure class="blog-post-cover-new">
            <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/images/hero-illustration.png" : Model.CoverImageUrl)" alt="@Model.Title" class="blog-post-cover-new__img" />
            <figcaption class="blog-post-cover-new__caption">@imageCaption</figcaption>
        </figure>

        <section class="blog-post__content">
            @Html.Raw(Model.Content)
        </section>

        <aside class="blog-trust-note" aria-labelledby="blog-trust-heading">
            <h2 id="blog-trust-heading">Editoryal not</h2>
            <p>
                Bu içerik, restoranların QR menü ve dijital menü kurulumunda karşılaştığı pratik sorulara yanıt vermek için
                TumMenu ekibi tarafından hazırlanmıştır. Yazılarda ürün tanıtımından çok uygulanabilir kontrol noktaları,
                menü yönetimi ve müşteri deneyimi konularına odaklanılır.
            </p>
        </aside>

        <aside class="blog-related-tools" aria-labelledby="blog-related-tools-heading">
            <h2 id="blog-related-tools-heading">İlgili araçlar ve kaynaklar</h2>
            <p>Okuduğunuz konuyu kendi işletmenize uyarlamak için aşağıdaki ücretsiz kaynakları kullanabilirsiniz.</p>
            <div class="blog-related-tools__grid">
                <article>
                    <h3>QR menü uygunluk testi</h3>
                    <p>İşletmenizin QR menüye ne kadar hazır olduğunu kısa sorularla değerlendirin.</p>
                    <a href="/qr-menu-uygunluk-testi">Teste git</a>
                </article>
                <article>
                    <h3>Baskı maliyeti hesaplayıcı</h3>
                    <p>Kağıt menü baskısının yıllık tahmini maliyetini kendi verilerinizle görün.</p>
                    <a href="/menu-baski-maliyeti-hesaplayici">Hesaplayıcıyı aç</a>
                </article>
                <article>
                    <h3>Kaynak merkezi</h3>
                    <p>Kontrol listeleri, blog rehberleri ve karar araçlarını tek sayfada inceleyin.</p>
                    <a href="/restoran-kaynaklari">Kaynaklara dön</a>
                </article>
            </div>
        </aside>

        <div class="blog-post__footer">
            <p>Bu yazıyı faydalı bulduysan diğer rehberlere de göz atabilirsin.</p>
            <a href="/blog" class="btn btn--primary">Diğer Yazılar</a>
        </div>

        <!-- Author Card -->
        <div class="blog-author-card">
            <img src="/images/logo.png" alt="TumMenu" class="blog-author-card__avatar" />
            <div class="blog-author-card__body">
                <span class="blog-author-card__name">TumMenu Ekibi</span>
                <p class="blog-author-card__bio">Restoran teknolojileri, QR menü çözümleri ve yemek kültürü üzerine içerikler üreten TumMenu editör ekibi.</p>
                <div class="blog-author-card__actions">
                    <a href="/blog" class="blog-author-card__action" aria-label="Tüm yazılar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                    </a>
                    <a href="mailto:blog@tummenu.com" class="blog-author-card__action" aria-label="İletişim">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </a>
                </div>
            </div>
        </div>

    </div>
</article>
