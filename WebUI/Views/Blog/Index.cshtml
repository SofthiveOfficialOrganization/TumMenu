@using System.Linq
@using Application.BlogPosts.DTOs
@using Application.Common.Base.DTOs
@model PaginatedListDTO<BlogPostListDTO>
@{
    ViewData["Title"] = "Blog";
    ViewData["Description"] = "Restoran, QR menü ve yemek kültürü hakkında faydalı yazılar.";

    var featured = Model.Items.FirstOrDefault();
    var restPosts = Model.Items.Skip(1).ToList();

    var tagGroups = Model.Items
        .Where(x => !string.IsNullOrWhiteSpace(x.Tags))
        .SelectMany(x => x.Tags!.Split(',', StringSplitOptions.RemoveEmptyEntries))
        .Select(x => x.Trim())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .GroupBy(x => x, StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(g => g.Count())
        .Take(8)
        .ToList();

    var topTags = tagGroups.Select(g => g.Key).ToList();
}

@section Head {
    @{
        var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var blogSchema = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Blog",
            ["name"] = "TümMenü Blog",
            ["description"] = ViewData["Description"],
            ["url"] = $"{baseUrl}/blog",
            ["inLanguage"] = "tr-TR",
            ["publisher"] = new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                ["name"] = "Tüm Menü",
                ["url"] = baseUrl,
                ["logo"] = new Dictionary<string, object?>
                {
                    ["@type"] = "ImageObject",
                    ["url"] = $"{baseUrl}/images/logo.png"
                }
            }
        };

        var itemListSchema = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "ItemList",
            ["name"] = "TümMenü restoran teknolojileri yazıları",
            ["itemListElement"] = Model.Items.Select((post, index) => new Dictionary<string, object?>
            {
                ["@type"] = "ListItem",
                ["position"] = index + 1,
                ["url"] = $"{baseUrl}/blog/{post.Slug}",
                ["name"] = post.Title
            }).ToList()
        };
    }

    <script type="application/ld+json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(blogSchema))
    </script>
    <script type="application/ld+json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(itemListSchema))
    </script>

    <style>
        .blog-topic-section {
            max-width: 1180px;
            margin: 0 auto 48px;
            padding: 0 24px;
        }

        .blog-topic-heading {
            margin-bottom: 18px;
        }

        .blog-topic-heading h2 {
            color: var(--color-secondary-dark);
            font-size: clamp(1.5rem, 3vw, 2.2rem);
            margin-bottom: 8px;
        }

        .blog-topic-heading p {
            color: var(--color-text-muted);
            line-height: 1.7;
            max-width: 780px;
        }

        .blog-topic-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 18px;
        }

        .blog-topic-card {
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 230px;
            padding: 22px;
            border-radius: 8px;
            border: 1px solid rgba(73, 85, 56, 0.12);
            background: #fff;
            box-shadow: 0 14px 34px rgba(48, 44, 35, 0.06);
        }

        .blog-topic-card h3 {
            color: var(--color-secondary-dark);
            font-size: 1.15rem;
            margin: 0;
        }

        .blog-topic-card p {
            color: var(--color-text-muted);
            line-height: 1.65;
            margin: 0;
        }

        .blog-topic-links {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: auto;
        }

        .blog-topic-links a {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 7px 10px;
            background: rgba(104, 135, 69, 0.1);
            color: var(--color-primary);
            font-size: 0.88rem;
            font-weight: 800;
            text-decoration: none;
        }

        .blog-resource-banner {
            max-width: 1180px;
            margin: 0 auto 48px;
            padding: 0 24px;
        }

        .blog-resource-banner__inner {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 18px;
            align-items: center;
            border: 1px solid rgba(73, 85, 56, 0.12);
            border-radius: 8px;
            padding: 24px;
            background: #fff;
            box-shadow: 0 14px 34px rgba(48, 44, 35, 0.06);
        }

        .blog-resource-banner h2 {
            color: var(--color-secondary-dark);
            font-size: 1.35rem;
            margin: 0 0 8px;
        }

        .blog-resource-banner p {
            color: var(--color-text-muted);
            line-height: 1.65;
            margin: 0;
        }

        .blog-resource-banner__actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        @@media (max-width: 820px) {
            .blog-resource-banner__inner {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<main class="blog-page-main">
    @if (Model.Items.Any())
    {
        @if (featured is not null)
        {
            <!-- Featured Article Section -->
            <section class="blog-featured-section" aria-labelledby="blog-featured-title">
                <div class="blog-featured-grid">
                    <div class="blog-featured-image-col">
                        <div class="blog-featured-image-glow"></div>
                        <div class="blog-featured-image-wrap">
                            <img src="@ImageUrlBuilder.Build(string.IsNullOrEmpty(featured.CoverImageUrl) ? "/images/hero-illustration-business.png" : featured.CoverImageUrl)"
                                 alt="@featured.Title"
                                 class="blog-featured-img" />
                        </div>
                        <span class="blog-featured-badge">Öne Çıkan</span>
                    </div>
                    <div class="blog-featured-body">
                        @if (!string.IsNullOrEmpty(featured.Tags))
                        {
                            <span class="blog-featured-category">@featured.Tags.Split(',').First().Trim()</span>
                        }
                        <h1 id="blog-featured-title" class="blog-featured-title">@featured.Title</h1>
                        <p class="blog-featured-summary">@featured.Summary</p>
                        <a href="/blog/@featured.Slug" class="blog-featured-cta">
                            Yazıyı Oku
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>
            </section>
        }

        <section class="blog-topic-section" aria-labelledby="blog-topic-heading">
            <div class="blog-topic-heading">
                <h2 id="blog-topic-heading">Konuya göre rehberler</h2>
                <p>
                    QR menüye geçiş, menü tasarımı, fiyatlandırma ve restoran pazarlaması üzerine yazıları
                    ihtiyacınıza göre grupladık. Böylece yalnızca son yazılara değil, karar sürecinize en yakın
                    rehberlere de hızlıca ulaşabilirsiniz.
                </p>
            </div>

            <div class="blog-topic-grid">
                <article class="blog-topic-card">
                    <h3>QR Menüye Başlangıç</h3>
                    <p>QR menünün çalışma mantığını, kağıt menüyle farklarını ve kurulum adımlarını öğrenin.</p>
                    <div class="blog-topic-links">
                        <a href="/blog/qr-menu-nedir-nasil-calisir">QR menü nedir?</a>
                        <a href="/blog/qr-menu-ile-kagit-menu-karsilastirmasi">QR vs kağıt</a>
                        <a href="/blog/qr-menu-kurulumu-adim-adim-restoran-rehberi">Kurulum</a>
                    </div>
                </article>

                <article class="blog-topic-card">
                    <h3>Menü Tasarımı ve İçerik</h3>
                    <p>Ürün açıklaması, fotoğraf, kategori düzeni ve fiyatlandırma kararlarını daha bilinçli planlayın.</p>
                    <div class="blog-topic-links">
                        <a href="/blog/restoran-menusu-nasil-tasarlanir">Menü tasarımı</a>
                        <a href="/blog/menu-fotograflari-dijital-menude-neden-onemlidir">Fotoğraf</a>
                        <a href="/blog/restoran-menu-fiyatlandirma-stratejileri">Fiyatlandırma</a>
                    </div>
                </article>

                <article class="blog-topic-card">
                    <h3>İşletme ve Müşteri Deneyimi</h3>
                    <p>Kafe, restoran ve çok şubeli işletmeler için dijital menünün operasyonel etkisini inceleyin.</p>
                    <div class="blog-topic-links">
                        <a href="/blog/restoranlar-neden-dijital-menuye-gecmeli">Neden dijital?</a>
                        <a href="/blog/qr-menu-musteri-deneyimini-nasil-iyilestirir">Deneyim</a>
                        <a href="/blog/kucuk-kafeler-icin-qr-menu-avantajlari">Küçük kafeler</a>
                    </div>
                </article>

                <article class="blog-topic-card">
                    <h3>Büyüme ve Pazarlama</h3>
                    <p>Online siparişe hazırlık, sosyal medya menü tanıtımı ve restoran teknolojisi trendlerini keşfedin.</p>
                    <div class="blog-topic-links">
                        <a href="/blog/online-siparise-hazirlik-rehberi">Online sipariş</a>
                        <a href="/blog/restoranlar-icin-sosyal-medya-menu-tanitimi">Sosyal medya</a>
                        <a href="/blog/restoran-teknolojileri-trendleri">Trendler</a>
                    </div>
                </article>
            </div>
        </section>

        <section class="blog-resource-banner" aria-labelledby="blog-resource-heading">
            <div class="blog-resource-banner__inner">
                <div>
                    <h2 id="blog-resource-heading">Yazıları araçlarla destekleyin</h2>
                    <p>QR menü kararınızı hızlandırmak için uygunluk testini çözebilir, kağıt menü baskı maliyetinizi hesaplayabilir ve kontrol listesini inceleyebilirsiniz.</p>
                </div>
                <div class="blog-resource-banner__actions">
                    <a class="btn btn--primary" href="/restoran-kaynaklari">Kaynak merkezi</a>
                    <a class="btn btn--ghost" href="/qr-menu-uygunluk-testi">Uygunluk testi</a>
                </div>
            </div>
        </section>

        <!-- Content Grid & Sidebar -->
        <div class="blog-content-grid">
            <!-- Articles Column -->
            <div class="blog-articles-col">
                <div class="blog-articles-heading-row">
                    <h2 class="blog-articles-heading">Son Yazılar</h2>
                    <div class="blog-articles-divider"></div>
                </div>
                <div class="blog-cards-grid">
                    @foreach (var post in restPosts.Any() ? restPosts : Model.Items.ToList())
                    {
                        <article class="blog-card-new">
                            <a href="/blog/@post.Slug" class="blog-card-new__hit" aria-label="@post.Title"></a>
                            <div class="blog-card-new__image-wrap">
                                <img src="@ImageUrlBuilder.Build(string.IsNullOrEmpty(post.CoverImageUrl) ? "/images/hero-illustration-customer.png" : post.CoverImageUrl)"
                                     alt="@post.Title"
                                     class="blog-card-new__image" />
                            </div>
                            <div class="blog-card-new__body">
                                @if (!string.IsNullOrEmpty(post.Tags))
                                {
                                    <span class="blog-card-new__category">@post.Tags.Split(',').First().Trim()</span>
                                }
                                <h3 class="blog-card-new__title">@post.Title</h3>
                                <p class="blog-card-new__summary">@post.Summary</p>
                                <a href="/blog/@post.Slug" class="blog-card-new__readmore">
                                    Devamını Oku
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            </div>

            <!-- Sidebar -->
            <aside class="blog-sidebar-new" aria-label="Blog Yan Panel">
                <!-- Categories -->
                @if (tagGroups.Any())
                {
                    <div class="blog-panel-new blog-panel-new--cats">
                        <h4 class="blog-panel-new__heading">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                            Kategoriler
                        </h4>
                        @foreach (var g in tagGroups)
                        {
                            <a href="/blog/etiket/@g.Key" class="blog-cat-item">
                                <span>@g.Key</span>
                                <span class="blog-cat-count">@g.Count()</span>
                            </a>
                        }
                    </div>
                }

                <!-- Popular Tags -->
                @if (topTags.Any())
                {
                    <div class="blog-panel-new">
                        <h4 class="blog-panel-new__heading">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                            Popüler Etiketler
                        </h4>
                        <div class="blog-tags-wrap">
                            @foreach (var tag in topTags)
                            {
                                <a href="/blog/etiket/@tag" class="blog-tag-new">@tag</a>
                            }
                        </div>
                    </div>
                }
            </aside>
        </div>
    }
    else
    {
        <div class="blog-empty-new">
            <h2>Henüz içerik yok</h2>
            <p>Restoran işletmeciliği, QR menü ve dijital menü tasarımı hakkında içerikler burada yayınlanır.</p>
        </div>
    }

    @if (Model.Pages > 1)
    {
        <nav class="pagination" aria-label="Blog sayfalandırma">
            @for (int i = 1; i <= Model.Pages; i++)
            {
                <a href="/blog?page=@i" class="pagination__item @(i == Model.Index ? "pagination__item--active" : "")">@i</a>
            }
        </nav>
    }
</main>
