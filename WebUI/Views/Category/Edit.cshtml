@model UpdateCategoryCommand


@{
    ViewData["Title"] = "Kategori Düzenle";
}
@{
    Guid? menuId = ViewData["MenuId"] is Guid g ? g : null;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">

                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input asp-for="Id" type="hidden" />
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Name" class="form-label">Kategori Adı</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Slug" class="form-label">Slug</label>
                                <input asp-for="Slug" class="form-control" type="number" />
                                <span asp-validation-for="Slug" class="text-danger"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        
                            
                             <div class="col-md-6">
                                <label asp-for="SortOrder" class="form-label">Sıralama</label>
                                <input asp-for="SortOrder" class="form-control" type="number" />
                                <span asp-validation-for="SortOrder" class="text-danger"></span>
                            </div>


                        </div>

                        <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" asp-route-MenuId="@menuId" class="btn btn-secondary">İptal</a>
                            <button type="submit" class="btn btn-primary px-4">Güncelle</button>
                        </div>
                        <a asp-action="Index" asp-route-menuId="@menuId" class="btn btn-secondary">İptal</a>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
