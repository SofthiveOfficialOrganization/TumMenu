@using Application.Categories.DTOs
@model CategoryDTO

@{
    ViewData["Title"] = "Kategori Detayı";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="Index" asp-route-MenuId="@Model?.MenuId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Listeye Dön
        </a>
    </div>

    @if (Model != null)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h2 class="card-title mb-3">@Model.Name</h2>
                        <p class="text-muted">Slug: @Model.Slug</p>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="mb-4">
                                <h5>Açıklama</h5>
                                <p>@Model.Description</p>
                            </div>
                        }

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <div class="p-3 border rounded bg-light">
                                    <small class="text-muted d-block mb-1">Menü ID</small>
                                    <span class="fs-6">@Model.MenuId</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 border rounded bg-light">
                                    <small class="text-muted d-block mb-1">Sıralama</small>
                                    <span class="fs-5 fw-bold">@Model.SortOrder</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="d-grid gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Düzenle
                            </a>
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="bi bi-trash"></i> Sil
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Silme Modalı -->
        <div class="modal fade" id="deleteModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Kategoriyi Sil</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p><strong>@Model.Name</strong> kategorisini silmek istediğinize emin misiniz?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">Evet, Sil</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Kategori bulunamadı.
        </div>
    }
</div>
